[submodule "3rd/edg"]
	path = 3rd/edg
	url = https://github.com/take-cheeze/edg-compiler
	shallow = true
[submodule "3rd/qbe"]
	path = 3rd/qbe
	url = https://github.com/take-cheeze/qbe
[submodule "3rd/mruby-onig-regexp"]
	path = 3rd/mruby-onig-regexp
	url = https://github.com/take-cheeze/mruby-onig-regexp.git
[submodule "3rd/mruby-json"]
	path = 3rd/mruby-json
	url = https://github.com/mattn/mruby-json
[submodule "bc2cpp/3rd/prism"]
	path = bc2cpp/3rd/prism
	url = https://github.com/take-cheeze/prism
[submodule "bc2cpp/3rd/rbs"]
	path = bc2cpp/3rd/rbs
	url = https://github.com/take-cheeze/rbs.git
[submodule "3rd/mruby"]
	path = 3rd/mruby
	url = https://github.com/take-cheeze/mruby
	branch = claude/fork-integration
[submodule "3rd/mruby-marshal"]
	path = 3rd/mruby-marshal
	url = https://github.com/take-cheeze/mruby-marshal
[submodule "3rd/quickjs"]
	path = 3rd/quickjs
	url = https://github.com/bellard/quickjs
