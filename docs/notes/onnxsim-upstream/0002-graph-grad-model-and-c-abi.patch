+/*
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * The gradient of a whole ONNX model: see graph_grad_model.cpp.
+ */
+#pragma once
+
+#include <onnx/onnx_pb.h>
+
+#include <cstddef>
+#include <string>
+#include <vector>
+
+// The forward nodes `loss` needs plus the nodes that compute d loss / d wrt[k]
+// by graph_grad.h's rules, as a new model. `loss` names a scalar float32 or
+// float64 tensor of `forward` whose shapes are all static; every `wrt[k]` is a
+// float tensor (an input, an initializer or any node output). The model keeps
+// `forward`'s inputs, initializers and opset, has one graph output
+// `<prefix>grad_<k>` per wrt (in order, with the shape and type of wrt[k]) and
+// every new tensor name starts with `prefix`, so it can be merged into a graph
+// that holds `forward` by name. Gradients are built in the element type of the
+// loss (GraphBuilder::SetFloatType). A wrt the loss does not reach gets a zero
+// of its shape; a wrt that is the loss gets the seed 1.
+//
+// Only nodes that depend on a wrt are differentiated, so an operator without a
+// rule elsewhere in the graph is not an error.
+//
+// Throws UnsupportedOpError for a differentiated node without a rule and
+// std::invalid_argument for a bad loss, wrt or model.
+onnx::ModelProto BuildGradientModel(const onnx::ModelProto& forward,
+                                    const std::string& loss,
+                                    const std::vector<std::string>& wrt,
+                                    const std::string& prefix = "grad_");
+
+extern "C" {
+
+// The same through bytes. Returns 0 (*out, *out_size hold the serialized
+// model), 1 (an operator without a rule: *error has the message) or 2 (any
+// other failure: *error). Release *out and *error with onnxsim_free.
+int onnxsim_gradient_model(const char* model, size_t size, const char* loss,
+                           const char* const* wrt, size_t num_wrt,
+                           const char* prefix, char** out, size_t* out_size,
+                           char** error);
+void onnxsim_free(void* p);
+
+}  // extern "C"
