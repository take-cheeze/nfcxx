@@ -0,0 +1,197 @@
+/*
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * Exercises graph_grad_model.{h,cpp}: the whole-model gradient and its C ABI.
+ * Like graph_grad_test.cpp it checks structure, not numbers (nothing here
+ * evaluates an ONNX graph); the numbers are the rules' own, tested there.
+ */
+#include "graph_grad_model.h"
+
+#include <onnx/onnx_pb.h>
+
+#include <cstdio>
+#include <cstring>
+#include <string>
+#include <vector>
+
+#include "graph_grad.h"
+
+namespace {
+
+int g_failures = 0;
+
+void Check(bool condition, const std::string& what) {
+  if (!condition) {
+    std::fprintf(stderr, "FAIL: %s\n", what.c_str());
+    ++g_failures;
+  }
+}
+
+void AddInput(onnx::GraphProto* g, const std::string& name, int type,
+              std::vector<int64_t> dims) {
+  onnx::ValueInfoProto* v = g->add_input();
+  v->set_name(name);
+  onnx::TypeProto_Tensor* t = v->mutable_type()->mutable_tensor_type();
+  t->set_elem_type(type);
+  t->mutable_shape();
+  for (int64_t d : dims) t->mutable_shape()->add_dim()->set_dim_value(d);
+}
+
+onnx::NodeProto* AddNode(onnx::GraphProto* g, const std::string& op,
+                         std::vector<std::string> in, std::string out) {
+  onnx::NodeProto* n = g->add_node();
+  n->set_op_type(op);
+  for (const std::string& i : in) n->add_input(i);
+  n->add_output(out);
+  return n;
+}
+
+// loss S = ReduceSum(Tanh(X @ W)), with an input U the loss does not use.
+onnx::ModelProto Forward(int type) {
+  onnx::ModelProto m;
+  m.set_ir_version(8);
+  onnx::OperatorSetIdProto* opset = m.add_opset_import();
+  opset->set_domain("");
+  opset->set_version(18);
+  onnx::GraphProto* g = m.mutable_graph();
+  g->set_name("t");
+  AddInput(g, "X", type, {2, 3});
+  AddInput(g, "W", type, {3, 4});
+  AddInput(g, "U", type, {5});
+  AddNode(g, "MatMul", {"X", "W"}, "H");
+  AddNode(g, "Tanh", {"H"}, "T");
+  onnx::NodeProto* sum = AddNode(g, "ReduceSum", {"T"}, "S");
+  onnx::AttributeProto* keep = sum->add_attribute();
+  keep->set_name("keepdims");
+  keep->set_type(onnx::AttributeProto::INT);
+  keep->set_i(0);
+  return m;
+}
+
+const onnx::ValueInfoProto* Output(const onnx::ModelProto& m, const std::string& name) {
+  for (const onnx::ValueInfoProto& o : m.graph().output()) {
+    if (o.name() == name) return &o;
+  }
+  return nullptr;
+}
+
+void TheGradientModelHasOneOutputPerWrtWithTheShapeOfTheWrt() {
+  const onnx::ModelProto fwd = Forward(onnx::TensorProto::FLOAT);
+  const onnx::ModelProto g = BuildGradientModel(fwd, "S", {"W", "X", "U"}, "p_");
+  Check(g.graph().output_size() == 3, "an output per wrt");
+  const onnx::ValueInfoProto* dw = Output(g, "p_grad_0");
+  const onnx::ValueInfoProto* dx = Output(g, "p_grad_1");
+  const onnx::ValueInfoProto* du = Output(g, "p_grad_2");
+  Check(dw && dx && du, "the outputs are named <prefix>grad_<k>");
+  if (!(dw && dx && du)) return;
+  Check(dw->type().tensor_type().shape().dim_size() == 2 && dw->type().tensor_type().shape().dim(0).dim_value() == 3, "the gradient of W is (3, 4)");
+  Check(dx->type().tensor_type().shape().dim(1).dim_value() == 3, "the gradient of X is (2, 3)");
+  Check(du->type().tensor_type().shape().dim_size() == 1 && du->type().tensor_type().shape().dim(0).dim_value() == 5, "U, which the loss does not use, gets a zero of its shape");
+  Check(du->type().tensor_type().elem_type() == onnx::TensorProto::FLOAT, "float32 in, float32 out");
+  // the forward nodes are carried along unchanged, the new names start with the prefix
+  Check(g.graph().node(0).op_type() == "MatMul" && g.graph().node(0).output(0) == "H", "the forward nodes come first");
+  for (int k = 3; k < g.graph().node_size(); ++k) {
+    for (const std::string& o : g.graph().node(k).output()) {
+      Check(o.compare(0, 2, "p_") == 0, "a new tensor name starts with the prefix: " + o);
+    }
+  }
+  for (const onnx::TensorProto& t : g.graph().initializer()) {
+    Check(t.name().compare(0, 2, "p_") == 0, "a new initializer starts with the prefix: " + t.name());
+  }
+  Check(g.functions_size() == 0, "the model-local functions of the templated rules are inlined");
+  for (const onnx::OperatorSetIdProto& o : g.opset_import()) {
+    Check(o.domain().empty(), "no private function domain is left in the opset imports");
+  }
+}
+
+void AFloat64LossGetsFloat64Constants() {
+  const onnx::ModelProto g = BuildGradientModel(Forward(onnx::TensorProto::DOUBLE), "S", {"W"}, "d_");
+  for (const onnx::TensorProto& t : g.graph().initializer()) {
+    if (t.name().compare(0, 2, "d_") != 0 || t.data_type() == onnx::TensorProto::INT64) continue;
+    Check(t.data_type() == onnx::TensorProto::DOUBLE, "float64 constant " + t.name());
+  }
+  Check(Output(g, "d_grad_0")->type().tensor_type().elem_type() == onnx::TensorProto::DOUBLE, "float64 gradient");
+}
+
+void ALossThatIsAWrtGetsTheSeed() {
+  const onnx::ModelProto g = BuildGradientModel(Forward(onnx::TensorProto::FLOAT), "S", {"S"}, "s_");
+  Check(g.graph().output_size() == 1 && g.graph().output(0).type().tensor_type().shape().dim_size() == 0, "d S / d S is a scalar");
+}
+
+void AnOperatorOffThePathOfEveryWrtIsNotReached() {
+  onnx::ModelProto fwd = Forward(onnx::TensorProto::FLOAT);
+  // a Sin that does not depend on X or W, feeding nothing the loss needs
+  AddNode(fwd.mutable_graph(), "Sin", {"U"}, "SU");
+  Check(BuildGradientModel(fwd, "S", {"X"}, "q_").graph().output_size() == 1, "an unrelated Sin is ignored");
+}
+
+void AnOperatorWithoutARuleOnThePathIsRefused() {
+  onnx::ModelProto fwd = Forward(onnx::TensorProto::FLOAT);
+  fwd.mutable_graph()->mutable_node(1)->set_op_type("Sin");   // Tanh -> Sin
+  bool threw = false;
+  try {
+    BuildGradientModel(fwd, "S", {"X"}, "q_");
+  } catch (const UnsupportedOpError& e) {
+    threw = std::string(e.what()).find("Sin") != std::string::npos;
+  }
+  Check(threw, "UnsupportedOpError names the operator");
+}
+
+void ABadLossOrWrtIsRefused() {
+  const onnx::ModelProto fwd = Forward(onnx::TensorProto::FLOAT);
+  auto refused = [&](const std::string& loss, const std::vector<std::string>& wrt, const std::string& fragment) {
+    try {
+      BuildGradientModel(fwd, loss, wrt, "q_");
+    } catch (const std::invalid_argument& e) {
+      return std::string(e.what()).find(fragment) != std::string::npos;
+    }
+    return false;
+  };
+  Check(refused("T", {"X"}, "must be a scalar"), "a loss with a shape");
+  Check(refused("nope", {"X"}, "not a value"), "an unknown loss");
+  Check(refused("S", {"nope"}, "not a value"), "an unknown wrt");
+}
+
+void TheCAbiReturnsTheModelOrTheMessage() {
+  const onnx::ModelProto fwd = Forward(onnx::TensorProto::FLOAT);
+  std::string bytes;
+  fwd.SerializeToString(&bytes);
+  const char* wrt[] = {"X", "W"};
+  char* out = nullptr;
+  char* err = nullptr;
+  size_t n = 0;
+  int rc = onnxsim_gradient_model(bytes.data(), bytes.size(), "S", wrt, 2, "c_", &out, &n, &err);
+  Check(rc == 0 && out != nullptr && err == nullptr, "success");
+  onnx::ModelProto back;
+  Check(out != nullptr && back.ParseFromArray(out, static_cast<int>(n)) && back.graph().output_size() == 2, "the bytes are a ModelProto with two outputs");
+  onnxsim_free(out);
+
+  onnx::ModelProto bad = fwd;
+  bad.mutable_graph()->mutable_node(1)->set_op_type("Sin");
+  bad.SerializeToString(&bytes);
+  rc = onnxsim_gradient_model(bytes.data(), bytes.size(), "S", wrt, 2, "c_", &out, &n, &err);
+  Check(rc == 1 && out == nullptr && err != nullptr && std::strstr(err, "Sin") != nullptr, "an operator without a rule is status 1 with the message");
+  onnxsim_free(err);
+
+  rc = onnxsim_gradient_model("junk", 4, "S", wrt, 2, "c_", &out, &n, &err);
+  Check(rc == 2 && err != nullptr, "bytes that are not a model are status 2");
+  onnxsim_free(err);
+}
+
+}  // namespace
+
+int main() {
+  TheGradientModelHasOneOutputPerWrtWithTheShapeOfTheWrt();
+  AFloat64LossGetsFloat64Constants();
+  ALossThatIsAWrtGetsTheSeed();
+  AnOperatorOffThePathOfEveryWrtIsNotReached();
+  AnOperatorWithoutARuleOnThePathIsRefused();
+  ABadLossOrWrtIsRefused();
+  TheCAbiReturnsTheModelOrTheMessage();
+  if (g_failures != 0) {
+    std::fprintf(stderr, "%d check(s) failed\n", g_failures);
+    return 1;
+  }
+  std::fprintf(stderr, "all graph_grad_model checks passed\n");
+  return 0;
+}
