--- a/quickjs-c-atomics.h
+++ b/quickjs-c-atomics.h
@@ -49,6 +49,23 @@
 #define atomic_fetch_sub(obj, arg) \
     __atomic_fetch_sub(obj, arg, __ATOMIC_SEQ_CST)
 #define _Atomic
+#elif defined(__CPROC__)
+/* cproc has no _Atomic and no generic __atomic_* builtins: the sized libatomic functions of the same operations
+   (qbe-prep.rb declares them), chosen by the size of the pointed-to type. Memory order 5 is seq_cst. */
+#define _Atomic
+#define QJS_ATOMIC_FN(op, obj) \
+    _Generic(*(obj), unsigned char: __atomic_ ## op ## _1, unsigned short: __atomic_ ## op ## _2, \
+             unsigned int: __atomic_ ## op ## _4, unsigned long: __atomic_ ## op ## _8)
+#define atomic_fetch_add(obj, arg) QJS_ATOMIC_FN(fetch_add, obj)((obj), (arg), 5)
+#define atomic_fetch_sub(obj, arg) QJS_ATOMIC_FN(fetch_sub, obj)((obj), (arg), 5)
+#define atomic_fetch_and(obj, arg) QJS_ATOMIC_FN(fetch_and, obj)((obj), (arg), 5)
+#define atomic_fetch_or(obj, arg) QJS_ATOMIC_FN(fetch_or, obj)((obj), (arg), 5)
+#define atomic_fetch_xor(obj, arg) QJS_ATOMIC_FN(fetch_xor, obj)((obj), (arg), 5)
+#define atomic_exchange(obj, desired) QJS_ATOMIC_FN(exchange, obj)((obj), (desired), 5)
+#define atomic_load(obj) QJS_ATOMIC_FN(load, obj)((obj), 5)
+#define atomic_store(obj, desired) QJS_ATOMIC_FN(store, obj)((obj), (desired), 5)
+#define atomic_compare_exchange_strong(obj, expected, desired) \
+    QJS_ATOMIC_FN(compare_exchange, obj)((obj), (expected), (desired), 0, 5, 5)
 #else
 #include <stdatomic.h>
 #endif
