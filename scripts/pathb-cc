#!/usr/bin/env bash
# Path B compiler: one C++ file to an object file.
#   EDG front end (lowered IL) -> typed IR (be/nfcxx_ir.c) -> QBE IL -> QBE -> assembler
#   the QBE IL is the SSA route (scripts/pathb-ssa-build) by default; --emitter=mruby selects scripts/pathb-qbe-emit.rb
#   (run by scripts/mrb), and a unit the SSA route does not fully emit falls back to it with a message on stderr.
#   The mruby pipeline is what tests/pathb-qbe/run.sh validates. Hosted by default (the host g++'s C++ library headers, see scripts/host-sys.sh).
# Usage: scripts/pathb-cc [options] [-std=c++NN] [-I dir | -Idir] [-Dmacro] [-Umacro] [--freestanding] file.cpp -o out.o
# The options below are what the nfcxx driver passes; each has an environment variable as a fallback (for scripts and tests that
# predate the flag), and the flag wins when both are given.
#   --keep=DIR       (PATHB_KEEP)  keep file.ir, file.ssa and file.s there
#   --timeout=SEC    (NFCXX_PATHB_TIMEOUT)  a stage (the front end, the SSA route) that runs over SEC seconds (default 300; 0: no limit)
#                    is stopped with status 124: the driver builds the program with gcc after any status but 0, so a stuck stage must end
#                    (the front end once looped on a type name over 300 bytes; the largest STL test takes 50 s). Needs timeout(1).
#   --safe-pointers  (NFCXX_SAFE_POINTERS=1)  -fsafe-pointers: the emitter checks pointer arithmetic and accesses (docs/notes/safe-pointers.md);
#                    the IR carries (loc ...) lines for the reports. Link with $(scripts/safeptr-rt) first.
#   --asan           (NFCXX_PATHB_ASAN=1)  -fsanitize=address (docs/notes/asan-plan.md): the SSA emitter calls libasan's __asan_load/store checks before
#                    each access through a computed address. Link the program with -fsanitize=address. Not with the mruby emitter or -fsafe-pointers.
#   --sanitize=LIST  (NFCXX_IR_SANITIZE)  the checks of -fsanitize=undefined (docs/notes/ubsan.md), made by the front end (pathb-dump)
#   --ir-opt=LIST    (NFCXX_IR_OPT)  the IR passes (scripts/pathb-ir-opt.rb), below; default inline; --ir-opt=none turns them off;
#                    --ir-opt-max=BYTES (NFCXX_IR_OPT_MAX)
#   --emitter=ssa|mruby  (NFCXX_PATHB_EMITTER)  the QBE IL emitter
#   --long-double=trap  (PATHB_LONG_DOUBLE=trap, or NFCXX_LONG_DOUBLE=trap)  a function of a hand-written IR that mentions the scalar type long_double
#                    becomes a stub that aborts when run. long double itself is supported (docs/notes/pathb-longdouble.md): link the
#                    object with $(scripts/pathb-ldrt) (the helpers in be/nfcxx_ldrt.c; the driver and the test scripts do)
# Exit status: 0 done; 3 the IR has a node, type or marker the emitter refuses (reason on stderr); anything else failed.
# Needs the Path B harness (scripts/setup-pathb.sh; PATHB_CPFE, PATHB_BASE) and build/qbe/qbe (QBE).
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
qbe=${QBE:-$root/build/qbe/qbe}
[ -x "$qbe" ] || { echo "pathb-cc: no QBE at $qbe; run scripts/setup-qbe.sh" >&2; exit 2; }
# The QBE target (PATHB_QBE_TARGET, else the host's): the append step takes the helpers of that target (scripts/host-sys.sh).
. "$root/scripts/host-sys.sh"
qbe_t=(); [ -n "${PATHB_QBE_TARGET:-}" ] && qbe_t=(-t "$PATHB_QBE_TARGET")
qbe_target=${PATHB_QBE_TARGET:-$(host_qbe_target)}

# The settings (variables are the defaults, flags override)
opts=(); src=""; out=""
safe_on=0; [ "${NFCXX_SAFE_POINTERS:-0}" != 1 ] || safe_on=1
asan_on=0; [ "${NFCXX_PATHB_ASAN:-0}" != 1 ] || asan_on=1
passes=${NFCXX_IR_OPT-inline}; ir_opt_max=${NFCXX_IR_OPT_MAX:-268435456}   # the inliner by default; none or off turns the passes off
passes_given=0; [ -z "${NFCXX_IR_OPT+x}" ] || passes_given=1
pic=()
emitter=${NFCXX_PATHB_EMITTER:-ssa}
ld_trap=0; [ "${PATHB_LONG_DOUBLE:-${NFCXX_LONG_DOUBLE:-}}" != trap ] || ld_trap=1
keep=${PATHB_KEEP:-}
timeout_s=${NFCXX_PATHB_TIMEOUT:-300}
dump_opts=()
while [ $# -gt 0 ]; do
  case $1 in
    -o) out=$2; shift ;;
    --safe-pointers) safe_on=1 ;;
    --asan) asan_on=1 ;;
    --pic) pic=(--pic) ;;   # -fPIC: the objects go into a shared object (scripts/pathb-ssa-qbe.rb, Qbe.pic)
    --sanitize=*) dump_opts+=("$1") ;;
    --gnu-version=*|--gnu_version=*) opts+=("$1") ;;   # the GNU version EDG emulates (nfcxx --freestanding passes 130000)
    --ir-opt=*) passes=${1#--ir-opt=}; passes_given=1 ;;
    --ir-opt-max=*) ir_opt_max=${1#--ir-opt-max=} ;;
    --emitter=*) emitter=${1#--emitter=} ;;
    --long-double=trap) ld_trap=1 ;;
    --keep=*) keep=${1#--keep=} ;;
    --timeout=*) timeout_s=${1#--timeout=} ;;
    -I|-D|-U) opts+=("$1$2"); shift ;;
    --modules) opts+=(--modules) ;;
    --modules_directory|--create_module_interface) opts+=("$1" "$2"); shift ;;   # C++ modules (docs/notes/modules.md)
    -include) opts+=(-include "$2"); shift ;;   # a forced include (cosmo's normalize.inc, docs/notes/cosmo.md)
    -I?*|-D?*|-U?*|-std=c++*|-std=c89|-std=c99|-std=c11|-std=c17|-std=c18|-std=c23|--freestanding|--eh-runtime|--cuda) opts+=("$1") ;;
    -*) ;;   # other compiler flags (-O2, -Wall, ...) do not apply
    *) src=$1 ;;
  esac
  shift
done
[ -n "$src" ] || { echo "pathb-cc: no input file" >&2; exit 2; }
[ -n "$out" ] || out=$(basename "${src%.*}").o

tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
n=$(basename "${src%.*}")
# The checks of --asan and --safe-pointers are made on the IR as the program wrote it (stack and heap objects keep their
# scopes): the inliner is off with them unless --ir-opt asks for it.
[ $passes_given = 1 ] || { [ $safe_on = 0 ] && [ $asan_on = 0 ]; } || passes=none
safe=(); [ $safe_on = 0 ] || { safe=(--safe); dump_opts+=(--ir-loc); }
# The IR's (loc ...) lines give the report its source lines, and its (decl)/(scope-end) facts the use after scope (--ir-scopes).
asan=(); [ $asan_on = 0 ] || { asan=(--asan); dump_opts+=(--ir-loc --ir-scopes); }
[ ${#asan[@]} = 0 ] || [ ${#safe[@]} = 0 ] || { echo "pathb-cc: --asan and --safe-pointers both replace malloc; use one" >&2; exit 2; }
tmo() { if [ "$timeout_s" != 0 ] && command -v timeout >/dev/null 2>&1; then timeout -k 5 "$timeout_s" "$@"; else "$@"; fi; }
if [ -n "${PATHB_IR:-}" ]; then cp "$PATHB_IR" "$tmp/$n.ir"   # a given IR file (tests run the emitters without the harness)
else
  [ "$emitter" != ssa ] || dump_opts+=(--ir-noinline)   # the SSA route's inliner honours noinline
  frc=0; tmo "$root/scripts/pathb-dump" --ir ${dump_opts[@]+"${dump_opts[@]}"} ${opts[@]+"${opts[@]}"} "$src" > "$tmp/$n.ir" || frc=$?
  [ $frc != 124 ] || echo "pathb-cc: $src: the front end ran over $timeout_s s (--timeout) and was stopped" >&2
  [ $frc = 0 ] || exit $frc
fi
# The IR-to-IR passes (scripts/pathb-ir-opt.rb, docs/notes/pathb-ir-passes.md): inline by default; --ir-opt names others (a
# comma-separated list), and none or off turns them off. IR over --ir-opt-max bytes (default 256 MiB) is not optimized. The inliner runs on what an external definition reaches (--prune-unused: a
# host TU of libstdc++ and vulkan.hpp is mostly unused template instances, 129 MB of IR for ggml-vulkan.cpp, 48 MB pruned). A given IR file (PATHB_IR, the
# tests' input) is emitted as it is.
raw=0
if [ -n "$passes" ] && [ "$passes" != none ] && [ "$passes" != off ] && [ -z "${PATHB_IR:-}" ]; then
  size=$(wc -c < "$tmp/$n.ir" | tr -d " ")   # wc, not stat: BSD stat has no -c
  if [ "$size" -gt "$ir_opt_max" ]; then
    echo "pathb-cc: $src: IR is $size bytes, over --ir-opt-max: not optimized" >&2
  else
    irpasses=(); IFS=, read -ra _p <<< "$passes"; for x in "${_p[@]}"; do irpasses+=("--$x"); [ "$x" != inline ] || irpasses=(--prune-unused --strip-leaf-eh "${irpasses[@]}"); done
    cp "$tmp/$n.ir" "$tmp/$n.raw.ir"; raw=1
    if ${RUBY:-ruby} "$root/scripts/pathb-ir-opt.rb" "${irpasses[@]}" "$tmp/$n.ir" > "$tmp/$n.opt.ir" 2> "$tmp/$n.opt.err"; then
      mv "$tmp/$n.opt.ir" "$tmp/$n.ir"
    else
      cp "$tmp/$n.raw.ir" "$tmp/$n.ir"; echo "pathb-cc: $src: the IR passes refused the unit, not optimized" >&2
    fi
  fi
fi
ldopt=(); [ $ld_trap = 0 ] || ldopt=(--long-double=trap)
# The mruby emitter only: on Darwin an extern data object is read through the GOT (see pathb-qbe-emit.rb, --extern-data-got).
emitopt=(); { [ "$(uname -s)" = Darwin ] || [ "$(uname -m)" = aarch64 ] || [ "$(uname -m)" = arm64 ]; } && emitopt=(--extern-data-got)
# And the target of the x87 thunks (x86-64 assembly; an arm64 module that needs one is refused): PATHB_X87_TARGET, else the host's.
# pathb-qbe-emit.rb reads its options in a fixed order (--long-double=trap, --extern-data-got, --x87-target=, --safe): see the call below.
emitopt+=(--x87-target="${PATHB_X87_TARGET:-$(uname -m)}")
# The emitter. The SSA route (scripts/pathb-ssa-build) is the default, --safe included (its checks carry the (loc ...)
# locations the reports print); --emitter=mruby selects the mruby pathb-qbe-emit.rb.
case $emitter in ssa|mruby) ;; *) echo "pathb-cc: --emitter (NFCXX_PATHB_EMITTER) must be ssa or mruby, not '$emitter'" >&2; exit 2 ;; esac
rc=0
[ ${#asan[@]} = 0 ] || [ "$emitter" = ssa ] || { echo "pathb-cc: --asan needs the SSA emitter (--emitter=ssa)" >&2; exit 2; }
if [ "$emitter" = ssa ]; then
  tmo "$root/scripts/pathb-ssa-build" --qbe="$qbe" -o "$tmp/$n.s" ${pic[@]+"${pic[@]}"} ${ldopt[@]+"${ldopt[@]}"} ${safe[@]+"${safe[@]}"} ${asan[@]+"${asan[@]}"} "$tmp/$n.ir" 2> "$tmp/$n.emit" || rc=$?
  if [ $rc != 0 ] && [ $rc != 124 ] && [ $raw = 1 ]; then   # the optimized IR is refused: emit the unoptimized one
    echo "pathb-cc: $src: the optimized IR is refused, using the unoptimized IR" >&2
    cp "$tmp/$n.raw.ir" "$tmp/$n.ir"; rc=0
    tmo "$root/scripts/pathb-ssa-build" --qbe="$qbe" -o "$tmp/$n.s" ${pic[@]+"${pic[@]}"} ${ldopt[@]+"${ldopt[@]}"} ${safe[@]+"${safe[@]}"} ${asan[@]+"${asan[@]}"} "$tmp/$n.ir" 2> "$tmp/$n.emit" || rc=$?
  fi
  if [ $rc != 0 ]; then
    # A function outside the SSA route's subset refuses the unit (no fallback to the mruby emitter; --emitter=mruby
    # selects that emitter explicitly).
    if [ $rc = 124 ]; then echo "pathb-cc: $src: SSA route: ran over $timeout_s s (--timeout) and was stopped" >&2
    else echo "pathb-cc: $src: SSA route: $(head -1 "$tmp/$n.emit")" >&2; fi
    [ -z "$keep" ] || { mkdir -p "$keep"; cp "$tmp/$n.ir" "$keep/"; }
    exit $rc
  fi
fi
if [ "$emitter" = mruby ]; then
  "$root/scripts/mrb" "$root/scripts/pathb-qbe-emit.rb" ${ldopt[@]+"${ldopt[@]}"} ${emitopt[@]+"${emitopt[@]}"} ${safe[@]+"${safe[@]}"} "$tmp/$n.ir" > "$tmp/$n.ssa" 2> "$tmp/$n.emit" || rc=$?
  if [ $rc != 0 ]; then
    echo "pathb-cc: $src: $(head -1 "$tmp/$n.emit")" >&2
    [ -z "$keep" ] || { mkdir -p "$keep"; cp "$tmp/$n.ir" "$keep/"; }
    exit $rc
  fi
  "$qbe" ${qbe_t[@]+"${qbe_t[@]}"} "$tmp/$n.ssa" > "$tmp/$n.s"
  # QBE has no weak linkage: .weak for the IR's (weak) definitions (COMDAT inline and template code)
  # Status 3: the target's assembler has no form for something in the unit (an ifunc or file-scope asm on Apple): refused.
  "$root/scripts/mrb" "$root/scripts/pathb-qbe-emit.rb" --append-weak "$tmp/$n.ssa" "$tmp/$n.s" "$qbe_target" 2> "$tmp/$n.aw" || rc=$?
  if [ $rc != 0 ]; then
    echo "pathb-cc: $src: $(head -1 "$tmp/$n.aw")" >&2
    [ -z "$keep" ] || { mkdir -p "$keep"; cp "$tmp/$n.ir" "$keep/"; }
    exit $rc
  fi
fi
if [ -n "$keep" ]; then mkdir -p "$keep"; cp "$tmp/$n.ir" "$tmp/$n.s" "$keep/"; [ ! -f "$tmp/$n.ssa" ] || cp "$tmp/$n.ssa" "$keep/"; fi
if [ -n "${NFCXX_GCC:-}" ]; then
  as -o "$out" "$tmp/$n.s"   # cosmocc does not take assembly input; the QBE output is x86_64 ELF, as gcc-cc does (--cosmo)
else
  cc -c -o "$out" "$tmp/$n.s"
fi
