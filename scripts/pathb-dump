#!/usr/bin/env bash
# Path B stage 1: print the lowered IL of a C++ file as s-expressions (see be/nfcxx_be.h for the format).
# Runs the harness front end (build/pathb, from scripts/setup-pathb.sh) from the EDG base dir, with the same
# flags as the nfcxx --emit-c branch. Front-end errors go to stderr and give a non-zero exit status.
# Usage: scripts/pathb-dump [-std=c++NN] file.cpp...
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
cpfe=${PATHB_CPFE:-$root/build/pathb/cmake/bin/cpfe}
base=${PATHB_BASE:-$root/build/pathb/edg-base}
[ -x "$cpfe" ] || { echo "pathb-dump: harness not built; run scripts/setup-pathb.sh" >&2; exit 2; }

std=--c++23; files=()
for arg in "$@"; do
  case $arg in
    -std=c++*) std=--c++${arg#-std=c++} ;;
    *) files+=("$arg") ;;
  esac
done
[ ${#files[@]} -gt 0 ] || { echo "pathb-dump: no input files" >&2; exit 2; }

status=0
for file in "${files[@]}"; do
  f=$(realpath "$file")
  stem=$(basename "$f" .cpp)
  # cpfe writes <stem>.ti (template instantiation requests) into its working directory. Remove it afterwards
  # unless it existed before, so the base dir stays as it was.
  ti=$base/$stem.ti; had_ti=0; [ -e "$ti" ] && had_ti=1
  (cd "$base" && "$cpfe" -D_POSIX_SOURCE -D__CHAR_BIT__=8 "$std" --g++ --sys_include="$base/include" "$f") || status=$?
  [ $had_ti = 1 ] || rm -f "$ti"
done
exit $status
