#!/usr/bin/env bash
# Path B: print the lowered IL of a C++ file as s-expressions (stage 1, see be/nfcxx_be.h for the format), or
# with --ir the mid-level IR (stage 2, see docs/notes/pathb-stage2.md). Runs the harness front end
# (build/pathb, from scripts/setup-pathb.sh) from the EDG base dir, with the same flags as the nfcxx --emit-c
# branch. Front-end errors go to stderr and give a non-zero exit status.
# Usage: scripts/pathb-dump [--ir] [-std=c++NN | -std=cNN] [-Idir] [-Dmacro] [-Umacro] [--freestanding] file.cpp...
# -std=c89, c99, c11, c17 (c18) or c23 reads the files as C (cpfe --cNN --gcc), and so does a file ending in .c when
# no -std is given (C17 then). Hosted C takes the host C compiler's include directories (gcc -x c, NFCXX_CC).
# Hosted by default, like the driver: the host g++'s C++ library include directories and GNU version
# (scripts/host-sys.sh; NFCXX_CXX, NFCXX_SYS_INCLUDES). --freestanding or PATHB_HOSTED=0 gives the old harness
# (only EDG's include_c++, no C library headers).
# --gnu-version=N (or --gnu_version=N) sets the GNU version of the front end, as nfcxx does; it overrides the host's.
# --stats (NFCXX_PATHB_STATS=1) prints per-node-kind lowered/unsupported counts to stderr (--ir only).
# The IR back end (be/nfcxx_ir.c, in the front end's process) reads its settings from the environment; these options set
# them, and take precedence over a variable already in the environment (--ir only):
#   --ir-loc          (NFCXX_IR_LOC=1)       (loc "FILE" LINE) lines: the source place of the statements after them
#   --ir-scopes       (NFCXX_IR_SCOPES=1)    (decl ...) and (scope-end ...) facts for locals
#   --ir-noinline     (NFCXX_IR_NOINLINE=1)  a (noinline) head on a function with __attribute__((noinline)), which scripts/pathb-ir-opt.rb's
#                                            inliner respects (only the SSA route reads it; the other emitters refuse an unknown head)
#   --borrow          (NFCXX_PATHB_BORROW=1) the facts the borrow checker reads (docs/notes/pathb-borrowck.md)
#   --sanitize=LIST   (NFCXX_IR_SANITIZE)    the checks of -fsanitize=undefined or CHECK[,CHECK...] (docs/notes/ubsan.md)
#   --overflow=trap   (NFCXX_IR_OVERFLOW=trap) signed overflow is a trap
#   --eh-runtime      with --freestanding: the program links EDG's runtime (libC.a), so the exception handling state is declared as
#                     that runtime has it (thread-local when scripts/setup-edg.sh built it that way); hosted mode always does
#   --cuda-device     (NFCXX_PATHB_CUDA=1)   a .cu file's device unit: the front end reads it as CUDA, without exceptions
#   --modules, --modules_directory DIR, --create_module_interface FILE   C++ modules: EDG's options, as nfcxx gives eccp
# gcc's own options, as nfcc's Path B route passes them (docs/notes/nfcc-pathb.md):
#   -funsigned-char / -fno-signed-char, -fsigned-char / -fno-unsigned-char   the signedness of plain char (EDG's --unsigned_chars,
#                     --signed_chars; -funsigned-char also defines __CHAR_UNSIGNED__ as gcc does)
#   -nostdinc         no host system include directories (hosted mode); only the -isystem and -idirafter ones, and EDG's own
#   -isystem DIR      a system include directory, searched before the host's; -idirafter DIR after them
#   -fshort-wchar     wchar_t of the headers (__WCHAR_TYPE__, __WCHAR_MAX__, __SIZEOF_WCHAR_T__ ...) is unsigned short, as gcc's. EDG has no such
#                     option: the type of a wide literal L"x" stays the target's int, so nfcc sends a unit with one to gcc
#   -ffreestanding    __STDC_HOSTED__ is 0 (the host headers are still read: give -nostdinc and -isystem to choose them)
# --target=linux_riscv32 (or --target NAME): the sizes and predefined macros of an EDG target (EDG's own tables; the
# IR's (layout ...) header carries them), with plain char signed. linux_riscv32 is ILP32, the data model of Emscripten's
# wasm32 (its plain char is unsigned in EDG's table, so --signed_chars is passed). It needs --freestanding: the host's C
# and C++ library headers are the host target's. Without it the IR is as before.
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
cpfe=${PATHB_CPFE:-$root/build/pathb/cmake/bin/cpfe}
base=${PATHB_BASE:-$root/build/pathb/edg-base}
[ -x "$cpfe" ] || { echo "pathb-dump: harness not built; run scripts/setup-pathb.sh" >&2; exit 2; }

source "$root/scripts/host-sys.sh"
std=""; files=(); user_opts=(); mode=il; hosted=${PATHB_HOSTED:-1}; target=""; eh_runtime=0
cuda_device=0; [ -z "${NFCXX_PATHB_CUDA:-}" ] || cuda_device=1
nostdinc=0; isys=(); idafter=()
args=("$@"); i=0
while [ $i -lt ${#args[@]} ]; do
  arg=${args[$i]}
  case $arg in
    --ir) mode=ir ;;
    --stats) export NFCXX_PATHB_STATS=1 ;;
    --ir-loc) export NFCXX_IR_LOC=1 ;;
    --ir-scopes) export NFCXX_IR_SCOPES=1 ;;
    --ir-noinline) export NFCXX_IR_NOINLINE=1 ;;
    --borrow) export NFCXX_PATHB_BORROW=1 ;;
    --sanitize=*) export NFCXX_IR_SANITIZE=${arg#--sanitize=} ;;
    --overflow=*) export NFCXX_IR_OVERFLOW=${arg#--overflow=} ;;
    --cuda-device) cuda_device=1 ;;
    --freestanding) hosted=0 ;;
    --eh-runtime) eh_runtime=1 ;;
    --cuda) user_opts+=(--cuda) ;;   # a .cu host copy: the <<<...>>> launches are read (nfcxx's cuda_opts, as the EDG path)
    --target=*) target=${arg#--target=} ;;
    --target) i=$((i + 1)); [ $i -lt ${#args[@]} ] || { echo "pathb-dump: --target needs a name" >&2; exit 2; }; target=${args[$i]} ;;
    -std=c++*) std=--c++${arg#-std=c++} ;;
    -std=c89|-std=c99|-std=c11|-std=c17|-std=c18|-std=c23) std=--${arg#-std=} ;;
    -std=*) echo "pathb-dump: unknown standard ${arg#-std=}" >&2; exit 2 ;;
    -I?*) user_opts+=("-I$(abs_path "${arg#-I}")") ;;   # the front end runs in another directory
    -D?*|-U?*) user_opts+=("$arg") ;;                        # preprocessor options reach the front end
    --modules) user_opts+=(--modules) ;;                     # C++ modules (docs/notes/modules.md): the options nfcxx gives eccp
    --modules_directory|--create_module_interface)
      i=$((i + 1)); [ $i -lt ${#args[@]} ] || { echo "pathb-dump: $arg needs a path" >&2; exit 2; }
      user_opts+=("$arg" "$(abs_path "${args[$i]}")") ;;     # the front end runs in another directory
    -funsigned-char|-fno-signed-char) user_opts+=(--unsigned_chars -U__CHAR_UNSIGNED__ -D__CHAR_UNSIGNED__=1) ;;
    -fsigned-char|-fno-unsigned-char) user_opts+=(--signed_chars -U__CHAR_UNSIGNED__) ;;
    -nostdinc) nostdinc=1 ;;
    -isystem|-idirafter)
      i=$((i + 1)); [ $i -lt ${#args[@]} ] || { echo "pathb-dump: $arg needs a directory" >&2; exit 2; }
      if [ "$arg" = -isystem ]; then isys+=("--sys_include=$(abs_path "${args[$i]}")"); else idafter+=("--sys_include=$(abs_path "${args[$i]}")"); fi ;;
    -isystem?*) isys+=("--sys_include=$(abs_path "${arg#-isystem}")") ;;
    -idirafter?*) idafter+=("--sys_include=$(abs_path "${arg#-idirafter}")") ;;
    -fshort-wchar) user_opts+=(--diag_suppress=predef_macro_redefined "-D__WCHAR_TYPE__=short unsigned int" -D__WCHAR_MAX__=0xffff
                               -D__WCHAR_MIN__=0 -D__WCHAR_WIDTH__=16 -D__SIZEOF_WCHAR_T__=2) ;;   # the macros gcc's <stddef.h> reads
    -ffreestanding) user_opts+=(--diag_suppress=predef_macro_redefined -D__STDC_HOSTED__=0) ;;
    --diag_*) user_opts+=("$arg") ;;                         # EDG front-end diagnostic options reach cpfe
    -include) i=$((i + 1)); [ $i -lt ${#args[@]} ] || { echo "pathb-dump: -include needs a file" >&2; exit 2; }
              user_opts+=(--preinclude "$(abs_path "${args[$i]}")") ;;   # as nfcxx: EDG's --preinclude (cosmo's c.inc)
    --gnu-version=*|--gnu_version=*) user_opts+=("--gnu_version=${arg#*=}") ;;   # as nfcxx: after the host's GNU version
    -Wno-narrowing) user_opts+=(--diag_warning=narrowing_conversion) ;;   # as nfcxx: a narrowing is a warning
    --dialect=*) ;;                                          # clang's dialect is not modelled: the harness is EDG's g++ mode
    -W*) ;;                                                  # other warnings do not change the object code
    *) files+=("$arg") ;;
  esac
  i=$((i + 1))
done
[ ${#files[@]} -gt 0 ] || { echo "pathb-dump: no input files" >&2; exit 2; }
# The language: C for a C standard, or for .c files without -std; else C++ (C++23 by default).
if [ -z "$std" ]; then
  case ${files[0]} in *.c) std=--c17 ;; *) std=--c++23 ;; esac
fi
case $std in --c++*) lang=c++; dialect=--g++ ;; *) lang=c; dialect=--gcc ;; esac
target_opts=()
if [ -n "$target" ]; then
  [ "$hosted" = 0 ] || { echo "pathb-dump: --target needs --freestanding (the host's library headers are the host target's)" >&2; exit 2; }
  [ -d "$base/lib_$target" ] || { echo "pathb-dump: no predefined macros for target '$target' in $base" >&2; exit 2; }
  # plain char is signed, as on the x86-64 host and in wasm32: EDG's linux_riscv32 table has it unsigned
  target_opts=(--target "$target" --signed_chars)
fi

sys_inc=(${isys[@]+"${isys[@]}"}); gnu_opts=()
cuda_device_opts=(); [ $cuda_device = 0 ] || cuda_device_opts=(--cuda --no_exceptions)
# Hosted, or --eh-runtime: the program links EDG's runtime; when its exception handling state is per thread (RUNTIME_EH_TLS, the eh-tls
# marker of scripts/setup-edg.sh), the EH variables of the IR are thread-local too, as the nfcxx driver has them.
eh_tls=()
if { [ "$hosted" != 0 ] || [ "$eh_runtime" = 1 ]; } && [ -f "${EDG_BUILD:-$root/build/edg}/eh-tls" ]; then eh_tls=(--nfcxx_eh_thread_local); fi
if [ "$hosted" != 0 ]; then
  if [ $nostdinc = 0 ]; then
    while IFS= read -r d; do [ -n "$d" ] && sys_inc+=("--sys_include=$d"); done < <(host_sys_includes "$lang")
  fi
  gnu=$(host_gnu_version); [ -z "$gnu" ] || gnu_opts=(--gnu_version="$gnu")
fi
sys_inc+=(${idafter[@]+"${idafter[@]}"})

# The feature-test macros of the host's C library, as the driver's --emit-c branch and the macOS EDG base set them: on
# Darwin _DARWIN_C_SOURCE (the SDK's stdlib.h declares at_quick_exit and quick_exit only then, and libc++'s <cstdlib>
# names them), elsewhere _POSIX_SOURCE.
posix_def=(-D_POSIX_SOURCE); [ "$(uname -s)" = Darwin ] && posix_def=(-D_DARWIN_C_SOURCE -U__BLOCKS__)
# Hosted on macOS: the SDK's libc++ and <cstdlib> need the Darwin feature-test macros (_DARWIN_C_SOURCE; at_quick_exit),
# clang's feature macros (lib/pathb/clang_macros.h), and an empty features.h first on the include path so that libc++
# does not take glibc's (lib/pathb/darwin-include). The driver passes the same options (nfcxx, hosted Path B on Darwin).
darwin_opts=()
if [ "$hosted" != 0 ] && [ "$(uname -s)" = Darwin ]; then
  posix_def=(-D_DARWIN_C_SOURCE -U__BLOCKS__)
  darwin_opts=(--preinclude "$root/lib/pathb/clang_macros.h" -I "$root/lib/pathb/darwin-include")
fi
# Hosted on Linux aarch64: the host's <bits/math-vector.h> uses GCC's AdvSIMD/SVE vector types, which EDG (x86-64 target)
# does not have. lib/pathb/linux-aarch64-include/bits/math-vector.h replaces it with an empty one (no vector declarations, as
# the x86-64 header has without -ffast-math).
if [ "$hosted" != 0 ] && [ "$(uname -s)" = Linux ] && { [ "$(uname -m)" = aarch64 ] || [ "$(uname -m)" = arm64 ]; }; then
  darwin_opts+=(-I "$root/lib/pathb/linux-aarch64-include")
fi
export NFCXX_PATHB_MODE=$mode   # read by back_end() in be/nfcxx_be.c: "ir" selects be/nfcxx_ir.c
# The IR back end keeps the module's functions in a file in TMPDIR; the front end runs in the base dir, so make it absolute.
[ -z "${TMPDIR:-}" ] || export TMPDIR="$(abs_path "$TMPDIR")"
status=0
for file in "${files[@]}"; do
  f=$(realpath "$file")
  stem=$(basename "$f"); stem=${stem%.*}
  # cpfe writes <stem>.ti (template instantiation requests) into its working directory. Remove it afterwards
  # unless it existed before, so the base dir stays as it was.
  ti=$base/$stem.ti; had_ti=0; [ -e "$ti" ] && had_ti=1
  # -tused: instantiate the templates this file uses, as eccp does for a single file that is compiled and linked
  # (eccp.sh, "instantiate used"). Without it a call to a template has no definition in the IR. C has no templates.
  tused=(); [ $lang = c ] || tused=(-tused)
  # --cuda-device (the driver's device pass): the front end reads the unit as CUDA (cpfe --cuda)
  (cd "$base" && "$cpfe" ${posix_def[@]} ${darwin_opts[@]+"${darwin_opts[@]}"} -D__CHAR_BIT__=8 "$std" $dialect --wdir / ${gnu_opts[@]+"${gnu_opts[@]}"} ${tused[@]+"${tused[@]}"} ${user_opts[@]+"${user_opts[@]}"} ${sys_inc[@]+"${sys_inc[@]}"} ${target_opts[@]+"${target_opts[@]}"} ${cuda_device_opts[@]+"${cuda_device_opts[@]}"} ${eh_tls[@]+"${eh_tls[@]}"} --sys_include="$base/include" "$f") || status=$?
  [ $had_ti = 1 ] || rm -f "$ti"
done
exit $status
