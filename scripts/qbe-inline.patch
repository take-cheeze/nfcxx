diff -ruN -x '*.o' -x qbe -x '*.s' -x '*.ssa' -x config.h qbe-orig/inline.c qbe-work/inline.c
--- qbe-orig/inline.c	1970-01-01 00:00:00.000000000 +0000
+++ qbe-work/inline.c	2026-10-14 01:43:11.298292437 +0000
@@ -0,0 +1,480 @@
+#include "all.h"
+#include <stdlib.h>
+#include <string.h>
+
+/*
+ * Intra-translation-unit inliner.
+ *
+ * It runs on the IL as parse() built it, before T.abi0 lowers calls and
+ * parameters to the target ABI, so the calls (Oarg... Ocall) and parameters
+ * (Opar) are still target-independent. A call is inlined when its callee is
+ * defined in the same input file, is small (QBE_INLINE instructions, default
+ * 24, 0 disables), is not vararg or self-recursive, and matches the call's
+ * arity and argument classes. The callee body is copied with fresh temps,
+ * blocks and constants. Its entry-block allocs are hoisted into the caller's
+ * entry block so they stay static stack slots. Each caller is visited once,
+ * and copied bodies are not visited again, so inlining does not cascade.
+ */
+
+static uint inlmax = 24;
+static uint inlid; /* counter for block names */
+static Fn **fntab; /* open-addressing table of the file's functions */
+static uint fntabn;
+
+static int retjmp[] = { Jretw, Jretl, Jrets, Jretd };
+
+typedef struct Inl Inl;
+struct Inl {
+	Fn *f, *g;      /* caller and callee */
+	Ref *tmap;      /* callee temp -> caller ref */
+	char *known;    /* tmap entry is set */
+};
+
+static uint
+strhash(char *s)
+{
+	uint h;
+
+	h = 2166136261u;
+	for (; *s; s++)
+		h = (h ^ (unsigned char)*s) * 16777619u;
+	return h;
+}
+
+static Fn *
+lookup(char *name)
+{
+	uint h, m;
+	Fn *g;
+
+	if (!fntabn)
+		return 0;
+	m = fntabn - 1;
+	for (h = strhash(name) & m;; h = (h + 1) & m) {
+		g = fntab[h];
+		if (!g)
+			return 0;
+		if (strcmp(g->name, name) == 0)
+			return g;
+	}
+}
+
+/* name of the function that r refers to, or 0 if r is not a direct symbol */
+static char *
+calleename(Fn *f, Ref r)
+{
+	Con *c;
+
+	if (r.type != RCon || r.val < 2)
+		return 0;
+	c = &f->con[r.val];
+	if (c->type != CAddr || c->sym.type != SGlo)
+		return 0;
+	return str(c->sym.id);
+}
+
+/* refs the copy cannot rename: registers, stack slots, memory operands */
+static int
+badref(Ref r)
+{
+	if (req(r, R))
+		return 0;
+	if (r.type == RSlot || r.type == RMem)
+		return 1;
+	return r.type == RTmp && r.val < Tmp0;
+}
+
+/* g's body fits the rules, for a call with nargs arguments and result class cls (-1: none) */
+static int
+calleeok(Fn *f, Fn *g, uint nargs, int cls)
+{
+	Blk *x;
+	Ins *i;
+	uint n, np, nret;
+
+	if (g == f || g->vararg || !g->start)
+		return 0;
+	n = np = nret = 0;
+	for (x=g->start; x; x=x->link) {
+		n += x->nins;
+		if (n > inlmax)
+			return 0;
+		for (i=x->ins; i<x->ins+x->nins; i++) {
+			if (ispar(i->op)) {
+				if (i->op != Opar || x != g->start)
+					return 0;
+				np++;
+			}
+			if (isalloc(i->op) && x != g->start)
+				return 0;
+			if (i->op == Ovastart || i->op == Ovaarg)
+				return 0;
+			if (i->op == Ocall) {
+				char *name = calleename(g, i->arg[0]);
+				if (name && strcmp(name, g->name) == 0)
+					return 0;
+			}
+			if (badref(i->to) || badref(i->arg[0]) || badref(i->arg[1]))
+				return 0;
+		}
+		if (badref(x->jmp.arg))
+			return 0;
+		switch (x->jmp.type) {
+		case Jjmp:
+			break;
+		case Jjnz:
+			break;
+		case Jret0:
+			if (cls >= 0)
+				return 0;
+			break;
+		case Jretw:
+		case Jretl:
+		case Jrets:
+		case Jretd:
+			if (cls >= 0) {
+				if (x->jmp.type != retjmp[cls])
+					return 0;
+				nret++;
+			}
+			break;
+		default:
+			return 0;
+		}
+	}
+	for (x=g->start; x; x=x->link)
+		if (x->s1 == g->start || x->s2 == g->start)
+			return 0;
+	if (np != nargs)
+		return 0;
+	if (cls >= 0 && nret == 0)
+		return 0;
+	return 1;
+}
+
+/* the callee of the call at b->ins[c] if it can be inlined; *i0 gets the first of its Oarg */
+static Fn *
+callsite(Fn *f, Blk *b, uint c, uint *i0)
+{
+	Ins *i;
+	Fn *g;
+	Ins *p;
+	char *name;
+	uint j, k, n;
+	int cls;
+
+	i = &b->ins[c];
+	if (rtype(i->arg[1]) == RType)
+		return 0; /* aggregate result */
+	name = calleename(f, i->arg[0]);
+	if (!name || !(g = lookup(name)))
+		return 0;
+	for (j=c; j>0 && isarg(b->ins[j-1].op); j--)
+		;
+	for (k=j; k<c; k++)
+		if (b->ins[k].op != Oarg)
+			return 0;
+	n = c - j;
+	cls = req(i->to, R) ? -1 : i->cls;
+	if (!calleeok(f, g, n, cls))
+		return 0;
+	k = 0;
+	for (p=g->start->ins; p<g->start->ins+g->start->nins; p++)
+		if (ispar(p->op)) {
+			if (p->cls != b->ins[j+k].cls)
+				return 0;
+			k++;
+		}
+	*i0 = j;
+	return g;
+}
+
+static Ref
+mapref(Inl *s, Ref r)
+{
+	if (req(r, R))
+		return r;
+	switch (r.type) {
+	case RTmp:
+		if (!s->known[r.val]) {
+			s->tmap[r.val] = newtmp(0, s->g->tmp[r.val].cls, s->f);
+			s->known[r.val] = 1;
+		}
+		return s->tmap[r.val];
+	case RCon:
+		if (r.val < 2) /* UNDEF and CON_Z keep their index */
+			return r;
+		return newcon(&s->g->con[r.val], s->f);
+	default:
+		return r;
+	}
+}
+
+/* succ's phis that name from as a predecessor now name to */
+static void
+retarget(Blk *succ, Blk *from, Blk *to)
+{
+	Phi *p;
+	uint k;
+
+	for (p=succ->phi; p; p=p->link)
+		for (k=0; k<p->narg; k++)
+			if (p->blk[k] == from)
+				p->blk[k] = to;
+}
+
+/*
+ * Replace the call at b->ins[c] (its Oarg at [i0, c)) with a copy of g.
+ * b keeps the instructions before the call and jumps into the copy; the
+ * instructions after the call and b's old jump move to a new block, which is
+ * returned.
+ */
+static Blk *
+inlinecall(Fn *f, Blk *b, uint c, uint i0, Fn *g)
+{
+	Inl s;
+	Ins *gi, *ii, *hoist;
+	Blk **gb, **nbk, **rb, *x, *nb, *cb, *tail;
+	Ref *rv, to;
+	Phi *p, *np, **pl;
+	uint ng, i, k, nret, nh;
+	int cls;
+
+	to = b->ins[c].to;
+	cls = req(to, R) ? -1 : b->ins[c].cls;
+	inlid++;
+
+	/* number the callee's blocks in list order, so its edges can be mapped */
+	for (x=g->start, ng=0; x; x=x->link)
+		x->id = ng++;
+	gb = calloc(ng, sizeof gb[0]);
+	nbk = calloc(ng, sizeof nbk[0]);
+	for (x=g->start; x; x=x->link)
+		gb[x->id] = x;
+	for (i=0; i<ng; i++) {
+		nbk[i] = newblk();
+		nbk[i]->name = strf(PFn, "inl%u.%u", inlid, i);
+	}
+
+	s.f = f;
+	s.g = g;
+	s.tmap = calloc(g->ntmp, sizeof s.tmap[0]);
+	s.known = calloc(g->ntmp, 1);
+	/* parameters stand for the caller's argument refs */
+	k = 0;
+	for (gi=g->start->ins; gi<g->start->ins+g->start->nins; gi++)
+		if (ispar(gi->op)) {
+			s.tmap[gi->to.val] = b->ins[i0+k].arg[0];
+			s.known[gi->to.val] = 1;
+			k++;
+		}
+
+	nret = 0;
+	for (i=0; i<ng; i++)
+		if (isret(gb[i]->jmp.type))
+			nret++;
+	rb = calloc(nret + 1, sizeof rb[0]);
+	rv = calloc(nret + 1, sizeof rv[0]);
+	hoist = calloc(g->start->nins + 1, sizeof hoist[0]);
+	nh = 0;
+
+	/* the continuation takes the caller's instructions after the call */
+	cb = newblk();
+	cb->name = strf(PFn, "inl%u.ret", inlid);
+	idup(cb, b->ins + c + 1, b->nins - c - 1);
+	cb->jmp = b->jmp;
+	cb->s1 = b->s1;
+	cb->s2 = b->s2;
+	if (cb->s1)
+		retarget(cb->s1, b, cb);
+	if (cb->s2 && cb->s2 != cb->s1)
+		retarget(cb->s2, b, cb);
+
+	/* b now jumps into the copy */
+	b->nins = i0;
+	b->jmp.type = Jjmp;
+	b->jmp.arg = R;
+	b->s1 = nbk[0];
+	b->s2 = 0;
+
+	nret = 0;
+	for (i=0; i<ng; i++) {
+		x = gb[i];
+		nb = nbk[i];
+		pl = &nb->phi;
+		for (p=x->phi; p; p=p->link) {
+			np = alloc(sizeof *np);
+			np->to = mapref(&s, p->to);
+			np->cls = p->cls;
+			np->narg = p->narg;
+			np->arg = vnew(p->narg, sizeof np->arg[0], PFn);
+			np->blk = vnew(p->narg, sizeof np->blk[0], PFn);
+			for (k=0; k<p->narg; k++) {
+				np->arg[k] = mapref(&s, p->arg[k]);
+				np->blk[k] = nbk[p->blk[k]->id];
+			}
+			*pl = np;
+			pl = &np->link;
+		}
+		vgrow(&nb->ins, x->nins + 1);
+		nb->nins = 0;
+		for (gi=x->ins; gi<x->ins+x->nins; gi++) {
+			if (ispar(gi->op))
+				continue;
+			if (isalloc(gi->op) && x == g->start) {
+				ii = &hoist[nh++];
+				*ii = *gi;
+				ii->to = mapref(&s, gi->to);
+				ii->arg[0] = mapref(&s, gi->arg[0]);
+				ii->arg[1] = mapref(&s, gi->arg[1]);
+				continue;
+			}
+			ii = &nb->ins[nb->nins++];
+			*ii = *gi;
+			ii->to = mapref(&s, gi->to);
+			ii->arg[0] = mapref(&s, gi->arg[0]);
+			ii->arg[1] = mapref(&s, gi->arg[1]);
+		}
+
+		nb->jmp.type = x->jmp.type;
+		nb->jmp.arg = mapref(&s, x->jmp.arg);
+		nb->s1 = x->s1 ? nbk[x->s1->id] : 0;
+		nb->s2 = x->s2 ? nbk[x->s2->id] : 0;
+		if (isret(x->jmp.type)) {
+			nb->jmp.type = Jjmp;
+			nb->jmp.arg = R;
+			nb->s1 = cb;
+			nb->s2 = 0;
+			if (cls >= 0) {
+				rb[nret] = nb;
+				rv[nret] = mapref(&s, x->jmp.arg);
+				nret++;
+			}
+		}
+	}
+
+	/* the call's result: a copy in the single return block, else a phi in the continuation */
+	if (cls >= 0) {
+		if (nret == 1) {
+			vgrow(&rb[0]->ins, rb[0]->nins + 1);
+			ii = &rb[0]->ins[rb[0]->nins++];
+			*ii = (Ins){Ocopy, cls, to, {rv[0], R}};
+		} else {
+			p = alloc(sizeof *p);
+			p->to = to;
+			p->cls = cls;
+			p->narg = nret;
+			p->arg = vnew(nret, sizeof p->arg[0], PFn);
+			p->blk = vnew(nret, sizeof p->blk[0], PFn);
+			for (k=0; k<nret; k++) {
+				p->arg[k] = rv[k];
+				p->blk[k] = rb[k];
+			}
+			cb->phi = p;
+		}
+	}
+
+	/* the callee's allocs run once, in the caller's entry block */
+	if (nh) {
+		Blk *st = f->start;
+		uint pos;
+
+		for (pos=0; pos<st->nins && (ispar(st->ins[pos].op) || isalloc(st->ins[pos].op)); pos++)
+			;
+		vgrow(&st->ins, st->nins + nh);
+		memmove(st->ins + pos + nh, st->ins + pos, (st->nins - pos) * sizeof st->ins[0]);
+		memcpy(st->ins + pos, hoist, nh * sizeof hoist[0]);
+		st->nins += nh;
+	}
+
+	/* append the new blocks to the caller's block list */
+	for (tail=f->start; tail->link; tail=tail->link)
+		;
+	for (i=0; i<ng; i++) {
+		tail->link = nbk[i];
+		tail = nbk[i];
+	}
+	tail->link = cb;
+	cb->link = 0;
+
+	free(s.tmap);
+	free(s.known);
+	free(gb);
+	free(nbk);
+	free(rb);
+	free(rv);
+	free(hoist);
+	return cb;
+}
+
+static void
+inlinefn(Fn *f)
+{
+	Blk **work, *b, *cb;
+	uint nwork, cap, w, c, i0, budget;
+	Fn *g;
+
+	work = 0;
+	nwork = cap = 0;
+	for (b=f->start; b; b=b->link) {
+		if (nwork == cap) {
+			cap = cap ? 2 * cap : 64;
+			work = realloc(work, cap * sizeof work[0]);
+			if (!work)
+				die("inlinefn, out of memory");
+		}
+		work[nwork++] = b;
+	}
+	/* instructions the inliner may still add to f; a callee adds at most inlmax */
+	budget = 1 << 16;
+	for (w=0; w<nwork; w++) {
+		b = work[w];
+		for (c=0; c<b->nins; c++) {
+			if (b->ins[c].op != Ocall)
+				continue;
+			g = callsite(f, b, c, &i0);
+			if (!g || budget < inlmax)
+				continue;
+			budget -= inlmax;
+			cb = inlinecall(f, b, c, i0, g);
+			if (nwork == cap) {
+				cap = cap ? 2 * cap : 64;
+				work = realloc(work, cap * sizeof work[0]);
+				if (!work)
+					die("inlinefn, out of memory");
+			}
+			work[nwork++] = cb;
+			break;
+		}
+	}
+	free(work);
+}
+
+/* inline within fns[0..n), the functions of one input file */
+void
+inlinefns(Fn **fns, uint n)
+{
+	uint i, h, m;
+	char *e;
+
+	e = getenv("QBE_INLINE");
+	inlmax = e ? atoi(e) : 24;
+	if (!inlmax || n == 0)
+		return;
+	for (fntabn=16; fntabn<2*n; fntabn*=2)
+		;
+	fntab = calloc(fntabn, sizeof fntab[0]);
+	if (!fntab)
+		die("inlinefns, out of memory");
+	m = fntabn - 1;
+	for (i=0; i<n; i++) {
+		for (h=strhash(fns[i]->name) & m; fntab[h]; h=(h+1) & m)
+			;
+		fntab[h] = fns[i];
+	}
+	for (i=0; i<n; i++)
+		inlinefn(fns[i]);
+	free(fntab);
+	fntab = 0;
+	fntabn = 0;
+}
