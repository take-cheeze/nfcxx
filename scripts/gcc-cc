#!/usr/bin/env bash
# The C compiler of the gcc backend, as eccp runs it on EDG's generated C (EDG_C_TO_OBJ_COMPILER). It is gcc, with
# three filters on a `-c file.c` compile of EDG's output (other arguments and files are unchanged):
#
# 1. A `#pragma GCC unroll N` line is removed. EDG passes the pragma through from libstdc++ 15's __find_if
#    (bits/stl_algobase.h), and gcc rejects it when a declaration follows it ("for, while or do statement expected
#    before 'auto'"). The pragma is only a loop hint.
#
# 2. EDG emits a class's complete-object destructor (the D1 of the Itanium ABI, when it is an alias of the D2 body)
#    as `extern __inline__`. Under gnu89 inline rules that is no external definition, so a static object whose data
#    refers to D1 (std::filesystem's directory_iterator holds a shared_ptr<_Dir>) does not link. D2 is written
#    without `extern`, weak, as EDG marks COMDAT members; the D1 wrapper is made the same, so both are emitted and
#    the copies of several units merge.
#
# 3. Weak symbols. EDG marks its COMDAT functions and data __attribute__((__weak__)) and GCC honours that, but a
#    non-extern `__inline__` member is an external definition under gnu89, so each object carries a strong copy
#    and the link fails with "multiple definition". The QBE path appends .weak directives for them
#    (scripts/weak-symbols.rb, which also covers `extern __inline__` members). Here the compile stops at the
#    assembly, the directives are appended, and the assembly is assembled to the object.
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
cc=${NFCXX_GCC:-cc}
CCBIN=("$cc"); if [ "${NFCXX_CCACHE:-1}" != 0 ] && command -v ccache >/dev/null; then CCBIN=(ccache "$cc"); fi
# 4. clang (macOS cc) drops a static function that only an asm alias names (__tls_init below); gcc keeps it, so the
#    definition is marked used (harmless for gcc, which keeps it anyway).
clang=0; if "$cc" --version 2>/dev/null | grep -qi clang; then clang=1; fi
# macOS: calls to the exported libc++ functions that return a class go through the thunks of scripts/darwin-sret.sh.
darwin=0; sret_sed=/dev/null; if [ "$(uname -s)" = Darwin ]; then darwin=1; sret_sed=$("$root/scripts/darwin-sret.sh" >/dev/null && echo "$root/build/darwin-sret/rename.sed"); fi
# On Mach-O every C symbol has one more leading underscore, so the asm alias of the TLS wrapper must name the underscored
# symbols too (the wrapper's reference, _ZTH2tl, is __ZTH2tl there).
tls_alias='s/__asm__("\(_ZTH[^ ]*\) = __tls_init")/__asm__("_\1 = ___tls_init")/'
[ "$(uname -s)" = Darwin ] || tls_alias='s/^$//'
tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
args=(); n=0
csrc=""; obj=""; compile=0
for a in "$@"; do
  case $a in
    -c) compile=1; args+=("$a") ;;
    *.c)
      csrc=$a
      if [ -f "$a" ] && { [ $darwin = 1 ] || grep -q '^[[:space:]]*#pragma GCC unroll' "$a" || { [ $clang = 1 ] && grep -q 'static void __tls_init(void)' "$a"; } || grep -q '^extern __inline__ __attribute__((visibility("default"))) void _ZN.*D1Ev(' "$a"; }; then
        n=$((n + 1)); f=$tmp/src$n.c
        grep -v '^[[:space:]]*#pragma GCC unroll' "$a" \
          | sed -e 's/static void __tls_init(void)/__attribute__((used)) static void __tls_init(void)/' \
          | sed -e "$tls_alias" \
          | sed -E -f "$sret_sed" \
          | sed -e 's/^extern __inline__ __attribute__((visibility("default"))) void \(_ZN.*D1Ev\)(/__attribute__((__weak__)) __inline__ __attribute__((visibility("default"))) void \1(/' > "$f"
        args+=("$f")
        csrc=$f
      else
        args+=("$a")
      fi ;;
    *) args+=("$a") ;;
  esac
done
# The output of a `-c ... -o FILE` compile is FILE; without -o, gcc writes the basename.o.
prev=""
for a in "$@"; do
  if [ "$prev" = "-o" ]; then obj=$a; fi
  prev=$a
done
if [ $compile = 1 ] && [ -n "$csrc" ] && [ -f "$csrc" ] && [ -n "$obj" ]; then
  # Weak directives are for EDG's own output only (the original .c file names the directives' symbols).
  asmf=$tmp/out.s
  build=()
  skip=0
  for a in ${args[@]+"${args[@]}"}; do
    if [ $skip = 1 ]; then skip=0; continue; fi
    case $a in
      -c) build+=(-S) ;;
      -o) build+=(-o "$asmf"); skip=1 ;;
      *) build+=("$a") ;;
    esac
  done
  ${CCBIN[@]+"${CCBIN[@]}"} ${build[@]+"${build[@]}"}
  "$(dirname "$0")/mrb" "$(dirname "$0")/weak-symbols.rb" "$csrc" "$asmf"
  exec as -o "$obj" "$asmf"
fi
exec ${CCBIN[@]+"${CCBIN[@]}"} ${args[@]+"${args[@]}"}
