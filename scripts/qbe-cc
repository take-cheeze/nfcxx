#!/usr/bin/env bash
# gcc-style C compiler wrapper for eccp (EDG_C_TO_OBJ_COMPILER) that compiles
# with the QBE back end:  cc -E | cproc-qbe | qbe | cc -c.
# Anything that isn't a "-c file.c" compile (i.e. the link step) goes to the
# system cc. Unknown gcc flags (-w, -O2, -fwrapv, ...) are dropped: QBE/cproc
# don't exploit C undefined behavior, so signed overflow wraps and strict
# aliasing isn't assumed.
set -euo pipefail
# ccache when it is installed (NFCXX_CCACHE=0 turns it off): the C compiles of the same preprocessed C repeat across runs.
CCBIN=(cc); if [ "${NFCXX_CCACHE:-1}" != 0 ] && command -v ccache >/dev/null; then CCBIN=(ccache cc); fi
root=$(cd "$(dirname "$0")/.." && pwd)
cproc=${CPROC_QBE:-$root/build/cproc/cproc-qbe}
qbe=${QBE:-$root/build/qbe/qbe}
source "$(dirname "$0")/trace.sh"
# NFCXX_QBE_PREP_RB, NFCXX_WEAK_SYMBOLS_RB: other copies of the two mruby scripts (tests/mruby/qbe-asm.sh runs the oracle ports).

compile=0 asm=0 pic=0 out="" src="" cppflags=() asflags=()
fsections=0 dsections=0
kcproc=() nofp=0 nounwind=0   # NFCXX_QBE_KERNEL (nfcc): cproc options for the kernel's -f options, and whether -mno-sse was given
i386=0 regparm=0 m16=0        # the kernel's real-mode code (-m16 -march=i386 -mregparm=3): cproc and QBE's i386 targets
args=("$@")
for ((i = 0; i < ${#args[@]}; i++)); do
  a=${args[i]}
  case $a in
    -c) compile=1 ;;
    -S) compile=1; asm=1 ;;   # stop at the assembly QBE wrote (-o - is stdout)
    -Wa,*) asflags+=("$a") ;;
    -fPIC|-fpic) pic=1 ;;   # code for a shared object: QBE -p (thread-local symbols by initial exec, not local exec)
    -fno-PIC|-fno-pic) pic=0 ;;
    -ffunction-sections) fsections=1 ;;   # each function in its own section (.text.NAME), each object (.data.NAME):
    -fdata-sections) dsections=1 ;;       # a link with --gc-sections then drops the ones nothing reaches
    -o) out=${args[++i]} ;;
    -D?*|-I?*|-U?*|-std=*|-ansi|-iquote?*|-isystem?*|-idirafter?*|-include?*|-imacros?*) cppflags+=("$a") ;;
    -D|-I|-U) cppflags+=("$a${args[++i]}") ;;
    -isystem|-iquote|-idirafter|-include|-imacros) cppflags+=("$a" "${args[++i]}") ;;
    -nostdinc|-undef) cppflags+=("$a") ;;
    # NFCXX_QBE_KERNEL: nfcc passes only the kernel options this path honours (nfcc's qbekernel). The preprocessor gets
    # them all, since gcc derives predefined macros from them (__SSE__, __CHAR_UNSIGNED__, __code_model_kernel__ ...).
    -f*|-m*)
      if [ -n "${NFCXX_QBE_KERNEL:-}" ]; then
        cppflags+=("$a")
        case $a in
          -funsigned-char) kcproc+=(-u) ;;
          -fshort-wchar) kcproc+=(-W) ;;
          -ftrivial-auto-var-init=zero) kcproc+=(-z) ;;
          -mno-sse|-mno-sse2|-mno-80387|-msoft-float) nofp=1 ;;
          -fno-asynchronous-unwind-tables) nounwind=1 ;;   # qbe -U: no .cfi directives, so no .eh_frame
          -fasynchronous-unwind-tables) nounwind=0 ;;
          -m16) m16=1; i386=1 ;;
          -march=i386) i386=1 ;;
          -mregparm=3) regparm=1 ;;
        esac
      fi ;;
    *.c) src=$a ;;
  esac
done
# the kernel's headers define far more static inline functions than a file uses: drop the unreferenced ones (cproc -p)
[ -z "${NFCXX_QBE_KERNEL:-}" ] || kcproc+=(-p -g -V)   # -g: the GNU keyword asm (the kernel is gnu11); -V: volatile accesses kept
# -G: GNU C's cleanup attribute, which runs at the end of the object's scope (the kernel's guard()); nfcxx's EDG-made C
# uses the attribute for its throw-only cleanups instead (docs/notes/cproc-nfcxx.md)
[ -z "${NFCXX_QBE_KERNEL:-}${NFCXX_C_INPUT:-}" ] || kcproc+=(-G)

if [ $compile = 0 ] && [ -n "${NFCXX_CIL:-}" ]; then
  # The CIL backend (scripts/cil-cc): the link is cil-link.rb over the translation units' fragments (docs/notes/cil.md).
  # The link's settings are arguments (the mruby interpreter has no environment): ILASM, CC and NFCXX_KEEP_IL.
  keep=(); [ -z "${NFCXX_KEEP_IL:-}" ] || keep=(--keep-il)
  exec "$(dirname "$0")/mrb" "$(dirname "$0")/cil-link.rb" --ilasm "${ILASM:-$root/build/cil/ilasm}" --cc "${CC:-cc}" \
    ${keep[@]+"${keep[@]}"} "$@"
fi
if [ $compile = 0 ]; then
  # The link. The sized __atomic_* calls qbe-prep.rb leaves in the C (for libstdc++'s std::atomic) are
  # libatomic functions; gcc inlines them, so only the QBE link adds the library. -lm: the fabs builtins
  # qbe-prep.rb maps to fabs/fabsf (a C-only program does not pull libm in through libstdc++).
  # libnfcxxld.a (be/nfcxx_ldrt.c) is the runtime of the helper calls cproc emits for long double and __float128.
  # Its __float128 to_chars wrappers need libstdc++; the archive member is only pulled in when a program calls a helper.
  # -fsanitize=address (NFCXX_ASAN=1): the program links libasan, whose preinit runs before main (docs/notes/asan.md)
  asan=(); [ -z "${NFCXX_ASAN:-}" ] || asan=(-fsanitize=address)
  # macOS: libc++ instead of libstdc++, and no libatomic (the sized atomics come from clang's runtime).
  if [ "$(uname -s)" = Darwin ]; then libs=(-lc++ -lm); else libs=(-latomic -lstdc++ -lm); fi
  # NFCXX_EH_UNWIND=1 (nfcxx's gate, nfcxx): the program's unwinder flag is 1. The gcc backend gets it from its
  # objects (lib/ehshim/nfcxx_eh_unwind.h); the cproc objects cannot (no weak definitions), so a flag object is linked in.
  ehflag=(); ehdir=""
  if [ "${NFCXX_EH_UNWIND:-}" = 1 ]; then
    ehdir=$(mktemp -d); printf 'int __nfcxx_eh_unwind_frames = 1;\n' > "$ehdir/flag.c"
    ${CCBIN[@]+"${CCBIN[@]}"} -c "$ehdir/flag.c" -o "$ehdir/flag.o"
    ehflag=("$ehdir/flag.o")
  fi
  st=0
  ${CCBIN[@]+"${CCBIN[@]}"} "$@" ${ehflag[@]+"${ehflag[@]}"} ${asan[@]+"${asan[@]}"} "$("$(dirname "$0")/pathb-ldrt")" ${libs[@]+"${libs[@]}"} || st=$?
  [ -z "$ehdir" ] || rm -rf "$ehdir"
  exit $st
fi
if [ -z "$src" ]; then
  exec ${CCBIN[@]+"${CCBIN[@]}"} "$@"
fi

tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
t=$(trace_start)
# -P drops the line markers, which -fsanitize=address needs for the source lines of its reports (NFCXX_ASAN=1 keeps them)
pflag=(-P); [ -z "${NFCXX_ASAN:-}" ] || pflag=()
# macOS: the SDK's headers declare nullability keywords (_Nullable, _Nonnull) that cproc does not know; cproc's own
# configure defines them away only for its internal preprocessor, which this clang -E does not use.
# NFCXX_MACOS_SYSROOT=DIR: a macOS arm64 compile check from any host. The C is preprocessed by clang for arm64-apple-darwin
# with the headers in DIR (tests/macos-cleanroom/include, written from public sources, not the SDK). Compile and
# assembly only: no link, no sret thunks (they need the SDK's export list), and the output is not run.
macos=0; [ "$(uname -s)" = Darwin ] && macos=1
if [ -n "${NFCXX_MACOS_SYSROOT:-}" ]; then
  macos=1
  CCBIN=(clang --target=arm64-apple-darwin -nostdinc -isystem "$NFCXX_MACOS_SYSROOT" -isystem "$(clang -print-resource-dir)/include")
fi
darwin=()
if [ $macos = 1 ]; then
  # cproc has no 128-bit integers; the SDK's ARM register state (sys/signal.h) has __uint128_t arrays. A two-word
  # struct of the same size stands in for it (only the layout of those ucontext members is affected).
  # __int128_t is a 64-bit integer here: libc++'s filesystem clock uses it for nanosecond counts that fit in 64 bits, and
  # cproc can compare and compute with a long long where it cannot with a struct.
  darwin=(-U__BLOCKS__ -D_Nullable= -D_Nonnull= -D_Null_unspecified= -D__compar=)
  # Native macOS only: the SDK's TargetConditionals.h stops with "unknown compiler" under -undef, because -undef removes the
  # compiler and target macros it reads. Predefine its include guard so the header is skipped, as mruby's common.h expects
  # on macOS. TARGET_OS_IPHONE is then undefined, which mruby-io reads as 0 (macOS), so its branches are unchanged.
  # The cross path (NFCXX_MACOS_SYSROOT, clean-room headers, no TargetConditionals.h) is unchanged.
  if [ "$(uname -s)" = Darwin ] && [ -z "${NFCXX_MACOS_SYSROOT:-}" ]; then
    darwin+=(-D__TARGETCONDITIONALS__)
  fi
fi
# __int128_t and __uint128_t are gcc and clang builtin typedefs (no header declares them): name cproc's 128-bit integer types.
darwin+=('-D__uint128_t=unsigned __int128' '-D__int128_t=__int128')
if [ -n "${NFCXX_QBE_KERNEL:-}" ]; then
  # The Linux kernel (nfcc's NFCXX_QBE_KERNEL): preprocessed exactly as gcc preprocesses it, with gcc's predefined
  # macros and the kernel's options, so cproc sees the same translation unit as the gcc backend's reference object.
  # The kernel needs gcc's identity (compiler_types.h stops on "Unknown compiler" without __GNUC__). The linemarkers
  # stay, so cproc's errors name the header and line (the migration log, NFCXX_QBE_LOG, is read by them).
  ${CCBIN[@]+"${CCBIN[@]}"} -E ${cppflags[@]+"${cppflags[@]}"} "$src" > "$tmp/pp.c"
elif [ -n "${NFCXX_C_INPUT:-}" ]; then
  # Hand-written C (nfcxx's .c inputs) includes host headers, which the -undef below would break:
  # glibc picks its ABI from __x86_64__ (gnu/stubs-32.h otherwise), gcc's stddef.h needs
  # __SIZE_TYPE__, limits.h needs __INT_MAX__. So pre-define the host target's macros, but not the
  # GCC-identity ones (__GNUC__, __VERSION__, ...): without __GNUC__ the headers use no GNU extensions,
  # which cproc cannot parse. (EDG's generated C is already preprocessed and skips this.)
  ${CCBIN[@]+"${CCBIN[@]}"} -dM -E -x c /dev/null | grep -Ev '^#define (__GNUC|__GNUG|__GXX|__VERSION__|__OPTIMIZE|__GCC_|__SSE|__MMX|__AVX|__FLT(16|32|64|128)|__SIZEOF_(INT128|FLOAT)|__STDC_|__STRICT_ANSI__|__pic__|__PIC__|__pie__|__PIE__|__CET__|__HAVE_SPECULATION|__BFLT16|__DEC|__BLOCKS__|__USER_LABEL_PREFIX__|__REGISTER_PREFIX__|__NO_INLINE__|__tune|__code_model|__k8|__znver|__amd64|__MMX|__SEG|__FXSR|__SSP|__GXX|__LDBL_|__SIZEOF_LONG_DOUBLE__)' > "$tmp/defs.h"
  ${CCBIN[@]+"${CCBIN[@]}"} -E ${pflag[@]+"${pflag[@]}"} -undef -D__CPROC__ ${darwin[@]+"${darwin[@]}"} -include "$tmp/defs.h" ${cppflags[@]+"${cppflags[@]}"} "$src" > "$tmp/pp.c"
else
  ${CCBIN[@]+"${CCBIN[@]}"} -E ${pflag[@]+"${pflag[@]}"} -undef -D__CPROC__ ${darwin[@]+"${darwin[@]}"} ${cppflags[@]+"${cppflags[@]}"} "$src" > "$tmp/pp.c"
fi
# macOS, Linux aarch64 and the macOS cross (NFCXX_MACOS_SYSROOT): calls to the exported library functions that return a class go
# through the thunks of scripts/sret.sh; the rename map is next to the object it prints.
sretobj="$("$(dirname "$0")/sret.sh")"
if [ -n "$sretobj" ]; then
  rename="$(dirname "$sretobj")/rename.sed"
  sed -E -f "$rename" "$tmp/pp.c" > "$tmp/pp.sret.c" && mv "$tmp/pp.sret.c" "$tmp/pp.c"
  # cproc has no _Atomic. libc++'s atomic operations are calls into libc++ (not inline), so the qualifier only matters
  # for the layout of the member it declares (__atomic_base's __a_value); the atomicity comes from the library.
  "$(dirname "$0")/mrb" "$(dirname "$0")/strip-atomic.rb" < "$tmp/pp.c" > "$tmp/pp.at.c" && mv "$tmp/pp.at.c" "$tmp/pp.c"
fi
trace_end "$t" "cc -E (preprocess)" qbe-backend
# cproc rejects some GNU forms EDG emits (top-level asm, aligned attributes, __bf16). qbe-prep.rb rewrites
# just those and writes the assembly they need (aliases) to $tmp/tail.s, appended after weak-symbols.rb.
# The C-input mode (hand-written C) is an argument: the mruby interpreter has no ENV.
t=$(trace_start)
prepflags=(); [ -z "${NFCXX_C_INPUT:-}" ] || prepflags=(--c-input)
# NFCXX_QBE_DCE=1: qbe-prep.rb drops the definitions of static functions nothing uses (what gcc does by not emitting them).
# cproc and QBE compile every one, so a file that includes a big header of static inline functions pays for all of them.
# The assembly is smaller, not identical, so it is opt-in; weak-symbols.rb gets only --c-input.
prepdce=(); [ -z "${NFCXX_QBE_DCE:-}" ] || prepdce=(--dce)
# Mach-O targets: qbe-prep.rb lists constructors in __mod_init_func with the "_" label prefix
macho=(); [ $macos = 1 ] && macho=(--macho)
# The fence stub is mfence on x86-64 and dmb ish on arm64. The target is arm64 on an arm64 host and in the macOS cross
# (NFCXX_MACOS_SYSROOT, from any host, where QBE gets -t arm64_apple).
arm64=(); case "$(uname -m)" in arm64|aarch64) arm64=(--arm64) ;; esac
[ -z "${NFCXX_MACOS_SYSROOT:-}" ] || arm64=(--arm64)
# qbe-prep.rb changes only the forms named in its header, and all of them contain one of these tokens. With
# none present (and no CR, which it would normalize), its output is its input and the tail is empty, so the
# file goes through unchanged. Under mruby the scan costs minutes on a multi-MB file (unicode_name_fsm: 11 MB).
# NFCXX_PREP_ALWAYS=1 runs qbe-prep.rb on every input (tests/mruby/qbe-prep.sh counts them through the tap).
# NFCXX_QBE_KERNEL: no rewriting. The kernel's translation unit is exactly gcc's preprocessed source, so cproc either
# compiles a construct itself or refuses it (and qbe-try keeps the gcc object); in particular volatile stays volatile
# (cproc -V), where qbe-prep.rb would drop it.
if [ -n "${NFCXX_QBE_KERNEL:-}" ] ||
   { [ -z "${NFCXX_C_INPUT:-}" ] && [ -z "${NFCXX_PREP_ALWAYS:-}" ] && ! grep -q -E '__asm|__attribute__|__builtin_|__atomic_|__sync_|volatile|_Float|__bf16|f(16|32|64|128)|return;' "$tmp/pp.c" &&
     ! grep -q "$(printf '\r')" "$tmp/pp.c"; }; then
  cp "$tmp/pp.c" "$tmp/prep.c"; : > "$tmp/tail.s"
else
  "$(dirname "$0")/mrb" "${NFCXX_QBE_PREP_RB:-$(dirname "$0")/qbe-prep.rb}" ${prepflags[@]+${prepflags[@]+"${prepflags[@]}"}} ${prepdce[@]+"${prepdce[@]}"} ${macho[@]+"${macho[@]}"} ${arm64[@]+"${arm64[@]}"} "$tmp/pp.c" "$tmp/prep.c" "$tmp/tail.s"
fi
trace_end "$t" "qbe-prep.rb (mruby, rewrite for cproc)" qbe-backend
t=$(trace_start)
# macOS arm64: the aarch64-apple target (Apple's va_list, see scripts/cproc-apple-valist.patch); elsewhere the default.
cprocarg=(); case "$(uname -m)" in arm64|aarch64) [ $macos = 1 ] && cprocarg=(-t aarch64-apple) ;; esac
# GNU extended inline asm is lowered to out-of-line thunks cproc writes here (x86_64 ELF only; the Mach-O label prefix
# and the CIL backend have no path, so -a is withheld there and cproc then refuses any asm instead of miscompiling it).
asmarg=()
if [ $macos = 0 ] && [ -z "${NFCXX_CIL:-}" ]; then asmarg=(-a "$tmp/asm.s"); : > "$tmp/asm.s"; fi
# true/false/nullptr/bool are C23 keywords; before C23 (the default, and the gnu* dialects) they are ordinary
# identifiers, which is how the Linux kernel's headers use them. cproc -K takes them as identifiers (its own default is
# C23), so it is passed unless the standard is C23.
c23=0
for a in ${cppflags[@]+"${cppflags[@]}"}; do case $a in -std=c23|-std=c2x|-std=gnu23|-std=gnu2x) c23=1 ;; -std=*) c23=0 ;; esac; done
# the i386 targets (the kernel's real-mode boot code): cproc's ILP32 layout, with the calling convention QBE writes; the
# regparm name also tells cproc's volatile helpers the convention. The object is 32-bit (cc -m32 below).
qbei386=(); cc32=()
if [ $i386 = 1 ]; then
  if [ $regparm = 1 ]; then cprocarg=(-t i386_regparm3); qbei386=(-t i386_regparm3)
  else cprocarg=(-t i386); qbei386=(-t i386); fi
  [ $m16 = 0 ] || qbei386+=(-m16)
  cc32=(-m32)
fi
[ $c23 = 1 ] || cprocarg+=(-K)
"$cproc" ${cprocarg[@]+"${cprocarg[@]}"} ${kcproc[@]+"${kcproc[@]}"} ${asmarg[@]+"${asmarg[@]}"} < "$tmp/prep.c" > "$tmp/out.ssa"
trace_end "$t" "cproc (C to QBE IL)" qbe-backend
if [ -n "${NFCXX_CIL:-}" ]; then
  # The CIL backend: the QBE IL becomes a fragment for the link (scripts/qbe2cil.rb); no assembler, no weak symbols.
  [ $asm = 0 ] || { echo "qbe-cc: -S is not supported by the CIL backend" >&2; exit 1; }
  "$(dirname "$0")/mrb" "$(dirname "$0")/qbe2cil.rb" "$tmp/out.ssa" "$tmp/tail.s" "$(basename "$src" .c | tr -c 'A-Za-z0-9_.-' _)" \
    "${out:-${src%.c}.o}"
  exit 0
fi
t=$(trace_start)
# A cross check from a non-Darwin host: QBE's default target there is ELF, so the Apple arm64 target is named.
qbetarget=(); if [ -n "${NFCXX_MACOS_SYSROOT:-}" ]; then qbetarget=(-t arm64_apple); fi
[ $i386 = 0 ] || qbetarget=("${qbei386[@]}")
# -mno-sse: qbe -n moves integers between stack slots through %rax, not %xmm15 (a commit of the fork, 3rd/qbe)
qbenofp=(); [ $nofp = 0 ] || qbenofp=(-n)
[ $nounwind = 0 ] || qbenofp+=(-U)
# NFCXX_QBE_ABS=1 (qbe-try, for the kernel's .head.text): global addresses are absolute immediates, as gcc's kernel model
# writes them, and loads of globals are rip-relative (qbe -A, a commit of the fork, 3rd/qbe)
[ "${NFCXX_QBE_ABS:-}" != 1 ] || qbenofp+=(-A)
[ $pic = 0 ] || qbenofp+=(-p)   # -fPIC: thread-local symbols by initial exec
"$qbe" ${qbetarget[@]+"${qbetarget[@]}"} ${qbenofp[@]+"${qbenofp[@]}"} "$tmp/out.ssa" > "$tmp/out.s"
trace_end "$t" "qbe (IL to assembly)" qbe-backend
# -mno-sse (NFCXX_QBE_KERNEL): QBE has no switch to avoid SSE and x87, so the code it wrote is checked instead (the
# inline-asm thunks are the program's own instructions, as with gcc, and are appended later).
if [ $nofp = 1 ] && grep -nE '%[xyz]mm[0-9]|%st\b|%st\(|^[[:space:]]+f[a-z]+[[:space:]]' "$tmp/out.s" > "$tmp/fp.txt"; then
  echo "qbe-cc: $src: the code QBE generated uses SSE or x87 registers, which -mno-sse forbids:" >&2
  head -3 "$tmp/fp.txt" >&2
  exit 1
fi
# -ffunction-sections, -fdata-sections: QBE opens each definition with .text or .data (then .balign, .globl and the
# label); that directive becomes a section of the definition's own, named after its label, as gcc names them. nfcxx's
# NFCXX_INSTANTIATE=used: every unit has its copy of an instance, and --gc-sections keeps the one the link chose.
if [ $macos = 0 ] && [ $((fsections + dsections)) -gt 0 ]; then
  awk -v f=$fsections -v d=$dsections '
    function flush() { if (n) { print open; for (i = 1; i <= n; i++) print held[i] } n = 0; open = "" }
    open != "" && /^[A-Za-z_.$][A-Za-z0-9_.$]*:/ {
      name = substr($0, 1, length($0) - 1)
      if (kind == ".text") print ".section .text." name ",\"ax\",@progbits"
      else if (kind == ".data") print ".section .data." name ",\"aw\",@progbits"
      else print ".section .bss." name ",\"aw\",@nobits"
      for (i = 1; i <= n; i++) print held[i]
      n = 0; open = ""; print; next
    }
    open != "" && /^\.(balign|p2align|align|globl|hidden|protected|local)[ \t]/ { held[++n] = $0; next }
    open != "" { flush() }
    ($0 == ".text" && f) || (($0 == ".data" || $0 == ".bss") && d) { open = $0; kind = $0; next }
    { print }
    END { flush() }' "$tmp/out.s" > "$tmp/out.sec.s" && mv "$tmp/out.sec.s" "$tmp/out.s"
fi
# COMDAT functions (inline and template instantiations) are __weak__ in EDG's C; mark them weak in the
# assembly too, so the link merges the per-object copies as gcc does.
t=$(trace_start)
# Mach-O: QBE's Apple targets prefix every label with "_" (T.assym), so the names are looked up with it.
symprefix=()
if [ $macos = 1 ]; then symprefix=(--sym-prefix=_); fi
# --marked: the inline-asm side file, where cproc already wrote the .weak of hand-written C's weak attribute
marked=(); [ ${#asmarg[@]} -eq 0 ] || marked=(--marked="$tmp/asm.s")
"$(dirname "$0")/mrb" "${NFCXX_WEAK_SYMBOLS_RB:-$(dirname "$0")/weak-symbols.rb}" ${symprefix[@]+"${symprefix[@]}"} ${prepflags[@]+${prepflags[@]+"${prepflags[@]}"}} ${marked[@]+"${marked[@]}"} "$tmp/prep.c" "$tmp/out.s"
# Hand-written C: without __GNUC__ (see above) glibc's <sys/cdefs.h> defines __attribute__ away, so an
# __attribute__((weak)) of the source is gone from prep.c. A plain preprocess of the same source keeps it; the names come from
# that text (weak-symbols.rb gives .weak only to the ones the assembly defines). Run only when a weak attribute is there.
if [ -n "${NFCXX_C_INPUT:-}" ] && [ $macos = 0 ]; then
  if ${CCBIN[@]+"${CCBIN[@]}"} -E ${pflag[@]+"${pflag[@]}"} ${cppflags[@]+"${cppflags[@]}"} "$src" > "$tmp/pp.weak.c" 2>/dev/null &&
     grep -q -E '__attribute__ *\(\([^;{}]*(__)?weak(__)?[ ,)]' "$tmp/pp.weak.c"; then
    "$(dirname "$0")/mrb" "${NFCXX_WEAK_SYMBOLS_RB:-$(dirname "$0")/weak-symbols.rb}" --c-input ${marked[@]+"${marked[@]}"} "$tmp/pp.weak.c" "$tmp/out.s"
  fi
fi
cat "$tmp/tail.s" >> "$tmp/out.s"
[ ${#asmarg[@]} -eq 0 ] || cat "$tmp/asm.s" >> "$tmp/out.s"   # inline-asm thunks, appended as local functions
# The weak or visibility directive of a symbol the unit only declares ("#nfcxx:ifused NAME", cproc's emitsymattr) stays
# only when the assembly names the symbol elsewhere: QBE drops dead code, and with it the last use of the declaration.
if grep -q '^#nfcxx:ifused ' "$tmp/out.s"; then
  awk 'NR == FNR { if ($0 ~ /^#nfcxx:/) { skip = $0 ~ /^#nfcxx:ifused /; next } if (skip) { skip = 0; next }
                   n = split($0, w, /[^A-Za-z0-9_.$]+/); for (i = 1; i <= n; i++) used[w[i]] = 1; next }
       /^#nfcxx:ifused / { drop = !($2 in used); next }
       drop { drop = 0; next }
       { print }' "$tmp/out.s" "$tmp/out.s" > "$tmp/out.used.s" && mv "$tmp/out.used.s" "$tmp/out.s"
fi
trace_end "$t" "weak-symbols.rb (mruby)" qbe-backend
t=$(trace_start)
if [ $asm = 1 ]; then
  if [ "$out" = - ]; then cat "$tmp/out.s"; else cp "$tmp/out.s" "${out:-${src%.c}.s}"; fi
else
  ${CCBIN[@]+"${CCBIN[@]}"} ${cc32[@]+"${cc32[@]}"} -c "${asflags[@]+"${asflags[@]}"}" -o "${out:-${src%.c}.o}" "$tmp/out.s"
fi
trace_end "$t" "cc -c (assemble)" qbe-backend
