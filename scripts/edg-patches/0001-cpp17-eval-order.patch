+/* nfcxx: C++17 sequencing for the C back end.  C leaves the order of
+   evaluation of function designator, "this" object and arguments, and of the
+   operands of most operators, unspecified, so the C compiler picks its own.
+   C++17 [expr.call], [expr.shift], [expr.ass], [expr.sub] and [over.match.oper]
+   fix the order (postfix-expression/object before the arguments, left before
+   right for << >> [], right before left for = and op=).  The routines below
+   evaluate the operand that must come first into a temporary ahead of the
+   operation, which makes the order explicit in the generated C. */
+
+static void sequence_operand_before_args(an_expr_node_ptr      node,
+                                         an_insert_location_ptr insert_location)
+/*
+Evaluate the (lowered, rvalue) expression node into a temporary at
+*insert_location and replace node by a use of the temporary.
+*/
+{
+  a_variable_ptr   temp;
+  an_expr_node_ptr temp_node;
+
+  check_assertion(!node->is_lvalue);
+  temp = make_lowered_temporary(node->type);
+  temp_node = make_var_assignment_expr(temp, copy_node(node));
+  (void)insert_expr_statement(temp_node, insert_location);
+  overwrite_node(node, var_rvalue_expr(temp));
+}  /* sequence_operand_before_args */
+
+
+static an_expr_node_ptr sequence_operands_of_operation(an_expr_node_ptr expr)
+/*
+expr is a lowered-operands, non-call, two operand built-in operation.  If
+C++17 mandates an evaluation order for its operands and C would not
+guarantee it, evaluate the operand that must go first into a temporary and
+return the assignment expression that does so (the caller makes it the left
+operand of a comma in front of expr); otherwise return NULL.
+*/
+{
+  an_expr_node_ptr      op1 = expr->variant.operation.operands, op2, assigns = NULL;
+  an_expr_operator_kind op = expr->variant.operation.kind;
+  a_boolean             first_is_op2 = FALSE, first_is_op1 = FALSE;
+
+  if (!strict_cpp17_eval_order || op1 == NULL) return NULL;
+  op2 = op1->next;
+  if (op2 == NULL || op2->next != NULL) return NULL;
+  switch (op) {
+    case eok_assign:
+      /* The right operand is sequenced before the left one.  What matters
+         for the left operand is the address it designates. */
+      if (expr->variant.operation.eval_right_to_left &&
+          !op2->is_lvalue &&
+          ((node_has_side_effects(op2, (a_boolean *)NULL) &&
+            !is_invariant_expr(op1, /*vars_can_change=*/TRUE,
+                               /*treat_as_potential_prvalue=*/FALSE)) ||
+           (node_has_side_effects(op1, (a_boolean *)NULL) &&
+            !is_invariant_expr(op2, /*vars_can_change=*/TRUE,
+                               /*treat_as_potential_prvalue=*/FALSE)))) {
+        first_is_op2 = TRUE;
+      }  /* if */
+      break;
+    case eok_add_assign:
+    case eok_subtract_assign:
+    case eok_multiply_assign:
+    case eok_divide_assign:
+    case eok_remainder_assign:
+    case eok_shiftl_assign:
+    case eok_shiftr_assign:
+    case eok_and_assign:
+    case eok_or_assign:
+    case eok_xor_assign:
+    case eok_padd_assign:
+    case eok_psubtract_assign:
+      /* The left operand's value is read too, so any side effect of the
+         right operand matters. */
+      if (expr->variant.operation.eval_right_to_left &&
+          !op2->is_lvalue &&
+          (node_has_side_effects(op2, (a_boolean *)NULL) ||
+           (node_has_side_effects(op1, (a_boolean *)NULL) &&
+            !is_invariant_expr(op2, /*vars_can_change=*/TRUE,
+                               /*treat_as_potential_prvalue=*/FALSE)))) {
+        first_is_op2 = TRUE;
+      }  /* if */
+      break;
+    case eok_shiftl:
+    case eok_shiftr:
+    case eok_subscript:
+      /* Left operand before the right one. */
+      if (expr->variant.operation.eval_left_to_right &&
+          !op1->is_lvalue &&
+          node_has_side_effects(op1, (a_boolean *)NULL) &&
+          !is_invariant_expr(op2, /*vars_can_change=*/TRUE,
+                             /*treat_as_potential_prvalue=*/FALSE)) {
+        first_is_op1 = TRUE;
+      }  /* if */
+      break;
+    default:
+      break;
+  }  /* switch */
+  if (first_is_op2) {
+    (void)pre_execute_expression(op2, &op1->next, &assigns);
+  } else if (first_is_op1) {
+    /* op1 is the first operand, so *prev is the expression pointer of the
+       operation itself; build the temporary by hand. */
+    a_variable_ptr   temp = make_lowered_temporary(op1->type);
+    an_expr_node_ptr copy = copy_node(op1);
+    copy->next = NULL;
+    assigns = make_var_assignment_expr(temp, copy);
+    set_expr_result_not_used(assigns);
+    overwrite_node(op1, var_rvalue_expr(temp));
+  }  /* if */
+  return assigns;
+}  /* sequence_operands_of_operation */
