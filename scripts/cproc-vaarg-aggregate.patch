 			/* https://todo.sr.ht/~mcf/cproc/52 */
 			if (!(e->type->prop & PROPSCALAR))
-				error(&tok.loc, "va_arg with non-scalar type is not yet supported");
+				return funcvaargagg(f, e);
 			l = funcexpr(f, e->base);
 			return funcinst(f, IVAARG, qbetype(e->type).base, l, NULL);
