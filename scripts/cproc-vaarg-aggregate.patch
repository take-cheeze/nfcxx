Local patch for 3rd/cproc (michaelforney/cproc at d1c53dd), applied after cproc-empty-struct.patch to the build
copy by scripts/setup-qbe.sh.

va_arg of an aggregate. cproc rejects it ("va_arg with non-scalar type is not yet supported",
https://todo.sr.ht/~mcf/cproc/52) because QBE's vaarg takes scalars only. mruby's VM passes mrb_value
(a struct) through varargs (mrb_funcall, mrb_raisef's %v and %t), so this is needed to build mruby.

This lowers the case that has a simple, exact SysV x86-64 rule: a struct, union or array-of-those of at most
16 bytes, alignment at most 8, whose scalars are all integers or pointers (every eightbyte is class INTEGER).
Such an argument is passed in the general registers, all of it or none, when gp_offset <= 48 - size, and in
the overflow area otherwise. The patch reads the va_list directly (gp_offset at 0, overflow_arg_area at 8,
reg_save_area at 16), advances it as va_arg does, and yields the address of the argument, which is how cproc
represents any aggregate value. Anything else (a float member, larger than 16 bytes, over-aligned, not
x86_64) keeps the error, with a message that says what is supported. Checked against gcc-compiled callers and
callees for 8- and 16-byte structs, including the case where one general register is left, in
tests/c/va_struct.c.
--- a/qbe.c
+++ b/qbe.c
@@ -755,6 +755,74 @@
 	return v;
 }
 
+/* true if every scalar in t is an integer, pointer or bool, so each eightbyte is SysV class INTEGER */
+static bool
+intclass(struct type *t)
+{
+	struct member *m;
+
+	switch (t->kind) {
+	case TYPEARRAY:
+		return intclass(t->base);
+	case TYPESTRUCT:
+	case TYPEUNION:
+		for (m = t->u.structunion.members; m; m = m->next) {
+			if (!intclass(m->type))
+				return false;
+		}
+		return true;
+	default:
+		return t->prop & PROPSCALAR && !(t->prop & PROPFLOAT);
+	}
+}
+
+/*
+va_arg for a struct/union of at most 16 bytes whose eightbytes are all class INTEGER
+(x86_64 SysV only; QBE's vaarg handles scalars). Such an argument is in the general
+registers when enough remain (gp_offset <= 48 - size), all of it or none, and otherwise in
+the overflow area. The result is the address of the argument, like any aggregate value.
+*/
+static struct value *
+funcvaargagg(struct func *f, struct expr *e)
+{
+	struct value *ap, *gp, *cond, *tmp, *addr[2];
+	struct block *b[3];
+	unsigned long long size;
+
+	if (strcmp(targ->name, "x86_64-sysv") != 0 || !e->type->size || e->type->size > 16
+	    || e->type->align > 8 || !intclass(e->type))
+		error(&tok.loc, "va_arg with non-scalar type is not yet supported (only integer-class aggregates of up to 16 bytes on x86_64)");
+	size = ALIGNUP(e->type->size, 8);
+	ap = funcexpr(f, e->base);
+	b[0] = mkblock("vaarg_reg");
+	b[1] = mkblock("vaarg_stack");
+	b[2] = mkblock("vaarg_join");
+
+	gp = funcinst(f, ILOADW, 'w', ap, NULL);
+	cond = funcinst(f, ICULEW, 'w', gp, mkintconst(48 - size));
+	funcjnz(f, cond, NULL, b[0], b[1]);
+
+	funclabel(f, b[0]);
+	tmp = funcinst(f, ILOADL, 'l', funcinst(f, IADD, 'l', ap, mkintconst(16)), NULL);  /* reg_save_area */
+	addr[0] = funcinst(f, IADD, 'l', tmp, funcinst(f, IEXTUW, 'l', gp, NULL));
+	funcinst(f, ISTOREW, 0, funcinst(f, IADD, 'w', gp, mkintconst(size)), ap);
+	b[2]->phi.val[0] = addr[0];
+	b[2]->phi.blk[0] = f->end;
+	funcjmp(f, b[2]);
+
+	funclabel(f, b[1]);
+	tmp = funcinst(f, IADD, 'l', ap, mkintconst(8));  /* &overflow_arg_area */
+	addr[1] = funcinst(f, ILOADL, 'l', tmp, NULL);
+	funcinst(f, ISTOREL, 0, funcinst(f, IADD, 'l', addr[1], mkintconst(size)), tmp);
+	b[2]->phi.val[1] = addr[1];
+	b[2]->phi.blk[1] = f->end;
+
+	funclabel(f, b[2]);
+	functemp(f, &b[2]->phi.res);
+	b[2]->phi.class = 'l';
+	return &b[2]->phi.res;
+}
+
 struct value *
 funcexpr(struct func *f, struct expr *e)
 {
@@ -999,7 +1067,7 @@
