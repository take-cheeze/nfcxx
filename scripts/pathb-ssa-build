#!/usr/bin/env ruby
# frozen_string_literal: true
#
# Opt-in Path B driver (docs/notes/pathb-ssa-build.md): a Path B IR file (the `pathb-dump --ir` text, see
# docs/notes/pathb-stage2.md) through the SSA converter (scripts/pathb-ssa.rb), the e-graph pass
# (scripts/pathb-egraph.rb) and the QBE emitter (scripts/pathb-ssa-qbe.rb), then QBE (build/qbe/qbe) to assembly.
# Nothing calls this by default; the default Path B flow does not use it.
#
#   scripts/pathb-ssa-build [-o OUT.s] [--no-opt] FILE.ir
#
# Each function is emitted on its own. A function outside the emitter's subset (QbeUnsupported) is not emitted: its
# name and reason go to stderr, the rest of the module is still written, and the status is 3. Callers of a function
# that was not emitted get an undefined symbol at link time, so status 3 output is not a complete program.
#
# Exit status: 0 every function emitted; 1 error (conversion, optimization, or QBE failed); 2 usage;
# 3 some functions not emitted (listed on stderr; the assembly has the others).
#
# --qbe=PATH (or NFCXX_QBE) overrides the QBE binary (default build/qbe/qbe under the repository root); the flag wins.

require "base64"
require "open3"
require "rbconfig"
require "tmpdir"
require_relative "pathb-egraph"
require_relative "pathb-ssa-qbe"
require_relative "pathb-x87-thunks"

# The reader of the IR and SSA text, for CRuby. scripts/pathb-ssa.rb tokenizes with a character loop, so that it runs in the
# script worlds (tests/bc2cpp/run_pathb_ssa.sh: no Regexp); under CRuby that loop takes about 15 times as long as one
# regex scan (Dev09_192736 of the Microsoft STL survey, 11.7 MB of IR: 42 s for the build, 11 s with this reader), and the
# build reads a module's text three times. Same forms: TOKEN_RE is the regex that the character loop reproduces, and a
# (const ...) form is normalised as its parenthesis closes, as normalise_literals does after the whole read.
TOKEN_RE = /\(|\)|"(?:\\.|[^"\\])*"|[$@&]"(?:\\.|[^"\\])*"|[^\s()"]+/

def normalise_const!(x)
  type, val = x[1], x[2]
  if float_type?(type) || type == "std::float16_t"
    x[2] = "1e999" if val == "+Infinity"
    x[2] = "-1e999" if val == "-Infinity"
  elsif hex_literal?(val) && INT_TYPES.key?(type)
    x[2] = canon(Integer(val, 16), type).to_s
  elsif hex_literal?(val) && type == "bool"
    x[2] = canon(Integer(val, 16), type).to_s
  end
end

def read_forms(text)
  stack = []
  cur = []
  text.scan(TOKEN_RE) do |t|
    c = t.getbyte(0)
    if c == 40 # (
      stack.push(cur)
      cur = []
    elsif c == 41 # )
      raise Fail, "unbalanced parentheses" if stack.empty?

      done = cur
      cur = stack.pop
      cur << done
      normalise_const!(done) if done[0] == "const" && done.size >= 3 && done[1].is_a?(String) && done[2].is_a?(String)
    elsif c == 34 # "
      cur << Str.new(t)
    elsif t.length > 1 && t.getbyte(1) == 34 && (c == 36 || c == 64 || c == 38)
      cur << Ref.new(t[0], t[1..])
    else
      cur << t
    end
  end
  raise Fail, "unbalanced parentheses" unless stack.empty?

  cur
end

ROOT_DIR = File.expand_path("..", __dir__)
EXIT_OK = 0
EXIT_ERROR = 1
EXIT_USAGE = 2
EXIT_PARTIAL = 3
EXIT_NOFP = 5   # --no-fp: the code QBE wrote uses SSE or x87 (nfcc's -mno-sse; scripts/pathb-cc does not retry this one)

def usage_exit
  warn "usage: pathb-ssa-build [-o OUT.s] [--qbe=PATH] [--no-opt] [--no-fp] [--no-unwind] [--trap-checks] [--safe | --asan] [--pic] FILE.ir"
  exit EXIT_USAGE
end

def error_exit(msg)
  warn "pathb-ssa-build: #{msg}"
  exit EXIT_ERROR
end

$qbe_path = nil
$qbe_flags = []   # --no-fp (qbe -n) and --no-unwind (qbe -U): nfcc's -mno-sse and -fno-asynchronous-unwind-tables

def qbe_binary
  $qbe_path || ENV.fetch("NFCXX_QBE") { File.expand_path("../build/qbe/qbe", __dir__) }
end

# The helpers the emitter names in "# pathb-asm NAME" comments, appended to the assembly once each (the same text as
# scripts/pathb-qbe-emit.rb's ASM_HELPERS, as weak functions). QBE has no fence, and a barrier is an empty call.
ASM_HELPERS = {
  "barrier" => ["\t.text", "\t.weak __pathb_barrier", "\t.type __pathb_barrier, @function", "__pathb_barrier:", "\tret",
                "\t.size __pathb_barrier, .-__pathb_barrier"],
  "fence" => ["\t.text", "\t.weak __pathb_fence", "\t.type __pathb_fence, @function", "__pathb_fence:", "\tmfence", "\tret",
              "\t.size __pathb_fence, .-__pathb_fence"],
  # An empty function whose argument (a slot's address) escapes: it keeps the slot in memory across a returns-twice call.
  "escape" => ["\t.text", "\t.weak __pathb_escape", "\t.type __pathb_escape, @function", "__pathb_escape:", "\tret",
               "\t.size __pathb_escape, .-__pathb_escape"],
# `pathb_check(cond, code)` (the checked operations of the SSA route): an abort when cond is nonzero. It is weak, so a
# test driver's own pathb_check overrides it.
"check" => ["\t.text", "\t.weak pathb_check", "\t.type pathb_check, @function", "pathb_check:", "\ttestl %edi, %edi",
            "\tje .Lpathb_check_ok", "\tsubq $8, %rsp", "\tcall abort", ".Lpathb_check_ok:", "\tret",
            "\t.size pathb_check, .-pathb_check"],
  # `__pathb_retaddr()` / `__pathb_frameaddr()`: __builtin_return_address(0) and __builtin_frame_address(0), read from the %rbp that QBE
  # sets up in the calling function (a call of the helper leaves it as it was). x86-64 only.
  "retaddr" => ["\t.text", "\t.weak __pathb_retaddr", "\t.type __pathb_retaddr, @function", "__pathb_retaddr:", "\tmovq 8(%rbp), %rax", "\tret",
                "\t.size __pathb_retaddr, .-__pathb_retaddr"],
  "frameaddr" => ["\t.text", "\t.weak __pathb_frameaddr", "\t.type __pathb_frameaddr, @function", "__pathb_frameaddr:", "\tmovq %rbp, %rax", "\tret",
                  "\t.size __pathb_frameaddr, .-__pathb_frameaddr"],
  "rdtsc" => ["\t.text", "\t.weak __pathb_rdtsc", "\t.type __pathb_rdtsc, @function", "__pathb_rdtsc:", "\trdtsc", "\tshlq $32, %rdx",
              "\torq %rdx, %rax", "\tret", "\t.size __pathb_rdtsc, .-__pathb_rdtsc"],
  # `__pathb_sp()`: the stack pointer of the caller at the call (a global register variable bound to rsp): its %rsp, past the return
  # address the call pushed. x86-64 only.
  "sp" => ["\t.text", "\t.weak __pathb_sp", "\t.type __pathb_sp, @function", "__pathb_sp:", "\tleaq 8(%rsp), %rax", "\tret",
           "\t.size __pathb_sp, .-__pathb_sp"],
  # `__pathb_vasink_CLS(v)`: takes the value of a va_arg that nothing else uses. QBE drops an unused vaarg, and the va_list
  # would then not advance past that argument; passing the value to this empty function keeps the read.
  "vasink_w" => ["\t.text", "\t.weak __pathb_vasink_w", "\t.type __pathb_vasink_w, @function", "__pathb_vasink_w:", "\tret",
                 "\t.size __pathb_vasink_w, .-__pathb_vasink_w"],
  "vasink_l" => ["\t.text", "\t.weak __pathb_vasink_l", "\t.type __pathb_vasink_l, @function", "__pathb_vasink_l:", "\tret",
                 "\t.size __pathb_vasink_l, .-__pathb_vasink_l"],
  "vasink_s" => ["\t.text", "\t.weak __pathb_vasink_s", "\t.type __pathb_vasink_s, @function", "__pathb_vasink_s:", "\tret",
                 "\t.size __pathb_vasink_s, .-__pathb_vasink_s"],
  "vasink_d" => ["\t.text", "\t.weak __pathb_vasink_d", "\t.type __pathb_vasink_d, @function", "__pathb_vasink_d:", "\tret",
                 "\t.size __pathb_vasink_d, .-__pathb_vasink_d"],
}.freeze

# The arm64 versions of the helpers above, for the arm64 QBE targets (arm64, arm64_apple), with the same semantics: check
# branches to abort when its argument is nonzero, fence is a full barrier (dmb ish), and rdtsc reads the generic timer's
# virtual count (cntvct_el0: arm64 has no time stamp counter). Each entry is [symbol, body]; ABORT names abort (or _abort).
ARM64_HELPERS = {
  "barrier" => ["__pathb_barrier", ["ret"]],
  "fence" => ["__pathb_fence", ["dmb ish", "ret"]],
  "escape" => ["__pathb_escape", ["ret"]],
  # The frame record of AAPCS64 (x29 is the frame pointer, QBE always keeps one): [x29] the caller's x29, [x29 + 8] the return
  # address. The helper runs without a frame of its own, so x29 is the function that called it (as %rbp is on x86-64).
  "retaddr" => ["__pathb_retaddr", ["ldr x0, [x29, #8]", "ret"]],
  "frameaddr" => ["__pathb_frameaddr", ["mov x0, x29", "ret"]],
  "check" => ["pathb_check", ["cbz w0, .Lpathb_check_ok", "b ABORT", ".Lpathb_check_ok:", "ret"]],
  "rdtsc" => ["__pathb_rdtsc", ["mrs x0, cntvct_el0", "ret"]],
  "vasink_w" => ["__pathb_vasink_w", ["ret"]],
  "vasink_l" => ["__pathb_vasink_l", ["ret"]],
  "vasink_s" => ["__pathb_vasink_s", ["ret"]],
  "vasink_d" => ["__pathb_vasink_d", ["ret"]],
}.freeze

# The QBE target the IL is assembled for: PATHB_QBE_TARGET when set (and passed to QBE with -t), else the host's, which is
# QBE's default for this host (the same as `uname`: Apple and Linux, arm64 and x86-64).
def qbe_target
  ENV.fetch("PATHB_QBE_TARGET") { host_qbe_target }
end

def host_qbe_target
  apple = RbConfig::CONFIG["host_os"].include?("darwin")
  if %w[arm64 aarch64].include?(RbConfig::CONFIG["host_cpu"])
    apple ? "arm64_apple" : "arm64"
  else
    apple ? "amd64_apple" : "amd64_sysv"
  end
end

def arm64_target?(target)
  target.start_with?("arm64")
end

def arm64_apple?(target)
  arm64_target?(target) && target.end_with?("_apple")
end

# The directives that make the symbol SYM (as the IL names it) a weak definition in the target's assembler. Apple's has no
# .weak: .globl and .weak_definition, on the name with the underscore QBE puts on every symbol there.
def weak_lines(sym, target, defined = true)
  return [".weak #{sym}"] unless target.end_with?("_apple")
  return ["\t.weak_reference _#{sym}"] unless defined
  ["\t.globl _#{sym}", "\t.weak_definition _#{sym}"]
end

# Apple (arm64_apple) refusals: an ifunc alias (Mach-O has no indirect function symbol) and a file-scope asm block (its text is
# ELF). The driver refuses the unit with status 3, as it refuses the constructs this route does not emit. nil when none.
def apple_refusal(il, target)
  return nil unless arm64_apple?(target)

  ifunc = il.scan(/^# pathb-alias ifunc (\S+) /).flatten.first
  return "ifunc #{ifunc}: Mach-O has no indirect function symbol" if ifunc
  return "file-scope asm has ELF directives, no Mach-O form" if il.match?(/^# pathb-text /)

  nil
end

# The assembly lines of the helper NAME for TARGET: the x86-64 text of ASM_HELPERS, or the arm64 one (ELF, or Apple's form).
def asm_helper(name, target)
  return ASM_HELPERS.fetch(name) { error_exit("no assembly helper for #{name}") } unless arm64_target?(target)
  sym, body = ARM64_HELPERS.fetch(name) { error_exit("no arm64 assembly helper for #{name}") }
  apple = arm64_apple?(target)
  s = apple ? "_" + sym : sym
  lines = body.map { |l| "\t" + l.gsub("ABORT", apple ? "_abort" : "abort") }
  if apple
    ["\t.text", "\t.globl #{s}", "\t.weak_definition #{s}", "#{s}:"] + lines
  else
    ["\t.text", "\t.weak #{s}", "\t.type #{s}, %function", "#{s}:"] + lines + ["\t.size #{s}, .-#{s}"]
  end
end

# The assembly directives for the markers in the IL: `# pathb-weak SYM` gives `.weak SYM` (QBE has no weak linkage), and
# `# pathb-asm NAME` appends that helper. TARGET is the QBE target the assembly is for.
def marker_asm(il, target, qbe_asm)
  # Apple: a weak name the unit defines (a label of the assembly, or an alias) is .weak_definition, else .weak_reference.
  defined = {}
  if arm64_apple?(target)
    qbe_asm.each_line { |l| defined[l.chomp.chop] = true if l.end_with?(":\n") && !l.start_with?("\t") }
    il.scan(/^# pathb-alias \S+ (\S+) /).flatten.each { |name| defined["_" + name] = true }
  end
  weak = il.scan(/^# pathb-weak (\S+)$/).flatten.uniq.flat_map { |sym| weak_lines(sym, target, defined.key?("_" + sym) || !arm64_apple?(target)) }
  helpers = il.scan(/^# pathb-asm (\S+)$/).flatten.uniq.flat_map { |h| asm_helper(h, target) }
  # `# pathb-alias KIND NAME TARGET [weak]` (one per IR alias form, from scripts/pathb-qbe-emit.rb's append_weak): a
  # global symbol NAME that is TARGET, typed by KIND (function, object or ifunc). QBE has no aliases, so this is the .set.
  # Apple: the same .set on the underscore names, no .type (an ifunc is refused by apple_refusal).
  apple = arm64_apple?(target)
  aliases = il.scan(/^# pathb-alias (\S+) (\S+) (\S+)( weak)?$/).flat_map do |kind, name, alias_target, weak|
    if apple
      next ["\t.globl _#{name}", "\t.set _#{name}, _#{alias_target}"] + (weak ? ["\t.weak_definition _#{name}"] : [])
    end
    type = { "function" => "@function", "ifunc" => "@gnu_indirect_function", "object" => "@object" }.fetch(kind) do
      error_exit("no symbol type for alias kind #{kind}")
    end
    ["\t#{weak ? '.weak' : '.globl'} #{name}", "\t.type #{name}, #{type}", "\t.set #{name}, #{alias_target}"]
  end
  # `# pathb-startup SECTION PRIO SYM`: a (constructor)/(destructor) function's pointer in .init_array/.fini_array, as
  # scripts/pathb-qbe-emit.rb's emit_startup_tables does (one entry per function; a priority P goes to SECTION.PPPPP).
  startup = il.scan(/^# pathb-startup (\S+) (\d+) (\S+)$/).map do |sect, prio, sym|
    sect = sect + format(".%05d", prio.to_i) if prio.to_i != 0
    ["\t.section #{sect},\"aw\"", "\t.align 8", "\t.quad #{sym}"]
  end
  texts = il.scan(/^# pathb-text (\S+)$/).flatten.uniq.map { |b| Base64.strict_decode64(b) }
  (weak + helpers + aliases + startup.flatten(1)).map { |line| "#{line}\n" }.join + texts.join
end

# The SSA text of the module's forms, from scripts/pathb-ssa.rb's convert_module, run in this process (the IR file is read
# once, and a second process would read it again). Its warnings go to stderr as they did from a process of its own, and
# a function it cannot convert is reported there. live: the names the module keeps (see live_names): the others are not
# converted, since the prune below would drop them.
def convert(forms, live, file)
  output, = convert_module(forms, live)
  output.map { |l| l.end_with?("\n") ? l : "#{l}\n" }.join   # what `puts output` printed
rescue VerifyFailed
  error_exit("pathb-ssa.rb failed on #{file}")
rescue Unsupported, Fail => e
  warn "pathb-ssa: #{e.message}"
  error_exit("pathb-ssa.rb failed on #{file}")
end

# --long-double=trap (pathb-qbe-emit.rb's stub_long_double): a function whose IR mentions the scalar type long_double
# becomes a stub that aborts when it runs (its linkage and start-up markers stay), and a global of that type is dropped.
# The rule is applied to the IR before conversion, so a stub is converted like any other function.
def mentions_long_double?(x)
  return x.any? { |y| mentions_long_double?(y) } if x.is_a?(Array)

  x.is_a?(String) && x == "long_double"
end

def stub_long_double(forms)
  out = [forms[0]]
  forms.drop(1).each do |f|
    if head(f) == "function" && mentions_long_double?(f)
      keep = f.drop(2).select { |p| %w[static weak constructor destructor].include?(head(p)) }
      out << (["function", f[1], ["ret", "void"], ["params"]] + keep + [["unreachable"]])
    elsif head(f) == "global" && mentions_long_double?(f)
      next
    else
      out << f
    end
  end
  out
end


# The names a module keeps (pathb-qbe-emit.rb's prune rule): a linked definition (not static, not weak, not an
# extern declaration) or a constructor or destructor is a root, and everything a live definition refers to with
# a global (@) or function (&) name is live too. A definition nothing reaches is left out.
def live_names(forms)
  defs = {}
  forms.each do |f|
    defs[f[1].raw.delete('"')] = f if %w[function global data].include?(head(f)) && f[1].is_a?(Str)
  end
  # An x87 entry thunk is the module's symbol for a long double function F, which is defined as __nfcxx_ldr_F: a
  # reference to F keeps __nfcxx_ldr_F, and the thunk exists only when that function is kept (scripts/pathb-x87-thunks.rb).
  x87_entries = {}
  forms.each do |f|
    next unless head(f) == "x87-thunk" && %w[entry entryc].include?(f[1].to_s)

    entry = f[2].raw.delete('"')
    x87_entries[entry] = ["x87-entry", Ref.new("@", "\"__nfcxx_ldr_#{entry}\"")]
    defs[entry] = x87_entries[entry]
  end
  live = {}
  work = []
  defs.each do |name, f|
    next if x87_entries.key?(name)
    next unless linked_or_startup?(f)

    live[name] = true
    work << name
  end
  # An alias names a live symbol: its target (for an ifunc, the resolver) is kept, though nothing else refers to it.
  forms.each do |f|
    next unless head(f) == "alias"

    target = (f[2].respond_to?(:raw) ? f[2].raw : f[2].to_s).delete('"')
    next unless defs.key?(target) && !live.key?(target)

    live[target] = true
    work << target
  end
  until work.empty?
    refs = {}
    collect_symbol_refs(defs[work.pop], refs)
    refs.each_key do |r|
      next if live.key?(r) || !defs.key?(r)

      live[r] = true
      work << r
    end
  end
  live
end

def linked_or_startup?(f)
  f.drop(2).any? { |p| %w[constructor destructor used].include?(head(p)) } ||
    f.drop(2).none? { |p| head(p) == "static" || head(p) == "extern" || (head(p) == "weak" && p.length == 1) }
end

def collect_symbol_refs(x, out)
  if x.is_a?(Ref)
    out[x.raw.delete('"')] = true if x.sigil == "@" || x.sigil == "&"
  elsif x.is_a?(Array)
    x.each { |y| collect_symbol_refs(y, out) }
  end
end

# The assembly of the QBE IL text, or nil with the QBE error text in `err`.
def assemble(il)
  Dir.mktmpdir("pathb-ssa-build") do |dir|
    path = File.join(dir, "module.qbe")
    File.write(path, il)
    qbe_args = ENV.key?("PATHB_QBE_TARGET") ? ["-t", qbe_target] : []
    qbe_args += $qbe_flags
    asm, err, st = Open3.capture3(qbe_binary, *qbe_args, path)
    return [nil, err] unless st.success?

    [asm, nil]
  end
end

output = nil
no_opt = false
no_prune = false
ld_trap = false
no_fp = false
safe = false
asan = false
pic = false
trap_checks = false
args = ARGV.dup
usage_exit if args.empty?
while args.first&.start_with?("-") && args.first != "-"
  flag = args.shift
  case flag
  when "-o" then output = args.shift or usage_exit
  when "--no-opt" then no_opt = true
  when "--no-prune" then no_prune = true
  when "--long-double=trap" then ld_trap = true
  when "--no-fp" then no_fp = true; $qbe_flags << "-n"
  when "--no-unwind" then $qbe_flags << "-U"
  when "--safe" then safe = true
  when "--asan" then asan = true
  when "--pic" then pic = true
  when "--trap-checks" then trap_checks = true   # a failed check is the trap instruction, not a call of abort (no libc)
  when /\A--qbe=(.+)\z/ then $qbe_path = $1
  else usage_exit
  end
end
usage_exit unless args.size == 1
usage_exit if safe && output.nil?
usage_exit if asan && safe   # both replace malloc and check accesses: one at a time
Qbe.safe = safe
Qbe.asan = asan
Qbe.pic = pic
Qbe.trap_checks = trap_checks
Qbe.darwin = RbConfig::CONFIG["host_os"].include?("darwin")
# extern data through the GOT (copy extern): on Darwin (ld64 cannot bind a dylib symbol at a page offset) and on aarch64
# Linux (a PIE adrp to a symbol in another object or a shared library is out of its range: R_AARCH64_ADR_PREL_PG_HI21)
Qbe.got_extern = Qbe.darwin || %w[aarch64 arm64].include?(RbConfig::CONFIG["host_cpu"])
Qbe.aarch64 = %w[aarch64 arm64].include?(RbConfig::CONFIG["host_cpu"])

file = args.first
# The x87 ABI thunks (`(x87-thunk ...)` forms: long double through the x87 helpers) are generated by scripts/
# pathb-x87-thunks.rb for the symbols the IL uses. A reference to a thunk with no matching form is refused (see below).
# Each input is parsed once: the IR file (the data, alias, x87 and live-name forms) and the SSA text (the globals and functions).
ir_forms = read_forms(File.read(file))
# Pruning: a definition nothing reaches is left out, as pathb-qbe-emit.rb does (--no-prune keeps every one). It comes
# before the conversion, the optimizer and the emitter, which work on each function alone: a function nothing reaches
# costs their time for no output (the STL route timed out on it, docs/notes/library-suite-results.md).
live = no_prune ? nil : live_names(ir_forms)
ssa = convert(ld_trap ? stub_long_double(ir_forms) : ir_forms, live, file)
ssa_forms = read_forms(ssa)
x87_forms = ir_forms.select { |f| head(f) == "x87-thunk" }
skipped = []
# A global the emitter refuses is reported and left out, so it does not stop the functions that do not use it.
globals = ssa_forms.select { |g| head(g) == "global" }.filter_map do |g|
  Qbe.module_il([g])
  g
rescue QbeUnsupported => e
  skipped << [g[1].raw.delete('"'), "global: #{e.message}"]
  nil
end
# The aggregate types (abi-type forms) every function and global is laid out and passed with.
globals = ssa_forms.select { |f| head(f) == "abi-type" } + globals
# The string literals: top-level data forms, which the SSA text does not carry.
globals += ir_forms.select { |f| head(f) == "data" }
text = no_opt ? ssa : PathbEgraph.optimize_forms(ssa_forms).first
fns = read_forms(text).select { |f| head(f) == "ssa-function" }
unless no_prune
  fns = fns.select { |f| live.key?(f[1].raw.delete('"')) }
  # An abi-type is a layout every function may need, not a definition to prune: it is kept.
  globals = globals.select { |g| head(g) == "abi-type" || live.key?(g[1].raw.delete('"')) }
end

# The globals' data, emitted once: the emitter writes data for a module's globals together with its functions.
# The functions are passed too: the module's shared text (its volatile helpers) depends on what the functions do.
ctx = Qbe.module_context(globals + fns)
data_text = ctx[:data].join("\n\n").strip
bodies = []
fns.each do |fn|
  name = fn[1].raw.delete('"')
  bodies << Qbe.function_text(ctx, fn).strip
rescue QbeUnsupported => e
  skipped << [name, e.message]
end

# The module's alias forms (IR: (alias NAME TARGET KIND [weak])), kept whatever the pruning: a resolver may be live
# only through its alias. Each becomes a `# pathb-alias` marker that marker_asm turns into the assembly directives.
name_of = ->(x) { (x.respond_to?(:raw) ? x.raw : x.to_s).delete('"') }
alias_markers = ir_forms.select { |f| head(f) == "alias" }.map do |a|
  weak = a[4] == "weak" ? " weak" : ""
  "# pathb-alias #{a[3]} #{Qbe.symbol(name_of.call(a[1]))} #{Qbe.symbol(name_of.call(a[2]))}#{weak}"
end

# Weak references (scripts/pathb-qbe-emit.rb's weak_refs): (declare "NAME" (weak)) is a function declared
# __attribute__((weak)) that the module refers to and does not define, and (global ... (weak) (extern)) an object. The
# symbol may be absent at link time, so it is marked .weak (QBE has no weak linkage): without it `if (absent_fn)` was
# an undefined reference. A defined weak symbol has its marker from the definition.
defined_syms = {}
ir_forms.each { |f| defined_syms[name_of.call(f[1])] = true if head(f) == "function" || (head(f) == "global" && f.none? { |p| head(p) == "extern" }) }
weak_ref_markers = ir_forms.filter_map do |f|
  next unless (head(f) == "declare" && f.length == 3 && head(f[2]) == "weak") ||
              (head(f) == "global" && f.any? { |p| head(p) == "extern" } && f.any? { |p| head(p) == "weak" && p.length == 1 })
  next if defined_syms.key?(name_of.call(f[1]))

  "# pathb-weak #{Qbe.symbol(name_of.call(f[1]))}"
end

# The (constructor [PRIO]) and (destructor [PRIO]) functions of the module: their pointers go in the start-up tables.
startup_markers = ssa_forms.select { |f| head(f) == "ssa-function" }.flat_map do |f|
  name = Qbe.symbol(name_of.call(f[1]))
  f.drop(2).select { |p| %w[constructor destructor].include?(head(p)) }.map do |p|
    sect = head(p) == "constructor" ? ".init_array" : ".fini_array"
    prio = p.length > 1 ? Qbe.int_lit(p[1]) : 0
    "# pathb-startup #{sect} #{prio} #{name}"
  end
end

# File-scope asm (the IR's (asm-decl HEX) forms, from be/nfcxx_ir.c): its text goes into the object as it is, as a
# pathb-text marker. A .cu's device image is defined this way (pathb-ptx-emit --embed), as the qbe route does.
# The text of an (asm-decl HEX) form: its hex digits as bytes, one line (a line ends with a newline for the assembler).
def text_of_asm_decl(f)
  text = [f[1].to_s].pack("H*")
  text.end_with?("\n") ? text : text + "\n"
end

asm_decl_markers = ir_forms.select { |f| head(f) == "asm-decl" }.map do |f|
  "# pathb-text #{Base64.strict_encode64(text_of_asm_decl(f))}"
end
il = ([data_text] + bodies + Qbe.ubfile_data(ctx[:link]) + [Qbe.asm_text_markers(ctx[:link])] + alias_markers + weak_ref_markers + startup_markers + [asm_decl_markers.join("\n")]).reject(&:empty?).join("\n\n") + "\n"
x87_asm = x87_thunks_asm(x87_forms, il)
thunk_refs = il.scan(/\$(__nfcxx_x87\w*)\(/).flatten.uniq
missing = thunk_refs.reject { |s| x87_asm.include?("#{s}:") }
unless missing.empty?
  warn "pathb-ssa-build: refused: #{File.basename(file)}: calls an x87 thunk with no form in the module: #{missing.first}"
  exit EXIT_PARTIAL
end
# The thunks are x86-64 assembly: on arm64 a module that needs one is refused (docs/notes/pathb-longdouble.md).
unless x87_asm.empty? || x87_target_x86_64?
  warn "pathb-ssa-build: refused: #{File.basename(file)}: long double ABI thunks (x87) are x86-64 assembly; target is #{x87_target_name}"
  exit EXIT_PARTIAL
end
asm, qbe_err = assemble(il)
error_exit("QBE failed: #{qbe_err.lines.first&.strip}") if asm.nil?
# -mno-sse: QBE has no switch to avoid SSE and x87 (-n only keeps integer moves out of %xmm15), so the code it wrote is checked, as
# scripts/qbe-cc does. The inline asm thunks and the long double helpers appended below are the program's own, as with gcc.
if no_fp && (hit = asm.lines.grep(/%[xyz]mm\d|%st\b|%st\(|^\s+f[a-z]+\s/).first)
  warn "pathb-ssa-build: refused: #{File.basename(file)}: the code QBE generated uses SSE or x87, which -mno-sse forbids: #{hit.strip}"
  exit EXIT_NOFP
end
if (why = apple_refusal(il, qbe_target))
  warn "pathb-ssa-build: refused: #{File.basename(file)}: #{why}"
  exit EXIT_PARTIAL
end
asm += marker_asm(il, qbe_target, asm)
asm += x87_asm

if output
  File.write(output, asm)
else
  $stdout.write(asm)
end
# --safe (-fsafe-pointers, docs/notes/safe-pointers.md): the runtime is linked first, as scripts/pathb-cc does with
# $(scripts/safeptr-rt). The driver does not link; it writes the object's path to OUT.link for the caller's link line.
# Slice 1: the assembly is unchanged by --safe (the per-access checks come in a later slice).
if safe
  rt_out, rt_err, rt_st = Open3.capture3(File.join(ROOT_DIR, "scripts", "safeptr-rt"))
  error_exit("safeptr-rt failed: #{rt_err.lines.first&.strip}") unless rt_st.success?
  File.write("#{output}.link", rt_out.strip + "\n")
end
skipped.each { |name, why| warn "pathb-ssa-build: not emitted: #{name}: #{why}" }
exit(skipped.empty? ? EXIT_OK : EXIT_PARTIAL)
