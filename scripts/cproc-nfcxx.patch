+/* write the thunk body: template with %N / %[name] / %%/%= expanded */
+static void
+asmtemplate(const char *t, struct asmrec *rec, unsigned total, char **names, unsigned expid)
+{
+	const char *p;
+	unsigned i;
+	int mod;
