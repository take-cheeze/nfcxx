+/* the register a fixed-register constraint letter names, or -1 */
+static int
+fixedreg(int c)
+{
+	switch (c) {
+	case 'a': return RAX;
+	case 'b': return RBX;
+	case 'c': return RCX;
+	case 'd': return RDX;
+	case 'S': return RSI;
+	case 'D': return RDI;
+	}
+	return -1;
+}
+
+/* map a clobber name ("rax", "eax", ...) to a register index, or -1 */
+static int
+clobberreg(const char *name)
+{
+	int r, s;
+
+	if (*name == '%')
+		++name;
+	for (r = 0; r < 16; ++r)
+		for (s = 0; s < 4; ++s)
+			if (strcmp(name, regname[r][s]) == 0)
