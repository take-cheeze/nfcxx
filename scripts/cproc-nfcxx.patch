+static const int rpool[] = {RAX, RCX, RDX, RSI, RDI, R8, R9, R10, R11};
+static int
+regsizecol(int sz)
+{
+	return sz == 8 ? 0 : sz == 4 ? 1 : sz == 2 ? 2 : 3;
+}
