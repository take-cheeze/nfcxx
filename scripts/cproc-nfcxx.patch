+			asmsubst(rec, total, mod, i);
+			continue;
+		}
+		if (!isdigit((unsigned char)*p))
+			error(&tok.loc, "bad asm operand reference");
+		i = 0;
+		while (isdigit((unsigned char)*p))
+			i = i * 10 + (*p++ - '0');
+		--p;
+		asmsubst(rec, total, mod, i);
+	}
+}
