+/* operand size from a type: scalars up to 8 bytes; anything else is refused */
+static int
+asmopsize(struct type *t)
+{
+	if (!(t->prop & PROPSCALAR) || t->size == 0 || t->size > 8)
+		error(&tok.loc, "unsupported type for an asm operand");
+	return t->size;
