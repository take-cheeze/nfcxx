 		break;
+	case BUILTINC11INIT:
+	case BUILTINC11LOAD:
+	case BUILTINC11STORE:
+	case BUILTINC11XCHG:
+	case BUILTINC11CAS:
+	case BUILTINC11FETCHADD:
+	case BUILTINC11FETCHSUB:
+	case BUILTINC11FETCHAND:
+	case BUILTINC11FETCHOR:
+	case BUILTINC11FETCHXOR:
+		e = atomicbuiltin(s, kind);
+		break;
