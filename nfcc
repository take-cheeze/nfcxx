#!/usr/bin/env bash
# nfcc: drop-in `cc` for build systems (make, rake, autoconf probes), on top of nfcxx's C pipeline.
#   NFCXX_BACKEND=qbe|gcc|pathb   (default: pathb on x86-64 Linux when the Path B harness is built (a unit it cannot take is made by gcc),
#              else qbe; qbe: cproc -> QBE; gcc: host gcc -fwrapv -fno-strict-aliasing, -O2 unless -O/-g say otherwise;
#              pathb: EDG's C front end -> typed IR -> QBE (scripts/pathb-cc, no cproc), docs/notes/nfcc-pathb.md;
#              the Linux kernel's options are accepted there: -nostdinc, -isystem, -idirafter, -funsigned-char, -fshort-wchar,
#              -ffreestanding and -mno-sse (checked) are honoured, codegen options without effect on QBE's output are dropped, and a
#              compile with another option that changes meaning (-m16, -fshort-enums, -iquote, an unknown -Wa,* ...) is made by gcc, never
#              dropped. NFCXX_PATHB_LOG=FILE: which one made each compile. NFCXX_PATHB_FALLBACK=gcc: also gcc for a unit Path B refuses)
#   NFCC_HOST_CC            host compiler for preprocessing, dependency files, assembling and linking (default cc)
#
#   nfcc -c a.c -o a.o        compile (several .c files without -o give one .o each in the cwd)
#   nfcc a.o b.o -lm -o prog  link; .c inputs are compiled to temporary objects first
#   nfcc -E ... / -M ... / -fsyntax-only   preprocess / dependency query / syntax check: host compiler, unchanged
#   nfcc --version, -v, -dumpmachine, -dumpversion, -print-*: answered like gcc (the host compiler answers)
#   nfcc -S a.c [-o a.s]      emit assembly (qbe: QBE's output; gcc: the host compiler's), one .s per source
#   @file                     response files are expanded first with gcc's rules (quotes, backslash, nested @file)
#   -MD -MMD -MF f -MT t -MQ t -MP   dependency file from the host preprocessor (gcc -M/-MM), with -c
#   honoured:  -std=* (C only), -ansi, -D -U -I -isystem -iquote -idirafter -include -imacros, -x c, -x none,
#              -l -L -Wl,* -Xlinker -shared -static -rdynamic -pie -no-pie -s -nostdlib -pthread -o
#              --bundle-libs, --bundle-exclude=*, --bundle-only=* (the libraries copied into the output: docs/notes/bundle.md)
#              --cuda-driver=auto|cudart|libcuda (a libcuda on the link line goes through libcudart by default:
#              docs/notes/cuda-driver.md)
#              -Wa,* (given to the assembler); -Wp,-D/-U/-I<arg>, -Wp,-isystem/-iquote/-idirafter/-include/-imacros,<arg>
#              and -Wp,-MD/-MMD,<file>, -Wp,-MF/-MT/-MQ,<arg>, -Wp,-MP (as the options without the -Wp,)
#              gcc backend: -O0 -O1 -O2 -O3 -Os -Og (-O2 when none is given) and -g, -g0..-g3, -ggdb, -gdwarf-N
#              gcc backend: -march=* and the ISA options -msse*, -mavx*, -mfma, -mbmi*, -mpopcnt, -mlzcnt, -mf16c,
#              -mcx16, -mmmx, -mrdrnd, -mrdseed, given to the C compile (qbe: ignored)
#              gcc backend: --param name=value and --param=name=value (optimiser tuning), given to the C compile (qbe: ignored)
#              gcc backend: -fno-jump-tables, and -fno-crossjumping when the host gcc is GNU gcc, given to the C compile (qbe: ignored)
#   ignored:   -O* and -g* on the qbe backend (cproc/QBE has no optimisation levels and writes no debug info);
#              -W* (except -Wp, -Wa) -w -pipe -v -m64 -mtune/-m<feature> (but see below), and the -f options in
#              the allow list below (-fPIC ... -fwrapv -fno-strict-aliasing, which this pipeline implies)
#   rejected with an error: -m32, -fsanitize*, -fopenmp, -fprofile*, --coverage, -ffast-math, -Ofast,
#              -funsigned-char, -fshort-enums, -ftrapv and other -f options that change semantics, C++ (-x c++,
#              -std=c++*, .cpp: use nfcxx), other -Wp,* options, unreadable @files, dependency options on a
#              compile-and-link command, and any option not listed here.
# Nothing that changes meaning is dropped silently.
set -euo pipefail
shopt -s extglob
root=$(cd "$(dirname "$0")" && pwd)
host=${NFCC_HOST_CC:-cc}
# The default backend: Path B when this checkout has the Path B harness and QBE, on x86-64 Linux, and then a unit Path B cannot
# take (an option it cannot honour, a construct it refuses) is made by gcc (NFCXX_PATHB_FALLBACK=gcc unless the environment sets it).
# Anywhere else, or without the harness, it is the qbe backend (cproc), as before. NFCXX_BACKEND=qbe|gcc|pathb chooses one.
if [ -n "${NFCXX_BACKEND:-}" ]; then backend=$NFCXX_BACKEND
elif [ "$(uname -s)" = Linux ] && [ "$(uname -m)" = x86_64 ] && [ -x "${PATHB_CPFE:-$root/build/pathb/cmake/bin/cpfe}" ] &&
     [ -x "$root/build/qbe/qbe" ] && [ -x "$root/scripts/pathb-cc" ]; then
  backend=pathb; export NFCXX_PATHB_FALLBACK=${NFCXX_PATHB_FALLBACK:-gcc}
else backend=qbe; fi
version=0.1

die() { echo "nfcc: error: $*" >&2; exit 1; }

case $backend in
  qbe) [ -x "$root/build/qbe/qbe" ] && [ -x "$root/build/cproc/cproc-qbe" ] ||
         die "QBE not built; run scripts/setup-qbe.sh"
       qcc=$root/scripts/qbe-cc ;;
  cil) [ -x "$root/build/cil/ilasm" ] || die "CIL backend not set up; run scripts/setup-cil.sh"
       qcc=$root/scripts/cil-cc ;;
  pathb) [ -x "$root/scripts/pathb-cc" ] || die "Path B not available (scripts/pathb-cc)"
         [ -x "$root/build/qbe/qbe" ] || die "QBE not built; run scripts/setup-qbe.sh" ;;
  gcc) ;;
  *) die "unknown NFCXX_BACKEND '$backend' (qbe, cil, gcc or pathb)" ;;
esac

# Response files (@file), expanded in place with gcc's (libiberty buildargv) rules: arguments are separated by
# whitespace; single or double quotes group (and are removed); a backslash makes the next character literal, even
# inside quotes; @file inside a response file is expanded again. A file that cannot be read stays an "@file"
# argument (gcc does the same) and is rejected below.
expanded=()
add_arg() {   # add_arg ARG DEPTH: ARG, or the arguments in the response file it names
  local f=${1:1} text len j ch q="" have=0 cur="" parsed=() k
  if [ "${1:0:1}" != @ ] || [ ! -f "$f" ] || [ ! -r "$f" ]; then expanded+=("$1"); return; fi
  [ "$2" -lt 32 ] || die "response files nested too deeply (a loop?): $f"
  text=$(cat -- "$f"; echo x); text=${text%x}; len=${#text}
  for ((j = 0; j < len; j++)); do
    ch=${text:j:1}
    if [ "$ch" = "\\" ]; then
      j=$((j + 1)); [ $j -lt $len ] || break
      cur+=${text:j:1}; have=1
    elif [ -n "$q" ]; then
      if [ "$ch" = "$q" ]; then q=""; else cur+=$ch; fi
    else
      case $ch in
        "'"|'"') q=$ch; have=1 ;;
        ' '|$'\t'|$'\n'|$'\r'|$'\f'|$'\v') if [ $have = 1 ]; then parsed+=("$cur"); fi; cur=""; have=0 ;;
        *) cur+=$ch; have=1 ;;
      esac
    fi
  done
  if [ $have = 1 ]; then parsed+=("$cur"); fi
  for k in "${parsed[@]+"${parsed[@]}"}"; do add_arg "$k" $(($2 + 1)); done
}
for a in "$@"; do add_arg "$a" 0; done
set -- "${expanded[@]+"${expanded[@]}"}"
source "$root/scripts/bundle-wrap.sh"; bundle_wrap "$root/nfcc" "$@"   # --bundle-libs (docs/notes/bundle.md)
source "$root/scripts/cuda-driver-wrap.sh"; cuda_driver_wrap "$root/nfcc" "$@"   # --cuda-driver= (docs/notes/cuda-driver.md)
set -- ${cuda_driver_args[@]+"${cuda_driver_args[@]}"}

# Queries first: they take no input files.
if [ $# -eq 0 ]; then die "no input files"; fi
for a in "$@"; do
  case $a in
    --version)
      echo "nfcc (nfcxx C driver $version, backend $backend) $("$host" -dumpfullversion 2>/dev/null || echo 0)"
      echo "gcc-compatible driver over cproc/QBE; the host compiler is $("$host" --version | head -1)"
      exit 0 ;;
    -dumpmachine|-dumpversion|-dumpfullversion|-dumpspecs|-print-*|-V|-qversion|--help|--target-help)
      exec "$host" "$@" ;;
  esac
done
if [ $# -eq 1 ] && [ "$1" = -v ]; then exec "$host" -v; fi

# Preprocessing and dependency queries (-E, -M, -MM, -MG) go to the host preprocessor exactly as asked: it
# understands every -d*, -P, -C, -Wp,* ... option, and there is no code generation to get wrong. So does
# -fsyntax-only (a check that writes no object; rake builds use `-Wp,-v - -fsyntax-only` to learn the
# header search path): the host front end answers it.
# NFCXX_QBE_TRY (gcc backend): scripts/qbe-try runs the compile, then moves it to the qbe backend when the qbe object
# matches the gcc one (docs/notes/linux-kernel.md)
if [ -n "${NFCXX_QBE_TRY:-}" ] && [ "$backend" = gcc ]; then exec "$root/scripts/qbe-try" "$@"; fi
for a in "$@"; do
  case $a in -E|-M|-MM|-MG|-fsyntax-only) exec "$host" "$@" ;; esac
done

# -f options that do not change what the program means here (or that this pipeline already implies).
fok='PIC|pic|PIE|pie|wrapv|no-strict-aliasing|strict-aliasing|no-common|common|visibility=*|no-omit-frame-pointer|omit-frame-pointer|exceptions|no-exceptions|asynchronous-unwind-tables|no-asynchronous-unwind-tables|unwind-tables|stack-protector|stack-protector-*|no-stack-protector|stack-clash-protection|function-sections|data-sections|ident|no-ident|diagnostics-color=*|color-diagnostics|no-color-diagnostics|diagnostics-show-option|message-length=*|max-errors=*|no-builtin|builtin|no-builtin-*|lto|no-lto|no-plt|plt|semantic-interposition|no-semantic-interposition|signed-char|no-delete-null-pointer-checks|no-strict-overflow|strict-overflow|trapping-math|no-trapping-math|math-errno|merge-all-constants|no-inline|inline|inline-functions|no-inline-functions|unroll-loops|tree-vectorize|no-tree-vectorize|no-tree-*|tree-*|no-gcse|gcse|ipa-*|no-ipa-*|prefetch-loop-arrays|align-functions=*|align-loops=*|align-jumps=*|reorder-blocks|no-reorder-blocks|schedule-insns|no-schedule-insns|schedule-insns2|no-schedule-insns2|keep-inline-functions|no-keep-static-consts|permissive|no-permissive|no-rtti|stack-protector-all|cf-protection=*|cf-protection|no-cf-protection|no-fat-lto-objects|fat-lto-objects|use-linker-plugin|no-use-linker-plugin|lto-partition=*|file-prefix-map=*|debug-prefix-map=*|macro-prefix-map=*|dwarf2-cfi-asm|no-dwarf2-cfi-asm|var-tracking|no-var-tracking|var-tracking-assignments|no-var-tracking-assignments|no-eliminate-unused-debug-types|eliminate-unused-debug-types|record-gcc-switches|no-record-gcc-switches|verbose-asm|no-verbose-asm|stack-usage|no-stack-usage'

mode=link out="" lang="" depmode="" dfile="" nodep=0 sawout=0
pp=()        # preprocessor options (-D -I -std ...), given to cc -E / cc -M and to the C compiler
ld=()        # link options, in order
inputs=()    # "kind:path": c, o (object/archive/other linker input), s (assembly)
picf=()
pathb_pie=0   # -fPIE: with -mno-sse (the kernel's boot decompressor) the compile is gcc's, see pathb_reason
pathb_pic=0   # -fPIC or -shared: Path B reads the address of a preemptible symbol through the GOT (scripts/pathb-cc --pic)
dts=()       # -MT / -MQ pairs
dp=0
asm=0        # -S
spon=0 spguard=()   # a stack protector is in effect (last of -fstack-protector*, -fno-stack-protector); the -mstack-protector-guard* options
asf=()       # -Wa,* (assembler options)
optlvl=-O2      # gcc backend: last -O option (-O2 when none)
dbg=()       # gcc backend: -g options, in order
gnu_gcc=
host_is_gnu_gcc() {  # whether the gcc backend's host compiler is GNU gcc (on macOS "gcc" is Apple clang); asked once, when first needed
  if [ -z "$gnu_gcc" ]; then gcc --version 2>&1 | grep -q 'Free Software Foundation' && gnu_gcc=1 || gnu_gcc=0; fi
  [ "$gnu_gcc" = 1 ]
}
isa=()       # gcc backend: -march and the ISA -m options (-msse*, -mavx*, ...), given to the C compile
# NFCXX_GCC_PASSTHROUGH=1 with the gcc backend: the options QBE cannot honour but gcc can (codegen -m options,
# -ffreestanding, -funsigned-char, -fno-PIE, --param ...) go to gcc unchanged, in command-line order, instead of being
# refused; every -f option goes to gcc, the harmless ones too. Without it both backends refuse the same options, so a
# program that builds on one builds on the other. The Linux kernel's build needs it (-mcmodel=kernel, -mno-red-zone,
# -mno-sse, ...): docs/notes/linux-kernel.md.
gccf=()
# NFCXX_QBE_KERNEL=1 with the qbe backend: the Linux kernel's options that the qbe path honours are accepted and given
# to qbe-cc (kqf), the rest are still refused. Honoured by cproc: -funsigned-char, -fshort-wchar,
# -ftrivial-auto-var-init=zero; by construction (QBE has no stack protector, jump tables, red-zone use, null-check or
# overflow assumptions, and writes PIC code that a non-PIE link takes): the rest of the list. -mno-sse and the other
# no-floating-point options are checked: qbe-cc refuses a translation unit whose QBE code touches SSE or x87 registers.
# docs/notes/linux-kernel.md.
kqf=()
qbekernel() {
  [ "$backend" = qbe ] && [ -n "${NFCXX_QBE_KERNEL:-}" ] || return 1
  case $1 in
    -funsigned-char|-fshort-wchar|-ftrivial-auto-var-init=zero|-ffreestanding|-fno-PIE|-fno-pie|-fno-PIC|-fno-pic|\
    -fno-stack-protector|-fno-jump-tables|-fno-delete-null-pointer-checks|-fno-strict-overflow|-fno-strict-aliasing|-fwrapv|\
    -fcf-protection=none|-fno-asynchronous-unwind-tables|-fconserve-stack|-fno-common|-falign-functions=*|-falign-jumps=*|\
    -falign-loops=*|-falign-labels=*|-fno-stack-check|-fno-stack-clash-protection|-fno-allow-store-data-races|\
    -fno-optimize-sibling-calls|-foptimize-sibling-calls|-fno-function-sections|-fno-data-sections|-fstrict-flex-arrays=*|-fomit-frame-pointer|-fno-omit-frame-pointer|-fmacro-prefix-map=*|\
    -m64|-mcmodel=kernel|-mno-red-zone|-mtune=*|-mpreferred-stack-boundary=3|-mskip-rax-setup|-mno-sse|-mno-sse2|-mno-mmx|\
    -mno-3dnow|-mno-avx|-mno-80387|-mno-fp-ret-in-387|-msoft-float|\
    -m16|-march=i386|-mregparm=3|-mpreferred-stack-boundary=2) kqf+=("$1") ;;
    *) return 1 ;;
  esac
}
# gcconly OPT: an option that changes meaning or code generation in a way QBE cannot honour. gcc backend with NFCXX_GCC_PASSTHROUGH:
# given to gcc. Path B: kept for the compile that falls back to gcc (needgcc: that compile goes to gcc, see pathb_reason). Otherwise
# refused by the caller. gccplain OPT: an option with no effect on QBE's output (nothing the program means or QBE can honour is lost
# by dropping it) that gcc still wants, given to gcc by the passthrough mode and kept for Path B's gcc fallback.
needgcc=()
gcconly() {
  if [ "$backend" = pathb ]; then gccf+=("$1"); needgcc+=("$1"); return 0; fi
  [ "$backend" = gcc ] && [ -n "${NFCXX_GCC_PASSTHROUGH:-}" ] || return 1; gccf+=("$1")
}
gccplain() { { [ "$backend" = pathb ] || { [ "$backend" = gcc ] && [ -n "${NFCXX_GCC_PASSTHROUGH:-}" ]; }; } || return 1; gccf+=("$1"); }
# NFCXX_BACKEND=pathb: the kernel's option set (docs/notes/nfcc-pathb.md, docs/notes/linux-kernel.md). The options Path B honours go to
# scripts/pathb-cc (pbf: -funsigned-char, -fshort-wchar, -ffreestanding, -ftrivial-auto-var-init=zero, -mno-sse's check, -fno-asynchronous-unwind-tables) or to the
# front end (-nostdinc, -isystem, -idirafter: pathb_reason); the ones with no effect on QBE's code are dropped (-mno-red-zone, ...);
# any other option that changes meaning sends that compile to gcc (needgcc), with every -f and -m option given in command-line order.
pbf=() nofp=0 nounwind=0 wchar16=0
# The real-mode boot code's options (-m16 -march=i386 -mregparm=3 -mpreferred-stack-boundary=2): Path B's 32-bit x86 target (scripts/pathb-cc --i386
# --regparm=3 --m16: ILP32, QBE's i386_regparm3, a 32-bit object with .code16gcc code), decided in pathb_reason when the whole command line is known.
# -mregparm=3 without -m16 is not honoured (a 32-bit hosted compile is gcc's); -march=i386 and -mpreferred-stack-boundary=2 change nothing
# on QBE's i386 code (it uses 386 instructions only and keeps 4-byte stack alignment). All of them are kept for a gcc compile (gccf).
pb_m16=0 pb_regparm=0
pathb_option() {   # 0: handled here
  case $1 in
    -m16) pb_m16=1 ;;
    -mregparm=3) pb_regparm=1 ;;
    -funsigned-char|-fno-signed-char|-fsigned-char|-fno-unsigned-char|-ffreestanding) pbf+=("$1") ;;
    -ftrivial-auto-var-init=zero|-ftrivial-auto-var-init=uninitialized) pbf+=("$1") ;;   # =pattern is gcc's (needgcc)
    -fshort-wchar) pbf+=("$1"); wchar16=1 ;;
    -mno-sse|-mno-sse2|-mno-80387|-msoft-float) pbf+=(--no-fp); nofp=1 ;;
    -fno-asynchronous-unwind-tables) pbf+=(--no-unwind); nounwind=1 ;;
    -fno-PIE|-fno-pie|-fno-PIC|-fno-pic) pbf+=(--no-pie) ;;   # no GOT-like cells for function addresses (a -fPIC given too wins)
    -fno-stack-check|-fno-stack-clash-protection|-fno-allow-store-data-races|\
    -fno-optimize-sibling-calls|-foptimize-sibling-calls|-fno-function-sections|-fno-data-sections|-fstrict-flex-arrays=*|\
    -fconserve-stack|-falign-labels=*|-mno-mmx|-mno-3dnow|-mno-avx|-mno-avx2|-mno-avx512*|-mno-ssse3|-mno-sse3|-mno-sse4*|\
    -mno-fma|-mno-bmi*|-mno-popcnt|-mno-fp-ret-in-387|-mskip-rax-setup|-mno-red-zone|-mred-zone) ;;
    *) return 1 ;;
  esac
  gccf+=("$1")
}
# -Wp,a,b,c: preprocessor options. The ones with a plain meaning are mapped to the option itself; anything else
# would be dropped silently, so it is an error.
# The same option parsed by the sealed scripts/driver-options.rb (build/driver-options, made by tests/bc2cpp/run_driver_options.sh):
# its output lines set the same variables. Used when that file exists; the bash below is the fallback.
wp_option_sealed() {
  local out line rest
  out=$("$root/build/driver-options" "$1") || exit 1
  while IFS= read -r line; do
    case $line in
      "pp "*) pp+=("${line#pp }") ;;
      "depmode "*) depmode=${line#depmode } ;;
      "dfile "*) dfile=${line#dfile } ;;
      "dt "*) rest=${line#dt }; dts+=("${rest%% *}" "${rest#* }") ;;
      "dp 1") dp=1 ;;
    esac
  done <<<"$out"
}
wp_option() {
  if [ -x "$root/build/driver-options" ]; then wp_option_sealed "$1"; return; fi
  local w j x
  IFS=, read -ra w <<<"${1#-Wp,}"
  for ((j = 0; j < ${#w[@]}; j++)); do
    x=${w[j]}
    case $x in
      -D?*|-U?*|-I?*) pp+=("$x") ;;
      -isystem|-iquote|-idirafter|-include|-imacros)
        [ $((j + 1)) -lt ${#w[@]} ] || die "$1: '$x' needs an argument"; pp+=("$x" "${w[++j]}") ;;
      -MD|-MMD) [ $((j + 1)) -lt ${#w[@]} ] || die "$1: '$x' needs a file name"; depmode=$x; dfile=${w[++j]} ;;
      -MF) [ $((j + 1)) -lt ${#w[@]} ] || die "$1: '-MF' needs a file name"; dfile=${w[++j]} ;;
      -MT|-MQ) [ $((j + 1)) -lt ${#w[@]} ] || die "$1: '$x' needs a target"; dts+=("$x" "${w[++j]}") ;;
      -MP) dp=1 ;;
      *) die "$1: the preprocessor option '$x' is not supported (only -D -U -I -isystem -iquote -idirafter -include -imacros -MD -MMD -MF -MT -MQ -MP)" ;;
    esac
  done
}
args=("$@")
n=${#args[@]}
need() { [ $((i + 1)) -lt $n ] || die "option '${args[i]}' requires an argument"; }
for ((i = 0; i < n; i++)); do
  a=${args[i]}
  qbekernel "$a" && continue
  [ "$backend" != pathb ] || ! pathb_option "$a" || continue
  case $a in
    -c) mode=compile ;;
    -S) asm=1 ;;
    -o) need; out=${args[++i]}; sawout=1 ;;
    -o?*) out=${a#-o}; sawout=1 ;;
    -x) need; lang=${args[++i]}
        case $lang in c|none|assembler|assembler-with-cpp) ;;
          *) die "-x $lang is not supported (C only; use nfcxx for C++)" ;; esac ;;
    -x?*) lang=${a#-x}
        case $lang in c|none|assembler|assembler-with-cpp) ;;
          *) die "-x $lang is not supported (C only; use nfcxx for C++)" ;; esac ;;
    -MD|-MMD) depmode=$a ;;
    -MF) need; dfile=${args[++i]} ;;
    -MF?*) dfile=${a#-MF} ;;
    -MT|-MQ) need; dts+=("$a" "${args[++i]}") ;;
    -MT?*|-MQ?*) dts+=("${a:0:3}" "${a:3}") ;;
    -MP) dp=1 ;;
    -D|-U|-I|-isystem|-iquote|-idirafter|-include|-imacros) need; pp+=("$a" "${args[++i]}") ;;
    -D?*|-U?*|-I?*|-isystem?*|-iquote?*|-idirafter?*|-include?*|-imacros?*) pp+=("$a") ;;
    -std=c++*|-std=gnu++*) die "$a: C++ is not supported by nfcc (use nfcxx)" ;;
    -std=*|-ansi) pp+=("$a") ;;
    -nostdinc|-undef|--sysroot=*) pp+=("$a"); ld+=("$a") ;;
    -l|-L) need; ld+=("$a" "${args[++i]}") ;;
    -l?*|-L?*) ld+=("$a") ;;
    -Xlinker|-z|-u|-T) need; ld+=("$a" "${args[++i]}") ;;
    -shared) pathb_pic=1; ld+=("$a") ;;
    -Wl,*|-static|-rdynamic|-pie|-no-pie|-s|-nostdlib|-nostartfiles|-nodefaultlibs|-static-libgcc|-shared-libgcc|-pthread|-fuse-ld=*|-Bstatic|-Bdynamic|-symbolic|-r) ld+=("$a") ;;
    -Wp,*) wp_option "$a" ;;
    -Wa,*) asf+=("$a") ;;
    -w|-W*) ;;
    -Ofast) die "$a is not supported (changes floating-point semantics)" ;;
    -O|-O0|-O1|-O2|-O3|-Os|-Og) optlvl=$a; [ "$a" != -O ] || optlvl=-O1 ;;
    -O?*) die "unknown optimisation option '$a'" ;;
    -g|-g?*) dbg+=("$a") ;;   # gcc validates the rest; QBE writes no debug info
    -pipe|-v|-time) ;;
    # QBE output is already PIC (GOT-relative); gcc needs the flag, in command-line order with the other codegen options
    # (gcc takes the last of -fno-PIE ... -fPIC, as the kernel's vDSO build relies on)
    # -fstack-protector*: noted for -mstack-protector-guard-* (below); the option itself goes where it did (gcc: given; Path B: ignored)
    -fstack-protector|-fstack-protector-strong|-fstack-protector-all|-fstack-protector-explicit) spon=1; gccplain "$a" || : ;;
    -fno-stack-protector) spon=0; gccplain "$a" || : ;;
    # the guard options only say where the canary lives: with no stack protector in effect (the last of -fstack-protector* and
    # -fno-stack-protector decides) they change nothing; with one, Path B has none to place, so that compile is gcc's. Decided after the loop.
    -mstack-protector-guard*) spguard+=("$a") ;;
    # -mindirect-branch=thunk* (retpolines), -mfunction-return=thunk* and -mharden-sls=* other than none change the code; QBE has no
    # such thunks, so those are gcc's. =keep / =none ask for the plain code, which is what QBE writes.
    -mindirect-branch=keep|-mfunction-return=keep|-mharden-sls=none|-mbranch-protection=none) gccplain "$a" || : ;;
    -mindirect-branch=*|-mfunction-return=*|-mharden-sls=*|-mbranch-protection=*) gcconly "$a" || die "$a is not supported" ;;
    -fPIC|-fpic) pathb_pic=1; ld+=("$a"); gccplain "$a" || picf+=("$a") ;;
    -fPIE|-fpie) pathb_pie=1; ld+=("$a"); gccplain "$a" || picf+=("$a") ;;
    -m32|-mx32|-m16|-miamcu) gcconly "$a" || die "$a is not supported (x86-64 only)" ;;   # gcc: the kernel's real-mode boot code
    # ISA options enable instructions, and intrinsics headers need them on the compile of the code that calls them
    # (gcc: "target specific option mismatch"): the gcc backend gets them; QBE cannot use them, so it ignores them.
    -march=*|-msse*|-mavx*|-mfma|-mbmi*|-mpopcnt|-mlzcnt|-mf16c|-mcx16|-mmmx|-mrdrnd|-mrdseed) gccplain "$a" || isa+=("$a") ;;
    # --param name=value: gcc's inlining and optimisation tuning knobs (ASTro's code store passes early-inlining-insns). They
    # change no meaning, only how hard gcc optimises, so the gcc backend gets them and QBE, which has no such knobs, ignores them.
    --param=*) isa+=("$a") ;;
    # -fno-jump-tables and -fno-crossjumping (ASTro's code store passes both) only steer gcc's code generation: gcc gets them;
    # QBE makes no jump tables and does no cross jumping.
    # -fno-crossjumping is GNU gcc only (clang stops with "unknown argument"), so it goes to the host compiler only when that is gcc.
    -fno-jump-tables) isa+=("$a") ;;
    -fno-crossjumping) host_is_gnu_gcc && isa+=("$a") ;;
    --param) need; isa+=("$a" "${args[++i]}") ;;
    -m64|-mtune=*|-mcpu=*|-mfpmath=*|-mcmodel=*|-mstackrealign|-mpreferred-stack-boundary=*|-mtls-dialect=*|-mrelax*|-masm=*|-mno-red-zone|-mred-zone) gccplain "$a" || : ;;
    -m*) gcconly "$a" || die "$a is not supported" ;;
    -fno-strict-aliasing|-fwrapv|-fno-strict-overflow) gccplain "$a" || : ;;
    -fopenmp*|-fsanitize*|-fprofile*|-fcoverage*|--coverage|-ftest-coverage|-fstack-check|-fmudflap) die "$a is not supported (instrumentation would be dropped)" ;;
    -ffast-math|-Ofast|-ffinite-math-only|-funsafe-math-optimizations|-fassociative-math|-freciprocal-math|-fno-signed-zeros|-fno-math-errno) gcconly "$a" || die "$a is not supported (changes floating-point semantics)" ;;
    -funsigned-char|-fshort-enums|-fpack-struct*|-ftrapv|-fgnu89-inline|-fms-extensions|-fplan9-extensions|-fno-signed-char|-fshort-wchar|-fshort-double|-fno-short-double|-fleading-underscore|-fno-leading-underscore|-fnon-call-exceptions|-fcheck-pointer-bounds|-fsigned-bitfields|-funsigned-bitfields|-fno-asm|-fno-gnu-keywords|-ffreestanding|-fhosted|-fopenacc*|-fgnu-tm|-fcilkplus|-fsplit-stack|-fgnu-unique|-fno-gnu-unique|-fstack-reuse=*|-fno-zero-initialized-in-bss|-fgraphite*|-fsel-sched*|-fcall-used-*|-fcall-saved-*|-ffixed-*|-finstrument-functions*|-fwhole-program|-fplugin*|-fdump-*|-fchecking*)
        gcconly "$a" || die "$a is not supported (it changes semantics or code generation that this pipeline cannot honour)" ;;
    -f*)
        # With NFCXX_GCC_PASSTHROUGH every -f option goes to gcc, the harmless ones too: gcc's own defaults (a
        # distribution's -fstack-protector-strong, -fPIE, -fcf-protection) would otherwise stand where the build turned
        # them off.
        if [[ ${a#-f} == @($fok) ]]; then gccplain "$a" || :; else gcconly "$a" || die "$a is not supported (not in nfcc's list of harmless -f options)"; fi ;;
    @*) die "response files ($a) are not supported" ;;
    -) inputs+=("c:-") ;;
    --param=*) gcconly "$a" || die "$a is not supported" ;;
    --param) need; gcconly "$a" && gccf+=("${args[++i]}") || die "$a is not supported" ;;
    -*) die "unsupported option '$a'" ;;
    *.c|*.i)
        case $lang in assembler|assembler-with-cpp) inputs+=("s:$a") ;; *) inputs+=("c:$a") ;; esac ;;
    *.s|*.S) inputs+=("s:$a") ;;
    *.cc|*.cpp|*.cxx|*.C|*.c++|*.ii|*.m|*.mm|*.f|*.f90|*.F|*.go|*.d|*.rs)
        [ "$lang" = c ] && inputs+=("c:$a") || die "$a: not a C source (use nfcxx for C++)" ;;
    *)  if [ "$lang" = c ]; then inputs+=("c:$a")
        elif [ "$lang" = assembler ] || [ "$lang" = assembler-with-cpp ]; then inputs+=("s:$a")
        else inputs+=("o:$a"); fi ;;
  esac
done

for a in "${spguard[@]+"${spguard[@]}"}"; do
  if [ $spon = 1 ]; then gcconly "$a" || die "$a is not supported"; else gccplain "$a" || :; fi
done
[ ${#inputs[@]} -gt 0 ] || die "no input files"
[ $asm = 0 ] || mode=compile   # -S stops after code generation, with or without -c
if [ "$mode" = compile ]; then
  [ "$sawout" = 0 ] || [ ${#inputs[@]} -le 1 ] || die "cannot specify -o with -c and multiple files"
fi
if [ -n "$depmode" ] && [ "$mode" != compile ]; then
  die "$depmode needs -c (dependency files for a compile-and-link command are not supported)"
fi
if [ -n "$dfile" ] && [ -z "$depmode" ]; then die "-MF needs -MD or -MMD with -c (or -M/-MM for -E)"; fi

tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
k=0

# Path B (NFCXX_BACKEND=pathb): scripts/pathb-cc takes -I -D -U -include, a C standard, -nostdinc, -isystem, -idirafter, -funsigned-char,
# -fshort-wchar, -ffreestanding, -m16 (with -mregparm=3: the 32-bit x86 target), and (--no-fp, --no-unwind) -mno-sse and -fno-asynchronous-unwind-tables. A compile with an option that
# changes meaning and that Path B cannot honour (-m32, -fshort-enums, -ftrivial-auto-var-init=pattern, -iquote, -Wa,*, ...) is made by gcc with
# the options as given (pb_reason says why); it is not dropped and not an error. NFCXX_PATHB_LOG=FILE appends one line per compile:
# "pathb SOURCE" or "gcc SOURCE: reason". NFCXX_PATHB_FALLBACK=gcc also moves a compile that scripts/pathb-cc refuses (inline asm it
# cannot emit, a unit with SSE code under -mno-sse) to gcc, as the nfcxx driver does; without it that compile fails.
pb_opts=() pb_std=-std=c11 pb_reason=
pathb_reason() {   # pathb_reason CSRC [-iquote DIR]: pb_reason empty, and pb_opts, pb_std set, when Path B can compile CSRC
  local csrc=$1 o k2=0 w
  shift
  pb_reason=; pb_opts=(); pb_std=-std=c11; pb_gnu=1
  if [ ${#needgcc[@]} -gt 0 ]; then pb_reason="${needgcc[*]}: not honoured by Path B"; return; fi
  # -fPIE in a freestanding unit (-mno-sse: the kernel's boot decompressor, which relocates itself and links with no run-time
  # relocations allowed): Path B's pointer cells and tables are absolute relocations, so that compile is gcc's.
  if [ $pathb_pie = 1 ] && [ $nofp = 1 ]; then pb_reason="-fPIE with -mno-sse: Path B's data is absolute relocations a position-independent boot image cannot carry"; return; fi
  if [ $pb_regparm = 1 ] && [ $pb_m16 = 0 ]; then pb_reason="-mregparm=3 without -m16: not honoured by Path B"; return; fi
  if [ $pb_m16 = 1 ]; then
    # freestanding: pathb-cc gives the front end --target=linux_i686 --freestanding. No inlining: the real-mode image is size limited (the kernel builds it -Os), and
    # the inliner grows the code (a third more on the boot code)
    pb_opts+=(--i386 --m16 --ir-opt=none); [ $pb_regparm = 0 ] || pb_opts+=(--regparm=3)
  fi
  # -Wa,*: options of the assembler step, which is the host cc assembling QBE's output (scripts/pathb-cc --as-opt). The ones the
  # assembler takes the same for QBE's assembly are given to that step; any other (--32, --defsym, -march=, ...) could change the
  # object's meaning, so that compile is gcc's.
  for o in "${asf[@]+"${asf[@]}"}"; do
    IFS=, read -ra w <<<"${o#-Wa,}"
    for x in "${w[@]}"; do
      case $x in
        --fatal-warnings|--noexecstack|-W|--no-warn|-mrelax-relocations=yes|-mrelax-relocations=no|-mx86-used-note=yes|-mx86-used-note=no) pb_opts+=("--as-opt=$x") ;;
        *) pb_reason="$o: assembler option Path B does not pass on"; return ;;
      esac
    done
  done
  while [ $k2 -lt ${#pp[@]} ]; do
    o=${pp[k2]}
    case $o in
      -D|-U|-I|-include|-isystem|-idirafter) pb_opts+=("$o" "${pp[k2 + 1]}"); k2=$((k2 + 1)) ;;
      -D?*|-U?*|-I?*|-isystem?*|-idirafter?*|-nostdinc) pb_opts+=("$o") ;;
      -include?*) pb_opts+=(-include "${o#-include}") ;;
      -std=c89|-std=c99|-std=c11|-std=c17|-std=c18|-std=c23) pb_std=$o; pb_gnu=0 ;;
      -std=gnu89|-std=gnu99|-std=gnu11|-std=gnu17|-std=gnu18|-std=gnu23) pb_std=-std=c${o#-std=gnu} ;;   # EDG's gcc mode takes the GNU extensions in every C standard
      -ansi|-std=c90|-std=iso9899:1990) pb_std=-std=c89; pb_gnu=0 ;;
      -std=iso9899:2011) pb_std=-std=c11; pb_gnu=0 ;;
      *) pb_reason="$o: not honoured by Path B"; return ;;
    esac
    k2=$((k2 + 1))
  done
  while [ $# -gt 0 ]; do pb_opts+=(-I "$2"); shift 2; done   # -iquote DIR of a non-.c source: its directory, as -I
  # EDG's gcc mode defines __STRICT_ANSI__ in every C standard, which makes glibc hide POSIX (struct stat's st_atim, ...). gcc's
  # gnu modes (the default, -std=gnu99, ...) do not, and glibc then turns on _DEFAULT_SOURCE: do the same.
  [ $pb_gnu = 0 ] || pb_opts=(-D_DEFAULT_SOURCE "${pb_opts[@]+"${pb_opts[@]}"}")
  [ $pathb_pic = 0 ] || pb_opts+=(--pic)   # -fPIC: the object goes into a shared object (scripts/pathb-ssa-qbe.rb, Qbe.pic)
  if [ $wchar16 = 1 ]; then
    # -fshort-wchar: the headers' wchar_t is unsigned short (pathb-dump), but EDG types a wide literal as the target's int, so a unit that
    # has one goes to gcc. The host preprocessor (same options) shows the literals of the headers and macros too.
    w=$tmp/wide$k.i
    "$host" -E -P "${gccf[@]+"${gccf[@]}"}" "${pp[@]+"${pp[@]}"}" "$@" -x c "$csrc" > "$w" 2>/dev/null || { pb_reason="-fshort-wchar: preprocessing failed"; return; }
    if grep -Eq "(^|[^A-Za-z0-9_\"'])L[\"']" "$w"; then pb_reason="-fshort-wchar: a wide character or string literal"; return; fi
  fi
}
# pathb_compile -c|-S SOURCE OUTPUT: pb_opts and pb_std as pathb_reason set them
pathb_compile() {
  local what=$1 csrc=$2 obj=$3 keep rc=0
  if [ "$what" = -S ]; then
    keep=$tmp/keep$k
    PATHB_KEEP=$keep "$root/scripts/pathb-cc" "$pb_std" "${pbf[@]+"${pbf[@]}"}" "${pb_opts[@]+"${pb_opts[@]}"}" "$csrc" -o "$tmp/pb$k.o" || rc=$?
    if [ $rc = 0 ]; then
      if [ "$obj" = - ]; then cat "$keep/$(basename "${csrc%.*}").s"; else cp "$keep/$(basename "${csrc%.*}").s" "$obj"; fi   # -S -o -: stdout, as gcc
    fi
  else
    "$root/scripts/pathb-cc" "$pb_std" "${pbf[@]+"${pbf[@]}"}" "${pb_opts[@]+"${pb_opts[@]}"}" "$csrc" -o "$obj" || rc=$?
  fi
  return $rc
}
pathb_log() { [ -z "${NFCXX_PATHB_LOG:-}" ] || echo "$1" >> "$NFCXX_PATHB_LOG"; }

# compile_one KIND SOURCE OBJECT
compile_one() {
  local kind=$1 src=$2 obj=$3 base
  base=$(basename "$src"); base=${base%.*}
  if [ "$kind" = s ]; then
    # -x assembler / assembler-with-cpp is kept: without it a source with another suffix (the kernel's
    # "-x assembler-with-cpp /dev/null" probe) would be taken for a linker input.
    local xl=(); case $lang in assembler|assembler-with-cpp) xl=(-x "$lang") ;; esac
    # -MD/-MMD on assembly: the host compiler writes the dependency file itself (kbuild's fixdep reads it)
    local dep=()
    if [ -n "$depmode" ] && [ $asm = 0 ]; then
      local df=$dfile tg=("${dts[@]+"${dts[@]}"}")
      [ -n "$df" ] || { if [ "$sawout" = 1 ]; then df=${obj%.*}.d; else df=$base.d; fi; }
      dep=("$depmode" -MF "$df" "${tg[@]+"${tg[@]}"}"); [ $dp = 0 ] || dep+=(-MP)
    fi
    if [ $asm = 1 ]; then   # -S on assembly: only .S (assembler-with-cpp) has anything to do, the preprocessing
      [[ $src == *.S ]] || [ "$lang" = assembler-with-cpp ] || die "-S: $src is assembly already"
      "$host" -S "${gccf[@]+"${gccf[@]}"}" "${pp[@]+"${pp[@]}"}" "${xl[@]+"${xl[@]}"}" "$src" -o "$obj"; return
    fi
    "$host" -c "${gccf[@]+"${gccf[@]}"}" "${dep[@]+"${dep[@]}"}" "${pp[@]+"${pp[@]}"}" "${asf[@]+"${asf[@]}"}" "${xl[@]+"${xl[@]}"}" "$src" -o "$obj"; return
  fi
  local csrc=$src extra=()
  if [ "$src" = - ]; then
    csrc=$tmp/stdin$k.c; cat > "$csrc"
  elif [[ $src != *.c ]]; then
    csrc=$tmp/src$k.c; ln -s "$(realpath "$src")" "$csrc"
    extra=(-iquote "$(dirname "$src")")
  fi
  k=$((k + 1))
  if [ -n "$depmode" ]; then
    local df=$dfile tg=("${dts[@]+"${dts[@]}"}") opt=-M
    [ "$depmode" = -MMD ] && opt=-MM
    if [ -z "$df" ]; then
      if [ "$sawout" = 1 ]; then df=${obj%.*}.d; else df=$base.d; fi
    fi
    [ ${#tg[@]} -gt 0 ] || tg=(-MT "$obj")
    [ "$src" = - ] || "$host" "$opt" -MF "$df" "${tg[@]}" $([ $dp = 1 ] && echo -MP) \
        "${gccf[@]+"${gccf[@]}"}" "${pp[@]+"${pp[@]}"}" "${extra[@]+"${extra[@]}"}" -x c "$csrc" ||
      die "dependency generation failed for $src"
  fi
  local what=-c; [ $asm = 0 ] || what=-S
  if [ $backend = pathb ]; then
    local rc=0
    pathb_reason "$csrc" "${extra[@]+"${extra[@]}"}"
    if [ -z "$pb_reason" ]; then
      pathb_compile "$what" "$csrc" "$obj" || rc=$?
      if [ $rc = 0 ]; then pathb_log "pathb $src"; return 0; fi
      [ "${NFCXX_PATHB_FALLBACK:-}" = gcc ] || exit $rc
      pb_reason="Path B refused it (status $rc)"
    fi
    pathb_log "gcc $src: $pb_reason"
    # gcc's own error is printed first; the nfcc line says which option sent the unit to gcc (the cc-mode checks match it)
    gcc $what "$optlvl" "${dbg[@]+"${dbg[@]}"}" -fwrapv -fno-strict-aliasing "${picf[@]+"${picf[@]}"}" "${isa[@]+"${isa[@]}"}" "${gccf[@]+"${gccf[@]}"}" "${pp[@]+"${pp[@]}"}" \
        "${asf[@]+"${asf[@]}"}" "${extra[@]+"${extra[@]}"}" -x c "$csrc" -o "$obj" || die "$src: gcc, the Path B fallback for $pb_reason, failed"
  elif [ $backend = qbe ] || [ $backend = cil ]; then
    "$qcc" --c-input $what "${kqf[@]+"${kqf[@]}"}" "${pp[@]+"${pp[@]}"}" "${asf[@]+"${asf[@]}"}" "${extra[@]+"${extra[@]}"}" "$csrc" -o "$obj"
  else
    gcc $what "$optlvl" "${dbg[@]+"${dbg[@]}"}" -fwrapv -fno-strict-aliasing "${picf[@]+"${picf[@]}"}" "${isa[@]+"${isa[@]}"}" "${gccf[@]+"${gccf[@]}"}" "${pp[@]+"${pp[@]}"}" \
        "${asf[@]+"${asf[@]}"}" "${extra[@]+"${extra[@]}"}" -x c "$csrc" -o "$obj"
  fi
}

if [ "$mode" = compile ]; then
  suffix=.o; [ $asm = 0 ] || suffix=.s
  for e in "${inputs[@]}"; do
    src=${e#?:}
    if [ "$sawout" = 1 ]; then obj=$out
    else obj=$(basename "$src"); obj=${obj%.*}$suffix; fi
    compile_one "${e%%:*}" "$src" "$obj"
  done
  exit 0
fi

# Link: compile the sources, keep the other inputs in command-line order.
objs=()
for e in "${inputs[@]}"; do
  case ${e%%:*} in
    o) objs+=("${e#?:}") ;;
    c|s) o=$tmp/obj$k.o; compile_one "${e%%:*}" "${e#?:}" "$o"; objs+=("$o") ;;
  esac
done
[ "$sawout" = 1 ] || out=a.out
if [ $backend = pathb ]; then
  # Path B objects link with EDG's runtime (libC.a), the long double helpers and libatomic, as nfcxx links them
  "$host" "${objs[@]}" "${ld[@]+"${ld[@]}"}" -o "$out" "$("$root/scripts/pathb-ldrt")" -L"${EDG_BUILD:-$root/build/edg}/lib" -lC -lstdc++ -lm -latomic
elif [ $backend = qbe ] || [ $backend = cil ]; then
  # qbe-cc's non-compile path is the link: cc plus -latomic (the sized __atomic_* calls the QBE path emits); the cil
  # backend's link is cil-link.rb (the wrapper sets NFCXX_CIL).
  "$qcc" "${objs[@]}" "${ld[@]+"${ld[@]}"}" -o "$out"
else
  gcc "${objs[@]}" "${ld[@]+"${ld[@]}"}" -o "$out"
fi
