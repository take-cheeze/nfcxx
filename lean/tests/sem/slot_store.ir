(ir-module "sum_loop.cpp" (layout (short 2) (int 4) (long 8) (long_long 8) (pointer 8) (float 4) (double 8) (long_double 16)))
(function "main"
  (ret int)
  (params)
  (slot "x" int 4 4)
  (store int $"x" (const int 41))
  (let %0 int (load int $"x"))
  (let %1 int (wadd int %0 (const int 1)))
  (return %1))
