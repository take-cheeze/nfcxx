(ir-module "copy.cpp" (layout (short 2) (int 4) (long 8) (long_long 8) (pointer 8) (float 4) (double 8) (long_double 16)))
(function "main"
  (ret int)
  (params)
  (slot "x" (array 4 int) 16 4)
  (store int $"x" (const int 1))
  (let %0 (ptr int) (offset $"x" 4))
  (store int %0 (const int 2))
  (let %1 (ptr int) (offset $"x" 8))
  (store int %1 (const int 3))
  (let %2 (ptr int) (offset $"x" 12))
  (store int %2 (const int 4))
  (copy 8 %0 $"x")
  (let %3 int (load int %0))
  (let %4 int (load int %1))
  (let %5 int (load int %2))
  (let %6 int (wmul int %3 (const int 100)))
  (let %7 int (wmul int %4 (const int 10)))
  (let %8 int (wadd int %6 %7))
  (let %9 int (wadd int %8 %5))
  (return %9))
