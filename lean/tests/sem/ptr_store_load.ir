(ir-module "ptr.cpp" (layout (short 2) (int 4) (long 8) (long_long 8) (pointer 8) (float 4) (double 8) (long_double 16)))
(function "main"
  (ret int)
  (params)
  (slot "x" int 4 4)
  (slot "p" (ptr int) 8 8)
  (store int $"x" (const int 42))
  (store (ptr int) $"p" $"x")
  (let %0 (ptr int) (load (ptr int) $"p"))
  (let %1 int (load int %0))
  (return %1))
