(ir-module "global_copy_unwritten.cpp" (layout (short 2) (int 4) (long 8) (long_long 8) (pointer 8) (float 4) (double 8) (long_double 16)))
(global "u" int 4 4 (static) (init (scalar 0 int (const int 9))))
(function "main"
  (ret int)
  (params)
  (slot "s" int 4 4)
  (copy 4 @"u" $"s")
  (let %0 int (load int @"u"))
  (return %0))
