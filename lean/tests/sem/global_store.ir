(ir-module "global_store.cpp" (layout (short 2) (int 4) (long 8) (long_long 8) (pointer 8) (float 4) (double 8) (long_double 16)))
(global "g" int 4 4 (static) (init (scalar 0 int (const int 1))))
(function "main"
  (ret int)
  (params)
  (store int @"g" (const int 40))
  (let %0 int (load int @"g"))
  (let %1 int (wadd int %0 (const int 2)))
  (return %1))
