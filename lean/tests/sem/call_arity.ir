(ir-module "call_arity.cpp" (layout (short 2) (int 4) (long 8) (long_long 8) (pointer 8) (float 4) (double 8) (long_double 16)))
(function "one"
  (ret int)
  (params (param %0 "x" int))
  (return (const int 0)))
(function "main"
  (ret int)
  (params)
  (let %0 int (call int &"one" (const int 1) (const int 2)))
  (return %0))
