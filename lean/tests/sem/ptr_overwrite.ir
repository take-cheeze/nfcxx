(ir-module "ptr.cpp" (layout (short 2) (int 4) (long 8) (long_long 8) (pointer 8) (float 4) (double 8) (long_double 16)))
(function "main"
  (ret int)
  (params)
  (slot "x" int 4 4)
  (slot "p" (ptr int) 8 8)
  (store (ptr int) $"p" $"x")
  (let %0 (ptr unsigned_char) (offset $"p" 3))
  (store unsigned_char %0 (const unsigned_char 1))
  (let %1 (ptr int) (load (ptr int) $"p"))
  (return (const int 0)))
