(ir-module "ptr.cpp" (layout (short 2) (int 4) (long 8) (long_long 8) (pointer 8) (float 4) (double 8) (long_double 16)))
(function "main"
  (ret int)
  (params)
  (slot "x" int 4 4)
  (store int $"x" (const int 16909060))
  (let %0 (ptr unsigned_char) (offset $"x" 1))
  (let %1 unsigned_char (load unsigned_char %0))
  (let %2 int (iconv int %1))
  (return %2))
