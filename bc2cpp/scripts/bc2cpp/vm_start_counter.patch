+/* VM-start counter (measurement only). Compiled in with -DBC2CPP_VM_START_COUNTER; off by default, so a normal
+   build has no counter code and no extra includes. Rows go to the file named by BC2CPP_VMCNT_OUT at exit. */
+#ifdef BC2CPP_VM_START_COUNTER
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+struct vmcnt_entry { const void *irep; int kind; long count; char *name; };
+#define VMCNT_SLOTS 65536
+static struct vmcnt_entry vmcnt_tab[VMCNT_SLOTS];
+static int vmcnt_registered;
+static const char *vmcnt_kind_name[] = {"", "C_entry", "SEND", "CALL", "BLKCALL", "EXEC"};
+static void vmcnt_dump(void) {
+  const char *path = getenv("BC2CPP_VMCNT_OUT");
+  FILE *f = path ? fopen(path, "a") : NULL;
+  if (!f) return;
+  for (int i = 0; i < VMCNT_SLOTS; i++) {
+    struct vmcnt_entry *e = &vmcnt_tab[i];
+    if (e->irep) fprintf(f, "%ld\t%s\t%s\n", e->count, vmcnt_kind_name[e->kind], e->name);
+  }
+  fclose(f);
+}
+static void vmcnt_hit(mrb_state *mrb, mrb_sym mid, struct RClass *klass, const mrb_irep *irep, int kind) {
+  if (!vmcnt_registered) {
+    vmcnt_registered = 1;
+    atexit(vmcnt_dump);
+  }
+  unsigned long h = ((unsigned long)irep >> 3) * 31u + (unsigned long)kind;
+  for (int i = 0; i < VMCNT_SLOTS; i++) {
+    struct vmcnt_entry *e = &vmcnt_tab[(h + i) % VMCNT_SLOTS];
+    if (!e->irep) {
+      char buf[512];
+      const char *cls = klass ? mrb_class_name(mrb, klass) : "(none)";
+      snprintf(buf, sizeof buf, "%s#%s", cls ? cls : "(anon)", mid ? mrb_sym_name(mrb, mid) : "(block)");
+      e->irep = irep; e->kind = kind; e->count = 0; e->name = strdup(buf);
+    }
+    if (e->irep == irep && e->kind == kind) { e->count++; return; }
+  }
+}
+#define VMCNT_HIT(mrb, mid, klass, irep, kind) vmcnt_hit(mrb, mid, klass, irep, kind)
+#else
+#define VMCNT_HIT(mrb, mid, klass, irep, kind) ((void)0)
+#endif
+
