# mruby-bc2cpp-sources: the bc2cpp source graph, compiled to bytecode and linked into this build, so that require loads
# each file by name without eval.
#
# tools/bc2cpp/bake_sources.rb --dir writes every file reachable from tools/bc2cpp/bc2cpp.rb (each with its
# require_relative and __FILE__ already resolved) under the build directory, so the sources are never copied into the
# tree. mrbc then compiles each to a bytecode array in one generated C file, with a table from the baked name to the
# array; MRubyRequire.load_baked(name) runs one array with mrb_load_irep. The build needs no mruby-eval.
BC2CPP_SOURCES_ROOT = File.expand_path('../..', __dir__)
BC2CPP_SOURCES_ENTRY = 'tools/bc2cpp/bc2cpp.rb'
# Scripts the tools load by name rather than by require_relative: baked in with the entry, so that require finds them.
BC2CPP_SOURCES_EXTRA = %w[scripts/rpg2k/closed_world_lint.rb].freeze

MRuby::Gem::Specification.new('mruby-bc2cpp-sources') do |spec|
  spec.license = 'MIT'
  spec.authors = 'take-cheeze'
  spec.summary = 'The bc2cpp source graph, compiled to bytecode for require under mruby'
  spec.add_dependency 'mruby-require'
  spec.add_dependency 'mruby-env'
  spec.add_dependency 'mruby-process'

  generator = File.join(BC2CPP_SOURCES_ROOT, 'tools/bc2cpp/bake_sources.rb')
  baked_dir = "#{build_dir}/baked"
  stamp = "#{build_dir}/bc2cpp_sources.stamp"
  inputs = Dir[File.join(BC2CPP_SOURCES_ROOT, 'tools/bc2cpp/**/*.rb')] + [generator] +
           BC2CPP_SOURCES_EXTRA.map { |f| File.join(BC2CPP_SOURCES_ROOT, f) }
  unless File.exist?(stamp) && File.mtime(stamp) >= inputs.map { |f| File.mtime(f) }.max
    FileUtils.mkdir_p(build_dir)
    ok = system(RbConfig.ruby, generator, '--dir', baked_dir, BC2CPP_SOURCES_ENTRY, stamp, *BC2CPP_SOURCES_EXTRA)
    raise 'mruby-bc2cpp-sources: tools/bc2cpp/bake_sources.rb failed' unless ok
  end

  c_src = "#{build_dir}/bc2cpp_sources.c"
  obj = objfile(c_src.ext)
  mrbc_file = build.mrbcfile
  file c_src => [stamp, mrbc_file, __FILE__] do |t|
    names = File.readlines("#{baked_dir}/index", chomp: true)
    FileUtils.mkdir_p(File.dirname(t.name))
    File.open(t.name, 'w') do |f|
      f.puts '/* Generated by host-libs/mruby-bc2cpp-sources/mrbgem.rake: the baked bc2cpp sources as bytecode. */'
      f.puts '#include <stdint.h>'
      f.puts '#include <string.h>'
      f.puts '#include <mruby.h>'
      f.puts '#include <mruby/irep.h>'
      f.puts '#include <mruby/dump.h>'
      f.puts '#include <mruby/proc.h>'
      f.puts '#include <mruby/variable.h>'
      f.puts '#include <mruby/string.h>'
      f.puts '#include <mruby/error.h>'
      names.each_with_index do |name, i|
        rel = "#{name}.rb"
        # The file name recorded in the debug info is the baked name, so a backtrace reads tools/bc2cpp/x.rb:LINE.
        out = "#{baked_dir}/#{name}.c"
        ok = system(mrbc_file, '-g', "-Bbc2cpp_src_#{i}", '-o', out, rel, chdir: baked_dir)
        raise "mruby-bc2cpp-sources: mrbc failed on #{rel}" unless ok

        f.puts File.read(out)
      end
      f.puts 'static const struct { const char *name; const uint8_t *irep; } bc2cpp_sources[] = {'
      names.each_with_index { |name, i| f.puts %(  { "#{name}", bc2cpp_src_#{i} },) }
      f.puts '  { NULL, NULL }'
      f.puts '};'
      f.puts <<~'C'

        static const uint8_t *
        find_source(mrb_state *mrb, mrb_value name)
        {
          const char *s = mrb_string_value_cstr(mrb, &name);
          for (int i = 0; bc2cpp_sources[i].name; i++) {
            if (strcmp(bc2cpp_sources[i].name, s) == 0) return bc2cpp_sources[i].irep;
          }
          return NULL;
        }

        /* MRubyRequire.baked?(name): is the source compiled into this build. */
        static mrb_value
        baked_p(mrb_state *mrb, mrb_value self)
        {
          mrb_value name;
          mrb_get_args(mrb, "S", &name);
          return mrb_bool_value(find_source(mrb, name) != NULL);
        }

        /* MRubyRequire.load_baked(name): run the source's bytecode at the top level, as eval at the top level would. */
        static mrb_value
        load_baked(mrb_state *mrb, mrb_value self)
        {
          mrb_value name;
          mrb_get_args(mrb, "S", &name);
          const uint8_t *irep = find_source(mrb, name);
          if (!irep) mrb_raise(mrb, E_ARGUMENT_ERROR, "no such baked source");
          /* Run as the top level: the target class is Object, not the module this method is called on, so the
             source's constants and methods land on Object as under eval. */
          mrb_irep *ir = mrb_read_irep(mrb, irep);
          if (!ir) mrb_raise(mrb, E_RUNTIME_ERROR, "cannot read baked source");
          struct RProc *proc = mrb_proc_new(mrb, ir);
          mrb_irep_decref(mrb, ir);
          MRB_PROC_SET_TARGET_CLASS(proc, mrb->object_class);
          mrb_top_run(mrb, proc, mrb_top_self(mrb), 0);
          if (mrb->exc) {
            mrb_value exc = mrb_obj_value(mrb->exc);
            mrb->exc = NULL;
            mrb_exc_raise(mrb, exc);
          }
          return mrb_true_value();
        }

        void
        mrb_mruby_bc2cpp_sources_gem_init(mrb_state *mrb)
        {
          struct RClass *mod = mrb_module_get(mrb, "MRubyRequire");
          mrb_define_module_function(mrb, mod, "baked?", baked_p, MRB_ARGS_REQ(1));
          mrb_define_module_function(mrb, mod, "load_baked", load_baked, MRB_ARGS_REQ(1));
        }

        void
        mrb_mruby_bc2cpp_sources_gem_final(mrb_state *mrb)
        {
          (void)mrb;
        }
      C
    end
  end
  file obj => c_src do |t|
    FileUtils.mkdir_p(File.dirname(t.name))
    cc.run t.name, c_src
  end
  spec.objs << obj
end
