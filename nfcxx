    ${sysdirs[@]+"${sysdirs[@]/#/-isystem}"} ${pp_pre[@]+${pp_pre[@]+"${pp_pre[@]}"}} ${srcs[@]+${srcs[@]+"${srcs[@]}"}} ${pp_in[@]+${pp_in[@]+"${pp_in[@]}"}} ${pp_out[@]+"${pp_out[@]}"}
fi
"${RUBY:-ruby}" "$root/scripts/nfcxx-argchecks.rb" check stdin_src="$stdin_src" xlang="$xlang" depmode="$depmode" compile_only="$compile_only" || exit $?   # the refusals (scripts/nfcxx-argchecks.rb)
if [ $ncpp -gt 0 ] || [ $emit_c = 1 ] || { [ $nobj -gt 0 ] && [ ${#cfiles[@]} = 0 ]; }; then
