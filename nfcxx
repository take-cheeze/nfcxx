# -fPIC / -rdynamic / -shared reach the C compiler and the link. EDG_OBJ_TO_EXEC_DEFAULT_OPTIONS replaces the
# options eccp gives its link command (default: the C compile options), so only -shared goes there.
picopts=(); ldopts=()
# -m options (ISA and target): the C compile gets them, and the front end gets the macros gcc predefines for them
# (gcc -mavx2 defines __AVX2__, which the intrinsic headers test). Each macro goes in files, as a -D option does, so
# eccp passes it to both the front end and the C compile. Macros with arguments are not passed.
if [ ${#isa[@]} -gt 0 ]; then
  for o in ${isa[@]+"${isa[@]}"}; do picopts+=(--c_to_obj_option "$o"); done
  while IFS= read -r d; do files+=("$d"); done < <(
    comm -13 <(gcc -dM -E -x c /dev/null | sort) <(gcc ${isa[@]+"${isa[@]}"} -dM -E -x c /dev/null | sort) \
      | sed -n 's/^#define \([^ (]*\) */-D\1=/p')
fi
[ $pic = 0 ] || { picopts=(--c_to_obj_option -fPIC); cflags_pic=(-fPIC); }
[ $rdynamic = 0 ] || picopts+=(--c_to_obj_option -rdynamic)
[ $pthread = 0 ] || picopts+=(--c_to_obj_option -pthread)
picopts+=(${pie_opts[@]+${pie_opts[@]+"${pie_opts[@]}"}})
for o in ${asan_c[@]+${asan_c[@]+"${asan_c[@]}"}}; do picopts+=(--c_to_obj_option "$o"); done
[ $shared = 0 ] || { export EDG_OBJ_TO_EXEC_DEFAULT_OPTIONS=-shared; ldopts=(-shared); }
# NFCXX_LD=NAME: the linker gcc runs, as -fuse-ld=NAME (mold, lld, gold, bfd; ld.NAME must be on PATH). The C++ link gets
# it through eccp's link options, as the -Wl options do.
if [ -n "${NFCXX_LD:-}" ]; then
  command -v "ld.$NFCXX_LD" >/dev/null || { echo "nfcxx: NFCXX_LD=$NFCXX_LD: ld.$NFCXX_LD is not on PATH" >&2; exit 2; }
  ldopts+=("-fuse-ld=$NFCXX_LD"); picopts+=(--c_to_obj_option "-fuse-ld=$NFCXX_LD")
fi

# C inputs: compile each .c to an object. Link options (-l, -L, ...) stay in files for the final link.
cobjs=()
if [ ${#cfiles[@]} -gt 0 ]; then
  ctmp=$(mktemp -d); trap 'rm -rf "$ctmp" "$cudatmp"; trace_finish' EXIT
  n=0
  for c in ${cfiles[@]+"${cfiles[@]}"}; do
    o=$ctmp/$n.o; n=$((n + 1))
    t=$(trace_start)
    if [ $backend != gcc ]; then
      NFCXX_C_INPUT=1 "$NFCXX_CC" -c ${cflags[@]+${cflags[@]+"${cflags[@]}"}} "$c" -o "$o"
    else
      gcc -c -O2 -fwrapv -fno-strict-aliasing ${asan_c[@]+${asan_c[@]+"${asan_c[@]}"}} ${cflags_pic[@]+${cflags_pic[@]+"${cflags_pic[@]}"}} ${cflags[@]+${cflags[@]+"${cflags[@]}"}} "$c" -o "$o"
    fi
    trace_end "$t" "C input: $c" cinput
    cobjs+=("$o")
  done
  if [ $compile_only = 1 ] && [ $ncpp = 0 ]; then
    # -c with only C sources: the objects are the output (-o names the one object; otherwise each is <source>.o)
    [ $outset = 0 ] || [ ${#cobjs[@]} = 1 ] || { echo "nfcxx: -c with -o needs exactly one source" >&2; exit 2; }
    for i in "${!cobjs[@]}"; do
      dst=$out; [ $outset = 1 ] || dst=$(basename "${cfiles[$i]}" .c).o
      cp "${cobjs[$i]}" "$dst"
    done
    exit 0
  fi
  if [ $ncpp = 0 ] && { [ $nobj = 0 ] || [ ! -x "$edg/eccp" ]; }; then
    # Only C: link with the C compiler (qbe-cc adds -latomic for the QBE backend).
    t=$(trace_start)
    if [ $backend != gcc ]; then "$NFCXX_CC" ${ldopts[@]+${ldopts[@]+"${ldopts[@]}"}} ${cobjs[@]+"${cobjs[@]}"} ${files[@]+${files[@]+"${files[@]}"}} -o "$out"
    else gcc ${asan_c[@]+${asan_c[@]+"${asan_c[@]}"}} ${ldopts[@]+${ldopts[@]+"${ldopts[@]}"}} ${cobjs[@]+"${cobjs[@]}"} ${files[@]+${files[@]+"${files[@]}"}} -o "$out"; fi
    trace_end "$t" "link (C only)" cinput
    exit 0
  fi
fi

# Path B: no C is generated. Each C++ file goes EDG -> typed IR -> QBE -> object (scripts/pathb-cc), and the objects are
# linked with EDG's runtime (libC.a: exceptions, operator new) before libstdc++, as tests/pathb-qbe/run.sh links them.
if [ $backend = pathb ]; then
  ptmp=$(mktemp -d); trap 'rm -rf "$ptmp" "$cudatmp"; trace_finish' EXIT
  pobjs=(); plink=(); n=0
  for f in ${files[@]+"${files[@]}"}; do
    case $f in
      -I*|-D*|-U*) ;;                       # reach pathb-cc through cflags
      -*|*.o|*.a|*.so) plink+=("$f") ;;
      *) o=$ptmp/p$n.o; n=$((n + 1))
         t=$(trace_start)
         "$root/scripts/pathb-cc" "-std=c++${std#--c++}" ${cflags[@]+${cflags[@]+"${cflags[@]}"}} "$f" -o "$o"
         trace_end "$t" "Path B: $f" pathb
         pobjs+=("$o") ;;
    esac
  done
  t=$(trace_start)
  # libnfcxxld.a: the long double helpers and nothing else (scripts/pathb-ldrt, docs/notes/pathb-longdouble.md)
  ldrt=$("$root/scripts/pathb-ldrt")
  cc ${ldopts[@]+${ldopts[@]+"${ldopts[@]}"}} -o "$out" ${cobjs[@]+${cobjs[@]+"${cobjs[@]}"}} ${pobjs[@]+"${pobjs[@]}"} ${plink[@]+${plink[@]+"${plink[@]}"}} "$ldrt" ${shim[@]+${shim[@]+"${shim[@]}"}} -L"${EDG_BUILD:-$root/build/edg}/lib" -lC -lstdc++ -lgcc_s -lpthread -lm -latomic
  trace_end "$t" "link" pathb
  exit 0
fi

# With the gcc backend the generated C relies on C's UB rules (e.g. plain signed '+'), so make the C
# compiler give those operations defined behavior. -fkeep-static-functions keeps EDG's static __tls_init
# (thread_local dynamic initialization): it is referenced only through a top-level asm alias, which gcc
# -O2 does not count as a use, so it was dropped and the wrapper's call went unresolved.
# With --trace, eccp's own C compiler steps are child processes that record their spans too (qbe-cc).
eflist=(); userinc=(); no_as_needed=0; as_needed=0
# -fkeep-static-functions is a GCC option; clang (the C compiler on macOS) rejects it.
keep_static=(--c_to_obj_option -fkeep-static-functions)
"${NFCXX_GCC:-cc}" --version 2>/dev/null | head -1 | grep -qi clang && keep_static=()
# NFCXX_EH_UNWIND=1: a throw runs the cleanups of the frames it unwinds in the system unwinder (EDG's --nfcxx_eh_unwind;
# lib_src/throw.c). gcc: the frames need unwind tables (-fexceptions) and the declarations of
# lib/ehshim/nfcxx_eh_unwind.h, which the C compiler reads first. qbe: cproc lowers the cleanups to landing pads (qbe.c,
# ehcleanupobj); the unwinder flag comes from the link (scripts/qbe-cc).
eh_unwind=()
if [ "${NFCXX_EH_UNWIND:-}" = 1 ] && [ "$backend" = gcc ]; then
  eh_unwind=(--nfcxx_eh_unwind --c_to_obj_option -fexceptions --c_to_obj_option -include --c_to_obj_option "$root/lib/ehshim/nfcxx_eh_unwind.h")
elif [ "${NFCXX_EH_UNWIND:-}" = 1 ] && [ "$backend" = qbe ]; then
  eh_unwind=(--nfcxx_eh_unwind)
fi
for f in ${files[@]+${files[@]+"${files[@]}"}}; do
  case $f in
    # User -I dirs go before the host's --sys_include dirs: eccp searches them in command-line order, and GCC
    # searches -I before the system directories, so "error.h" from a file outside EDG's src/ must not pick
    # glibc's <error.h> (ifc_modules_templ.c, docs/notes/cxx-driver.md).
    -I?*) userinc+=("$(ecp_arg "$f")") ;;
    # -lcudart from a CUDA_HOME (the toolkit's or a PyPI-wheel directory): the binary records that directory's lib64 as
    # its runpath, so it loads the same libcudart it was linked against (not whichever one the loader finds first).
    -lcudart)
      [ -n "${CUDA_HOME:-}" ] && [ -d "$CUDA_HOME/lib64" ] && eflist+=(--c_to_obj_option "-Wl,-rpath,$CUDA_HOME/lib64")
      # The device-wide CUB algorithms behind lib/cuda/host/cub/cub.cuh (scripts/cuda-cub): an archive, ahead of
      # libcudart, so only a program that calls them links them.
      if [ $compile_only = 0 ]; then
        cub_lib=$("$root/scripts/cuda-cub") || cub_lib=""
        [ -z "$cub_lib" ] || eflist+=("$cub_lib")
      fi
      eflist+=("--c_to_obj_lib=cudart") ;;
    -l?*) eflist+=("--c_to_obj_lib=${f#-l}") ;;
    # --no-as-needed keeps the libraries after it in DT_NEEDED; find_package(Torch) links libtorch_cpu, libtorch_cuda and
    # libtorch as -Wl,--no-as-needed,LIB ... -Wl,--as-needed. eccp puts its --c_to_obj_option items before every
    # input, so the option cannot be kept where it is: one --no-as-needed for the whole link stands for every such
    # span (every library is then kept, which only adds DT_NEEDED entries), and the items given with the option stay
    # inputs in place. The --as-needed that closes a span is dropped then; alone, it applies to the whole link.
    -Wl,--no-as-needed|-Wl,--no-as-needed,*)
      no_as_needed=1
      if [ "$f" != -Wl,--no-as-needed ]; then
        IFS=, read -r -a nan_items <<< "${f#-Wl,--no-as-needed,}"
        for item in ${nan_items[@]+"${nan_items[@]}"}; do
          case $item in
            -l?*) eflist+=("--c_to_obj_lib=${item#-l}") ;;
            -*) eflist+=(--c_to_obj_option "$(ecp_arg "-Wl,$item")") ;;
            *) eflist+=("$(ecp_arg "$item")") ;;
          esac
        done
      fi ;;
    -Wl,--as-needed) as_needed=1 ;;
    # eccp puts its --c_to_obj_option items before every object and archive, so a link option that acts on the
    # arguments after it would act on the wrong ones. Refused rather than moved (docs/notes/cxx-driver.md).
    -Wl,--whole-archive|-Wl,--whole-archive,*|-Wl,--no-whole-archive|-Wl,--no-whole-archive,*|\
-Wl,--start-group|-Wl,--start-group,*|-Wl,--end-group|-Wl,--end-group,*|-Wl,--as-needed,*|\
-Wl,-Bstatic|-Wl,-Bstatic,*|-Wl,-Bdynamic|-Wl,-Bdynamic,*)
      echo "nfcxx: $f: an order-dependent link option cannot be kept with C++ inputs (docs/notes/cxx-driver.md)" >&2
      exit 2 ;;
    -Wl,*) eflist+=(--c_to_obj_option "$(ecp_arg "$f")") ;;   # -Wl,-rpath,DIR, -Wl,-E, ...: the host link (eccp's C compile options)
    *) eflist+=("$(ecp_arg "$f")") ;;
  esac
done
if [ $no_as_needed = 1 ]; then eflist+=(--c_to_obj_option -Wl,--no-as-needed)
elif [ $as_needed = 1 ]; then eflist+=(--c_to_obj_option -Wl,--as-needed); fi
# -c: eccp writes the records of each source (<stem>.ti, the requests) beside its object, and the link reads them there. eccp
# adds to a .ti that exists, so the records of the sources being compiled are removed first and the compile starts clean
# (eccp keeps the old content of a .ti and writes the new record ahead of it). The first source takes the name of -o, as eccp names it.
if [ $compile_only = 1 ] && [ $ncpp -gt 0 ]; then
  first=1
  for s in ${srcs[@]+"${srcs[@]}"}; do
    b=$(basename "$s"); b=${b%.*}
    if [ $first = 1 ] && [ "$out" != "${out%.*}" ]; then b=${out%.*}; fi
    rm -f "$b.ii" "$b.ti"; first=0
  done
fi
link_records_rm() {  # link_records_rm: removes <stem>.ii beside each object of this link (see "A link writes" below)
  local f
  for f in ${files[@]+"${files[@]}"}; do
    case $f in *.o) rm -f "${f%.o}.ii" ;; esac
  done
}
# A link writes <stem>.ii beside each object it uses: the instances the link assigned to that object (the <stem>.ti requests
# stay). An assignment left by an earlier link can name an instance that a later link assigns to another object ("assigned
# to more than one file"), so these records are removed before the link and again once it succeeds (set -e: a failed link
# exits before the second removal).
link_records_rm
# Compile cache (opt-in: NFCXX_CACHE=DIR). A -c compile of one C++ source with -o is kept in DIR/objects under a key of
# everything that can change the object: the command as given, the absolute output path (the prelinker records it in the
# object's .ti), the working directory, the source and each header the host preprocessor lists (-M), the NFCXX_* environment,
# the driver and its scripts, the EDG and QBE binaries, and the host compilers. A hit copies the object back with its
# <stem>.ti and <stem>.ii, which the link reads beside it. Not cached: .cu, C and -E inputs, -MD (its dependency file), several
# sources in one command, and an -o without an extension. A file name with spaces in the header list is not handled.
cache_sha() { if command -v sha256sum >/dev/null 2>&1; then sha256sum; else shasum -a 256; fi; }
cache_log() {  # cache_log TEXT: appends TEXT as one write to NFCXX_CACHE_LOG when it is set (a diagnostic; no effect on the key).
  # Parallel compiles share the file, so each append takes a lock (mkdir, which is portable) and is a single printf.
  [ -n "${NFCXX_CACHE_LOG:-}" ] || return 0
  while ! mkdir "$NFCXX_CACHE_LOG.lock" 2>/dev/null; do sleep 0.05; done
  printf '%s\n' "$*" >> "$NFCXX_CACHE_LOG"
  rmdir "$NFCXX_CACHE_LOG.lock"
}
cache_lookup() {  # cache_lookup SRC OUT: prints the key, or fails when the headers cannot be listed. With NFCXX_CACHE_LOG
  # the whole lookup is logged in one write: the output, the key inputs, the key, and hit or miss.
  local src=$1 out=$2 deps f pre=() inputs key state
  for f in ${preinc[@]+"${preinc[@]}"}; do pre+=(-include "$f"); done
  deps=$("${NFCXX_CXX:-g++}" -M "-std=${std#--}" ${cflags[@]+"${cflags[@]}"} ${pre[@]+"${pre[@]}"} ${sysdirs[@]+"${sysdirs[@]/#/-isystem}"} "$src" 2>/dev/null) || return 1
  deps=$(sed 's/\\$//' <<<"$deps" | tr ' ' '\n' | sed '/^$/d' | tail -n +2)
  inputs=$({
    printf 'nfcxx-cache-1\nargv:'; printf ' %q' "${nfcxx_argv[@]}"; printf '\ncwd: %s\nout: %s\nsrc: %s\n' "$PWD" "$(realpath -m "$out")" "$(realpath -m "$src")"
    (env | grep '^NFCXX_' | grep -v '^NFCXX_CACHE_LOG=' || true) | LC_ALL=C sort   # the log is a diagnostic: it must not change the key
    cache_sha < "$root/nfcxx"
    find "$root/scripts" -type f -print0 | LC_ALL=C sort -z | xargs -0 cat | cache_sha
    find "$edg" -maxdepth 1 -type f -print0 | LC_ALL=C sort -z | xargs -0 cat | cache_sha
    for f in "$root/build/qbe/qbe" "$root/build/cproc/cproc"; do [ ! -f "$f" ] || cache_sha < "$f"; done
    # The EDG driver: the eccp script and environment that the wrapper (bin/eccp) runs and sources, and the configuration it reads
    for f in "$(sed -n 's/^exec "\([^"]*\)".*/\1/p' "$edg/eccp" 2>/dev/null)" "$(sed -n 's/^\. "\([^"]*\)".*/\1/p' "$edg/eccp" 2>/dev/null)" \
             "${EDG_BASE:-$root/build/edg-base}/edg_eccp_config"; do
      if [ -f "$f" ]; then cache_sha < "$f"; else echo "missing $f"; fi
    done
    "${NFCXX_CXX:-g++}" --version | head -1; cc --version | head -1
    for f in $deps; do printf '%s ' "$f"; if [ -f "$f" ]; then cache_sha < "$f"; else echo missing; fi; done
  })
  key=$(printf '%s\n' "$inputs" | cache_sha | cut -c1-40)
  state=miss; [ ! -f "$NFCXX_CACHE/objects/$key/obj" ] || state=hit
  cache_log "== $out ($src)"$'\n'"$inputs"$'\n'"key $key"$'\n'"$state"
  printf '%s\n' "$key"
}
cache_entry=""
if [ -n "${NFCXX_CACHE:-}" ] && [ $compile_only = 1 ] && [ $ncpp = 1 ] && [ $outset = 1 ] && [ $nobj = 0 ] && [ ${#cfiles[@]} = 0 ] && [ $modules = 0 ] \
   && [ ${#cu_inputs[@]} = 0 ] && [ ${#cpp2_inputs[@]} = 0 ] && [ -z "$depmode" ] && [ $preprocess = 0 ] && [ $stdin_src = 0 ] && [ "$out" != "${out%.*}" ]; then
  if key=$(cache_lookup "${srcs[0]}" "$out") && [ -n "$key" ]; then
    cache_entry=$NFCXX_CACHE/objects/$key
    if [ -f "$cache_entry/obj" ]; then
      rm -f "${out%.*}.ti" "${out%.*}.ii"
      cp "$cache_entry/obj" "$out"
      for x in ti ii; do [ ! -f "$cache_entry/$x" ] || cp "$cache_entry/$x" "${out%.*}.$x"; done
      exit 0
    fi
  fi
fi
# The one-step build: eccp runs in a temporary directory (see ecp_arg), so its paths are made absolute before the cd.
eccp_bin=$(ecp_arg "$edg/eccp"); eccp_out=$(ecp_arg "$out")
if [ $moves = 1 ]; then
  eccp_dir=$(mktemp -d); trap eccp_cleanup EXIT
  [ "${NFCXX_KEEP_INTERMEDIATES:-}" != 1 ] || echo "nfcxx: intermediates kept in $eccp_dir (NFCXX_KEEP_INTERMEDIATES=1)" >&2
fi
t=$(trace_start)
(
  [ -z "$eccp_dir" ] || cd "$eccp_dir"
  "$eccp_bin" "$std" --"$dialect" --wdir / ${extra[@]+"${extra[@]}"} ${modopts[@]+"${modopts[@]}"} ${diag_opts[@]+"${diag_opts[@]}"} ${userinc[@]+${userinc[@]+"${userinc[@]}"}} ${sys_inc[@]+"${sys_inc[@]}"} ${hosted_libs[@]+"${hosted_libs[@]}"} --c_to_obj_option -O2 --c_to_obj_option -fwrapv --c_to_obj_option -fno-strict-aliasing ${keep_static[@]+${keep_static[@]+"${keep_static[@]}"}} ${eh_unwind[@]+${eh_unwind[@]+"${eh_unwind[@]}"}} --c_to_obj_option -fgnu89-inline ${picopts[@]+${picopts[@]+"${picopts[@]}"}} \
    ${cobjs[@]+${cobjs[@]+"${cobjs[@]}"}} ${pre_opts[@]+${pre_opts[@]+"${pre_opts[@]}"}} ${cuda_opts[@]+${cuda_opts[@]+"${cuda_opts[@]}"}} ${eflist[@]+${eflist[@]+"${eflist[@]}"}} ${shim[@]+${shim[@]+"${shim[@]}"}} ${vlart[@]+${vlart[@]+"${vlart[@]}"}} ${rtlib[@]+${rtlib[@]+"${rtlib[@]}"}} -o "$eccp_out"
)
trace_end "$t" "eccp (front end, C compile, link)" eccp
link_records_rm
# Kernel instances from the host compile. The rewriter lists the kernel templates whose instances the text does not
# give (<kernels>.unresolved: a launch or address in a template the unit calls with deduced or dependent arguments,
# binbcast.cu's launch_bin_bcast_pack), and their device code is not made. The host compile made them, though: when its
# output has an instance of one of them (nm -C), the build runs again with those symbols (NFCXX_CUDA_HOST_SYMBOLS), and
# the device rewrite makes each instance's entry. A unit whose templates are instantiated by other units (fattn.cu)
# has none, and builds once. One .cu input only: the symbols of two units' static kernels could not be told apart.
if [ ${#cu_inputs[@]} = 1 ] && [ -z "${NFCXX_CUDA_HOST_SYMBOLS:-}" ] && [ $preprocess = 0 ] && [ -f "$out" ] \
   && [ -s "$cudatmp/$(basename "${cu_inputs[0]}" .cu).dev.kernels.unresolved" ]; then
  hsyms=$cudatmp/host.syms
  nm -C "$out" 2>/dev/null | sed 's/_INTERNAL_[A-Za-z0-9_]*:://g' > "$hsyms" || true
  found=0
  while IFS= read -r k; do
    [ -n "$k" ] && grep -qE "(^|[ :])$k<" "$hsyms" && found=1
  done < "$cudatmp/$(basename "${cu_inputs[0]}" .cu).dev.kernels.unresolved"
  if [ $found = 1 ]; then
    t=$(trace_start)
    NFCXX_CUDA_HOST_SYMBOLS=$hsyms NFCXX_CACHE= "$root/nfcxx" "${args0[@]}" || exit $?
    trace_end "$t" "second pass (kernel instances from the host compile)" eccp
  fi
fi
if [ -n "$cache_entry" ] && [ ! -f "$cache_entry/obj" ]; then   # a whole entry appears at once: a partial copy is never a hit
  ctmp=$cache_entry.tmp.$$; mkdir -p "$ctmp" "$(dirname "$cache_entry")"
  cp "$out" "$ctmp/obj"
  for x in ti ii; do [ ! -f "${out%.*}.$x" ] || cp "${out%.*}.$x" "$ctmp/$x"; done
  [ -e "$cache_entry" ] || mv "$ctmp" "$cache_entry" 2>/dev/null
  rm -rf "$ctmp"
fi
if [ -n "$depmode" ]; then
  # -MD/-MMD (with -MF/-MT/-MQ/-MP): the host preprocessor writes the dependency file, as nfcc does for C.
  df=${dfile:-${out%.*}.d}; tgt=${dtarget:-$out}
  mflag=-M; [ "$depmode" = -MMD ] && mflag=-MM
  "${NFCXX_CXX:-g++}" $mflag $depphony -MT "$tgt" -MF "$df" "-std=${std#--}" ${cflags[@]+${cflags[@]+"${cflags[@]}"}} \
    ${sysdirs[@]+"${sysdirs[@]/#/-isystem}"} ${srcs[@]+${srcs[@]+"${srcs[@]}"}}
fi
