#!/usr/bin/env bash
# nfcxx: experimental C++ compiler driver.
#   Path A: C++ --(EDG front end)--> C --(host C compiler)--> executable
# Usage: nfcxx [--emit-c] [--backend=qbe|gcc|pathb] [--dialect=g++|clang] [--gnu-version=N] [--freestanding]
#   Hosted (default): host C++ headers and GNU version from g++ (see host_sys_includes below).
#              [-o out] [-std=c++NN] file.cpp...
#   qbe (default): generated C -> cproc -> QBE -> asm      (scripts/setup-qbe.sh)
#   gcc:           generated C -> gcc -O2 -fwrapv -fno-strict-aliasing
#   pathb:         (opt-in; also NFCXX_PATH=b) EDG lowered IL -> typed IR -> QBE, no generated C. Hosted programs only.
#                  Needs the Path B harness (scripts/setup-pathb.sh, PATHB_CPFE/PATHB_BASE); docs/notes/pathb-hosted.md.
#   --dialect:     EDG front-end mode (default g++; NFCXX_DIALECT overrides the default)
#   --gnu-version: GCC version the g++ front end emulates, e.g. 130000 (EDG default when unset)
#   --trace=FILE: write a Chrome trace-event JSON file (open in ui.perfetto.dev); NFCXX_TRACE=FILE too.
#   -shared [-fPIC] [-rdynamic]: build a shared object (-shared implies -fPIC); -rdynamic exports an
#                  executable's symbols so a dlopen'd object can bind to them. See docs/notes/eval.md.
#   -c / *.o:      separate compilation: `nfcxx -c a.cpp -o a.o`, then `nfcxx a.o b.o -o x` links objects (docs/notes/multi-tu.md).
#   --freestanding: headers come only from lib/ (no EDG std headers, no hosted libc++/libstdc++),
#                  and --gnu-version defaults to 130000. Opt-in; see docs/notes/freestanding.md.
set -euo pipefail
root=$(cd "$(dirname "$0")" && pwd)
source "$root/scripts/trace.sh"
edg=${EDG_BUILD:-$root/build/edg}/bin

std=--c++23; out=a.out; emit_c=0; backend=${NFCXX_BACKEND:-qbe}; files=()
cfiles=(); cflags=(); cflags_pic=(); ncpp=0; nobj=0
shared=0; pic=0; rdynamic=0
dialect=${NFCXX_DIALECT:-g++}; freestanding=0; gnu=""; trace=${NFCXX_TRACE:-}
while [ $# -gt 0 ]; do
  case $1 in
    --emit-c) emit_c=1 ;;
    --backend=*) backend=${1#--backend=} ;;
    --dialect=*) dialect=${1#--dialect=} ;;
    --gnu-version=*) gnu=${1#--gnu-version=} ;;
    --freestanding) freestanding=1 ;;
    --trace=*) trace=${1#--trace=} ;;
    -shared) shared=1; pic=1 ;;
    -fPIC|-fpic) pic=1 ;;
    -rdynamic) rdynamic=1 ;;
    -o) out=$2; shift ;;
    -std=c++*) std=--c++${1#-std=c++} ;;
    # C inputs skip EDG (see "C inputs" below). Their -I/-D/-U go to the C compiler as well as to eccp.
    *.c) cfiles+=("$1") ;;
    -I?*|-D?*|-U?*) cflags+=("$1"); files+=("$1") ;;
    *.o) files+=("$1"); nobj=$((nobj + 1)) ;;
    -*|*.a|*.so) files+=("$1") ;;
    *) files+=("$1"); ncpp=$((ncpp + 1)) ;;
  esac
  shift
done
[ $((ncpp + nobj + ${#cfiles[@]})) -gt 0 ] || { echo "nfcxx: no input files" >&2; exit 2; }
if [ $ncpp -gt 0 ] || [ $emit_c = 1 ] || { [ $nobj -gt 0 ] && [ ${#cfiles[@]} = 0 ]; }; then
  [ -x "$edg/eccp" ] || { echo "nfcxx: EDG not built; run scripts/setup-edg.sh" >&2; exit 2; }
fi
case $dialect in g++|clang) ;; *) echo "nfcxx: unknown dialect '$dialect'" >&2; exit 2 ;; esac
[ -z "$trace" ] || trace_begin "$trace"

# C inputs: a .c file does not go through EDG. It is compiled to an object file by the backend's C compiler
# (qbe: scripts/qbe-cc, the same cproc -> QBE pipeline as EDG's generated C; gcc: gcc -O2 -fwrapv
# -fno-strict-aliasing), and the objects are linked with the C++ side (EDG's runtime) when any .cpp is
# present. -I, -D, -U options reach the C compiler; -l/-L and other options go to the link only.
# A stand-alone C program therefore needs no EDG build.

# Freestanding: headers come only from lib/. --no_standard_includes drops EDG's default include dirs
# (EDG ships no <cstdio> etc. for the C++ side anyway). Without --gnu-version the g++ front end rejects
# __is_same, __builtin_bit_cast and friends, so freestanding defaults to GCC 13 emulation.
# Hosted mode (default) uses the host C++ library headers, so real code can include <cstdio>,
# <cctype>, <string> and friends. Their include directories and the GNU version come from the host
# g++ (override with NFCXX_CXX, or NFCXX_SYS_INCLUDES as a colon-separated list).
source "$root/scripts/host-sys.sh"   # host_sys_includes, host_gnu_version (shared with scripts/pathb-dump)
extra=()
sys_inc=()
hosted_libs=()
if [ $freestanding = 1 ]; then
  extra=(--no_standard_includes "-I$root/lib")
  [ -n "$gnu" ] || gnu=130000
else
  t=$(trace_start)
  while IFS= read -r d; do [ -n "$d" ] && sys_inc+=("--sys_include=$d"); done < <(host_sys_includes)
  trace_end "$t" "host C++ headers" driver
  # g++ links libm implicitly through libstdc++; the hosted headers (<cmath>, used by doctest for
  # log10) need it too. The EDG link appends --c_to_obj_lib libraries after the objects.
  hosted_libs=(--c_to_obj_lib=m)
  if [ -z "$gnu" ]; then
    gnu=$(host_gnu_version)
  fi
fi
gnu_opts=()
[ -n "$gnu" ] && gnu_opts=(--gnu_version="$gnu")
[ ${#gnu_opts[@]} -gt 0 ] && export EDG_CPFE_DEFAULT_OPTIONS="${gnu_opts[*]} ${EDG_CPFE_DEFAULT_OPTIONS:-}"

if [ $emit_c = 1 ] && [ ${#cfiles[@]} -gt 0 ]; then
  echo "nfcxx: --emit-c does not apply to .c inputs (they skip the front end)" >&2; exit 2
fi
if [ $emit_c = 1 ]; then
  # Run the front end alone and print the generated C.
  base=${EDG_BASE:-$root/build/edg-base}
  tmp=$(mktemp -d); trap 'rm -rf "$tmp"; trace_finish' EXIT
  f=$(realpath "${files[0]}")
  # host dirs first, then EDG's own, as eccp orders user and default include dirs
  inc=(${sys_inc[@]+"${sys_inc[@]}"} --sys_include="$base/include"); [ $freestanding = 1 ] && inc=("-I$root/lib")
  t=$(trace_start)
  (cd "$base" && "$edg/cpfe" -D_POSIX_SOURCE -D__CHAR_BIT__=8 "$std" --"$dialect" "${gnu_opts[@]}" \
      "${inc[@]}" --gen_c_file_name="$tmp/out.c" "$f")
  trace_end "$t" "cpfe --emit-c (front end)" frontend
  cat "$tmp/out.c"
  exit 0
fi

[ "${NFCXX_PATH:-}" != b ] || backend=pathb   # NFCXX_PATH=b: the Path B compiler (docs/notes/pathb-hosted.md)
case $backend in
  pathb) [ $freestanding = 0 ] || { echo "nfcxx: Path B (NFCXX_PATH=b) compiles hosted programs only" >&2; exit 2; }
       [ -x "$root/build/qbe/qbe" ] || { echo "nfcxx: QBE not built; run scripts/setup-qbe.sh" >&2; exit 2; }
       export NFCXX_CC=$root/scripts/qbe-cc ;;   # for the .c inputs
  qbe) [ -x "$root/build/qbe/qbe" ] || { echo "nfcxx: QBE not built; run scripts/setup-qbe.sh" >&2; exit 2; }
       export NFCXX_CC=$root/scripts/qbe-cc ;;
  gcc) ;;
  *) echo "nfcxx: unknown backend '$backend'" >&2; exit 2 ;;
esac

# -fPIC / -rdynamic / -shared reach the C compiler and the link. EDG_OBJ_TO_EXEC_DEFAULT_OPTIONS replaces the
# options eccp gives its link command (default: the C compile options), so only -shared goes there.
picopts=(); ldopts=()
[ $pic = 0 ] || { picopts=(--c_to_obj_option -fPIC); cflags_pic=(-fPIC); }
[ $rdynamic = 0 ] || picopts+=(--c_to_obj_option -rdynamic)
[ $shared = 0 ] || { export EDG_OBJ_TO_EXEC_DEFAULT_OPTIONS=-shared; ldopts=(-shared); }

# C inputs: compile each .c to an object. Link options (-l, -L, ...) stay in files for the final link.
cobjs=()
if [ ${#cfiles[@]} -gt 0 ]; then
  ctmp=$(mktemp -d); trap 'rm -rf "$ctmp"; trace_finish' EXIT
  n=0
  for c in "${cfiles[@]}"; do
    o=$ctmp/$n.o; n=$((n + 1))
    t=$(trace_start)
    if [ $backend != gcc ]; then
      NFCXX_C_INPUT=1 "$NFCXX_CC" -c ${cflags[@]+"${cflags[@]}"} "$c" -o "$o"
    else
      gcc -c -O2 -fwrapv -fno-strict-aliasing ${cflags_pic[@]+"${cflags_pic[@]}"} ${cflags[@]+"${cflags[@]}"} "$c" -o "$o"
    fi
    trace_end "$t" "C input: $c" cinput
    cobjs+=("$o")
  done
  if [ $ncpp = 0 ] && { [ $nobj = 0 ] || [ ! -x "$edg/eccp" ]; }; then
    # Only C: link with the C compiler (qbe-cc adds -latomic for the QBE backend).
    t=$(trace_start)
    if [ $backend != gcc ]; then "$NFCXX_CC" ${ldopts[@]+"${ldopts[@]}"} "${cobjs[@]}" ${files[@]+"${files[@]}"} -o "$out"
    else gcc ${ldopts[@]+"${ldopts[@]}"} "${cobjs[@]}" ${files[@]+"${files[@]}"} -o "$out"; fi
    trace_end "$t" "link (C only)" cinput
    exit 0
  fi
fi

# Path B: no C is generated. Each C++ file goes EDG -> typed IR -> QBE -> object (scripts/pathb-cc), and the objects are
# linked with EDG's runtime (libC.a: exceptions, operator new) before libstdc++, as tests/pathb-qbe/run.sh links them.
if [ $backend = pathb ]; then
  ptmp=$(mktemp -d); trap 'rm -rf "$ptmp"; trace_finish' EXIT
  pobjs=(); plink=(); n=0
  for f in "${files[@]}"; do
    case $f in
      -I*|-D*|-U*) ;;                       # reach pathb-cc through cflags
      -*|*.o|*.a|*.so) plink+=("$f") ;;
      *) o=$ptmp/p$n.o; n=$((n + 1))
         t=$(trace_start)
         "$root/scripts/pathb-cc" "-std=c++${std#--c++}" ${cflags[@]+"${cflags[@]}"} "$f" -o "$o"
         trace_end "$t" "Path B: $f" pathb
         pobjs+=("$o") ;;
    esac
  done
  t=$(trace_start)
  cc ${ldopts[@]+"${ldopts[@]}"} -o "$out" ${cobjs[@]+"${cobjs[@]}"} "${pobjs[@]}" ${plink[@]+"${plink[@]}"} -L"${EDG_BUILD:-$root/build/edg}/lib" -lC -lstdc++ -lgcc_s -lpthread -lm -latomic
  trace_end "$t" "link" pathb
  exit 0
fi

# With the gcc backend the generated C relies on C's UB rules (e.g. plain signed '+'), so make the C
# compiler give those operations defined behavior. -fkeep-static-functions keeps EDG's static __tls_init
# (thread_local dynamic initialization): it is referenced only through a top-level asm alias, which gcc
# -O2 does not count as a use, so it was dropped and the wrapper's call went unresolved.
# With --trace, eccp's own C compiler steps are child processes that record their spans too (qbe-cc).
t=$(trace_start)
"$edg/eccp" "$std" --"$dialect" "${extra[@]}" "${sys_inc[@]}" "${hosted_libs[@]}" --c_to_obj_option -O2 --c_to_obj_option -fwrapv --c_to_obj_option -fno-strict-aliasing --c_to_obj_option -fkeep-static-functions --c_to_obj_option -fgnu89-inline ${picopts[@]+"${picopts[@]}"} \
  ${cobjs[@]+"${cobjs[@]}"} "${files[@]}" -o "$out"
trace_end "$t" "eccp (front end, C compile, link)" eccp
