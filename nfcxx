setup_sh=$("${RUBY:-ruby}" "$root/scripts/nfcxx-setup.rb" setup backend="$backend" backend_explicit="$backend_explicit" freestanding="$freestanding" cosmo="$cosmo" emit_c="$emit_c" target="$target" preprocess="$preprocess" depmode="$depmode" shared="$shared" host="$(uname -s) $(uname -m)" asan="$asan" asanopts="$(IFS=$'\x1f'; echo "${asanopts[*]-}")" instantiate="$instantiate" sys="$(uname -s)" gnu="$gnu" root="$root" dialect="$dialect" mach="$(uname -m)" gnu_opts="" path_b="$path_b" bash_pid="${BASHPID:-$$}") || exit $?
