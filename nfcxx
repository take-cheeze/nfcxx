#!/usr/bin/env ruby
# nfcxx: the C++ compiler driver, the Ruby driver (scripts/nfcxx.rb). This file only starts it, so callers that run ./nfcxx keep
# working. The driver body is scripts/nfcxx-body.rb (in this process).
require "rbconfig"
exec(ENV["RUBY"] || RbConfig.ruby, File.join(__dir__, "scripts", "nfcxx.rb"), *ARGV)
