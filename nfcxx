    -I|-D|-U) [ $# -ge 2 ] || { echo "nfcxx: $1 needs an argument" >&2; exit 2; }
              cflags+=("$1$2"); files+=("$1$2"); shift ;;
    *.o) files+=("$1"); nobj=$((nobj + 1)) ;;
    -*|*.a|*.so) files+=("$1") ;;
    *.cu) cu_inputs+=("$1"); files+=("$1"); ncpp=$((ncpp + 1)); srcs+=("$1") ;;
    *.cpp2) cpp2_inputs+=("$1"); files+=("$1"); ncpp=$((ncpp + 1)); srcs+=("$1") ;;
    *) files+=("$1"); ncpp=$((ncpp + 1)); srcs+=("$1") ;;
