case $dialect in g++|clang) ;; *) echo "nfcxx: unknown dialect '$dialect'" >&2; exit 2 ;; esac
[ -z "$trace" ] || trace_begin "$trace"
# C++ modules (docs/notes/modules.md). A program whose sources declare or import a module is built by mod_build_program, which
