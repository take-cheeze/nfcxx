flags_sh=$("${RUBY:-ruby}" "$root/scripts/nfcxx-setup.rb" flags ir_opt_set="$ir_opt_set" ir_opt="${ir_opt:-}" asan="$asan" backend="$backend" pic="$pic" diag_opts="$(IFS=$'\x1f'; echo "${diag_opts[*]-}")" dialect="$dialect" dialect_asked="${dialect_asked:-}" gnu_user="${gnu_user:-}" freestanding="$freestanding" gnu="$gnu" root="$root" pb_fs_host="$pb_fs_host") || exit $?
