nfcxx_argv=("$@")   # the command as given: the compile cache keys on it (see cache_key)
args0=("$@")   # the arguments as given: the SYCL two-pass build below re-runs the driver with them
# BEGIN the argument loop: scripts/nfcxx-loop.rb --records reads the arguments and answers the state they leave; this block
# sets that state. The records are NUL-terminated: "s NAME=VALUE" a scalar the loop assigns; "a NAME=VALUE" an element the
# loop appends to an array; "x MESSAGE" an argument the loop refuses (printed; status 2); "u OPTION" a value option given
# last (set -u ends the driver, as the bash loop did: "$2: unbound variable"); "z" the end marker, written only on success.
# A planner that stops before "z" ends the driver with status 1, so a crash is never silent.
loop_no_value() { : "$2"; }   # a value option given last: $2 is unset here (set -u ends the driver)
# the ld.NAME programs that exist, for -fuse-ld=NAME (the planner does not ask the shell)
# The loop's state as the shell statements that apply it (scripts/nfcxx-loop.rb --shell): a refusal ends the driver with 2, a
# value option given last ends it as the bash did (loop_no_value), and the state is set and appended as the loop made it.
loop_sh=$("${RUBY:-ruby}" "$root/scripts/nfcxx-loop.rb" --shell --probe-ld -- "$@") || exit $?
eval "$loop_sh"
shift $#
