#!/usr/bin/env bash
# nfcxx: experimental C++ compiler driver.
#   Path A: C++ --(EDG front end)--> C --(host C compiler)--> executable
# Usage: nfcxx [--emit-c] [--backend=qbe|gcc|pathb] [--dialect=g++|clang] [--gnu-version=N] [--freestanding]
#   Hosted (default): host C++ headers and GNU version from g++ (see host_sys_includes below).
#              [-o out] [-std=c++NN] file.cpp...
#   qbe (default): generated C -> cproc -> QBE -> asm      (scripts/setup-qbe.sh)
#   gcc:           generated C -> gcc -O2 -fwrapv -fno-strict-aliasing
#   pathb:         (opt-in; also NFCXX_PATH=b) EDG lowered IL -> typed IR -> QBE, no generated C. Hosted programs only.
#                  Needs the Path B harness (scripts/setup-pathb.sh, PATHB_CPFE/PATHB_BASE); docs/notes/pathb-hosted.md.
#   --dialect:     EDG front-end mode (default g++; NFCXX_DIALECT overrides the default)
#   --gnu-version: GCC version the g++ front end emulates, e.g. 130000 (EDG default when unset)
#   -fsanitize=undefined|CHECK[,CHECK...]: the undefined behavior sanitizer (docs/notes/ubsan.md). Implies Path B, whose IR has the
#                  checks; a failing check prints "file:line: runtime error: ..." and aborts. -fno-sanitize=all turns it off.
#   --trace=FILE: write a Chrome trace-event JSON file (open in ui.perfetto.dev); NFCXX_TRACE=FILE too.
#   NFCXX_KEEP_INTERMEDIATES=1: a compile and link keeps its intermediates (the .o files, <stem>.ii, <stem>.ti) in the
#                  temporary directory the driver names on stderr, instead of removing it on exit. A -c compile keeps
#                  <stem>.ii and <stem>.ti beside its object in any case: the link that follows reads them there.
#   -shared [-fPIC] [-rdynamic]: build a shared object (-shared implies -fPIC); -rdynamic exports an
#                  executable's symbols so a dlopen'd object can bind to them. See docs/notes/eval.md.
#   -c / *.o:      separate compilation: `nfcxx -c a.cpp -o a.o`, then `nfcxx a.o b.o -o x` links objects (docs/notes/multi-tu.md).
#   NFCXX_CACHE=DIR: keeps each -c compile in DIR and takes it back when nothing it depends on changed (docs/notes/cxx-driver.md).
#   NFCXX_CACHE_LOG=FILE: with NFCXX_CACHE, appends each lookup's key inputs, its key, and hit or miss to FILE, to diff a miss against a hit.
#   -fsanitize=address: AddressSanitizer (heap/stack/global overflow, use-after-free, double free, leaks). The gcc and qbe
#                  backends instrument the code; Path B is refused. docs/notes/asan.md. -fno-sanitize=address undoes it;
#                  other -fsanitize= values are refused.
#   --freestanding: headers come only from lib/ (no EDG std headers, no hosted libc++/libstdc++),
#                  and --gnu-version defaults to 130000. Opt-in; see docs/notes/freestanding.md.
set -euo pipefail
root=$(cd "$(dirname "$0")" && pwd)
source "$root/scripts/trace.sh"
edg=${EDG_BUILD:-$root/build/edg}/bin

source "$root/scripts/host-sys.sh"   # host_dialect, host_clang_version, host_sys_includes, host_gnu_version
sanitize=""
std=--c++23; out=a.out; emit_c=0; backend=${NFCXX_BACKEND:-qbe}; files=()
cfiles=(); cflags=(); cflags_pic=(); ncpp=0; nobj=0
shared=0; pic=0; rdynamic=0; compile_only=0
asan=0; backend_explicit=0; asanopts=()
dialect=${NFCXX_DIALECT:-$(host_dialect)}; freestanding=0; gnu=""; trace=${NFCXX_TRACE:-}
# CUDA kernel names are obfuscated (docs/notes/gpu.md, "Kernel name obfuscation"): --obfuscate-kernels, or NFCXX_OBFUSCATE_KERNELS=1
# in the environment (which reaches a CMake build through nfcxx-cuda without any change to its command line).
obfuscate=0; case ${NFCXX_OBFUSCATE_KERNELS:-0} in 0|"") ;; *) obfuscate=1 ;; esac
# Compiler-driver options a build system passes (CMake, ninja, make; mruby's rake build). See docs/notes/cxx-driver.md.
pthread=0; preprocess=0; outset=0; depmode=""; dfile=""; dtarget=""; depphony=""
sysdirs=(); srcs=(); ppflags=(); pie_opts=(); xlang=""; stdin_src=0; preinc=(); isa=(); cuda_opts=()
# A .cu input is rewritten to C++ before the front end (scripts/cuda-rewrite.rb: launches become calls of
# __nfcxx_cuda_launch), and the runtime helper lib/cuda/nfcxx_cuda.h is included first. The copy goes in a temp
# directory that the EXIT traps below remove. Its basename is the source's, so default output names are unchanged.
cudatmp=""
# Device code of a .cu file: its __global__ and __device__ functions go through the Path B front end
# (scripts/pathb-dump), the IR-to-PTX emitter (scripts/pathb-ptx-emit.rb) and ptxas for NFCXX_SM (default 75). The
# cubin is embedded at the end of the host copy with a registration tail (scripts/cuda-embed.rb), so the one object
# holds the host code and its device image. A file with no kernel gets no device image.
# The rewritten copy of each .cu input is made after the arguments are read (cu_prepare), so that -c and -o are known:
# with -c the copy goes to the per-user cache (see cu_prepare), not to the user's tree. Otherwise it goes in a temp directory.
cu_inputs=()
cu_prepare() {  # cu_prepare: rewrites every .cu input and puts its copy in srcs and files in place of the source
  [ ${#cu_inputs[@]} -gt 0 ] || return 0
  cudatmp=$(mktemp -d); trap 'rm -rf "$cudatmp"' EXIT
  local dir=$cudatmp
  if [ $compile_only = 1 ]; then
    # The copy must outlive the compile: the prelinker re-reads it when it needs a template instance at link time,
    # and a failed link deletes the objects. It goes to a per-user cache, keyed by the absolute object path, and the
    # object records that absolute path, so the link finds it from any directory.
    local obj=$out; [ $outset = 1 ] || obj=$(basename "${cu_inputs[0]}" .cu).o
    local key; key=$(realpath -m "$obj" | sha1sum | cut -c1-16)
    dir=${NFCXX_CU_CACHE:-${XDG_CACHE_HOME:-${HOME:-/tmp}/.cache}/nfcxx}/cu/$key
    mkdir -p "$dir"
  fi
  local src copy i sdir
  for src in ${cu_inputs[@]+"${cu_inputs[@]}"}; do
    # The copy is not next to the source, so quoted includes that are relative to the source (`#include "../x.cuh"`
    # in a .cu, and in the headers it includes) are found through the source's own directory, as a user -I.
    sdir=$(realpath -- "$(dirname -- "$src")")
    cflags+=("-I$sdir"); files+=("-I$sdir")
    copy=$dir/$(basename "$src" .cu).cpp
    cu_rewrite "$src" "$copy"
    # if, not `[ ] && x`: a loop whose last test fails returns non-zero, and set -e would end the driver.
    for i in "${!srcs[@]}"; do if [ "${srcs[$i]}" = "$src" ]; then srcs[$i]=$copy; fi; done
    for i in "${!files[@]}"; do if [ "${files[$i]}" = "$src" ]; then files[$i]=$copy; fi; done
  done
}
# A CUDA_HOME outside /usr is still a system directory for the rewriter (its headers are not inlined into the device unit),
# so a CUDA_HOME-shaped directory from PyPI wheels (scripts/fetch-cudart-wheel.sh) behaves like the toolkit's.
[ -n "${CUDA_HOME:-}" ] && export NFCXX_SYSTEM_PATHS="$CUDA_HOME${NFCXX_SYSTEM_PATHS:+:$NFCXX_SYSTEM_PATHS}"
# The rewriter: the C++ port (build/cuda-rewrite, built from tools/cuda-rewrite on first use) by default; the Ruby
# reference scripts/cuda-rewrite.rb with NFCXX_CUDA_REWRITER=ruby. Both take the same flags and give the same output.
rewriter=()
if [ "${NFCXX_CUDA_REWRITER:-cxx}" = ruby ]; then
  rewriter=("$root/scripts/mrb" "$root/scripts/cuda-rewrite.rb")
else
  [ -x "$root/build/cuda-rewrite" ] || make -s -C "$root/tools/cuda-rewrite" || exit $?
  rewriter=("$root/build/cuda-rewrite")
fi
cu_rewrite() {  # cu_rewrite FILE.cu COPY: writes the rewritten copy to COPY, with the device image appended
  local src=$1 copy=$2
  local base; base=$(basename "$src" .cu)
  # The -I directories: the rewriter inlines the project headers they name (quoted and angle-bracket includes).
  local incs=(); local f; for f in ${cflags[@]+${cflags[@]+"${cflags[@]}"}}; do case $f in -I*) incs+=("$f");; esac; done
  # The -D and -U options: the host compile gets them, and the device pass resolves its conditionals with them, so both
  # copies agree on every #if the defines decide.
  local defs_opts=(); for f in ${cflags[@]+${cflags[@]+"${cflags[@]}"}}; do case $f in -D*|-U*) defs_opts+=("$f");; esac; done
  # Kernel name obfuscation: one seed for both copies of the file (the host copy and the device unit must agree).
  local obf=(); if [ "$obfuscate" = 1 ]; then obf=(--obfuscate="${NFCXX_OBFUSCATE_SEED:-$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')}"); fi
  # The front end parses the plain kernel launches (EDG --cuda, 3rd/edg); the rewriter leaves them. Launches with
  # template arguments are still rewritten here, and the device unit is unchanged. On by default, for .cu inputs only
  # (this function); NFCXX_CUDA_EDG_LAUNCH=0 restores the rewriter's own launch rewrite.
  local rw=()
  if [ "${NFCXX_CUDA_EDG_LAUNCH:-1}" = 1 ]; then
    rw+=(--edg-launches)
    # An eccp argument, not the environment: the prelinker re-runs the front end on this copy at link time with the
    # options recorded at compile time, and it must see --cuda there too (see the eccp call below).
    cuda_opts=(--cuda)
  fi
  ${rewriter[@]+"${rewriter[@]}"} ${incs[@]+${incs[@]+"${incs[@]}"}} ${defs_opts[@]+${defs_opts[@]+"${defs_opts[@]}"}} ${obf[@]+"${obf[@]}"} ${rw[@]+${rw[@]+"${rw[@]}"}} "$src" > "$copy" || exit $?
  case " ${preinc[*]+${preinc[*]}} " in *" $root/lib/cuda/nfcxx_cuda.h "*) ;; *) preinc+=("$root/lib/cuda/nfcxx_cuda.h") ;; esac
  local dev=$cudatmp/$base.dev sm=${NFCXX_SM:-75} ptxas=${NFCXX_PTXAS:-${CUDA_HOME:-/usr/local/cuda}/bin/ptxas}
  ${rewriter[@]+"${rewriter[@]}"} ${incs[@]+${incs[@]+"${incs[@]}"}} ${defs_opts[@]+${defs_opts[@]+"${defs_opts[@]}"}} ${obf[@]+"${obf[@]}"} --device --kernels="$dev.kernels" "$src" > "$dev.cpp" || exit $?
  [ -s "$dev.kernels" ] || return 0
  NFCXX_PATHB_CUDA=1 "$root/scripts/pathb-dump" ${defs_opts[@]+${defs_opts[@]+"${defs_opts[@]}"}} --ir --freestanding "$dev.cpp" > "$dev.ir" \
    || { echo "nfcxx: $src: device code: the front end refused it (see above; needs scripts/setup-pathb.sh)" >&2; exit 2; }
  # The kernels are the names cuda-rewrite.rb listed (its launches); the emitter lowers only what they reach.
  kopts=(); while IFS= read -r k; do [ -n "$k" ] && kopts+=(--kernel="$k"); done < "$dev.kernels"
  # NFCXX_PTX_EMITTER=cxx: the C++ emitter (tools/pathb-ptx-emit, same text as the Ruby; the default; NFCXX_PTX_EMITTER=ruby selects the Ruby script)
  if [ "${NFCXX_PTX_EMITTER:-cxx}" = cxx ]; then
    [ -x "$root/build/pathb-ptx-emit" ] || make -s -C "$root/tools/pathb-ptx-emit" || exit 1
    "$root/build/pathb-ptx-emit" --emit --sm=$sm ${kopts[@]+${kopts[@]+"${kopts[@]}"}} "$dev.ir" > "$dev.ptx" || exit $?
  else
    "$root/scripts/mrb" "$root/scripts/pathb-ptx-emit.rb" --sm=$sm ${kopts[@]+${kopts[@]+"${kopts[@]}"}} "$dev.ir" > "$dev.ptx" || exit $?
  fi
  # NFCXX_CUDA_JIT=1: the image is the PTX text, loaded by the runtime's JIT (cudaLibraryLoadData); ptxas is not run.
  if [ "${NFCXX_CUDA_JIT:-0}" = 1 ]; then
    "$root/scripts/mrb" "$root/scripts/cuda-embed.rb" "$dev.ptx" "$dev.ir" "$dev.kernels" "$dev.kernels.addr" >> "$copy" || exit $?
  else
    "$ptxas" -arch=sm_$sm "$dev.ptx" -o "$dev.cubin" || exit $?
    "$root/scripts/mrb" "$root/scripts/cuda-embed.rb" "$dev.cubin" "$dev.ir" "$dev.kernels" "$dev.kernels.addr" >> "$copy" || exit $?
  fi
}
# A compile and link (or a link of objects) runs eccp in a temporary directory, which the EXIT trap removes. eccp writes
# <stem>.o, <stem>.ii and <stem>.ti into its working directory, and the prelinker reads the .ii and .ti there, so the
# records of one build could be read by the next build in the same directory. The arguments of such a run are made
# absolute first (ecp_arg), because its working directory changes. A -c compile is not moved: the link that follows reads
# its <stem>.ii and <stem>.ti beside the object (see "-c" before the eccp call).
moves=0; eccp_dir=""
ecp_arg() {  # ecp_arg ARG: ARG as eccp receives it (its paths absolute when eccp runs in the temporary directory)
  if [ $moves = 0 ]; then printf '%s\n' "$1"; return 0; fi
  case $1 in
    -I?*) printf -- '-I%s\n' "$(abs_path "${1#-I}")" ;;
    -L?*) printf -- '-L%s\n' "$(abs_path "${1#-L}")" ;;
    -Wl,*)   # a file named in a link option (-Wl,--version-script=FILE, -Wl,-T,FILE) is made absolute when it exists here
      local res=-Wl p parts=()
      IFS=, read -r -a parts <<< "${1#-Wl,}"
      for p in ${parts[@]+"${parts[@]}"}; do
        case $p in
          *=*) if [ -e "${p#*=}" ]; then p="${p%%=*}=$(abs_path "${p#*=}")"; fi ;;
          *) if [ -e "$p" ]; then p=$(abs_path "$p"); fi ;;
        esac
        res+=",$p"
      done
      printf '%s\n' "$res" ;;
    -*) printf '%s\n' "$1" ;;
    *) printf '%s\n' "$(abs_path "$1")" ;;
  esac
}
eccp_cleanup() {  # the EXIT trap of a build that runs eccp in a temporary directory (and of the C-input and .cu steps)
  local rc=$?
  if [ -n "$eccp_dir" ] && [ "${NFCXX_KEEP_INTERMEDIATES:-}" != 1 ]; then rm -rf "$eccp_dir"; fi
  if [ -n "${cudatmp:-}" ]; then rm -rf "$cudatmp"; fi
  if [ -n "${ctmp:-}" ]; then rm -rf "$ctmp"; fi
  trace_finish
  return $rc
}
nfcxx_argv=("$@")   # the command as given: the compile cache keys on it (see cache_key)
while [ $# -gt 0 ]; do
  case $1 in
    --emit-c) emit_c=1 ;;
    --backend=*) backend=${1#--backend=}; backend_explicit=1 ;;
    --obfuscate-kernels) obfuscate=1 ;;
    -fsanitize=address) asan=1 ;;
    -fno-sanitize=address) asan=0 ;;
    -fsanitize=*|-fsanitize-*) echo "nfcxx: $1 is not supported (only -fsanitize=address; docs/notes/asan.md)" >&2; exit 2 ;;
    -fno-omit-frame-pointer|-fomit-frame-pointer) asanopts+=("$1") ;;   # asan's usual companions; they go to the C compile
    --dialect=*) dialect=${1#--dialect=} ;;
    --gnu-version=*) gnu=${1#--gnu-version=} ;;
    --freestanding) freestanding=1 ;;
    --trace=*) trace=${1#--trace=} ;;
    -shared) shared=1; pic=1 ;;
    -fPIC|-fpic) pic=1 ;;
    -rdynamic) rdynamic=1 ;;
    -c) compile_only=1; files+=(-c) ;;
    -o) out=$2; outset=1; shift ;;
    -std=c++*) std=--c++${1#-std=c++} ;;
    -std=gnu++*) std=--c++${1#-std=gnu++} ;;   # GNU and strict modes differ in the dialect, which --dialect selects
    -E) preprocess=1 ;;
    -P) ppflags+=(-P) ;;
    -x) xlang=$2; shift ;;      # -x c++ (CMake's compiler probes pipe a source to -E -x c++ -)
    -) stdin_src=1 ;;           # the source on stdin: only -E reads it
    -pthread) pthread=1 ;;
    -fexceptions|-fwrapv|-fno-strict-aliasing) ;;   # EDG always lowers exceptions; the C side already gets -fwrapv -fno-strict-aliasing
    -fsanitize=*) sanitize=${sanitize:+$sanitize,}${1#-fsanitize=} ;;
    -fno-sanitize=all) sanitize="" ;;
    -fno-sanitize=*|-fsanitize-*) echo "nfcxx: $1 is not supported (only -fsanitize=undefined and its checks, docs/notes/ubsan.md)" >&2; exit 2 ;;
    -pipe) ;;                                       # pass data between the compiler stages through pipes: no effect on the output
    # Symbol visibility is not implemented; nfcc ignores it too (docs/notes/realworld.md), so nfcxx does the same
    # for consistency. It changes the exports of a -shared object, which is the one place it could matter.
    -fvisibility=*|-fvisibility-inlines-hidden) ;;
    -fPIE|-fpie) pie_opts+=(--c_to_obj_option -fPIE) ;;   # CMake's POSITION_INDEPENDENT_CODE on an executable
    -pie) pie_opts+=(--c_to_obj_option -pie) ;;
    -Wl,*) files+=("$1") ;;
    # -lNAME stays -lNAME for the host link steps; the EDG call below spells it --c_to_obj_lib=NAME (eccp's own -l
    # search only looks in -L directories and /lib, /usr/lib, so it cannot find a multiarch libm).
    -l?*) files+=("$1") ;;
    -W*|-w) ;;                                      # warnings do not change the object code
    -m*) isa+=("$1") ;;                             # ISA/target options (-mavx2, -march=..): see the -m block below
    -MD|-MMD) depmode=$1 ;;
    -MP) depphony=-MP ;;
    -MF) dfile=$2; shift ;;
    -MT|-MQ) dtarget=$2; shift ;;
    -include) preinc+=("$2"); shift ;;   # EDG's --preinclude (the front end only; same macros and declarations)
    -isystem) sysdirs+=("$2"); shift ;;
    -isystem?*) sysdirs+=("${1#-isystem}") ;;
    # C inputs skip EDG (see "C inputs" below). Their -I/-D/-U go to the C compiler as well as to eccp.
    *.c) cfiles+=("$1") ;;
    -I?*|-D?*|-U?*) cflags+=("$1"); files+=("$1") ;;
    # The separate form (`-I DIR`, as mrustc's Makefile writes it) is joined here: the host dependency pass
    # (-MMD) sees only cflags, so without this it ran without the include path.
    -I|-D|-U) [ $# -ge 2 ] || { echo "nfcxx: $1 needs an argument" >&2; exit 2; }
              cflags+=("$1$2"); files+=("$1$2"); shift ;;
    *.o) files+=("$1"); nobj=$((nobj + 1)) ;;
    -*|*.a|*.so) files+=("$1") ;;
    *.cu) cu_inputs+=("$1"); files+=("$1"); ncpp=$((ncpp + 1)); srcs+=("$1") ;;
    *) files+=("$1"); ncpp=$((ncpp + 1)); srcs+=("$1") ;;
  esac
  shift
done
[ $((ncpp + nobj + ${#cfiles[@]} + stdin_src)) -gt 0 ] || { echo "nfcxx: no input files" >&2; exit 2; }
[ $compile_only = 1 ] || moves=1   # a -c compile stays in the user's directory (see ecp_arg)
cu_prepare
if [ $preprocess = 1 ]; then
  # -E: the host C++ compiler preprocesses, as nfcc does for C (build systems run the compiler this way).
  hostcxx=${NFCXX_CXX:-g++}
  pp_out=(); [ $outset = 0 ] || pp_out=(-o "$out")
  pp_x=(); [ -z "$xlang" ] || pp_x=(-x "$xlang")
  pp_in=(); [ $stdin_src = 0 ] || pp_in=(-)
  pp_pre=(); for f in ${preinc[@]+${preinc[@]+"${preinc[@]}"}}; do pp_pre+=(-include "$f"); done
  exec "$hostcxx" -E "-std=${std#--}" ${pp_x[@]+${pp_x[@]+"${pp_x[@]}"}} ${ppflags[@]+${ppflags[@]+"${ppflags[@]}"}} ${cflags[@]+${cflags[@]+"${cflags[@]}"}} \
    ${sysdirs[@]+"${sysdirs[@]/#/-isystem}"} ${pp_pre[@]+${pp_pre[@]+"${pp_pre[@]}"}} ${srcs[@]+${srcs[@]+"${srcs[@]}"}} ${pp_in[@]+${pp_in[@]+"${pp_in[@]}"}} ${pp_out[@]+"${pp_out[@]}"}
fi
if [ $stdin_src = 1 ]; then
  echo "nfcxx: a source on stdin is supported only with -E" >&2; exit 2
fi
case $xlang in ""|c++|none) ;; *) echo "nfcxx: -x $xlang: only C++ sources (use nfcc for C)" >&2; exit 2 ;; esac
if [ -n "$depmode" ] && [ $compile_only = 0 ]; then
  echo "nfcxx: $depmode needs -c (dependency files are written for a compile only)" >&2; exit 2
fi
if [ $ncpp -gt 0 ] || [ $emit_c = 1 ] || { [ $nobj -gt 0 ] && [ ${#cfiles[@]} = 0 ]; }; then
  [ -x "$edg/eccp" ] || { echo "nfcxx: EDG not built; run scripts/setup-edg.sh" >&2; exit 2; }
fi
case $dialect in g++|clang) ;; *) echo "nfcxx: unknown dialect '$dialect'" >&2; exit 2 ;; esac
[ -z "$trace" ] || trace_begin "$trace"

# -fsanitize=address: gcc's instrumentation on the gcc backend; on qbe, cproc's checks of every load and store (take-cheeze/cproc
# branch nfcxx-asan-combined, the pin of 3rd/cproc; NFCXX_ASAN). Both link libasan. Path B is not instrumented yet (docs/notes/asan-plan.md).
asan_c=()   # options for every C compile and link of the program
if [ $asan = 1 ]; then
  [ "${NFCXX_PATH:-}" != b ] && [ "$backend" != pathb ] || { echo "nfcxx: -fsanitize=address does not work with Path B yet; use the gcc or qbe backend (docs/notes/asan-plan.md)" >&2; exit 2; }
  case $backend in
    gcc) ;;
    qbe) export NFCXX_ASAN=1 ;;
    *) echo "nfcxx: -fsanitize=address: unknown backend $backend" >&2; exit 2 ;;
  esac
  asan_c=(-fsanitize=address -fno-omit-frame-pointer ${asanopts[@]+${asanopts[@]+"${asanopts[@]}"}})
else
  asanopts=()
fi

# C inputs: a .c file does not go through EDG. It is compiled to an object file by the backend's C compiler
# (qbe: scripts/qbe-cc, the same cproc -> QBE pipeline as EDG's generated C; gcc: gcc -O2 -fwrapv
# -fno-strict-aliasing), and the objects are linked with the C++ side (EDG's runtime) when any .cpp is
# present. -I, -D, -U options reach the C compiler; -l/-L and other options go to the link only.
# A stand-alone C program therefore needs no EDG build.

# Freestanding: headers come only from lib/. --no_standard_includes drops EDG's default include dirs
# (EDG ships no <cstdio> etc. for the C++ side anyway). Without --gnu-version the g++ front end rejects
# __is_same, __builtin_bit_cast and friends, so freestanding defaults to GCC 13 emulation.
# Hosted mode (default) uses the host C++ library headers, so real code can include <cstdio>,
# <cctype>, <string> and friends. Their include directories and the GNU version come from the host
# g++ (override with NFCXX_CXX, or NFCXX_SYS_INCLUDES as a colon-separated list).
source "$root/scripts/host-sys.sh"   # host_sys_includes, host_gnu_version (shared with scripts/pathb-dump)
extra=()
sys_inc=()
hosted_libs=()
if [ $freestanding = 1 ]; then
  extra=(--no_standard_includes "-I$root/lib")
  [ -n "$gnu" ] || gnu=130000
else
  t=$(trace_start)
  while IFS= read -r d; do [ -n "$d" ] && sys_inc+=("--sys_include=$d"); done < <(host_sys_includes)
  trace_end "$t" "host C++ headers" driver
  # g++ links libm implicitly through libstdc++; the hosted headers (<cmath>, used by doctest for
  # log10) need it too. The EDG link appends --c_to_obj_lib libraries after the objects.
  hosted_libs=(--c_to_obj_lib=m)
  # macOS has libc++, not libstdc++: the link needs it explicitly (eccp's Linux default is libstdc++).
  [ "$(uname -s)" = Darwin ] && hosted_libs+=(--c_to_obj_lib=c++)
  if [ -z "$gnu" ]; then
    gnu=$(host_gnu_version)
  fi
fi
# -isystem DIR from the command line: searched after the host's own directories, as the host compiler does.
for d in ${sysdirs[@]+${sysdirs[@]+"${sysdirs[@]}"}}; do sys_inc+=("--sys_include=$(ecp_arg "$d")"); done
# -include FILE is found through the include directories as well as here, so it is made absolute only when it exists here.
pre_opts=(); for f in ${preinc[@]+${preinc[@]+"${preinc[@]}"}}; do
  if [ $moves = 1 ] && [ -e "$f" ]; then f=$(abs_path "$f"); fi
  pre_opts+=(--preinclude "$f")
done
gnu_opts=()
if [ "$dialect" = clang ]; then
  cv=$(host_clang_version); [ -n "$cv" ] && gnu_opts=(--clang_version="$cv")
elif [ -n "$gnu" ]; then
  gnu_opts=(--gnu_version="$gnu")
fi
[ ${#gnu_opts[@]} -gt 0 ] && export EDG_CPFE_DEFAULT_OPTIONS="${gnu_opts[*]} ${EDG_CPFE_DEFAULT_OPTIONS:-}"

if [ $emit_c = 1 ] && [ ${#cfiles[@]} -gt 0 ]; then
  echo "nfcxx: --emit-c does not apply to .c inputs (they skip the front end)" >&2; exit 2
fi
if [ $emit_c = 1 ]; then
  # Run the front end alone and print the generated C.
  base=${EDG_BASE:-$root/build/edg-base}
  tmp=$(mktemp -d); trap 'rm -rf "$tmp" "$cudatmp"; trace_finish' EXIT
  f=$(realpath "${srcs[0]}")   # the first source, not files[0] (which may be an -I option)
  # host dirs first, then EDG's own, as eccp orders user and default include dirs
  inc=(${sys_inc[@]+${sys_inc[@]+"${sys_inc[@]}"}} --sys_include="$base/include"); [ $freestanding = 1 ] && inc=("-I$root/lib")
  # The user's -I directories (kept in files, with the other options) go in front, as eccp puts them.
  # cpfe runs from the EDG base directory, so a relative -I is made absolute first.
  for x in ${files[@]+${files[@]+"${files[@]}"}}; do case $x in -I?*) inc=("-I$(abs_path "${x#-I}")" ${inc[@]+${inc[@]+"${inc[@]}"}}) ;; esac; done
  t=$(trace_start)
  posix_def=(-D_POSIX_SOURCE); [ "$(uname -s)" = Darwin ] && posix_def=(-D_DARWIN_C_SOURCE -U__BLOCKS__)   # as the macOS base
  (cd "$base" && "$edg/cpfe" ${posix_def[@]+"${posix_def[@]}"} -D__CHAR_BIT__=8 "$std" --"$dialect" ${gnu_opts[@]+"${gnu_opts[@]}"} \
      ${inc[@]+"${inc[@]}"} --gen_c_file_name="$tmp/out.c" "$f")
  trace_end "$t" "cpfe --emit-c (front end)" frontend
  cat "$tmp/out.c"
  exit 0
fi

if [ -n "$sanitize" ]; then
  # The checks live in the Path B IR (docs/notes/ubsan.md); the names are gcc's, and not every one is implemented.
  IFS=, read -ra sz <<< "$sanitize"
  for c in ${sz[@]+"${sz[@]}"}; do
    case $c in
      undefined|signed-integer-overflow|integer-divide-by-zero|shift|bounds|null|unreachable|return|float-cast-overflow) ;;
      *) echo "nfcxx: -fsanitize=$c is not supported (implemented: undefined, signed-integer-overflow, integer-divide-by-zero, shift, bounds, null, unreachable, return, float-cast-overflow)" >&2; exit 2 ;;
    esac
  done
  [ $freestanding = 0 ] || { echo "nfcxx: -fsanitize needs Path B, which compiles hosted programs only" >&2; exit 2; }
  export NFCXX_IR_SANITIZE=$sanitize
  backend=pathb
fi
[ "${NFCXX_PATH:-}" != b ] || backend=pathb   # NFCXX_PATH=b: the Path B compiler (docs/notes/pathb-hosted.md)
case $backend in
  pathb) [ $freestanding = 0 ] || { echo "nfcxx: Path B (NFCXX_PATH=b) compiles hosted programs only" >&2; exit 2; }
       [ -x "$root/build/qbe/qbe" ] || { echo "nfcxx: QBE not built; run scripts/setup-qbe.sh" >&2; exit 2; }
       export NFCXX_CC=$root/scripts/qbe-cc ;;   # for the .c inputs
  qbe) [ -x "$root/build/qbe/qbe" ] || { echo "nfcxx: QBE not built; run scripts/setup-qbe.sh" >&2; exit 2; }
       export NFCXX_CC=$root/scripts/qbe-cc ;;
  gcc) export NFCXX_CC=$root/scripts/gcc-cc ;;   # EDG's generated C through gcc, with the pragma filter (edg_eccp_config reads NFCXX_CC)
  *) echo "nfcxx: unknown backend '$backend'" >&2; exit 2 ;;
esac

# Hosted link (not -c, -shared or --freestanding): two additions to what eccp links.
#  - the EH shim (lib/ehshim, docs/notes/eh-shim.md): exceptions thrown by libstdc++.so and std::exception_ptr on EDG's
#    exception runtime; NFCXX_EHSHIM=0 leaves it out;
#  - libC.a (EDG's runtime) ahead of libstdc++, as Path B links it: eccp puts -lC last, after -lstdc++, so `operator new`
#    came from libstdc++.so and threw a gcc-ABI std::bad_alloc that EDG's handlers cannot catch.
# With -fsanitize=address, the C++ VLA runtime (lib/asan/nfcxx_vla_asan.c, docs/notes/asan.md) goes ahead of libC.a: it
# defines the four VLA entry points, so EDG's allocator in libC.a is not linked.
shim=(); rtlib=(); vlart=()
if [ $freestanding = 0 ] && [ $compile_only = 0 ] && [ $shared = 0 ] && [ $((ncpp + nobj)) -gt 0 ]; then
  t=$(trace_start)
  s=$("$root/scripts/ehshim") || s=""
  trace_end "$t" "EH shim" driver
  [ -z "$s" ] || shim=("$s")
  # macOS and Linux aarch64: the thunks that pass the result of the library's class-returning functions in x8 (scripts/sret.sh)
  sret_obj=$("$root/scripts/sret.sh"); [ -z "$sret_obj" ] || shim+=("$sret_obj")
  rtlib=(-lC)
  if [ $asan = 1 ]; then
    t=$(trace_start)
    v=$("$root/scripts/asan-vla") || { echo "nfcxx: cannot build the C++ VLA runtime for -fsanitize=address (scripts/asan-vla)" >&2; exit 2; }
    trace_end "$t" "VLA runtime (asan)" driver
    vlart=("$v")
  fi
fi

# -fPIC / -rdynamic / -shared reach the C compiler and the link. EDG_OBJ_TO_EXEC_DEFAULT_OPTIONS replaces the
# options eccp gives its link command (default: the C compile options), so only -shared goes there.
picopts=(); ldopts=()
# -m options (ISA and target): the C compile gets them, and the front end gets the macros gcc predefines for them
# (gcc -mavx2 defines __AVX2__, which the intrinsic headers test). Each macro goes in files, as a -D option does, so
# eccp passes it to both the front end and the C compile. Macros with arguments are not passed.
if [ ${#isa[@]} -gt 0 ]; then
  for o in ${isa[@]+"${isa[@]}"}; do picopts+=(--c_to_obj_option "$o"); done
  while IFS= read -r d; do files+=("$d"); done < <(
    comm -13 <(gcc -dM -E -x c /dev/null | sort) <(gcc ${isa[@]+"${isa[@]}"} -dM -E -x c /dev/null | sort) \
      | sed -n 's/^#define \([^ (]*\) */-D\1=/p')
fi
[ $pic = 0 ] || { picopts=(--c_to_obj_option -fPIC); cflags_pic=(-fPIC); }
[ $rdynamic = 0 ] || picopts+=(--c_to_obj_option -rdynamic)
[ $pthread = 0 ] || picopts+=(--c_to_obj_option -pthread)
picopts+=(${pie_opts[@]+${pie_opts[@]+"${pie_opts[@]}"}})
for o in ${asan_c[@]+${asan_c[@]+"${asan_c[@]}"}}; do picopts+=(--c_to_obj_option "$o"); done
[ $shared = 0 ] || { export EDG_OBJ_TO_EXEC_DEFAULT_OPTIONS=-shared; ldopts=(-shared); }

# C inputs: compile each .c to an object. Link options (-l, -L, ...) stay in files for the final link.
cobjs=()
if [ ${#cfiles[@]} -gt 0 ]; then
  ctmp=$(mktemp -d); trap 'rm -rf "$ctmp" "$cudatmp"; trace_finish' EXIT
  n=0
  for c in ${cfiles[@]+"${cfiles[@]}"}; do
    o=$ctmp/$n.o; n=$((n + 1))
    t=$(trace_start)
    if [ $backend != gcc ]; then
      NFCXX_C_INPUT=1 "$NFCXX_CC" -c ${cflags[@]+${cflags[@]+"${cflags[@]}"}} "$c" -o "$o"
    else
      gcc -c -O2 -fwrapv -fno-strict-aliasing ${asan_c[@]+${asan_c[@]+"${asan_c[@]}"}} ${cflags_pic[@]+${cflags_pic[@]+"${cflags_pic[@]}"}} ${cflags[@]+${cflags[@]+"${cflags[@]}"}} "$c" -o "$o"
    fi
    trace_end "$t" "C input: $c" cinput
    cobjs+=("$o")
  done
  if [ $compile_only = 1 ] && [ $ncpp = 0 ]; then
    # -c with only C sources: the objects are the output (-o names the one object; otherwise each is <source>.o)
    [ $outset = 0 ] || [ ${#cobjs[@]} = 1 ] || { echo "nfcxx: -c with -o needs exactly one source" >&2; exit 2; }
    for i in "${!cobjs[@]}"; do
      dst=$out; [ $outset = 1 ] || dst=$(basename "${cfiles[$i]}" .c).o
      cp "${cobjs[$i]}" "$dst"
    done
    exit 0
  fi
  if [ $ncpp = 0 ] && { [ $nobj = 0 ] || [ ! -x "$edg/eccp" ]; }; then
    # Only C: link with the C compiler (qbe-cc adds -latomic for the QBE backend).
    t=$(trace_start)
    if [ $backend != gcc ]; then "$NFCXX_CC" ${ldopts[@]+${ldopts[@]+"${ldopts[@]}"}} ${cobjs[@]+"${cobjs[@]}"} ${files[@]+${files[@]+"${files[@]}"}} -o "$out"
    else gcc ${asan_c[@]+${asan_c[@]+"${asan_c[@]}"}} ${ldopts[@]+${ldopts[@]+"${ldopts[@]}"}} ${cobjs[@]+"${cobjs[@]}"} ${files[@]+${files[@]+"${files[@]}"}} -o "$out"; fi
    trace_end "$t" "link (C only)" cinput
    exit 0
  fi
fi

# Path B: no C is generated. Each C++ file goes EDG -> typed IR -> QBE -> object (scripts/pathb-cc), and the objects are
# linked with EDG's runtime (libC.a: exceptions, operator new) before libstdc++, as tests/pathb-qbe/run.sh links them.
if [ $backend = pathb ]; then
  ptmp=$(mktemp -d); trap 'rm -rf "$ptmp" "$cudatmp"; trace_finish' EXIT
  pobjs=(); plink=(); n=0
  for f in ${files[@]+"${files[@]}"}; do
    case $f in
      -I*|-D*|-U*) ;;                       # reach pathb-cc through cflags
      -*|*.o|*.a|*.so) plink+=("$f") ;;
      *) o=$ptmp/p$n.o; n=$((n + 1))
         t=$(trace_start)
         "$root/scripts/pathb-cc" "-std=c++${std#--c++}" ${cflags[@]+${cflags[@]+"${cflags[@]}"}} "$f" -o "$o"
         trace_end "$t" "Path B: $f" pathb
         pobjs+=("$o") ;;
    esac
  done
  t=$(trace_start)
  # libnfcxxld.a: the long double helpers and nothing else (scripts/pathb-ldrt, docs/notes/pathb-longdouble.md)
  ldrt=$("$root/scripts/pathb-ldrt")
  cc ${ldopts[@]+${ldopts[@]+"${ldopts[@]}"}} -o "$out" ${cobjs[@]+${cobjs[@]+"${cobjs[@]}"}} ${pobjs[@]+"${pobjs[@]}"} ${plink[@]+${plink[@]+"${plink[@]}"}} "$ldrt" ${shim[@]+${shim[@]+"${shim[@]}"}} -L"${EDG_BUILD:-$root/build/edg}/lib" -lC -lstdc++ -lgcc_s -lpthread -lm -latomic
  trace_end "$t" "link" pathb
  exit 0
fi

# With the gcc backend the generated C relies on C's UB rules (e.g. plain signed '+'), so make the C
# compiler give those operations defined behavior. -fkeep-static-functions keeps EDG's static __tls_init
# (thread_local dynamic initialization): it is referenced only through a top-level asm alias, which gcc
# -O2 does not count as a use, so it was dropped and the wrapper's call went unresolved.
# With --trace, eccp's own C compiler steps are child processes that record their spans too (qbe-cc).
eflist=(); userinc=()
# -fkeep-static-functions is a GCC option; clang (the C compiler on macOS) rejects it.
keep_static=(--c_to_obj_option -fkeep-static-functions)
"${NFCXX_GCC:-cc}" --version 2>/dev/null | head -1 | grep -qi clang && keep_static=()
for f in ${files[@]+${files[@]+"${files[@]}"}}; do
  case $f in
    # User -I dirs go before the host's --sys_include dirs: eccp searches them in command-line order, and GCC
    # searches -I before the system directories, so "error.h" from a file outside EDG's src/ must not pick
    # glibc's <error.h> (ifc_modules_templ.c, docs/notes/cxx-driver.md).
    -I?*) userinc+=("$(ecp_arg "$f")") ;;
    # -lcudart from a CUDA_HOME (the toolkit's or a PyPI-wheel directory): the binary records that directory's lib64 as
    # its runpath, so it loads the same libcudart it was linked against (not whichever one the loader finds first).
    -lcudart)
      [ -n "${CUDA_HOME:-}" ] && [ -d "$CUDA_HOME/lib64" ] && eflist+=(--c_to_obj_option "-Wl,-rpath,$CUDA_HOME/lib64")
      eflist+=("--c_to_obj_lib=cudart") ;;
    -l?*) eflist+=("--c_to_obj_lib=${f#-l}") ;;
    # eccp puts its --c_to_obj_option items before every object and archive, so a link option that acts on the
    # arguments after it would act on the wrong ones. Refused rather than moved (docs/notes/cxx-driver.md).
    -Wl,--whole-archive|-Wl,--whole-archive,*|-Wl,--no-whole-archive|-Wl,--no-whole-archive,*|\
-Wl,--start-group|-Wl,--start-group,*|-Wl,--end-group|-Wl,--end-group,*|-Wl,--as-needed|-Wl,--as-needed,*|\
-Wl,--no-as-needed|-Wl,--no-as-needed,*|-Wl,-Bstatic|-Wl,-Bstatic,*|-Wl,-Bdynamic|-Wl,-Bdynamic,*)
      echo "nfcxx: $f: an order-dependent link option cannot be kept with C++ inputs (docs/notes/cxx-driver.md)" >&2
      exit 2 ;;
    -Wl,*) eflist+=(--c_to_obj_option "$(ecp_arg "$f")") ;;   # -Wl,-rpath,DIR, -Wl,-E, ...: the host link (eccp's C compile options)
    *) eflist+=("$(ecp_arg "$f")") ;;
  esac
done
# -c: eccp writes the records of each source (<stem>.ti, the requests) beside its object, and the link reads them there. eccp
# adds to a .ti that exists, so the records of the sources being compiled are removed first and the compile starts clean
# (eccp keeps the old content of a .ti and writes the new record ahead of it). The first source takes the name of -o, as eccp names it.
if [ $compile_only = 1 ] && [ $ncpp -gt 0 ]; then
  first=1
  for s in ${srcs[@]+"${srcs[@]}"}; do
    b=$(basename "$s"); b=${b%.*}
    if [ $first = 1 ] && [ "$out" != "${out%.*}" ]; then b=${out%.*}; fi
    rm -f "$b.ii" "$b.ti"; first=0
  done
fi
link_records_rm() {  # link_records_rm: removes <stem>.ii beside each object of this link (see "A link writes" below)
  local f
  for f in ${files[@]+"${files[@]}"}; do
    case $f in *.o) rm -f "${f%.o}.ii" ;; esac
  done
}
# A link writes <stem>.ii beside each object it uses: the instances the link assigned to that object (the <stem>.ti requests
# stay). An assignment left by an earlier link can name an instance that a later link assigns to another object ("assigned
# to more than one file"), so these records are removed before the link and again once it succeeds (set -e: a failed link
# exits before the second removal).
link_records_rm
# Compile cache (opt-in: NFCXX_CACHE=DIR). A -c compile of one C++ source with -o is kept in DIR/objects under a key of
# everything that can change the object: the command as given, the absolute output path (the prelinker records it in the
# object's .ti), the working directory, the source and each header the host preprocessor lists (-M), the NFCXX_* environment,
# the driver and its scripts, the EDG and QBE binaries, and the host compilers. A hit copies the object back with its
# <stem>.ti and <stem>.ii, which the link reads beside it. Not cached: .cu, C and -E inputs, -MD (its dependency file), several
# sources in one command, and an -o without an extension. A file name with spaces in the header list is not handled.
cache_sha() { if command -v sha256sum >/dev/null 2>&1; then sha256sum; else shasum -a 256; fi; }
cache_log() {  # cache_log TEXT: appends TEXT as one write to NFCXX_CACHE_LOG when it is set (a diagnostic; no effect on the key).
  # Parallel compiles share the file, so each append takes a lock (mkdir, which is portable) and is a single printf.
  [ -n "${NFCXX_CACHE_LOG:-}" ] || return 0
  while ! mkdir "$NFCXX_CACHE_LOG.lock" 2>/dev/null; do sleep 0.05; done
  printf '%s\n' "$*" >> "$NFCXX_CACHE_LOG"
  rmdir "$NFCXX_CACHE_LOG.lock"
}
cache_lookup() {  # cache_lookup SRC OUT: prints the key, or fails when the headers cannot be listed. With NFCXX_CACHE_LOG
  # the whole lookup is logged in one write: the output, the key inputs, the key, and hit or miss.
  local src=$1 out=$2 deps f pre=() inputs key state
  for f in ${preinc[@]+"${preinc[@]}"}; do pre+=(-include "$f"); done
  deps=$("${NFCXX_CXX:-g++}" -M "-std=${std#--}" ${cflags[@]+"${cflags[@]}"} ${pre[@]+"${pre[@]}"} ${sysdirs[@]+"${sysdirs[@]/#/-isystem}"} "$src" 2>/dev/null) || return 1
  deps=$(sed 's/\\$//' <<<"$deps" | tr ' ' '\n' | sed '/^$/d' | tail -n +2)
  inputs=$({
    printf 'nfcxx-cache-1\nargv:'; printf ' %q' "${nfcxx_argv[@]}"; printf '\ncwd: %s\nout: %s\nsrc: %s\n' "$PWD" "$(realpath -m "$out")" "$(realpath -m "$src")"
    (env | grep '^NFCXX_' | grep -v '^NFCXX_CACHE_LOG=' || true) | LC_ALL=C sort   # the log is a diagnostic: it must not change the key
    cache_sha < "$root/nfcxx"
    find "$root/scripts" -type f -print0 | LC_ALL=C sort -z | xargs -0 cat | cache_sha
    find "$edg" -maxdepth 1 -type f -print0 | LC_ALL=C sort -z | xargs -0 cat | cache_sha
    for f in "$root/build/qbe/qbe" "$root/build/cproc/cproc"; do [ ! -f "$f" ] || cache_sha < "$f"; done
    # The EDG driver: the eccp script and environment that the wrapper (bin/eccp) runs and sources, and the configuration it reads
    for f in "$(sed -n 's/^exec "\([^"]*\)".*/\1/p' "$edg/eccp" 2>/dev/null)" "$(sed -n 's/^\. "\([^"]*\)".*/\1/p' "$edg/eccp" 2>/dev/null)" \
             "${EDG_BASE:-$root/build/edg-base}/edg_eccp_config"; do
      if [ -f "$f" ]; then cache_sha < "$f"; else echo "missing $f"; fi
    done
    "${NFCXX_CXX:-g++}" --version | head -1; cc --version | head -1
    for f in $deps; do printf '%s ' "$f"; if [ -f "$f" ]; then cache_sha < "$f"; else echo missing; fi; done
  })
  key=$(printf '%s\n' "$inputs" | cache_sha | cut -c1-40)
  state=miss; [ ! -f "$NFCXX_CACHE/objects/$key/obj" ] || state=hit
  cache_log "== $out ($src)"$'\n'"$inputs"$'\n'"key $key"$'\n'"$state"
  printf '%s\n' "$key"
}
cache_entry=""
if [ -n "${NFCXX_CACHE:-}" ] && [ $compile_only = 1 ] && [ $ncpp = 1 ] && [ $outset = 1 ] && [ $nobj = 0 ] && [ ${#cfiles[@]} = 0 ] \
   && [ ${#cu_inputs[@]} = 0 ] && [ -z "$depmode" ] && [ $preprocess = 0 ] && [ $stdin_src = 0 ] && [ "$out" != "${out%.*}" ]; then
  if key=$(cache_lookup "${srcs[0]}" "$out") && [ -n "$key" ]; then
    cache_entry=$NFCXX_CACHE/objects/$key
    if [ -f "$cache_entry/obj" ]; then
      rm -f "${out%.*}.ti" "${out%.*}.ii"
      cp "$cache_entry/obj" "$out"
      for x in ti ii; do [ ! -f "$cache_entry/$x" ] || cp "$cache_entry/$x" "${out%.*}.$x"; done
      exit 0
    fi
  fi
fi
# The one-step build: eccp runs in a temporary directory (see ecp_arg), so its paths are made absolute before the cd.
eccp_bin=$(ecp_arg "$edg/eccp"); eccp_out=$(ecp_arg "$out")
if [ $moves = 1 ]; then
  eccp_dir=$(mktemp -d); trap eccp_cleanup EXIT
  [ "${NFCXX_KEEP_INTERMEDIATES:-}" != 1 ] || echo "nfcxx: intermediates kept in $eccp_dir (NFCXX_KEEP_INTERMEDIATES=1)" >&2
fi
t=$(trace_start)
(
  [ -z "$eccp_dir" ] || cd "$eccp_dir"
  "$eccp_bin" "$std" --"$dialect" ${extra[@]+"${extra[@]}"} ${userinc[@]+${userinc[@]+"${userinc[@]}"}} ${sys_inc[@]+"${sys_inc[@]}"} ${hosted_libs[@]+"${hosted_libs[@]}"} --c_to_obj_option -O2 --c_to_obj_option -fwrapv --c_to_obj_option -fno-strict-aliasing ${keep_static[@]+${keep_static[@]+"${keep_static[@]}"}} --c_to_obj_option -fgnu89-inline ${picopts[@]+${picopts[@]+"${picopts[@]}"}} \
    ${cobjs[@]+${cobjs[@]+"${cobjs[@]}"}} ${pre_opts[@]+${pre_opts[@]+"${pre_opts[@]}"}} ${cuda_opts[@]+${cuda_opts[@]+"${cuda_opts[@]}"}} ${eflist[@]+${eflist[@]+"${eflist[@]}"}} ${shim[@]+${shim[@]+"${shim[@]}"}} ${vlart[@]+${vlart[@]+"${vlart[@]}"}} ${rtlib[@]+${rtlib[@]+"${rtlib[@]}"}} -o "$eccp_out"
)
trace_end "$t" "eccp (front end, C compile, link)" eccp
link_records_rm
if [ -n "$cache_entry" ] && [ ! -f "$cache_entry/obj" ]; then   # a whole entry appears at once: a partial copy is never a hit
  ctmp=$cache_entry.tmp.$$; mkdir -p "$ctmp" "$(dirname "$cache_entry")"
  cp "$out" "$ctmp/obj"
  for x in ti ii; do [ ! -f "${out%.*}.$x" ] || cp "${out%.*}.$x" "$ctmp/$x"; done
  [ -e "$cache_entry" ] || mv "$ctmp" "$cache_entry" 2>/dev/null
  rm -rf "$ctmp"
fi
if [ -n "$depmode" ]; then
  # -MD/-MMD (with -MF/-MT/-MQ/-MP): the host preprocessor writes the dependency file, as nfcc does for C.
  df=${dfile:-${out%.*}.d}; tgt=${dtarget:-$out}
  mflag=-M; [ "$depmode" = -MMD ] && mflag=-MM
  "${NFCXX_CXX:-g++}" $mflag $depphony -MT "$tgt" -MF "$df" "-std=${std#--}" ${cflags[@]+${cflags[@]+"${cflags[@]}"}} \
    ${sysdirs[@]+"${sysdirs[@]/#/-isystem}"} ${srcs[@]+${srcs[@]+"${srcs[@]}"}}
fi
