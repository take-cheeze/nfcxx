#!/usr/bin/env bash
# nfcxx: experimental C++ compiler driver.
#   Path A: C++ --(EDG front end)--> C --(host C compiler)--> executable
# Usage: nfcxx [--emit-c] [--backend=qbe|gcc|pathb] [--dialect=g++|clang] [--gnu-version=N] [--freestanding]
#   Hosted (default): host C++ headers and GNU version from g++ (see host_sys_includes below).
#              [-o out] [-std=c++NN] file.cpp...
#   qbe (default): generated C -> cproc -> QBE -> asm      (scripts/setup-qbe.sh)
#   gcc:           generated C -> gcc -O2 -fwrapv -fno-strict-aliasing
#   pathb:         (opt-in; also NFCXX_PATH=b) EDG lowered IL -> typed IR -> QBE, no generated C. Hosted programs only.
#                  Needs the Path B harness (scripts/setup-pathb.sh, PATHB_CPFE/PATHB_BASE); docs/notes/pathb-hosted.md.
#   --dialect:     EDG front-end mode (default g++; NFCXX_DIALECT overrides the default)
#   --gnu-version: GCC version the g++ front end emulates, e.g. 130000 (EDG default when unset)
#   -fsanitize=undefined|CHECK[,CHECK...]: the undefined behavior sanitizer (docs/notes/ubsan.md). Implies Path B, whose IR has the
#                  checks; a failing check prints "file:line: runtime error: ..." and aborts. -fno-sanitize=all turns it off.
#   file.cpp2:     Cpp2 source, experimental: cppfront (build/cppfront, scripts/setup-cppfront.sh) translates it to C++ first.
#                  docs/notes/cpp2.md.
#   --trace=FILE: write a Chrome trace-event JSON file (open in ui.perfetto.dev); NFCXX_TRACE=FILE too.
#   --module-dir=DIR: where C++ module interface files (NAME.eifc) are written and read; the default is the directory of -o.
#                  A program with `export module` or `import` is built one source at a time (docs/notes/modules.md).
#   NFCXX_CUDA_HOST_SYMBOLS=FILE: internal (the second pass of a .cu compile, see "Kernel instances from the host
#                  compile" below): the demangled symbols of the first pass's output, for the device rewrite.
#   NFCXX_KEEP_INTERMEDIATES=1: a compile and link keeps its intermediates (the .o files, <stem>.ii, <stem>.ti) in the
#                  temporary directory the driver names on stderr, instead of removing it on exit. A -c compile keeps
#                  <stem>.ii and <stem>.ti beside its object in any case: the link that follows reads them there.
#   -shared [-fPIC] [-rdynamic]: build a shared object (-shared implies -fPIC); -rdynamic exports an
#                  executable's symbols so a dlopen'd object can bind to them. See docs/notes/eval.md.
#   --bundle-libs [--bundle-exclude=NAME,...] [--bundle-only=NAME,...]: after the link, the shared libraries the output
#                  needs (libstdc++, libgcc_s, the program's own; never glibc) are copied into it, so it runs without them
#                  (tools/bundle, docs/notes/bundle.md). Executables and -shared objects.
#   --cuda-driver=auto|cudart|libcuda: a link that names libcuda (-lcuda, CMake's CUDA::cuda_driver path) reaches the
#                  CUDA driver API through libcudart instead (default auto; scripts/cuda-driver-wrap.sh,
#                  docs/notes/cuda-driver.md); NFCXX_CUDA_DRIVER= for every command.
#   -c / *.o:      separate compilation: `nfcxx -c a.cpp -o a.o`, then `nfcxx a.o b.o -o x` links objects (docs/notes/multi-tu.md).
#   NFCXX_LD=NAME: link with -fuse-ld=NAME (mold, lld, gold, bfd; needs ld.NAME on PATH). Default: the system linker.
#   NFCXX_CACHE=DIR: keeps each -c compile in DIR and takes it back when nothing it depends on changed (docs/notes/cxx-driver.md).
#   NFCXX_CACHE_LOG=FILE: with NFCXX_CACHE, appends each lookup's key inputs, its key, and hit or miss to FILE, to diff a miss against a hit.
#   -fsanitize=address: AddressSanitizer (heap/stack/global overflow, use-after-free, double free, leaks). The gcc and qbe
#                  backends instrument the code; Path B is refused. docs/notes/asan.md. -fno-sanitize=address undoes it;
#                  other -fsanitize= values are refused.
#   --freestanding: headers come only from lib/ (no EDG std headers, no hosted libc++/libstdc++),
#                  and --gnu-version defaults to 130000. Opt-in; see docs/notes/freestanding.md.
#   --target=NAME: with --freestanding and --emit-c only. The front end lays out the program for an EDG target (sizes,
#                  predefined macros) instead of the build host: linux_aarch64, linux_armv7, linux_riscv64, linux_riscv32,
#                  linux_i686, win64 (MinGW's macros when MinGW is installed at setup; docs/notes/freestanding.md, "Windows"), win32. The generated C is for that target, so the
#                  host cc must not compile it: give it to a cross compiler. docs/notes/freestanding.md, "Targets".
set -euo pipefail
root=$(cd "$(dirname "$0")" && pwd)
source "$root/scripts/bundle-wrap.sh"; bundle_wrap "$root/nfcxx" "$@"   # --bundle-libs (docs/notes/bundle.md)
source "$root/scripts/cuda-driver-wrap.sh"; cuda_driver_wrap "$root/nfcxx" "$@"   # --cuda-driver= (docs/notes/cuda-driver.md)
set -- ${cuda_driver_args[@]+"${cuda_driver_args[@]}"}
source "$root/scripts/trace.sh"
edg=${EDG_BUILD:-$root/build/edg}/bin

source "$root/scripts/host-sys.sh"   # host_dialect, host_clang_version, host_sys_includes, host_gnu_version
sanitize=""
std=--c++23; out=a.out; emit_c=0; backend=${NFCXX_BACKEND:-qbe}; files=()
cfiles=(); cflags=(); cflags_pic=(); ncpp=0; nobj=0
shared=0; pic=0; rdynamic=0; compile_only=0
asan=0; backend_explicit=0; asanopts=()
dialect=${NFCXX_DIALECT:-$(host_dialect)}; freestanding=0; gnu=""; trace=${NFCXX_TRACE:-}; target=""
# CUDA kernel names are obfuscated (docs/notes/gpu.md, "Kernel name obfuscation"): --obfuscate-kernels, or NFCXX_OBFUSCATE_KERNELS=1
# in the environment (which reaches a CMake build through nfcxx-cuda without any change to its command line).
obfuscate=0; case ${NFCXX_OBFUSCATE_KERNELS:-0} in 0|"") ;; *) obfuscate=1 ;; esac
# Compiler-driver options a build system passes (CMake, ninja, make; mruby's rake build). See docs/notes/cxx-driver.md.
pthread=0; preprocess=0; outset=0; depmode=""; dfile=""; dtarget=""; depphony=""
moddir=""   # --module-dir=DIR: where C++ module interface files are written and read (docs/notes/modules.md)
sysdirs=(); srcs=(); ppflags=(); pie_opts=(); xlang=""; stdin_src=0; preinc=(); isa=(); cuda_opts=()
# A .cu input is rewritten to C++ before the front end (tools/cuda-rewrite: launches become calls of
# __nfcxx_cuda_launch), and the runtime helper lib/cuda/nfcxx_cuda.h is included first. The copy goes in a temp
# directory that the EXIT traps below remove. Its basename is the source's, so default output names are unchanged.
cudatmp=""
# Device code of a .cu file: its __global__ and __device__ functions go through the Path B front end
# (scripts/pathb-dump), the IR-to-PTX emitter (tools/pathb-ptx-emit) and ptxas for NFCXX_SM (default 75). The kernels
# are split into modules within NFCXX_CUDA_MAX_CONST_BYTES (65536: ptxas's limit on constant data) and
# NFCXX_CUDA_MAX_PTX_LINES; each module is one cubin (a file that fits has one). The cubins are embedded at the end of
# the host copy with a registration tail (pathb-ptx-emit --embed), so the one object holds the host code and its device
# images. A file with no kernel gets no device image.
# The rewritten copy of each .cu input is made after the arguments are read (cu_prepare), so that -c and -o are known:
# with -c the copy goes to the per-user cache (see cu_prepare), not to the user's tree. Otherwise it goes in a temp directory.
cu_inputs=()
cu_keep=""   # with -c: the directory the device images are kept in (the link re-reads the copy, and the copy names them)
cu_prepare() {  # cu_prepare: rewrites every .cu input and puts its copy in srcs and files in place of the source
  [ ${#cu_inputs[@]} -gt 0 ] || return 0
  cudatmp=$(mktemp -d); trap 'rm -rf "$cudatmp"' EXIT
  local dir=$cudatmp
  if [ $compile_only = 1 ]; then
    # The copy must outlive the compile: the prelinker re-reads it when it needs a template instance at link time,
    # and a failed link deletes the objects. It goes to a per-user cache, keyed by the absolute object path, and the
    # object records that absolute path, so the link finds it from any directory.
    local obj=$out; [ $outset = 1 ] || obj=$(basename "${cu_inputs[0]}" .cu).o
    local key; key=$(realpath -m "$obj" | sha1sum | cut -c1-16)
    dir=${NFCXX_CU_CACHE:-${XDG_CACHE_HOME:-${HOME:-/tmp}/.cache}/nfcxx}/cu/$key
    mkdir -p "$dir"
    cu_keep=$dir
  fi
  local src copy i sdir
  for src in ${cu_inputs[@]+"${cu_inputs[@]}"}; do
    # The copy is not next to the source, so quoted includes that are relative to the source (`#include "../x.cuh"`
    # in a .cu, and in the headers it includes) are found through the source's own directory, as a user -I.
    sdir=$(realpath -- "$(dirname -- "$src")")
    cflags+=("-I$sdir"); files+=("-I$sdir")
    copy=$dir/$(basename "$src" .cu).cpp
    cu_rewrite "$src" "$copy"
    # if, not `[ ] && x`: a loop whose last test fails returns non-zero, and set -e would end the driver.
    for i in "${!srcs[@]}"; do if [ "${srcs[$i]}" = "$src" ]; then srcs[$i]=$copy; fi; done
    for i in "${!files[@]}"; do if [ "${files[$i]}" = "$src" ]; then files[$i]=$copy; fi; done
  done
}
# A .cpp2 input (experimental, docs/notes/cpp2.md) is translated to C++1 by cppfront (scripts/setup-cppfront.sh) before the
# front end, the way .cu inputs are rewritten: the copy has the source's basename, so default output names are unchanged, and
# its #line directives name the .cpp2 file. cppfront writes cpp2_post_build.sh into its working directory, so it runs in a
# scratch directory. The metaclass build steps that file would hold are not run. cpp2util.h, which the copy includes, comes from the pinned source.
cpp2_inputs=()
cpp2_prepare() {  # cpp2_prepare: translates every .cpp2 input and puts its translation in srcs and files in place of the source
  [ ${#cpp2_inputs[@]} -gt 0 ] || return 0
  local cppfront_src=${CPPFRONT_SRC:-$root/build/cppfront-src}
  [ -x "$root/build/cppfront" ] || { echo "nfcxx: cppfront is not built; run scripts/setup-cppfront.sh (docs/notes/cpp2.md)" >&2; exit 2; }
  [ -f "$cppfront_src/include/cpp2util.h" ] || { echo "nfcxx: no cpp2util.h under $cppfront_src; run scripts/setup-cppfront.sh" >&2; exit 2; }
  if [ -z "${cudatmp:-}" ]; then cudatmp=$(mktemp -d); trap 'rm -rf "$cudatmp"' EXIT; fi
  local dir=$cudatmp
  if [ $compile_only = 1 ]; then
    # As for .cu inputs (cu_prepare): the translation outlives the compile, because the prelinker re-reads it at link time.
    local obj=$out; [ $outset = 1 ] || obj=$(basename "${cpp2_inputs[0]}" .cpp2).o
    local key; key=$(realpath -m "$obj" | sha1sum | cut -c1-16)
    dir=${NFCXX_CU_CACHE:-${XDG_CACHE_HOME:-${HOME:-/tmp}/.cache}/nfcxx}/cpp2/$key
    mkdir -p "$dir"
  fi
  local scratch; scratch=$(mktemp -d -p "$cudatmp")
  local src sdir copy i
  for src in "${cpp2_inputs[@]}"; do
    # The translation is not next to the source, so quoted includes relative to the source are found through its directory.
    sdir=$(realpath -- "$(dirname -- "$src")")
    cflags+=("-I$sdir"); files+=("-I$sdir")
    copy=$dir/$(basename "$src" .cpp2).cpp
    local abs; abs=$(realpath -- "$src")   # before the cd: a relative source is relative to the caller's directory
    (cd "$scratch" && "$root/build/cppfront" -q -o "$copy" "$abs") || exit $?
    for i in "${!srcs[@]}"; do if [ "${srcs[$i]}" = "$src" ]; then srcs[$i]=$copy; fi; done
    for i in "${!files[@]}"; do if [ "${files[$i]}" = "$src" ]; then files[$i]=$copy; fi; done
  done
  cflags+=("-I$cppfront_src/include"); files+=("-I$cppfront_src/include")
}
# A CUDA_HOME outside /usr is still a system directory for the rewriter (its headers are not inlined into the device unit),
# so a CUDA_HOME-shaped directory from PyPI wheels (scripts/fetch-cudart-wheel.sh) behaves like the toolkit's.
[ -n "${CUDA_HOME:-}" ] && export NFCXX_SYSTEM_PATHS="$CUDA_HOME${NFCXX_SYSTEM_PATHS:+:$NFCXX_SYSTEM_PATHS}"
# ensure_tool DIR OUT: builds the repo tool in DIR (its build.ninja) into OUT on first use. The driver runs in parallel
# (one process per source file), so the build is serialized by a lock directory: the first run builds, the others wait
# and find OUT. ninja's output is not hidden: a failed build says why.
ensure_tool() {
  local dir=$1 out=$2 lock=$2.lock waited=0
  [ -x "$out" ] && return 0
  while ! mkdir "$lock" 2>/dev/null; do
    [ -x "$out" ] && return 0
    sleep 0.2; waited=$((waited + 1))
    [ "$waited" -lt 3000 ] || { echo "nfcxx: $lock is stuck (remove it if no build is running)" >&2; return 1; }
  done
  local rc=0
  [ -x "$out" ] || ninja -C "$dir" >&2 || rc=$?
  rmdir "$lock"
  return $rc
}
# The rewriter: the C++ tool (build/cuda-rewrite, built from tools/cuda-rewrite on first use).
ensure_tool "$root/tools/cuda-rewrite" "$root/build/cuda-rewrite" || exit $?
rewriter=("$root/build/cuda-rewrite")
cu_rewrite() {  # cu_rewrite FILE.cu COPY: writes the rewritten copy to COPY, with the device image appended
  local src=$1 copy=$2
  local base; base=$(basename "$src" .cu)
  # The -I directories: the rewriter inlines the project headers they name (quoted and angle-bracket includes).
  local incs=(); local f; for f in ${cflags[@]+${cflags[@]+"${cflags[@]}"}}; do case $f in -I*) incs+=("$f");; esac; done
  # The -D and -U options: the host compile gets them, and the device pass resolves its conditionals with them, so both
  # copies agree on every #if the defines decide.
  local defs_opts=(); for f in ${cflags[@]+${cflags[@]+"${cflags[@]}"}}; do case $f in -D*|-U*) defs_opts+=("$f");; esac; done
  # The toolkit's version macros, for the device pass only: the host copy has them from the CUDA headers, the device unit
  # includes none, and code tests them in #if (ggml-cuda's GGML_CUDA_USE_CUB is CUDART_VERSION >= 11070; without the
  # value the host launched CUB-path kernels whose device bodies were the other branch). Read from the headers the host
  # compile finds first (the -I directories, then CUDA_HOME); a -D of the same name on the command line wins.
  local ver_opts=() d m v
  for d in ${incs[@]+"${incs[@]#-I}"} "${CUDA_HOME:-/usr/local/cuda}/include"; do
    [ -f "$d/cuda_runtime_api.h" ] || continue
    for m in CUDART_VERSION:cuda_runtime_api.h CUDA_VERSION:cuda.h; do
      case " ${defs_opts[*]+${defs_opts[*]}} " in *" -D${m%%:*}="*|*" -D${m%%:*} "*|*" -U${m%%:*} "*) continue ;; esac
      v=$(sed -n "s/^#define ${m%%:*}  *\([0-9][0-9]*\).*/\1/p" "$d/${m#*:}" 2>/dev/null | head -1)
      [ -z "$v" ] || ver_opts+=("-D${m%%:*}=$v")
    done
    break
  done
  # Kernel name obfuscation: one seed for both copies of the file (the host copy and the device unit must agree).
  local obf=(); if [ "$obfuscate" = 1 ]; then obf=(--obfuscate="${NFCXX_OBFUSCATE_SEED:-$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')}"); fi
  # The front end parses the plain kernel launches (EDG --cuda, 3rd/edg); the rewriter leaves them. Launches with
  # template arguments are still rewritten here, and the device unit is unchanged. On by default, for .cu inputs only
  # (this function); NFCXX_CUDA_EDG_LAUNCH=0 restores the rewriter's own launch rewrite.
  local rw=()
  if [ "${NFCXX_CUDA_EDG_LAUNCH:-1}" = 1 ]; then
    rw+=(--edg-launches)
    # An eccp argument, not the environment: the prelinker re-runs the front end on this copy at link time with the
    # options recorded at compile time, and it must see --cuda there too (see the eccp call below).
    cuda_opts=(--cuda)
  fi
  ${rewriter[@]+"${rewriter[@]}"} ${incs[@]+${incs[@]+"${incs[@]}"}} ${defs_opts[@]+${defs_opts[@]+"${defs_opts[@]}"}} ${obf[@]+"${obf[@]}"} ${rw[@]+${rw[@]+"${rw[@]}"}} "$src" > "$copy" || exit $?
  case " ${preinc[*]+${preinc[*]}} " in *" $root/lib/cuda/nfcxx_cuda.h "*) ;; *) preinc+=("$root/lib/cuda/nfcxx_cuda.h") ;; esac
  local dev=$cudatmp/$base.dev sm=${NFCXX_SM:-75} ptxas=${NFCXX_PTXAS:-${CUDA_HOME:-/usr/local/cuda}/bin/ptxas}
  ${rewriter[@]+"${rewriter[@]}"} ${incs[@]+${incs[@]+"${incs[@]}"}} ${defs_opts[@]+${defs_opts[@]+"${defs_opts[@]}"}} ${ver_opts[@]+"${ver_opts[@]}"} ${obf[@]+"${obf[@]}"} ${NFCXX_CUDA_HOST_SYMBOLS:+"--host-symbols=$NFCXX_CUDA_HOST_SYMBOLS"} --device --kernels="$dev.kernels" "$src" > "$dev.cpp" || exit $?
  [ -s "$dev.kernels" ] || return 0
  NFCXX_PATHB_CUDA=1 "$root/scripts/pathb-dump" ${defs_opts[@]+${defs_opts[@]+"${defs_opts[@]}"}} ${ver_opts[@]+"${ver_opts[@]}"} --ir --freestanding "$dev.cpp" > "$dev.ir" \
    || { echo "nfcxx: $src: device code: the front end refused it (see above; needs scripts/setup-pathb.sh)" >&2; exit 2; }
  # The kernels are the names the rewriter listed (its launches); the emitter lowers only what they reach.
  kopts=(); while IFS= read -r k; do [ -n "$k" ] && kopts+=(--kernel="$k"); done < "$dev.kernels"
  ensure_tool "$root/tools/pathb-ptx-emit" "$root/build/pathb-ptx-emit" || exit 1
  # The kernels are partitioned into modules within the budgets (NFCXX_CUDA_MAX_CONST_BYTES: the constant data a module
  # references, 64 KB is ptxas's limit; NFCXX_CUDA_MAX_PTX_LINES: its functions). A file that fits one module has one
  # group. Each group is one PTX module: $base.groups/gNNNN.ptx and its kernels in groups.txt.
  # The images are the copy's .incbin files: with -c they are kept beside the copy, which the link re-reads (cu_prepare).
  local groups=${cu_keep:-$cudatmp}/$base.groups
  rm -rf "$groups"
  "$root/build/pathb-ptx-emit" --emit --sm=$sm --f2i=convert --groups-dir="$groups" \
    --max-const-bytes=${NFCXX_CUDA_MAX_CONST_BYTES:-65536} --max-ptx-lines=${NFCXX_CUDA_MAX_PTX_LINES:-60000} \
    ${kopts[@]+${kopts[@]+"${kopts[@]}"}} "$dev.ir" || exit $?
  # NFCXX_CUDA_JIT=1: the image of each group is its PTX text, loaded by the runtime's JIT (cudaLibraryLoadData); ptxas is not run.
  local ext=cubin g
  if [ "${NFCXX_CUDA_JIT:-0}" = 1 ]; then
    ext=ptx
  else
    # The groups are independent: assemble them NFCXX_PTXAS_JOBS at a time (default 4; each ptxas is ~170 MB at 8 kernels).
    ls "$groups"/g*.ptx | xargs -P "${NFCXX_PTXAS_JOBS:-4}" -I{} sh -c 'f=$1; "$2" -arch=sm_$3 "$f" -o "${f%.ptx}.cubin"' _ {} "$ptxas" "$sm" || exit $?
  fi
  "$root/build/pathb-ptx-emit" --embed --groups="$groups" --ext=$ext "$dev.ir" "$dev.kernels" "$dev.kernels.addr" >> "$copy" || exit $?
}
# A compile and link (or a link of objects) runs eccp in a temporary directory, which the EXIT trap removes. eccp writes
# <stem>.o, <stem>.ii and <stem>.ti into its working directory, and the prelinker reads the .ii and .ti there, so the
# records of one build could be read by the next build in the same directory. The arguments of such a run are made
# absolute first (ecp_arg), because its working directory changes. A -c compile is not moved: the link that follows reads
# its <stem>.ii and <stem>.ti beside the object (see "-c" before the eccp call).
moves=0; eccp_dir=""
ecp_arg() {  # ecp_arg ARG: ARG as eccp receives it (its paths absolute when eccp runs in the temporary directory)
  if [ $moves = 0 ]; then printf '%s\n' "$1"; return 0; fi
  case $1 in
    -I?*) printf -- '-I%s\n' "$(abs_path "${1#-I}")" ;;
    -L?*) printf -- '-L%s\n' "$(abs_path "${1#-L}")" ;;
    -Wl,*)   # a file named in a link option (-Wl,--version-script=FILE, -Wl,-T,FILE) is made absolute when it exists here
      local res=-Wl p parts=()
      IFS=, read -r -a parts <<< "${1#-Wl,}"
      for p in ${parts[@]+"${parts[@]}"}; do
        case $p in
          # Files the link writes (CMake 4 passes -Wl,--dependency-file=CMakeFiles/T.dir/link.d): absolute when their
          # directory exists here, since they do not exist yet.
          --dependency-file=*|-Map=*|--Map=*)
            if [ -e "${p#*=}" ] || [ -d "$(dirname -- "${p#*=}")" ]; then
              p="${p%%=*}=$(abs_path "$(dirname -- "${p#*=}")")/$(basename -- "${p#*=}")"
            fi ;;
          *=*) if [ -e "${p#*=}" ]; then p="${p%%=*}=$(abs_path "${p#*=}")"; fi ;;
          *) if [ -e "$p" ]; then p=$(abs_path "$p"); fi ;;
        esac
        res+=",$p"
      done
      printf '%s\n' "$res" ;;
    -*) printf '%s\n' "$1" ;;
    *) printf '%s\n' "$(abs_path "$1")" ;;
  esac
}
eccp_cleanup() {  # the EXIT trap of a build that runs eccp in a temporary directory (and of the C-input and .cu steps)
  local rc=$?
  if [ -n "$eccp_dir" ] && [ "${NFCXX_KEEP_INTERMEDIATES:-}" != 1 ]; then rm -rf "$eccp_dir"; fi
  if [ -n "${cudatmp:-}" ]; then rm -rf "$cudatmp"; fi
  if [ -n "${ctmp:-}" ]; then rm -rf "$ctmp"; fi
  trace_finish
  return $rc
}
# C++ modules (docs/notes/modules.md). mod_decl_name FILE prints NAME for an interface unit (export module NAME;); mod_imports FILE
# prints the names it imports (import NAME;). Both read the declarations at the start of a line only.
mod_is_module_src() {  # mod_is_module_src FILE: true when FILE declares a module or imports one
  grep -Eq '^[[:space:]]*(export[[:space:]]+)?(module|import)[[:space:]]+[A-Za-z_<"]' "$1"
}
mod_decl_name() {
  awk '/^[ \t]*export[ \t]+module[ \t]+[A-Za-z_][A-Za-z0-9_.]*[ \t]*;/ {
         sub(/^[ \t]*export[ \t]+module[ \t]+/, ""); sub(/[ \t]*;.*/, ""); print; exit }' "$1"
}
mod_imports() {
  awk '/^[ \t]*(export[ \t]+)?import[ \t]+[A-Za-z_][A-Za-z0-9_.]*[ \t]*;/ {
         sub(/^[ \t]*(export[ \t]+)?import[ \t]+/, ""); sub(/[ \t]*;.*/, ""); print }' "$1"
}
mod_check_src() {  # mod_check_src FILE: refuses the module features that are not built yet
  if grep -Eq '^[[:space:]]*(export[[:space:]]+)?module[[:space:]]+[A-Za-z_][A-Za-z0-9_.]*[[:space:]]*:' "$1"; then
    echo "nfcxx: $1: module partitions are not supported yet (docs/notes/modules.md)" >&2; exit 2
  fi
  if grep -Eq '^[[:space:]]*(export[[:space:]]+)?import[[:space:]]+[<"]' "$1"; then
    echo "nfcxx: $1: header units are not supported yet (docs/notes/modules.md)" >&2; exit 2
  fi
  local d
  for d in $(mod_imports "$1"); do
    case $d in std|std.*) echo "nfcxx: $1: import $d: the standard library modules are not built yet (docs/notes/modules.md)" >&2; exit 2 ;; esac
  done
}
# mod_build_program: a program with modules is compiled one source at a time (EDG takes one translation unit per call with
# modules on), the interface units first in dependency order, and the objects are then linked. Each step is this driver again.
mod_build_program() {
  local mdir ifaces=() others=() ordered=() rest=() s d o n=0 ready progress all=" " done_names=" "
  local objs=() compile_args=() link_args=() a x is_src skip=0
  mtmp=$(mktemp -d); trap 'rm -rf "$mtmp"' EXIT
  mdir=${moddir:-$mtmp}
  for s in ${srcs[@]+"${srcs[@]}"}; do
    mod_check_src "$s"
    if [ -n "$(mod_decl_name "$s")" ]; then ifaces+=("$s"); all+="$(mod_decl_name "$s") "; else others+=("$s"); fi
  done
  while [ ${#ifaces[@]} -gt 0 ]; do
    progress=0; rest=()
    for s in "${ifaces[@]}"; do
      ready=1
      for d in $(mod_imports "$s"); do
        case $all in *" $d "*) case $done_names in *" $d "*) ;; *) ready=0 ;; esac ;; esac
      done
      if [ $ready = 1 ]; then ordered+=("$s"); done_names+="$(mod_decl_name "$s") "; progress=1; else rest+=("$s"); fi
    done
    [ $progress = 1 ] || { echo "nfcxx: cyclic module imports among: ${rest[*]}" >&2; exit 2; }
    ifaces=(${rest[@]+"${rest[@]}"})
  done
  ordered+=(${others[@]+"${others[@]}"})
  # The options of each step: the compile gets everything but the link-only ones, the link gets everything but the sources.
  for a in ${nfcxx_argv[@]+"${nfcxx_argv[@]}"}; do
    if [ $skip = 1 ]; then skip=0; continue; fi
    is_src=0; for x in ${srcs[@]+"${srcs[@]}"}; do [ "$x" = "$a" ] && is_src=1; done
    [ $is_src = 0 ] || continue
    case $a in
      -o) skip=1 ;;
      -c|--module-dir=*) ;;
      -l?*|-L?*|-Wl,*|*.o|*.a|*.so) link_args+=("$a") ;;
      *) compile_args+=("$a"); link_args+=("$a") ;;
    esac
  done
  for s in ${ordered[@]+"${ordered[@]}"}; do
    o=$mtmp/m$n.o; n=$((n + 1))
    "$root/nfcxx" -c "$s" -o "$o" --module-dir="$mdir" ${compile_args[@]+"${compile_args[@]}"}
    objs+=("$o")
  done
  "$root/nfcxx" ${objs[@]+"${objs[@]}"} ${link_args[@]+"${link_args[@]}"} -o "$out"
  exit 0
}
nfcxx_argv=("$@")   # the command as given: the compile cache keys on it (see cache_key)
args0=("$@")   # the arguments as given: the SYCL two-pass build below re-runs the driver with them
while [ $# -gt 0 ]; do
  case $1 in
    --emit-c) emit_c=1 ;;
    --backend=*) backend=${1#--backend=}; backend_explicit=1 ;;
    --obfuscate-kernels) obfuscate=1 ;;
    -fsanitize=address) asan=1 ;;
    -fno-sanitize=address) asan=0 ;;
    -fsanitize=*|-fsanitize-*) echo "nfcxx: $1 is not supported (only -fsanitize=address; docs/notes/asan.md)" >&2; exit 2 ;;
    -fno-omit-frame-pointer|-fomit-frame-pointer) asanopts+=("$1") ;;   # asan's usual companions; they go to the C compile
    --dialect=*) dialect=${1#--dialect=} ;;
    --gnu-version=*) gnu=${1#--gnu-version=} ;;
    --freestanding) freestanding=1 ;;
    --target=*) target=${1#--target=} ;;
    --trace=*) trace=${1#--trace=} ;;
    --module-dir=*) moddir=${1#--module-dir=} ;;
    -shared) shared=1; pic=1 ;;
    -fPIC|-fpic) pic=1 ;;
    -rdynamic) rdynamic=1 ;;
    -c) compile_only=1; files+=(-c) ;;
    -o) out=$2; outset=1; shift ;;
    -std=c++*) std=--c++${1#-std=c++} ;;
    -std=gnu++*) std=--c++${1#-std=gnu++} ;;   # GNU and strict modes differ in the dialect, which --dialect selects
