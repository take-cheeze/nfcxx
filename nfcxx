[ $((ncpp + nobj + ${#cfiles[@]} + stdin_src)) -gt 0 ] || { echo "nfcxx: no input files" >&2; exit 2; }
# SYCL kernel integration (docs/notes/sycl-kernel-builtins.md). A -c compile of one C++ source that includes the oneAPI SYCL
# headers (a -I directory holding sycl/detail/kernel_desc.hpp) runs in two passes, as the real toolchain's integration headers
# do. Pass 1 (NFCXX_SYCL_DUMP) records each kernel's stable name, closure size and parameters; scripts/sycl-integration-header.sh
# turns them into KernelInfoData specializations; pass 2 compiles a wrapper that includes sycl.hpp, that header and the source,
# with __SYCL_UNNAMED_LAMBDA__ defined as the real toolchain defines it. Other sources are unchanged.
sycl_kernel_headers() {  # sycl_kernel_headers ARG...: TRUE when a -I directory of the arguments has the oneAPI kernel header
  local prev="" a d=""
  for a in "$@"; do
    d=""
    case $a in -I?*) d=${a#-I} ;; esac
    [ "$prev" = -I ] && d=$a
    prev=$a
    if [ -n "$d" ] && [ -f "$d/sycl/detail/kernel_desc.hpp" ]; then return 0; fi
  done
  return 1
}
if [ $compile_only = 1 ] && [ $ncpp = 1 ] && [ $nobj = 0 ] && [ ${#cfiles[@]} = 0 ] && [ $preprocess = 0 ] \
   && [ $emit_c = 0 ] && [ -z "${NFCXX_SYCL_PASS:-}" ] && sycl_kernel_headers "${args0[@]}" \
   && grep -Eq '#[[:space:]]*include[[:space:]]*[<"]sycl/' "${srcs[0]}"; then
  sy_tmp=$(mktemp -d)
  sy_src=$(realpath "${srcs[0]}")
  # Pass 1: the front end records the kernels (the compile fails at the header's size check; the record is what matters).
  NFCXX_SYCL_PASS=1 NFCXX_SYCL_DUMP="$sy_tmp/dump" "$root/nfcxx" "${args0[@]}" > "$sy_tmp/pass1.log" 2>&1 || true
  if [ ! -s "$sy_tmp/dump" ]; then
    cat "$sy_tmp/pass1.log" >&2; rm -rf "$sy_tmp"
    echo "nfcxx: the SYCL pre-pass recorded no kernels" >&2; exit 2
  fi
  "$root/scripts/sycl-integration-header.sh" "$sy_tmp/dump" > "$sy_tmp/integration.hpp" || { rm -rf "$sy_tmp"; exit 2; }
  printf '#include <sycl/sycl.hpp>\n#include "%s"\n#include "%s"\n' "$sy_tmp/integration.hpp" "$sy_src" > "$sy_tmp/wrapper.cpp"
  sy_args=()
  for a in "${args0[@]}"; do
