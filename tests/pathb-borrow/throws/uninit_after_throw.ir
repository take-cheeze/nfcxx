(ir-module "throws" (layout (pointer 8) (int 4)))
(call-effects "may" (returns void) (may-throw) (noescape) (closed) (args (write int)))
(function "test" (ret int) (params)
(slot "x" int 4 4) (slot "y" int 4 4)
(decl $"x" val) (decl $"y" val)
(eval (call void &"may" $"x"))
(let %0 int (load int $"y"))
(scope-end $"y") (scope-end $"x") (return %0))
