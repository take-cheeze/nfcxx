(ir-module "throws" (layout (pointer 8) (int 4)))
(call-effects "may" (returns void) (may-throw) (noescape) (closed) (args (write int)))
(function "test" (ret int) (params)
(slot "x" (struct "S") 4 4) (slot "y" int 4 4)
(drop-obligation "x" object $"x")
(decl $"x" val) (decl $"y" val) (zero-fill 4 $"y")
(drop-live "x")
(eval (call void &"may" $"y"))
(drop-state "x")
(scope-end $"x")
(return (const int 0)))
