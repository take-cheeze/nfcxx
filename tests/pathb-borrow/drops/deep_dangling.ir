(ir-module "drops" (layout (pointer 8) (int 4)))
(borrow-layout (struct "Ref") 8 8 (field "r" 0 (ptr int)))
(function "test" (ret int) (params )
(slot "x" int 4 4) (slot "h" (struct "Ref") 8 8)
(drop-obligation "h" (struct "Ref") $"h" deep)
(decl $"h" val) (decl $"x" val) (store int $"x" (const int 5))
(let %0 (ptr int) (borrow (ptr int) "a" shared $"x")) (store (ptr int) $"h" %0) (drop-live "h")
(scope-end $"x") (drop-state "h") (return (const int 0))
)
