(ir-module "drops" (layout (pointer 8) (int 4)))

(function "test" (ret int) (params )
(slot "x" int 4 4)
(drop-obligation "x" int $"x")
(decl $"x" val)(store int $"x" (const int 7))(drop-live "x")(let %0 int (move-value int $"x"))(store int $"x" (const int 7))(drop-live "x")(drop-state "x")(return (const int 0))
)
