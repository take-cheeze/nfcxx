(ir-module "drops" (layout (pointer 8) (int 4)))

(function "test" (ret int) (params )
(slot "s" (struct "P") 8 4)
(drop-obligation "s" object $"s")
(decl $"s" val)(drop-live "s")(store int $"s" (const int 1))(let %0 (ptr int) (offset $"s" 0))(drop-state "s")(let %1 int (load int %0))(scope-end $"s")(return %1)
)
