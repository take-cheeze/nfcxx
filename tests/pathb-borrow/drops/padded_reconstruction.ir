(ir-module "drops" (layout (pointer 8) (int 4)))
(borrow-layout (struct "Pad") 8 4 (field "a" 0 char) (field "b" 4 int))
(function "test" (ret int) (params )
(slot "s" (struct "Pad") 8 4)
(drop-obligation "p" (struct "Pad") $"s")
(decl $"s" val) (store char $"s" (const char 2)) (store int (offset $"s" 4) (const int 5)) (drop-live "p")(drop-state "p") (store char $"s" (const char 1)) (store int (offset $"s" 4) (const int 2)) (drop-live "p") (drop-state "p")(return (const int 0))
)
