(ir-module "drops" (layout (pointer 8) (int 4)))

(function "test" (ret int) (params )
(slot "s" (struct "P") 8 4)
(drop-obligation "s" object $"s")
(decl $"s" val)(drop-live "s")(store int $"s" (const int 1))(let %0 (ptr int) (borrow (ptr int) "a" shared $"s"))(drop-state "s")(loan-end "a")(scope-end $"s")(return (const int 0))
)
