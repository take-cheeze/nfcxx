(ir-module "drops" (layout (pointer 8) (int 4)))
(borrow-layout (struct "Pad") 8 4 (field "a" 0 char) (field "b" 4 int))
(function "test" (ret int) (params )
(slot "s" (struct "Pad") 8 4) (slot "t" (struct "Pad") 8 4) (slot "c" bool 1 1)
(drop-obligation "s" (struct "Pad") $"s") (drop-obligation "t" (struct "Pad") $"t")
(decl $"s" val) (decl $"t" val) (decl $"c" val) (store bool $"c" (const bool 1)) (store char $"t" (const char 1)) (store int (offset $"t" 4) (const int 1)) (drop-live "t") (store char $"s" (const char 2)) (store int (offset $"s" 4) (const int 5)) (drop-live "s")
(let %0 bool (load bool $"c")) (if %0 (then (move 8 $"s"))) (drop-state-if-live "s") (drop-state "t") (return (const int 0))
)
