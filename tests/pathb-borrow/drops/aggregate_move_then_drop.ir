(ir-module "drops" (layout (pointer 8) (int 4)))
(borrow-layout (struct "Pad") 8 4 (field "a" 0 char) (field "b" 4 int))
(function "test" (ret int) (params )
(slot "s" (struct "Pad") 8 4) (slot "t" (struct "Pad") 8 4)
(drop-obligation "s" (struct "Pad") $"s") (drop-obligation "t" (struct "Pad") $"t")
(decl $"s" val) (decl $"t" val) (store char $"s" (const char 2)) (store int (offset $"s" 4) (const int 5)) (drop-live "s")
(move 8 $"t" $"s") (drop-live "t") (drop-state "s") (drop-state "t") (return (const int 0))
)
