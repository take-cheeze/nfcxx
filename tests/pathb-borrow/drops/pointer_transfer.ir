(ir-module "drops" (layout (pointer 8) (int 4)))

(function "test" (ret int) (params (param %9 "input" (ptr int)))
(slot "p" (ptr int) 8 8)
(drop-obligation "p" (ptr int) $"p")
(decl $"p" ref) (store (ptr int) $"p" %9) (drop-live "p")(let %0 (ptr int) (move-value (ptr int) $"p")) (drop-state-if-live "p")(return (const int 0))
)
