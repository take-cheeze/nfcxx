(ir-module "drops" (layout (pointer 8) (int 4)))
(borrow-layout (struct "Pad") 8 4 (field "a" 0 char) (field "b" 4 int))
(borrow-layout (struct "Two") 16 4 (field "x" 0 (struct "Pad")) (field "y" 8 (struct "Pad")))
(function "test" (ret int) (params )
(slot "u" (struct "Two") 16 4) (slot "v" (struct "Pad") 8 4)
(drop-obligation "u.x" (struct "Pad") $"u") (drop-obligation "u.y" (struct "Pad") (offset $"u" 8)) (drop-obligation "v" (struct "Pad") $"v")
(decl $"u" val) (decl $"v" val) (store char $"u" (const char 1)) (store int (offset $"u" 4) (const int 1)) (drop-live "u.x") (store char (offset $"u" 8) (const char 1)) (store int (offset $"u" 12) (const int 1)) (drop-live "u.y")
(move 8 $"v" (offset $"u" 8)) (drop-live "v") (drop-state "u.x") (drop-state "v") (return (const int 0))
)
