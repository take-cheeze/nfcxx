(ir-module "verify" (layout (pointer 8) (int 4)))
(call-effects "identity" (returns (ptr int) (from-arg 0 0 shared)) (nothrow) (noescape) (closed) (args (read int)))
(function "identity" (ret (ptr int)) (params (param %0 "p" (ptr int)))
(slot "x" int 4 4)
(decl $"x" val) (store int $"x" (const int 1)) (return $"x")
)
