(ir-module "borrow-test" (layout (pointer 8) (int 4)))
(alias "entry" "first" function)
(function "first" (ret int) (params ) (static)
(let %0 (ptr (fn int ())) &"second") (return (const int 0))
)
(function "second" (ret int) (params ) (weak)
(slot "x" int 4 4)
(decl $"x" val) (scope-end $"x") (let %0 int (load int $"x")) (return %0)
)
