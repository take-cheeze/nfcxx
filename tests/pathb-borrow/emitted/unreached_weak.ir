(ir-module "borrow-test" (layout (pointer 8) (int 4)))
(function "inline_helper" (ret int) (params ) (weak)
(slot "x" int 4 4)
(decl $"x" val) (unsupported syntax) (return (const int 0))
)
(function "unused_static" (ret int) (params ) (static)
(slot "x" int 4 4)
(decl $"x" val) (scope-end $"x") (let %0 int (load int $"x")) (return %0)
)
(function "test" (ret int) (params )
(slot "x" int 4 4)
(decl $"x" val) (store int $"x" (const int 1)) (let %0 int (load int $"x")) (scope-end $"x") (return %0)
)
