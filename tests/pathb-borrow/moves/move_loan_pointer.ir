(ir-module "moves" (layout (pointer 8) (int 4)))
(function "test" (ret int) (params )
(slot "x" int 4 4) (slot "p" (ptr int) 8 8)
(decl $"x" val) (store int $"x" (const int 7))
(decl $"p" ref)(let %2 (ptr int) (borrow (ptr int) "a" exclusive $"x"))(store (ptr int) $"p" %2)(let %0 (ptr int) (move-value (ptr int) $"p"))(store int %0 (const int 2)) (loan-end "a")(return (const int 0))
)
