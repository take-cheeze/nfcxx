(decl $"x" val) (store int $"x" (const int 7))
(let %2 (ptr int) (borrow (ptr int) "a" shared $"x"))(let %1 int (copy-value int $"x"))
(let %3 int (load int %2))(loan-end "a")(return (const int 0))
