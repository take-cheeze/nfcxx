(ir-module "moves" (layout (pointer 8) (int 4)))
(function "test" (ret int) (params (param %9 "flag" bool))
(slot "x" int 4 4)
(decl $"x" val) (store int $"x" (const int 7))
(loop (body (store int $"x" (const int 2))
(let %0 int (move-value int $"x"))
(if %9 (then (continue)) (else (break)))))(return (const int 0))
)
