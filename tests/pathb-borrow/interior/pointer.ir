(ir-module "interior" (layout (pointer 8) (int 4)))
(borrow-layout (struct "UnsafeCell") 8 8 (field "value" 0 (ptr int)))
(interior-mutable (struct "UnsafeCell"))
(function "store_pointer" (ret int) (params)
(slot "x" int 4 4)
(slot "c" (struct "UnsafeCell") 8 8)
(decl $"x" val) (store int $"x" (const int 1))
(decl $"c" val) (store (ptr int) $"c" $"x")
(let %0 (ptr (struct "UnsafeCell")) (borrow (ptr (struct "UnsafeCell")) "a" shared $"c"))
(store (ptr int) %0 $"x")
(loan-end "a")
(scope-end $"c") (scope-end $"x")
(return (const int 0)))
(function "store_over_pointer" (ret int) (params)
(slot "x" int 4 4)
(slot "c" (struct "UnsafeCell") 8 8)
(decl $"x" val) (store int $"x" (const int 1))
(decl $"c" val) (store (ptr int) $"c" $"x")
(let %0 (ptr (struct "UnsafeCell")) (borrow (ptr (struct "UnsafeCell")) "b" shared $"c"))
(store long %0 (const long 0))
(loan-end "b")
(scope-end $"c") (scope-end $"x")
(return (const int 0)))
