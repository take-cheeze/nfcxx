(ir-module "interior" (layout (pointer 8) (int 4)))
(borrow-layout (struct "UnsafeCell") 4 4 (field "value" 0 int))
(borrow-layout (struct "Pair") 8 4 (field "count" 0 int) (field "cell" 4 (struct "UnsafeCell")))
(interior-mutable (struct "UnsafeCell"))
(function "test" (ret int) (params)
(slot "s" (struct "Pair") 8 4)
(decl $"s" val) (store int $"s" (const int 1)) (store int (offset $"s" 4) (const int 2))
(let %0 (ptr (struct "Pair")) (borrow (ptr (struct "Pair")) "a" shared $"s"))
(store int (offset %0 4) (const int 3))
(store int %0 (const int 4))
(loan-end "a")
(scope-end $"s")
(return (const int 0)))
