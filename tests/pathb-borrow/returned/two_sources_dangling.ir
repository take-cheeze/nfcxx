(ir-module "returned" (layout (pointer 8) (int 4)))
(call-effects "pick" (returns (ptr int) (from-arg 0 0 shared) (from-arg 1 0 shared)) (nothrow) (noescape) (closed) (args (read int) (read int) (value int)))
(function "test" (ret int) (params)
(slot "x" int 4 4) (slot "y" int 4 4) (slot "r" (ptr int) 8 8)
(decl $"x" val) (store int $"x" (const int 1)) (decl $"r" ref)
(block (decl $"y" val) (store int $"y" (const int 2))
  (let %0 (ptr int) (call (ptr int) &"pick" $"x" $"y" (const int 0))) (store (ptr int) $"r" %0) (scope-end $"y"))
(let %1 (ptr int) (load (ptr int) $"r")) (let %2 int (load int %1))
(scope-end $"x") (return %2))
