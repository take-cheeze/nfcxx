(ir-module "returned" (layout (pointer 8) (int 4)))
(call-effects "identity" (returns (ptr int) (from-arg 0 0 exclusive)) (nothrow) (noescape) (closed) (args (write int)))
(function "test" (ret int) (params)
(slot "x" int 4 4)
(decl $"x" val) (store int $"x" (const int 7))
(let %r (ptr int) (call-borrow (ptr int) "R" root &"identity" $"x"))
(store int %r (const int 9)) (let %v int (load int %r)) (loan-end "R") (return %v)
)
