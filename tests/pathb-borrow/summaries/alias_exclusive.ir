(ir-module "summaries" (layout (pointer 8) (int 4)))
(function "id" (ret (ptr int)) (params (param %0 "p" (ptr int)))
(decl %0 param) (store int %0 (const int 2)) (return %0))
(function "main" (ret int) (params)
(slot "x" int 4 4)
(decl $"x" val) (store int $"x" (const int 0))
(let %0 (ptr int) (call-borrow (ptr int) "R" root &"id" $"x")) (store int %0 (const int 3)) (loan-end "R")
(scope-end $"x") (return (const int 0)))
