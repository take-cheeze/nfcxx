(ir-module "summaries" (layout (pointer 8) (int 4)))
(borrow-layout (struct "Pair") 8 4 (field "a" 0 int) (field "b" 4 int))
(function "get" (ret (ptr int)) (params (param %0 "m" (ptr (struct "Pair"))) (param %1 "k" int))
(decl %0 param)
(let %2 (ptr int) (offset %0 0)) (if %1 (then (set %2 (offset %0 4))) (else)) (return %2))
(function "main" (ret int) (params)
(slot "s" (struct "Pair") 8 4)
(decl $"s" val) (store int (offset $"s" 0) (const int 1)) (store int (offset $"s" 4) (const int 2))
(let %p (ptr (struct "Pair")) (borrow (ptr (struct "Pair")) "S" exclusive $"s"))
(let %0 (ptr int) (call (ptr int) &"get" %p (const int 0)))
(let %1 int (load int %0)) (store int %0 (wadd int %1 (const int 1))) (loan-end "S")
(let %2 int (load int (offset $"s" 0))) (scope-end $"s") (return %2))
