(ir-module "summaries" (layout (pointer 8) (int 4)))
(borrow-layout (struct "UnsafeCell") 4 4 (field "value" 0 int))
(borrow-layout (struct "Cell") 4 4 (field "value" 0 (struct "UnsafeCell")))
(interior-mutable (struct "UnsafeCell"))
(function "bump" (ret void) (params (param %0 "c" (ptr (struct "Cell"))))
(decl %0 param) (readonly %0) (let %1 int (load int %0)) (store int %0 (wadd int %1 (const int 1))) (return))
(function "main" (ret int) (params)
(slot "c" (struct "Cell") 4 4)
(decl $"c" val) (store int $"c" (const int 0))
(let %0 (ptr (struct "Cell")) (borrow (ptr (struct "Cell")) "a" shared $"c"))
(let %1 (ptr (struct "Cell")) (borrow (ptr (struct "Cell")) "b" shared $"c"))
(eval (call void &"bump" %0)) (let %2 int (load int %1)) (loan-end "a") (loan-end "b")
(scope-end $"c") (return %2))
