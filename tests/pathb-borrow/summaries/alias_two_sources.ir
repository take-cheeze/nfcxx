(ir-module "summaries" (layout (pointer 8) (int 4)))
(function "pick" (ret (ptr int)) (params (param %0 "a" (ptr int)) (param %1 "b" (ptr int)) (param %2 "c" int))
(decl %0 param) (decl %1 param)
(let %3 (ptr int) %0) (if %2 (then (set %3 %1)) (else)) (return %3))
(function "main" (ret int) (params)
(slot "x" int 4 4) (slot "y" int 4 4)
(decl $"x" val) (store int $"x" (const int 1)) (decl $"y" val) (store int $"y" (const int 2))
(let %a (ptr int) (borrow (ptr int) "A" exclusive $"x")) (let %b (ptr int) (borrow (ptr int) "B" exclusive $"y"))
(let %0 (ptr int) (call (ptr int) &"pick" %a %b (const int 0)))
(store int %0 (const int 5)) (loan-end "A") (loan-end "B")
(let %1 int (load int $"y")) (scope-end $"x") (scope-end $"y") (return %1))
