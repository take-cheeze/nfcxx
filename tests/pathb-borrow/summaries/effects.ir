(ir-module "summaries" (layout (pointer 8) (int 4)))
(function "get" (ret int) (params (param %0 "p" (ptr (const int))))
(decl %0 param) (let %1 int (load int %0)) (return %1))
(function "put" (ret void) (params (param %0 "p" (ptr int)) (param %1 "v" int))
(decl %0 param) (store int %0 %1) (return))
(function "bump" (ret void) (params (param %0 "p" (ptr int)))
(decl %0 param) (let %1 int (load int %0)) (let %2 int (wadd int %1 (const int 1))) (store int %0 %2) (return))
(function "main" (ret int) (params)
(slot "x" int 4 4)
(decl $"x" val) (eval (call void &"put" $"x" (const int 1))) (eval (call void &"bump" $"x"))
(let %0 int (call int &"get" $"x")) (scope-end $"x") (return %0))
