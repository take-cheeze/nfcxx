(ir-module "borrow-test" (layout (pointer 8) (int 4)))
(function "test" (ret int) (params (param %9 "flag" bool))
(slot "x" int 4 4)
(loop (body (decl $"x" val) (store int $"x" (const int 1)) (let %0 int (load int $"x")) (scope-end $"x") (if %9 (then (continue)) (else (break))))) (return (const int 0))
)
