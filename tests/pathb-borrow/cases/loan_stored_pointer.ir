(ir-module "loans" (layout (pointer 8) (int 4)))
(function "test" (ret int) (params )
(slot "x" int 4 4) (slot "p" (ptr int) 8 8)
(decl $"x" val) (store int $"x" (const int 1))
(decl $"p" ref)(let %0 (ptr int) (borrow (ptr int) "a" exclusive $"x"))
(store (ptr int) $"p" %0) (let %1 (ptr int) (load (ptr int) $"p")) (store int %1 (const int 7))(loan-end "a")
(return (const int 0))
)
