(ir-module "borrow-test" (layout (pointer 8) (int 4)))
(function "test" (ret int) (params )
(slot "x" int 4 4) (slot "p" (ptr int) 8 8)
(decl $"x" val) (decl $"p" ref) (store (ptr int) $"p" $"x") (let %0 (ptr int) (load (ptr int) $"p")) (store int %0 (const int 4)) (let %1 int (load int $"x")) (return %1)
)
