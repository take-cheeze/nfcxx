(ir-module "loans" (layout (pointer 8) (int 4)))
(function "test" (ret int) (params (param %9 "flag" bool))
(slot "x" int 4 4)
(decl $"x" val) (store int $"x" (const int 1))
(let %0 (ptr int) (borrow (ptr int) "a" two-phase $"x"))
(if %9 (then (store int %0 (const int 2))) (else))
(let %2 int (load int $"x"))
(loan-end "a")
(return (const int 0))
)
