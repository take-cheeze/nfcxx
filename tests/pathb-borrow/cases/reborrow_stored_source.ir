(ir-module "reborrows" (layout (pointer 8) (int 4)))
(function "test" (ret int) (params )
(slot "x" int 4 4) (slot "p" (ptr int) 8 8)
(decl $"x" val) (store int $"x" (const int 1))
(let %0 (ptr int) (borrow (ptr int) "parent" exclusive $"x"))
(decl $"p" ref) (store (ptr int) $"p" %0) (let %3 (ptr int) (load (ptr int) $"p"))(let %1 (ptr int) (reborrow (ptr int) "child" exclusive "parent" %3))
(store int %1 (const int 7))(loan-end "child") (loan-end "parent") (return (const int 0))
)
