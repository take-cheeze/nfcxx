(ir-module "loans" (layout (pointer 8) (int 4)))
(function "test" (ret int) (params )
(slot "x" int 4 4)
(decl $"x" val) (store int $"x" (const int 1))
(let %0 (ptr int) (borrow (ptr int) "a" exclusive $"x"))
(loan-end "a")
(store int $"x" (const int 2)) (let %1 int (load int $"x"))(return (const int 0))
)
