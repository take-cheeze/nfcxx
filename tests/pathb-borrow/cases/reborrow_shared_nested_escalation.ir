(ir-module "reborrows" (layout (pointer 8) (int 4)))
(function "test" (ret int) (params )
(slot "x" int 4 4)
(decl $"x" val) (store int $"x" (const int 1))
(let %0 (ptr int) (borrow (ptr int) "parent" exclusive $"x"))
(let %1 (ptr int) (reborrow (ptr int) "child" shared "parent" %0))
(let %2 (ptr int) (reborrow (ptr int) "grandchild" exclusive "child" %1)) (loan-end "grandchild")(loan-end "child") (loan-end "parent") (return (const int 0))
)
