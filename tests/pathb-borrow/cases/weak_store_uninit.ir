(ir-module "borrow-test" (layout (pointer 8) (int 4)))
(function "test" (ret int) (params (param %9 "flag" bool))
(slot "x" int 4 4) (slot "y" int 4 4)
(decl $"x" val) (decl $"y" val) (store int $"y" (const int 2))
(let %0 (ptr int) $"x") (if %9 (then (set %0 $"y")) (else))
(store int %0 (const int 1)) (let %1 int (load int $"x")) (return %1)
)
