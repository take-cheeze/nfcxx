(ir-module "loans" (layout (pointer 8) (int 4)))
(function "test" (ret int) (params (param %9 "flag" bool))
(slot "x" int 4 4) (slot "p" (ptr int) 8 8)
(decl $"x" val) (store int $"x" (const int 1)) (decl $"p" ref) (store (ptr int) $"p" $"x") (label "again") (let %0 (ptr int) (borrow (ptr int) "a" shared $"x")) (let %1 (ptr int) (load (ptr int) $"p")) (let %2 int (load int %1)) (store (ptr int) $"p" %0) (loan-end "a") (if %9 (then (goto "again")) (else (return %2)))
)
