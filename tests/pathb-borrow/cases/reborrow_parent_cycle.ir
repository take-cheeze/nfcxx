(ir-module "reborrows" (layout (pointer 8) (int 4)))
(function "test" (ret int) (params )
(slot "x" int 4 4)
(decl $"x" val) (store int $"x" (const int 1))
(let %0 (ptr int) (reborrow (ptr int) "parent" exclusive "child" %1))(let %1 (ptr int) (reborrow (ptr int) "child" exclusive "parent" %0))
(loan-end "child") (loan-end "parent") (return (const int 0))
)
