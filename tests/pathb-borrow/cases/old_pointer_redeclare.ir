(ir-module "borrow-test" (layout (pointer 8) (int 4)))
(function "test" (ret int) (params )
(slot "x" int 4 4) (slot "p" (ptr int) 8 8)
(decl $"p" ref) (decl $"x" val) (store int $"x" (const int 1)) (store (ptr int) $"p" $"x") (scope-end $"x") (decl $"x" val) (store int $"x" (const int 2)) (let %0 (ptr int) (load (ptr int) $"p")) (let %1 int (load int %0)) (return %1)
)
