(ir-module "reborrows" (layout (pointer 8) (int 4)))
(function "test" (ret int) (params )
(slot "x" int 4 4)
(decl $"x" val) (store int $"x" (const int 1))
(let %0 (ptr int) (borrow (ptr int) "parent" exclusive $"x"))
(let %1 (ptr int) (reborrow (ptr int) "child" exclusive "parent" %0))
(store int %1 (const int 7)) (loan-end "child") (store int %0 (const int 8)) (loan-end "parent") (return (const int 0))
)
