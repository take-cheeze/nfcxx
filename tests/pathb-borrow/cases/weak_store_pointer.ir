(ir-module "borrow-test" (layout (pointer 8) (int 4)))
(function "test" (ret int) (params (param %9 "flag" bool))
(slot "x" int 4 4) (slot "y" int 4 4) (slot "p" (ptr int) 8 8) (slot "q" (ptr int) 8 8)
(decl $"x" val) (store int $"x" (const int 1))
(decl $"p" ref) (decl $"q" ref) (store (ptr int) $"p" $"x")
(let %0 (ptr (ptr int)) $"p") (if %9 (then (set %0 $"q")) (else))
(block (decl $"y" val) (store int $"y" (const int 2)) (store (ptr int) %0 $"y") (scope-end $"y"))
(let %1 (ptr int) (load (ptr int) $"p")) (let %2 int (load int %1)) (return %2)
)
