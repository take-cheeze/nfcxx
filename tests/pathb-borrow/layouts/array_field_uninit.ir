(ir-module "semantic" (layout (pointer 8) (int 4)))
(borrow-layout (struct "Buf") 12 4 (field "tag" 0 char) (field "v" 4 (array 2 int)))
(function "test" (ret int) (params)
(slot "s" (struct "Buf") 12 4)
(decl $"s" val) (store char $"s" (const char 1)) (store int (offset $"s" 4) (const int 2))
(let %0 (ptr (struct "Buf")) (borrow (ptr (struct "Buf")) "p" shared $"s")) (loan-end "p")
(scope-end $"s") (return (const int 0)))
