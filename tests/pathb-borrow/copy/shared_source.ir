(ir-module "copy" (layout (pointer 8) (int 4)))
(function "test" (ret int) (params)
(slot "a" (struct "P") 8 4) (slot "b" (struct "P") 8 4)
(decl $"a" val) (decl $"b" val) (zero-fill 8 $"a")
(let %0 (ptr int) (borrow (ptr int) "r" shared $"a"))
(copy 8 $"b" $"a")
(let %1 int (load int %0)) (loan-end "r")
(let %2 int (load int (offset $"b" 4)))
(scope-end $"b") (scope-end $"a") (return %2))
