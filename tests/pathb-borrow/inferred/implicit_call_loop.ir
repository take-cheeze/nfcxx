(ir-module "implicit" (layout (pointer 8) (int 4)))
(call-effects "pick" (returns (ptr int) (from-arg 0 0 exclusive)) (nothrow) (noescape) (closed) (args (write int)))
(function "test" (ret int) (params (param %9 "n" int))
(slot "x" int 4 4)
(decl %9 param) (decl $"x" val) (store int $"x" (const int 1))
(loop (body (if %9 (then) (else (break)))
  (let %0 (ptr int) (call (ptr int) &"pick" $"x")) (store int %0 (const int 2))) (step))
(let %1 int (load int $"x")) (scope-end $"x") (return %1))
