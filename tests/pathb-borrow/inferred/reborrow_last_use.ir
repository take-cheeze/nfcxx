(ir-module "inferred" (layout (pointer 8) (int 4)))
(function "test" (ret int) (params )
(slot "x" int 4 4)
(decl $"x" val) (store int $"x" (const int 1))
(let %0 (ptr int) (borrow (ptr int) "parent" exclusive $"x"))
(let %1 (ptr int) (reborrow (ptr int) "child" exclusive "parent" %0))(let %2 int (load int %1))(store int %0 (const int 2))(return (const int 0))
)
