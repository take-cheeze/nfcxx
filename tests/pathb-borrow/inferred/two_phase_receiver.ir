(ir-module "inferred" (layout (pointer 8) (int 4)))
(function "test" (ret int) (params )
(slot "x" int 4 4)
(decl $"x" val) (store int $"x" (const int 1))
(let %0 (ptr int) (borrow (ptr int) "a" two-phase $"x"))
(let %1 (ptr int) (borrow (ptr int) "b" shared $"x"))
(let %2 int (load int %1))
(store int %0 %2)
(return (const int 0))
)
