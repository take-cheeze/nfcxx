(ir-module "inferred" (layout (pointer 8) (int 4)))
(function "test" (ret int) (params )
(slot "x" int 4 4) (slot "p" (ptr int) 8 8)
(decl $"x" val) (store int $"x" (const int 1))
(let %0 (ptr int) (borrow (ptr int) "a" exclusive $"x"))
(decl $"p" ref) (store (ptr int) $"p" %0)(store (ptr int) $"p" $"x")(store int $"x" (const int 2))
(let %1 (ptr int) (load (ptr int) $"p")) (let %2 int (load int %1))(return (const int 0))
)
