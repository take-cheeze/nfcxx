(ir-module "calls" (layout (pointer 8) (int 4)))
(call-effects "read" (returns int) (nothrow) (noescape) (closed) (args (read int)))
(function "test" (ret int) (params )
(slot "x" int 4 4)

(decl $"x" val) (store int $"x" (const int 7))(let %0 int $"x") (let %1 int (call int &"read" (offset %0 0)))(return (const int 0))
)
