(ir-module "calls" (layout (pointer 8) (int 4)))
(call-effects "pick" (returns (ptr (ptr int)) (from-arg 0 0 exclusive)) (nothrow) (noescape) (closed) (args (write (ptr int))))
(function "test" (ret int) (params (param %0 "p" (ptr (ptr int))))
(slot "x" int 4 4)
(decl %0 param) (decl $"x" val) (store int $"x" (const int 1))
(let %1 (ptr (ptr int)) (call (ptr (ptr int)) &"pick" %0))
(store (ptr int) %1 $"x")
(scope-end $"x") (return (const int 0)))
