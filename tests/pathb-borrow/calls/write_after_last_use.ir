(ir-module "calls" (layout (pointer 8) (int 4)))
(call-effects "write" (returns void) (nothrow) (noescape) (closed) (args (write int)))
(function "test" (ret int) (params )
(slot "x" int 4 4)

(decl $"x" val) (store int $"x" (const int 7))(let %0 (ptr int) (borrow (ptr int) "a" shared $"x"))(let %1 int (load int %0))(eval (call void &"write" $"x"))(loan-end "a")(return (const int 0))
)
