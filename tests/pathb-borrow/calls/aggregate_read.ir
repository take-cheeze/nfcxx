(ir-module "calls" (layout (pointer 8) (int 4)))
(borrow-layout (struct "Pad") 8 4 (field "a" 0 char) (field "b" 4 int))
(call-effects "pad_read" (returns void) (nothrow) (noescape) (closed) (args (read (struct "Pad"))))
(function "test" (ret int) (params )
(slot "s" (struct "Pad") 8 4)

(decl $"s" val) (store char $"s" (const char 2)) (store int (offset $"s" 4) (const int 5))(eval (call void &"pad_read" $"s"))(return (const int 0))
)
