(ir-module "calls" (layout (pointer 8) (int 4)))
(borrow-layout (struct "H") 8 8 (field "p" 0 (ptr int)))
(call-effects "show" (returns void) (nothrow) (noescape) (closed) (args (byval-deep (struct "H"))))
(function "test" (ret void) (params)
(slot "x" int 4 4) (slot "h" (struct "H") 8 8)
(decl $"h" val) (decl $"x" val) (store int $"x" (const int 1))
(let %0 (ptr int) (borrow (ptr int) "L" shared $"x"))
(store (ptr int) $"h" %0)
(scope-end $"x")
(eval (call void &"show" (byval (struct "H") $"h")))
(scope-end $"h") (return))
