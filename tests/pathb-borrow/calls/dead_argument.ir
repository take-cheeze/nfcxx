(ir-module "calls" (layout (pointer 8) (int 4)))
(call-effects "peek" (returns int) (nothrow) (noescape) (closed) (args (read int)))
(function "test" (ret int) (params)
(slot "x" int 4 4)
(decl $"x" val) (store int $"x" (const int 1))
(let %0 (ptr int) (bitcast (ptr int) $"x"))
(scope-end $"x")
(let %1 int (call int &"peek" %0))
(return %1))
