(ir-module "calls" (layout (pointer 8) (int 4)))
(call-effects "destroy" (returns int) (nothrow) (noescape) (closed) (args (consume int)))
(function "test" (ret int) (params )
(slot "x" int 4 4)

(decl $"x" val) (store int $"x" (const int 7))(let %1 int (call int &"destroy" $"x"))(return (const int 0))
)
