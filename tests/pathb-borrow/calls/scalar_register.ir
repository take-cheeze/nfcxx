(ir-module "calls" (layout (pointer 8) (int 4)))
(call-effects "value" (returns void) (nothrow) (noescape) (closed) (args (value int)))
(function "test" (ret int) (params )
(slot "x" int 4 4)

(decl $"x" val) (store int $"x" (const int 7))(let %0 int (load int $"x")) (eval (call void &"value" %0))(return (const int 0))
)
