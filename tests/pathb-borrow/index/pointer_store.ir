(ir-module "index" (layout (pointer 8) (int 4)))
(function "test" (ret int) (params (param %0 "i" int))
(slot "x" int 4 4)
(slot "a" (array 2 (ptr int)) 16 8)
(decl %0 param) (decl $"x" val) (decl $"a" val) (zero-fill 16 $"a")
(store (ptr int) (index $"a" %0 8) $"x")
(scope-end $"a") (scope-end $"x")
(return (const int 0)))
