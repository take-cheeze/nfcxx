(ir-module "index" (layout (pointer 8) (int 4)))
(function "test" (ret int) (params (param %0 "i" int))
(slot "a" (array 2 int) 8 4)
(decl %0 param) (decl $"a" val) (zero-fill 8 $"a")
(let %1 (ptr int) (borrow (ptr int) "r" exclusive $"a"))
(store int (index %1 %0 4) (const int 1))
(let %2 int (load int (index %1 %0 4)))
(loan-end "r")
(scope-end $"a")
(return %2))
