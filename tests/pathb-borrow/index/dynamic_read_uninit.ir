(ir-module "index" (layout (pointer 8) (int 4)))
(function "test" (ret int) (params (param %0 "i" int))
(slot "a" (array 3 int) 12 4)
(decl %0 param) (decl $"a" val)
(store int (index $"a" (const int 0) 4) (const int 1))
(store int (index $"a" (const int 1) 4) (const int 2))
(let %1 int (load int (index $"a" %0 4)))
(scope-end $"a")
(return %1))
