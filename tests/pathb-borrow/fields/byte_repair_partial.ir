(ir-module "fields" (layout (pointer 8) (int 4)))
(function "test" (ret int) (params )
(slot "s" (struct "Pair") 8 4)
(decl $"s" val) (zero-fill 8 $"s")
(let %0 int (move-value int (offset $"s" 0)))
(store unsigned_short (offset $"s" 0) (const unsigned_short 2))(let %1 int (load int (offset $"s" 0)))
(return (const int 0))
)
