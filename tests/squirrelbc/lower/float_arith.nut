// Float arithmetic: + - * / % with two floats, and with an integer on either side (the integer converts to a float).
local a = 2.5;
local b = 4;
print(a + b);
print(" ");
print(a - b);
print(" ");
print(a * b);
print(" ");
print(a / b);
print(" ");
print(b / a);
print(" ");
print(b + 0.5);
print(" ");
print(7 % 2.5);
print(" ");
print(7.5 % 2);
print(" ");
print(-a);
print(" ");
print(a * 2.0 - 0.25);
print(" ");
print(1.0 * 3);
print(" ");
print(3.0 - 3);
print(" ");
print(5 / 2.0);
return 0;
