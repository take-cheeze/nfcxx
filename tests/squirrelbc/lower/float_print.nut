// print of floats: the reference's ToString is %g of the float (sqvm.cpp), so 1/3 is 0.333333 and 1e20 is 1e+20.
print(1.5);
print(" ");
print(1.0 / 3);
print(" ");
print(1e20);
print(" ");
print(-0.0);
print(" ");
print(-1.5);
print(" ");
print(100000000.0);
print(" ");
print(0.0001234567);
print(" ");
print(16777217 + 0.0);
print(" ");
print(0.1 + 0.2);
return 0;
