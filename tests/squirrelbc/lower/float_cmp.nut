// Comparisons of floats with floats and with integers, through the bool of CMP (ObjCmp: a float by its value).
local a = 1.5;
local b = 2;
print(a < b);
print(a <= 1.5);
print(a > b);
print(a >= 1.5);
print(b > a);
print(2.0 < 2);
print(2.0 <= 2);
print(2.0 > 2);
print(-0.5 < 0);
print(null < 0.0);
print(0.0 > null);
return a < 2.5;
