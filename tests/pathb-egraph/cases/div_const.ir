(ir-module "t.cpp" (layout (short 2) (int 4) (long 8) (long_long 8) (pointer 8) (float 4) (double 8) (long_double 16)))
(function "main"
  (ret int)
  (params (param %0 "a" int))
  (block
    (let %1 int (cdiv int (const int -7) (const int 2)))
    (let %2 int (crem int (const int -7) (const int 2)))
    (let %3 int (crem int (const int 7) (const int -2)))
    (let %4 int (cdiv int (const int 7) (const int -2)))
    (let %5 int (cdiv int %0 (const int 1)))
    (let %6 int (wadd int %1 %2))
    (let %7 int (wadd int %6 %3))
    (let %8 int (wadd int %7 %4))
    (let %9 int (wadd int %8 %5))
    (let %10 unsigned_int (cdiv unsigned_int (const unsigned_int -1) (const unsigned_int 2)))
    (let %11 int (iconv int %10))
    (let %12 int (wadd int %9 %11))
    (return %12)))
