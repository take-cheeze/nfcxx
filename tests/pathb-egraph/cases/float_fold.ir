(ir-module "f.cpp" (layout (short 2) (int 4) (long 8) (long_long 8) (pointer 8) (float 4) (double 8) (long_double 16)))
(function "main"
  (ret int)
  (params (param %0 "n" int))
  (let %1 double (fdiv double (const double 1.0) (const double -0.0)))
  (let %2 double (fdiv double (const double 1.0) (const double 0.0)))
  (let %3 bool (lt.f double %1 (const double 0.0)))
  (let %4 bool (lt.f double %2 (const double 0.0)))
  (let %5 int (iconv int %3))
  (let %6 int (iconv int %4))
  (let %7 int (wmul int %5 (const int 10)))
  (let %8 int (wadd int %7 %6))
  (let %9 double (fmul double (const double 1.5) (const double 4.0)))
  (let %10 float (fconv float %9))
  (let %11 float (fadd float (const float 16777216.0) (const float 1.0)))
  (let %12 double (fconv double %11))
  (let %13 int (cf2i int %12))
  (let %14 int (wadd int %8 %13))
  (return %14))
