(ir-module "t.cpp" (layout (short 2) (int 4) (long 8) (long_long 8) (pointer 8) (float 4) (double 8) (long_double 16)))
(function "main"
  (ret int)
  (params (param %0 "a" int) (param %1 "b" int))
  (slot "x" int 4 4)
  (slot "y" long 8 8)
  (eval (call void &"observe" (addr $"x") (addr $"y")))
  (block
    (let %2 int (wadd int %0 %1))
    (store int $"x" %2)
    (let %3 int (load int $"x"))
    (store int $"x" (const int 9))
    (let %4 int (load int $"x"))
    (store long $"y" (const long 4))
    (let %5 int (load int $"y"))
    (let %6 int (wmul int %3 %4))
    (let %7 int (wadd int %6 %5))
    (return %7)))
