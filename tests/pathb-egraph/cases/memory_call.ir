(ir-module "t.cpp" (layout (short 2) (int 4) (long 8) (long_long 8) (pointer 8) (float 4) (double 8) (long_double 16)))
(function "main"
  (ret int)
  (params (param %0 "n" int))
  (slot "x" int 4 4)
  (store int $"x" %0)
  (eval (call void &"clobber" (addr $"x")))
  (block
    (let %1 int (load int $"x"))
    (store int $"x" (const int 2))
    (let %2 int (load int $"x"))
    (let %3 int (wadd int %1 %2))
    (let %4 int (wadd int %3 %0))
    (return %4)))
