(ir-module "t.cpp" (layout (short 2) (int 4) (long 8) (long_long 8) (pointer 8) (float 4) (double 8) (long_double 16)))
(function "main"
  (ret int)
  (params (param %0 "a" int) (param %1 "b" int))
  (slot "a" int 4 4)
  (slot "b" int 4 4)
  (store int $"a" %0)
  (store int $"b" %1)
  (eval (call void &"observe" (addr $"a") (addr $"b")))
  (block
    (let %2 int (load int $"a"))
    (let %3 int (load int $"a"))
    (let %4 int (load int $"b"))
    (let %5 int (wmul int %2 (const int 10)))
    (let %6 int (wadd int %5 %3))
    (let %7 int (wadd int %6 %4))
    (return %7)))
