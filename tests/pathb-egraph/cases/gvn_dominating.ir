(ir-module "t.cpp" (layout (short 2) (int 4) (long 8) (long_long 8) (pointer 8) (float 4) (double 8) (long_double 16)))
(function "main"
  (ret int)
  (params (param %0 "a" int) (param %1 "b" int))
  (slot "a" int 4 4)
  (slot "b" int 4 4)
  (slot "r" int 4 4)
  (store int $"a" %0)
  (store int $"b" %1)
  (block
    (let %2 int (load int $"a"))
    (let %3 int (load int $"b"))
    (let %4 int (wadd int %2 %3))
    (let %5 bool (lt.s int %4 (const int 10)))
    (if %5
      (then
        (let %6 int (wadd int %2 %3))
        (let %7 int (wmul int %6 (const int 2)))
        (store int $"r" %7))
      (else
        (store int $"r" %4)))
    (let %8 int (load int $"r"))
    (return %8)))
