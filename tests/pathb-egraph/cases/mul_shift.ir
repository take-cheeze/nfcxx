(ir-module "t.cpp" (layout (short 2) (int 4) (long 8) (long_long 8) (pointer 8) (float 4) (double 8) (long_double 16)))
(function "main"
  (ret int)
  (params (param %0 "a" int))
  (block
    (let %1 int (wmul int %0 (const int 8)))
    (let %2 unsigned_int (iconv unsigned_int %0))
    (let %3 unsigned_int (wmul unsigned_int %2 (const unsigned_int 1024)))
    (let %4 int (iconv int %3))
    (let %5 int (wadd int %1 %4))
    (return %5)))
