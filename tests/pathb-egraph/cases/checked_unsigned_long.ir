(ir-module "t.cpp" (layout (short 2) (int 4) (long 8) (long_long 8) (pointer 8) (float 4) (double 8) (long_double 16)))
(function "main"
  (ret int)
  (params (param %0 "a" unsigned_long) (param %1 "b" unsigned_long))
  (block
    (let %2 unsigned_long (cmul unsigned_long %0 %1))
    (let %3 int (iconv int %2))
    (return %3)))
