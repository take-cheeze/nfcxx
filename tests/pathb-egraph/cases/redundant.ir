(ir-module "t.cpp" (layout (short 2) (int 4) (long 8) (long_long 8) (pointer 8) (float 4) (double 8) (long_double 16)))
(function "main"
  (ret int)
  (params (param %0 "a" int) (param %1 "b" int))
  (slot "a" int 4 4)
  (slot "b" int 4 4)
  (slot "r" int 4 4)
  (store int $"a" %0)
  (store int $"b" %1)
  (block
    (let %2 int (load int $"a"))
    (let %3 int (load int $"b"))
    (let %4 int (wadd int %2 %3))
    (let %5 int (wadd int %3 %2))
    (let %6 int (wadd int %2 %3))
    (let %7 int (wmul int %4 (const int 1)))
    (let %8 int (wadd int %7 (const int 0)))
    (let %9 int (wadd int %6 (const int 3)))
    (let %10 int (wadd int %9 (const int 4)))
    (let %11 int (wsub int %10 %10))
    (let %12 int (wadd int %11 %5))
    (let %13 int (and int %12 (const int -1)))
    (let %14 int (xor int %13 (const int 0)))
    (let %15 bool (eq int %4 %5))
    (let %16 int (wmul int %14 (const int 0)))
    (let %17 int (wadd int %8 %10))
    (let %18 int (wadd int %16 %17))
    (let %19 int (iconv int %18))
    (store int $"r" %19)
    (if %15
      (then
        (let %20 int (wadd int %3 %2))
        (let %21 int (wmul int %20 (const int 2)))
        (store int $"r" %21))
      (else
        (let %22 int (wadd int %2 %3))
        (let %23 int (wadd int %22 (const int 0)))
        (store int $"r" %23)))
    (let %24 int (load int $"r"))
    (let %25 int (wadd int %24 %16))
    (let %26 int (wsub int %25 (const int 1)))
    (let %27 int (wadd int %26 (const int 1)))
    (return %27)))
