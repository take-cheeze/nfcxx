(ir-module "t.cpp" (layout (short 2) (int 4) (long 8) (long_long 8) (pointer 8) (float 4) (double 8) (long_double 16)))
(function "main"
  (ret int)
  (params (param %0 "a" int) (param %1 "b" int))
  (slot "x" int 4 4)
  (slot "y" int 4 4)
  (store int $"x" %0)
  (store int $"y" %1)
  (eval (call void &"observe" (addr $"x") (addr $"y")))
  (block
    (let %2 int (load int $"x"))
    (let %3 int (load int $"y"))
    (let %4 int (load int $"x"))
    (let %5 int (load int $"y"))
    (let %6 int (wsub int %3 %2))
    (let %7 int (wmul int %4 (const int 3)))
    (let %8 int (wadd int %6 %7))
    (let %9 int (wadd int %8 %5))
    (return %9)))
