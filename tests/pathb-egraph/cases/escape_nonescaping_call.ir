(ir-module "t.cpp" (layout (short 2) (int 4) (long 8) (long_long 8) (pointer 8) (float 4) (double 8) (long_double 16)))
(function "main"
  (ret int)
  (params (param %0 "a" int))
  (slot "s" (array 2 int) 8 4)
  (let %1 (ptr int) (offset $"s" 4))
  (store int %1 %0)
  (eval (call void &"observe"))
  (block
    (let %2 (ptr int) (offset $"s" 4))
    (let %3 int (load int %2))
    (let %4 int (wadd int %3 %0))
    (return %4)))
