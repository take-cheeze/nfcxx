(ir-module "t.cpp" (layout (short 2) (int 4) (long 8) (long_long 8) (pointer 8) (float 4) (double 8) (long_double 16)))
(function "main"
  (ret int)
  (params (param %0 "a" int))
  (slot "a" int 4 4)
  (store int $"a" %0)
  (block
    (let %1 int (load int $"a"))
    (let %2 int (wneg int (const int 5)))
    (let %3 int (not int (const int 0)))
    (let %4 bool (not bool (const bool 0)))
    (let %5 int (iconv int %4))
    (let %6 int (wadd int %1 %2))
    (let %7 int (wadd int %6 %3))
    (let %8 int (wadd int %7 %5))
    (return %8)))
