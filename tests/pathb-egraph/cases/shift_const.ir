(ir-module "t.cpp" (layout (short 2) (int 4) (long 8) (long_long 8) (pointer 8) (float 4) (double 8) (long_double 16)))
(function "main"
  (ret int)
  (params (param %0 "a" int))
  (block
    (let %1 int (cshl int (const int 3) (const int 4)))
    (let %2 int (cshr int (const int -64) (const int 2)))
    (let %3 int (cshl int (const int 1) (const int 31)))
    (let %4 int (wadd int %1 %2))
    (let %5 int (wadd int %4 %3))
    (let %6 unsigned_int (cshr unsigned_int (const unsigned_int -8) (const int 1)))
    (let %7 int (iconv int %6))
    (let %8 int (wadd int %5 %7))
    (let %9 int (wadd int %8 %0))
    (return %9)))
