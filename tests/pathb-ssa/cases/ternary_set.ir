(ir-module "t.cpp" (layout (short 2) (int 4) (long 8) (long_long 8) (pointer 8) (float 4) (double 8) (long_double 16)))
(function "main"
  (ret int)
  (params (param %0 "a" int) (param %1 "b" int))
  (slot "a" int 4 4)
  (slot "b" int 4 4)
  (slot "r" int 4 4)
  (store int $"a" %0)
  (store int $"b" %1)
  (block
    (let %2 int (const int 0))
    (let %3 int (load int $"a"))
    (let %4 int (load int $"b"))
    (let %5 bool (lt.s int %3 %4))
    (if %5 (then (set %2 %3)) (else (set %2 %4)))
    (let %6 int (wadd int %2 (const int 10)))
    (store int $"r" %6)
    (let %7 int (load int $"r"))
    (return %7)))
