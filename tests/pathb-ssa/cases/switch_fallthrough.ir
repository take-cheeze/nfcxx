(ir-module "t.cpp" (layout (short 2) (int 4) (long 8) (long_long 8) (pointer 8) (float 4) (double 8) (long_double 16)))
(function "main"
  (ret int)
  (params (param %0 "x" int))
  (slot "x" int 4 4)
  (slot "r" int 4 4)
  (store int $"x" %0)
  (store int $"r" (const int 0))
  (let %1 int (load int $"x"))
  (switch %1
    (body
      (block
        (case (const int 1))
        (let %2 int (load int $"r"))
        (store int $"r" (wadd int %2 (const int 1)))
        (case (const int 2))
        (let %3 int (load int $"r"))
        (store int $"r" (wadd int %3 (const int 10)))
        (case (const int 3))
        (let %4 int (load int $"r"))
        (store int $"r" (wadd int %4 (const int 100)))
        (break)
        (case (const int 4))
        (let %5 int (load int $"r"))
        (store int $"r" (wadd int %5 (const int 1000))))))
  (let %6 int (load int $"r"))
  (return %6))
