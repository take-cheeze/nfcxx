(ir-module "t.cpp" (layout (short 2) (int 4) (long 8) (long_long 8) (pointer 8) (float 4) (double 8) (long_double 16)))
(function "main"
  (ret int)
  (params (param %0 "n" int))
  (slot "n" int 4 4)
  (slot "i" int 4 4)
  (slot "j" int 4 4)
  (slot "acc" int 4 4)
  (store int $"n" %0)
  (store int $"acc" (const int 0))
  (store int $"i" (const int 0))
  (block
    (loop
      (body
        (let %1 int (load int $"i"))
        (let %2 int (load int $"n"))
        (let %3 bool (lt.s int %1 %2))
        (if %3 (then) (else (break)))
        (store int $"j" (const int 0))
        (loop
          (body
            (let %4 int (load int $"j"))
            (let %5 bool (lt.s int %4 (const int 3)))
            (if %5 (then) (else (break)))
            (let %6 int (load int $"j"))
            (let %7 int (load int $"acc"))
            (let %8 int (wadd int %7 %6))
            (store int $"acc" %8)
            (let %9 int (load int $"j"))
            (let %10 int (wadd int %9 (const int 1)))
            (store int $"j" %10))
          (step))
        (let %11 int (load int $"i"))
        (let %12 int (wadd int %11 (const int 1)))
        (store int $"i" %12))
      (step))
    (let %13 int (load int $"acc"))
    (return %13)))
