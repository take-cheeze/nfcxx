(ir-module "f.cpp" (layout (short 2) (int 4) (long 8) (long_long 8) (pointer 8) (float 4) (double 8) (long_double 16)))
(function "main"
  (ret int)
  (params (param %0 "n" int))
  (slot "n" int 4 4)
  (slot "x" double 8 8)
  (store int $"n" %0)
  (let %1 int (load int $"n"))
  (let %2 double (i2f double %1))
  (let %3 double (fmul double %2 (const double 0.5)))
  (store double $"x" %3)
  (let %4 double (load double $"x"))
  (let %5 bool (lt.f double %4 (const double 2.5)))
  (let %6 int (cf2i int %4))
  (if %5 (then (let %7 int (wadd int %6 (const int 100)))) (else (let %8 int (wadd int %6 (const int 0)))))
  (let %9 int (load int $"n"))
  (return %6))
