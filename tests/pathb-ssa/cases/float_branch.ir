(ir-module "f.cpp" (layout (short 2) (int 4) (long 8) (long_long 8) (pointer 8) (float 4) (double 8) (long_double 16)))
(function "main"
  (ret int)
  (params (param %0 "n" int))
  (slot "n" int 4 4)
  (slot "r" int 4 4)
  (store int $"n" %0)
  (block
    (let %1 int (const int 0))
    (let %2 int (load int $"n"))
    (let %3 double (i2f double %2))
    (let %4 double (fmul double %3 (const double 0.75)))
    (let %5 int (cf2i int %4))
    (let %6 bool (lt.s int %5 (const int 6)))
    (if %6 (then (set %1 %5)) (else (set %1 (wadd int %5 (const int 100)))))
    (let %7 int (wadd int %1 (const int 1)))
    (store int $"r" %7)
    (let %8 int (load int $"r"))
    (return %8)))
