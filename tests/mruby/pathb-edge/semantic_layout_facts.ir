(ir-module "semantic_layout_facts" (layout (pointer 8) (int 4)))
(borrow-layout (struct "Pad") 8 4 (field "a" 0 char) (field "b" 4 int))
(function "main"
  (ret int)
  (params)
  (slot "s" (struct "Pad") 8 4)
  (decl $"s" val)
  (store char $"s" (const char 2))
  (store int (offset $"s" 4) (const int 5))
  (let %0 (ptr (struct "Pad")) (borrow (ptr (struct "Pad")) "parent" exclusive $"s"))
  (let %1 (ptr int) (reborrow (ptr int) "child" shared "parent" (offset %0 4)))
  (let %2 int (load int %1))
  (loan-end "child")
  (let %3 char (load char %0))
  (let %4 int (iconv int %3))
  (let %5 int (wadd int %4 %2))
  (loan-end "parent")
  (scope-end $"s")
  (return %5))
