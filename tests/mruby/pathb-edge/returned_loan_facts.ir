(ir-module "returned_loan_facts" (layout (pointer 8) (int 4)))
(call-effects "nfcb_identity" (returns (ptr int) (from-arg 0 0 exclusive)) (nothrow) (noescape) (closed) (args (write int)))
(function "main" (ret int) (params)
  (slot "x" int 4 4)
  (decl $"x" val)
  (store int $"x" (const int 1))
  (let %0 (ptr int) (call-borrow (ptr int) "R" root &"nfcb_identity" $"x"))
  (store int %0 (const int 7))
  (let %1 int (load int %0))
  (loan-end "R")
  (scope-end $"x")
  (return %1))
