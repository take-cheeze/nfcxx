(ir-module "object_drop_facts" (layout (pointer 8) (int 4)))
(function "main"
  (ret int)
  (params)
  (slot "s" (struct "P") 8 4)
  (drop-obligation "s" object $"s")
  (decl $"s" val)
  (drop-live "s")
  (store int $"s" (const int 3))
  (store int (offset $"s" 4) (const int 4))
  (let %0 int (load int $"s"))
  (let %1 int (load int (offset $"s" 4)))
  (drop-state "s")
  (let %2 int (wadd int %0 %1))
  (scope-end $"s")
  (return %2))
