(ir-module "edge.cpp" (layout (short 2) (int 4) (long 8) (long_long 8) (pointer 8) (float 4) (double 8) (long_double 16)))

(global "t_init" int 4 4 (thread) (init (scalar 0 int (const int 5))))
(global "t_zero" (array 4 long) 32 8 (thread) (init (zero 0 32)))
(global "t_static" short 2 2 (static) (thread) (init (scalar 0 short (const short 9))))
(global "t_weak" int 4 4 (weak) (thread) (init (scalar 0 int (const int 1))))
(global "t_ext" int 4 4 (thread) (extern))
(global "t_ext_arr" (array 3 double) 24 8 (thread) (extern))
(global "plain" int 4 4 (init (scalar 0 int (const int 1))))
(global "pt" (ptr int) 8 8 (init (addr 0 (ptr int) @"plain" 0)))
(function "main"
  (ret int)
  (params)
  (slot "x" int 4 4)
  (let %0 int (load int @"t_init"))
  (store int @"t_init" (const int 8))
  (let %1 (ptr long) (index @"t_zero" (const int 2) 8))
  (store long %1 (const long 9))
  (let %2 short (load short @"t_static"))
  (let %3 int (load int @"t_weak"))
  (let %4 int (load int @"t_ext"))
  (store int @"t_ext" %4)
  (let %5 (ptr double) (index @"t_ext_arr" (const int 1) 8))
  (let %6 (ptr int) (offset @"t_init" 0))
  (eval (call void &"use" @"t_init" @"plain"))
  (return %0))
