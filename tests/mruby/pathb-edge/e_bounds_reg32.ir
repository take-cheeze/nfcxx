(ir-module "edge.cpp" (layout (short 2) (int 4) (long 8) (long_long 8) (pointer 8) (float 4) (double 8) (long_double 16)))

(function "f"
  (ret int)
  (params (param %0 "i" int) (param %1 "n" unsigned_long))
  (bounds %0 %1)
  (return (const int 0)))

(function "main"
  (ret int)
  (params)
  (let %0 int (call int &"f" (const int 1) (const unsigned_long 4)))
  (return %0))
