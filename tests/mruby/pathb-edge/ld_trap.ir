(ir-module "edge.cpp" (layout (short 2) (int 4) (long 8) (long_long 8) (pointer 8) (float 4) (double 8) (long_double 16)))
(global "gld" long_double 16 16 (init (zero 0 16)))
(function "uses"
  (ret long_double)
  (params (param %0 "x" long_double))
  (weak)
  (return %0))
(function "main"
  (ret int)
  (params)
  (let %0 int (call int &"uses"))
  (return (const int 0)))
