(ir-module "edge.cpp" (layout (short 2) (int 4) (long 8) (long_long 8) (pointer 8) (float 4) (double 8) (long_double 16)))

(function "static_unused" (ret int) (params) (static) (return (const int 1)))
(function "weak_unused" (ret int) (params) (weak) (return (const int 1)))
(function "weak_used" (ret int) (params) (weak) (return (const int 1)))
(function "static_used" (ret int) (params) (static) (return (call int &"weak_used")))
(function "main" (ret int) (params) (return (call int &"static_used")))
(global "extdecl" int 4 4 (extern))
(global "gw" int 4 4 (weak) (init (scalar 0 int (const int 3))))
