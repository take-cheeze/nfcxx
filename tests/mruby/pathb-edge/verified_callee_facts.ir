(ir-module "verified_callee_facts" (layout (pointer 8) (int 4)))
(call-effects "vc_make" (returns void) (nothrow) (noescape) (closed) (args (init int) (value int)))
(call-effects "vc_bump" (returns (ptr int) (from-arg 0 0 exclusive)) (nothrow) (noescape) (closed) (args (write int)))
(call-effects "vc_get" (returns int) (nothrow) (noescape) (closed) (args (read int)))
(function "vc_make" (ret void) (params (param %0 "p" (ptr int)) (param %1 "v" int))
  (decl %0 param)
  (store int %0 %1)
  (return))
(function "vc_bump" (ret (ptr int)) (params (param %0 "p" (ptr int)))
  (decl %0 param)
  (let %1 int (load int %0))
  (let %2 int (wadd int %1 (const int 2)))
  (store int %0 %2)
  (return %0))
(function "vc_get" (ret int) (params (param %0 "p" (ptr int)))
  (decl %0 param)
  (let %1 int (load int %0))
  (return %1))
(function "main" (ret int) (params)
  (slot "x" int 4 4)
  (decl $"x" val)
  (eval (call void &"vc_make" $"x" (const int 3)))
  (let %0 (ptr int) (call-borrow (ptr int) "R" root &"vc_bump" $"x"))
  (let %1 int (load int %0))
  (let %2 int (wadd int %1 (const int 2)))
  (store int %0 %2)
  (loan-end "R")
  (let %3 int (call int &"vc_get" $"x"))
  (scope-end $"x")
  (return %3))
