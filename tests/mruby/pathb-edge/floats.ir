(ir-module "edge.cpp" (layout (short 2) (int 4) (long 8) (long_long 8) (pointer 8) (float 4) (double 8) (long_double 16)))

(function "main"
  (ret int)
  (params)
  (let %0 double (const double 1e16))
  (let %1 double (const double 1e-5))
  (let %2 float (const float 0.1))
  (let %3 double (const double 123456789012345678.0))
  (let %4 double (const double -0.0))
  (let %5 double (const double 1e300))
  (let %6 double (const double 5e-324))
  (let %7 float (const float 3.4e38))
  (let %8 double (const double 0.30000000000000004))
  (let %9 double (const double 100.0))
  (let %10 double (const double 1e15))
  (let %11 double (const double 0.0001))
  (let %12 double (const double 2.5e-5))
  (let %13 double (const double 9007199254740993))
  (let %14 float (const float 16777217))
  (let %15 float (const float 1e-45))
  (let %16 double (const double 1.7976931348623157e308))
  (let %17 double (const double 12345678901234567890))
  (let %18 double (fadd double %0 %1))
  (let %19 double (fsub double %0 %1))
  (let %20 double (fmul double %0 %1))
  (let %21 double (fdiv double %0 %1))
  (let %22 double (fneg double %0))
  (let %23 bool (lt.f double %0 %1))
  (let %24 bool (le.f float %2 (const float 2.5)))
  (let %25 double (fconv double %2))
  (let %26 float (fconv float %0))
  (let %27 float (fconv float %2))
  (return (const int 0)))

