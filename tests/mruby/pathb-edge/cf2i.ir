(ir-module "edge.cpp" (layout (short 2) (int 4) (long 8) (long_long 8) (pointer 8) (float 4) (double 8) (long_double 16)))

(function "main"
  (ret int)
  (params)
  (let %0 char (cf2i char (const float 3.75)))
  (let %1 unsigned_char (cf2i unsigned_char (const float 3.75)))
  (let %2 short (cf2i short (const float 3.75)))
  (let %3 unsigned_short (cf2i unsigned_short (const float 3.75)))
  (let %4 int (cf2i int (const float 3.75)))
  (let %5 unsigned_int (cf2i unsigned_int (const float 3.75)))
  (let %6 long (cf2i long (const float 3.75)))
  (let %7 unsigned_long (cf2i unsigned_long (const float 3.75)))
  (let %8 signed_char (cf2i signed_char (const float 3.75)))
  (let %9 unsigned_long_long (cf2i unsigned_long_long (const float 3.75)))
  (let %10 char (cf2i char (const double 3.75)))
  (let %11 unsigned_char (cf2i unsigned_char (const double 3.75)))
  (let %12 short (cf2i short (const double 3.75)))
  (let %13 unsigned_short (cf2i unsigned_short (const double 3.75)))
  (let %14 int (cf2i int (const double 3.75)))
  (let %15 unsigned_int (cf2i unsigned_int (const double 3.75)))
  (let %16 long (cf2i long (const double 3.75)))
  (let %17 unsigned_long (cf2i unsigned_long (const double 3.75)))
  (let %18 signed_char (cf2i signed_char (const double 3.75)))
  (let %19 unsigned_long_long (cf2i unsigned_long_long (const double 3.75)))
  (let %20 double (i2f double (const int 3)))
  (let %21 float (i2f float (const long 3)))
  (let %22 double (u2f double (const unsigned_int 3)))
  (let %23 float (u2f float (const unsigned_long 3)))
  (let %24 double (i2f double (const unsigned_long 3)))
  (let %25 double (i2f double (const char 3)))
  (return (const int 0)))

