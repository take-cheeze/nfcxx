(ir-module "edge.cpp" (layout (short 2) (int 4) (long 8) (long_long 8) (pointer 8) (float 4) (double 8) (long_double 16)))

(function "vla"
  (ret int)
  (params (param %0 "n" int))
  (slot "n" int 4 4)
  (slot "a" (ptr (array ? int)) 8 8)
  (slot "b" (ptr (array ? (array ? char))) 8 8)
  (store int $"n" %0)
  (let %1 int (load int $"n"))
  (let %2 unsigned_long (iconv unsigned_long %1))
  (let %3 unsigned_long (wmul unsigned_long %2 (const unsigned_long 4)))
  (vlaalloc $"a" %3)
  (let %4 unsigned_int (iconv unsigned_int %1))
  (vlaalloc $"b" %4)
  (let %5 (ptr (array ? int)) (load (ptr (array ? int)) $"a"))
  (let %6 (ptr int) (bitcast (ptr int) %5))
  (let %7 (ptr int) (index %6 (const int 3) %3))
  (let %8 (ptr int) (index %6 (const int 3) %4))
  (let %9 long (pdiff %7 %8 %3))
  (let %10 long (pdiff %7 %8 %4))
  (let %11 long (pdiff %7 %8 4))
  (store int %7 (const int 1))
  (return (const int 0)))
(function "main"
  (ret int)
  (params)
  (return (const int 0)))
