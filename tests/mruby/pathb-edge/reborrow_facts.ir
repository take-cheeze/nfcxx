(ir-module "reborrow_facts" (layout (pointer 8) (int 4)))
(function "main"
  (ret int)
  (params)
  (slot "x" int 4 4)
  (decl $"x" val)
  (store int $"x" (const int 1))
  (let %0 (ptr int) (borrow (ptr int) "parent" exclusive $"x"))
  (let %1 (ptr int) (reborrow (ptr int) "child" exclusive "parent" %0))
  (store int %1 (const int 7))
  (loan-end "child")
  (let %2 int (load int %0))
  (loan-end "parent")
  (scope-end $"x")
  (return %2))
