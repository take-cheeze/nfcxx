(ir-module "drop_state_facts" (layout (pointer 8) (int 4)))
(function "main"
  (ret int)
  (params)
  (slot "x" int 4 4)
  (drop-obligation "x" int $"x")
  (decl $"x" val)
  (store int $"x" (const int 2))
  (drop-live "x")
  (let %0 int (move-value int $"x"))
  (drop-state-if-live "x")
  (store int $"x" (const int 5))
  (drop-live "x")
  (let %1 int (load int $"x"))
  (drop-state "x")
  (let %2 int (wadd int %0 %1))
  (scope-end $"x")
  (return %2))
