(ir-module "edge.cpp" (layout (short 2) (int 4) (long 8) (long_long 8) (pointer 8) (float 4) (double 8) (long_double 16)))

(function "resolve_impl"
  (ret long)
  (params)
  (static)
  (return (const long 0)))

(alias "ifn" "resolve_impl" ifunc)

(function "main"
  (ret int)
  (params)
  (let %0 int (call int &"ifn" (const int 1)))
  (return %0))
