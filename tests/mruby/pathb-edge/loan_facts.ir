(ir-module "loan_facts" (layout (pointer 8) (int 4)))
(function "main"
  (ret int)
  (params)
  (slot "x" int 4 4)
  (decl $"x" val)
  (store int $"x" (const int 1))
  (let %0 (ptr int) (borrow (ptr int) "read" shared $"x"))
  (let %1 int (load int %0))
  (loan-end "read")
  (let %2 (ptr int) (borrow (ptr int) "write" exclusive $"x"))
  (store int %2 (const int 7))
  (let %3 int (load int %2))
  (loan-end "write")
  (scope-end $"x")
  (return %3))
