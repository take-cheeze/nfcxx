(ir-module "edge.cpp" (layout (short 2) (int 4) (long 8) (long_long 8) (pointer 8) (float 4) (double 8) (long_double 16)))

(global "gv" (volatile int) 4 4 (init (zero 0 4)))
(global "gvp" (volatile (ptr (volatile char))) 8 8 (init (zero 0 8)))
(function "main"
  (ret int)
  (params (param %0 "p" (ptr (volatile unsigned_short))))
  (slot "p" (ptr (volatile unsigned_short)) 8 8)
  (slot "c" (volatile char) 1 1)
  (slot "uc" (volatile unsigned_char) 1 1)
  (slot "s" (volatile short) 2 2)
  (slot "u" (volatile unsigned_int) 4 4)
  (slot "l" (volatile long) 8 8)
  (slot "f" (volatile float) 4 4)
  (slot "d" (volatile double) 8 8)
  (slot "q" (volatile (ptr int)) 8 8)
  (slot "b" (volatile bool) 1 1)
  (store (ptr (volatile unsigned_short)) $"p" %0)
  (store.v char $"c" (const char 1))
  (store.v unsigned_char $"uc" (const unsigned_char 2))
  (store.v short $"s" (const short 3))
  (store.v unsigned_int $"u" (const unsigned_int 4))
  (store.v long $"l" (const long 5))
  (store.v float $"f" (const float 1.5))
  (store.v double $"d" (const double 2.5))
  (store.v (ptr int) $"q" (null (ptr int)))
  (store.v bool $"b" (const bool 1))
  (store.v int @"gv" (const int 6))
  (let %1 char (load.v char $"c"))
  (let %2 unsigned_char (load.v unsigned_char $"uc"))
  (let %3 short (load.v short $"s"))
  (let %4 unsigned_int (load.v unsigned_int $"u"))
  (let %5 long (load.v long $"l"))
  (let %6 float (load.v float $"f"))
  (let %7 double (load.v double $"d"))
  (let %8 (ptr int) (load.v (ptr int) $"q"))
  (let %9 bool (load.v bool $"b"))
  (let %10 int (load.v int @"gv"))
  (let %11 (ptr (volatile unsigned_short)) (load (ptr (volatile unsigned_short)) $"p"))
  (let %12 unsigned_short (load.v unsigned_short %11))
  (store.v unsigned_short %11 (const unsigned_short 7))
  (return %10))
