(ir-module "borrow_facts.cpp" (layout (short 2) (int 4) (long 8) (long_long 8) (pointer 8) (float 4) (double 8) (long_double 16)))

(function "bf"
  (ret int)
  (params (param %0 "r" (ptr int)) (param %1 "n" int))
  (slot "r" (ptr int) 8 8)
  (slot "n" int 4 4)
  (slot "x" int 4 4)
  (slot "rx" (ptr int) 8 8)
  (slot "t" int 4 4)
  (decl %0 ref)
  (decl %1 param)
  (store (ptr int) $"r" %0)
  (store int $"n" %1)
  (decl $"x" val)
  (store int $"x" (const int 1))
  (decl $"rx" ref)
  (store (ptr int) $"rx" $"x")
  (block
    (decl $"t" val)
    (store int $"t" (const int 2))
    (rref-arg %0)
    (scope-end $"t"))
  (rref-arg $"x")
  (scope-end $"rx")
  (scope-end $"x")
  (return (const int 0)))

(function "ptr_decl"
  (ret void)
  (params)
  (slot "p" (ptr int) 8 8)
  (decl $"p" val)
  (decl $"p" ref)
  (scope-end $"p")
  (return))
