(ir-module "edge.cpp" (layout (short 2) (int 4) (long 8) (long_long 8) (pointer 8) (float 4) (double 8) (long_double 16)))

(global "g" (array 16 int) 64 64 (init (zero 0 64)))
(global "h" int 4 4096 (init (scalar 0 int (const int 3))))
(global "d" double 8 8 (init (scalar 0 double (const double inf))))
(global "f" float 4 4 (init (scalar 0 float (const float -inf))))
(function "main"
  (ret int)
  (params)
  (slot "buf" (array 64 char) 64 64)
  (slot "small" int 4 4)
  (slot "wide" (array 8 long) 64 128)
  (store int $"small" (const int 1))
  (let %0 (ptr char) (bitcast (ptr char) $"buf"))
  (store char %0 (const char 2))
  (let %1 (ptr long) (bitcast (ptr long) $"wide"))
  (store long %1 (const long 3))
  (let %2 double (const double nan))
  (let %3 float (const float inf))
  (let %4 int (load int $"small"))
  (return %4))
