(ir-module "field_move_facts" (layout (pointer 8) (int 4)))
(function "main"
  (ret int)
  (params)
  (slot "s" (struct "Pair") 8 4)
  (decl $"s" val)
  (zero-fill 8 $"s")
  (store int $"s" (const int 2))
  (store int (offset $"s" 4) (const int 5))
  (let %0 int (move-value int (offset $"s" 0)))
  (let %1 int (copy-value int (offset $"s" 4)))
  (store int (offset $"s" 0) (const int 3))
  (let %2 int (wadd int %0 %1))
  (scope-end $"s")
  (return %2))
