(global "fn_table" (array 2 (ptr (fn int (int)))) 16 8 (init
    (addr 0 (ptr (fn int (int))) &"absent_fn" 0)
    (addr 8 (ptr (fn int (int))) &"weak_def_fn" 0)))
(declare "absent_fn" (weak))
(declare "absent_void" (weak))
(declare "weak_def_fn" (weak))
(function "weak_def_fn"
