(ir-module "move_facts" (layout (pointer 8) (int 4)))
(function "main"
  (ret int)
  (params)
  (slot "x" int 4 4)
  (decl $"x" val)
  (store int $"x" (const int 2))
  (let %0 int (copy-value int $"x"))
  (let %1 int (move-value int $"x"))
  (store int $"x" (const int 3))
  (let %2 int (copy-value int $"x"))
  (let %3 int (wadd int %0 %1))
  (let %4 int (wadd int %3 %2))
  (scope-end $"x")
  (return %4))
