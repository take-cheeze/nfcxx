(ir-module "edge.cpp" (layout (short 2) (int 4) (long 8) (long_long 8) (pointer 8) (float 4) (double 8) (long_double 16)))
(abi-type "II" 8 4 (leaf 0 w) (leaf 4 w))
(abi-type "MIX" 16 8 (leaf 0 l) (leaf 8 d))
(abi-type "PAD" 16 8 (leaf 0 w) (leaf 8 l))
(abi-type "BIG" 24 8 (memory))
(abi-type "EMP" 1 1 (empty))
(abi-type "UNI" 8 8 (unsupported "union"))

(function "mk"
  (ret void)
  (params (sret %0 (struct "II")) (param %1 "a" int))
  (slot "a" int 4 4)
  (store int $"a" %1)
  (return))
(function "take"
  (ret int)
  (params (param %0 "x" (byval (struct "MIX"))) (param %1 "e" (byval (struct "EMP"))) (param %2 "p" (byval (struct "PAD"))) (param %3 "b" (byval (struct "BIG"))))
  (return (const int 1)))
(function "ret_empty"
  (ret void)
  (params (sret %0 (struct "EMP")))
  (return))
(function "main"
  (ret int)
  (params)
  (slot "t" (struct "II") 8 4)
  (slot "m" (struct "MIX") 16 8)
  (slot "e" (struct "EMP") 1 1)
  (slot "p" (struct "PAD") 16 8)
  (slot "b" (struct "BIG") 24 8)
  (eval (call void &"mk" (sret (struct "II") $"t") (const int 4)))
  (let %0 int (call int &"take" (byval (struct "MIX") $"m") (byval (struct "EMP") $"e") (byval (struct "PAD") $"p") (byval (struct "BIG") $"b")))
  (eval (call void &"ret_empty" (sret (struct "EMP") $"e")))
  (eval (call void &"ext" (variadic 1) (sret (struct "II") $"t") (const int 1)))
  (return (const int 0)))
