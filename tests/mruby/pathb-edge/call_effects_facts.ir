(ir-module "call_effects_facts" (layout (pointer 8) (int 4)))
(call-effects "nfcb_init" (returns void) (nothrow) (noescape) (closed) (args (init int) (value int)))
(call-effects "nfcb_read" (returns int) (nothrow) (noescape) (closed) (args (read int)))
(call-effects "nfcb_write" (returns void) (nothrow) (noescape) (closed) (args (write int) (value int)))
(call-effects "nfcb_consume" (returns int) (nothrow) (noescape) (closed) (args (consume int)))
(function "main"
  (ret int)
  (params)
  (slot "x" int 4 4)
  (drop-obligation "x" int $"x")
  (decl $"x" val)
  (eval (call void &"nfcb_init" $"x" (const int 7)))
  (drop-live "x")
  (let %0 int (call int &"nfcb_read" $"x"))
  (eval (call void &"nfcb_write" $"x" (const int 11)))
  (let %1 int (call int &"nfcb_consume" $"x"))
  (let %2 int (wsub int %1 (const int 11)))
  (let %3 int (wadd int %0 %2))
  (scope-end $"x")
  (return %3))
