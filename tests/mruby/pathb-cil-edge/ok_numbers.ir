(ir-module "numbers.cpp" (layout (int 4)))
(function "n1" (ret int) (params) (return (const int -0x10)))
(function "n2" (ret long) (params) (return (const long 0xffffffffffffffff)))
(function "n3" (ret long) (params) (return (const long -9223372036854775808)))
(function "n4" (ret double) (params) (return (const double 1.)))
(function "n5" (ret double) (params) (return (const double -0.0)))
(function "n6" (ret double) (params) (return (const double 1.5e-3)))
(function "n7" (ret double) (params) (return (const double 1.0E5)))
(function "n8" (ret double) (params) (return (const double 1e300)))
(function "n9" (ret float) (params) (return (const float 0.1)))
(function "n10" (ret int) (params) (return (const int 2.5)))
(function "n11" (ret long) (params) (return (const long 1.0e300)))
(function "n12" (ret double) (params) (return (const double 4294967296)))
(function "n13" (ret float) (params) (return (const float 3.4e38)))
(function "n14" (ret double) (params) (return (const double inf)))
(function "n15" (ret double) (params) (return (const double nan)))
(function "n16" (ret unsigned_int) (params) (return (const unsigned_int 4294967295)))
(function "n17" (ret unsigned_long) (params) (return (const unsigned_long 0x8000000000000000)))
(function "n18" (ret double) (params) (return (const double 007)))
(function "n19" (ret long) (params) (return (const long 9223372036854775807)))
(function "n20" (ret double) (params) (return (const double -1.25e+2)))
