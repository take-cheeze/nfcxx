(ir-module "ov" (layout (short 2) (int 4) (long 8) (long_long 8) (pointer 8) (float 4) (double 8) (long_double 16)))
(function "add32" (ret int) (params (param %0 "a" int) (param %1 "b" int)) (let %2 int (cadd int %0 %1)) (return %2))
(function "sub32" (ret int) (params (param %0 "a" int) (param %1 "b" int)) (let %2 int (csub int %0 %1)) (return %2))
(function "mul32" (ret int) (params (param %0 "a" int) (param %1 "b" int)) (let %2 int (cmul int %0 %1)) (return %2))
(function "neg32" (ret int) (params (param %0 "a" int)) (let %2 int (cneg int %0)) (return %2))
(function "addu" (ret unsigned_int) (params (param %0 "a" unsigned_int) (param %1 "b" unsigned_int)) (let %2 unsigned_int (cadd unsigned_int %0 %1)) (return %2))
(function "add64" (ret long) (params (param %0 "a" long) (param %1 "b" long)) (let %2 long (cadd long %0 %1)) (return %2))
(function "sub64" (ret long) (params (param %0 "a" long) (param %1 "b" long)) (let %2 long (csub long %0 %1)) (return %2))
(function "mul64" (ret long) (params (param %0 "a" long) (param %1 "b" long)) (let %2 long (cmul long %0 %1)) (return %2))
(function "neg64" (ret long) (params (param %0 "a" long)) (let %2 long (cneg long %0)) (return %2))
(function "addul" (ret unsigned_long) (params (param %0 "a" unsigned_long) (param %1 "b" unsigned_long)) (let %2 unsigned_long (cadd unsigned_long %0 %1)) (return %2))
(function "subul" (ret unsigned_long) (params (param %0 "a" unsigned_long) (param %1 "b" unsigned_long)) (let %2 unsigned_long (csub unsigned_long %0 %1)) (return %2))
(function "mulul" (ret unsigned_long) (params (param %0 "a" unsigned_long) (param %1 "b" unsigned_long)) (let %2 unsigned_long (cmul unsigned_long %0 %1)) (return %2))
(function "sc" (ret char) (params (param %0 "a" char) (param %1 "b" char)) (let %2 char (cadd char %0 %1)) (return %2))
