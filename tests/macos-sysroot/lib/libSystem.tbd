--- !tapi-tbd
# Clean-room link stub for scripts/cross-macos-check.sh --link. Written from the public C and POSIX names and from
# nfcxx's own references (tests/c, be/nfcxx_ldrt.c). It exports symbols only: there is no code and no behaviour, so a
# program linked against it can be checked for its Mach-O shape and its imports, not run. Not Apple's libSystem.
tbd-version:     4
targets:         [ arm64-macos ]
uuids:
  - target:          arm64-macos
    value:           00000000-0000-0000-0000-000000000000
install-name:    /usr/lib/libSystem.B.dylib
current-version: 1
compatibility-version: 1
exports:
  - targets:         [ arm64-macos ]
    symbols:         [ _abort, _abs, _acos, _asin, _atan2, _ceil, _clearerr, _clock, _cos, _difftime,
                       ___divti3, dyld_stub_binder, ___error, _exit, _exp, _fabs, _fabsf, _fclose, _feof,
                       _ferror, _fflush, _fgets, ___fixdfti, ___fixsfti, ___fixunsdfti, ___fixunssfti,
                       ___floattidf, ___floattisf, ___floatuntidf, ___floatuntisf, _floor, _fmod, _fopen,
                       _fprintf, _fputs, _fread, _free, _freopen, _frexp, _fseek, _ftell, _fwrite, _getc,
                       _getenv, _gmtime, _isalnum, _isalpha, _iscntrl, _isdigit, _isgraph, _islower,
                       _ispunct, _isspace, _isupper, _isxdigit, _ldexp, _localeconv, _localtime, _log,
                       _log10, _log2, _longjmp, _memchr, _memcmp, _memcpy, _memset, _mktime, ___modti3, _pow,
                       _printf, _puts, _qsort, _realloc, _remove, _rename, _setjmp, _setlocale, _setvbuf,
                       _signal, _sin, _snprintf, _sqrt, ___stderrp, ___stdinp, ___stdoutp, _strchr, _strcmp,
                       _strcoll, _strcpy, _strerror, _strftime, _strlen, _strncmp, _strpbrk, _strspn,
                       _strstr, _strtod, _strtol, _system, _tan, _time, _tmpfile, _tmpnam, _tolower,
                       _toupper, ___udivti3, ___umodti3, _ungetc, _vsnprintf, _memmove, __setjmp, _access,
                       _close, _dup, _isatty, _read, _write, _trunc, _round, _strrchr, _strncpy, _strncat,
                       _strcat, _putc, _fputc, _fileno, _fgetc, __longjmp, __exit, _dup2, _execl, _fcntl, _flock, _fork, _ftruncate, _getcwd, _getpwnam, _lseek, _open, _pipe, _readlink, _realpath, _select, _symlink, _sysconf, _umask, _unlink, _waitpid, _chmod, _lstat, _fstat, _stat, _pwrite, _pread, _strtoll, _strtoull, ___stack_chk_fail, ___stack_chk_guard, ___cxa_atexit, ___cxa_finalize, _atexit, _bzero, _malloc, _posix_memalign, _vfprintf, _atoi, ___cxa_thread_atexit, _gettimeofday, _raise, _gmtime_r, _sigaction, _sigaltstack, _rand, _srand, _ceilf, __tlv_bootstrap, __Unwind_DeleteException, __Unwind_GetIP, __Unwind_GetLanguageSpecificData, __Unwind_GetRegionStart, __Unwind_RaiseException, __Unwind_Resume, __Unwind_SetGR, __Unwind_SetIP, _pthread_getspecific, _pthread_key_create, _pthread_mutex_lock, _pthread_mutex_unlock, _pthread_once, _pthread_setspecific, _calloc, _fseeko, _ftello, ___mb_cur_max, _mbrtowc_l, _mbsinit_l, _mbsrtowcs_l, _wcrtomb_l, _wcsnrtombs_l, ___mb_cur_max_l, _mbrlen_l, _mbtowc_l, _mbsnrtowcs_l, _fputwc, _getwc, _ungetwc, _iswalpha, _iswblank, _iswcntrl, _iswdigit, _iswlower, _iswprint, _iswpunct, _iswspace, _iswupper, _iswxdigit, _pthread_cond_broadcast, _pthread_cond_wait, _uselocale, _wcscoll, _wcsxfrm, _asprintf_l, _btowc, _catclose, _catgets, _catopen, _freelocale, _isdigit_l, _islower_l, _isupper_l, _iswctype, _isxdigit_l, _localeconv_l, _nanosleep, _newlocale, _pthread_cond_destroy, _pthread_cond_signal, _pthread_cond_timedwait, _pthread_detach, _pthread_join, _pthread_mutex_destroy, _pthread_mutex_init, _pthread_mutex_trylock, _pthread_mutexattr_destroy, _pthread_mutexattr_init, _pthread_mutexattr_settype, _pthread_self, _snprintf_l, _sscanf, _sscanf_l, _strcoll_l, _strerror_r, _strftime_l, _strtod_l, _strtof, _strtof_l, _strtold, _strtold_l, _strtoll_l, _strtoul, _strtoull_l, _strxfrm_l, _swprintf, _tolower_l, _toupper_l, _towlower, _towupper, _wcslen, _wcstod, _wcstof, _wcstol, _wcstold, _wcstoll, _wcstoul, _wcstoull, _wctob, _wmemchr, _wmemcmp ]
    weak-symbols:    [ ]
    objc-classes:    [ ]
    objc-ivars:      [ ]
    objc-eh-types:   [ ]
...
