#!/usr/bin/env bash
# nfcxx: experimental C++ compiler driver.
#   Path A: C++ --(EDG front end)--> C --(host C compiler)--> executable
# Usage: nfcxx [--emit-c] [--backend=gcc|pathb] [--dialect=g++|clang] [--gnu-version=N] [--freestanding]
# Options are flags; most also have an NFCXX_* environment variable (listed with each), the fallback for build systems and
# scripts that cannot change a command line. When both are given the flag wins. Tool and host locations stay environment
# variables, as CC= does: NFCXX_GCC, NFCXX_CC, NFCXX_CXX, NFCXX_COSMOCC, NFCXX_SYSTEM_PATHS, NFCXX_SYS_INCLUDES,
# NFCXX_K1OM_ROOT, NFCXX_MACOS_SYSROOT, and the CUDA tuning variables (NFCXX_SM, NFCXX_CUDA_*, docs/notes/gpu.md).
#   Hosted (default): host C++ headers and GNU version from g++ (see scripts/host-sys.rb host_sys_includes below).
#              [-o out] [-std=c++NN] file.cpp...
#   pathb (default on x86-64 Linux, unless cosmo, --emit-c, --target, -E, -M or -shared is
#                  asked for; --backend=pathb, or NFCXX_PATH=b): EDG lowered IL -> typed IR -> QBE, no generated C. Hosted programs, and freestanding ones on x86-64 and aarch64 Linux and arm64 macOS.
#                  A program it does not build is built with the gcc backend instead (docs/notes/pathb-default.md).
#   gcc (default elsewhere, and for the options above): EDG's generated C through the host compiler (scripts/gcc-cc.rb)
#   gcc:           generated C -> gcc -O2 -fwrapv -fno-strict-aliasing
#                  Needs the Path B harness (scripts/setup-pathb.sh, PATHB_CPFE/PATHB_BASE); docs/notes/pathb-hosted.md.
#   --dialect:     EDG front-end mode (default g++; NFCXX_DIALECT overrides the default)
#   --ir-opt=LIST (NFCXX_IR_OPT): the Path B IR passes (docs/notes/pathb-ir-passes.md), a comma-separated list or none. Off by
#                  default for host code; a .cu file's device code runs inline,sroa unless it is set (--ir-opt=off turns them off).
#   --eh-unwind (NFCXX_EH_UNWIND=1): a throw runs the cleanups of the frames it unwinds in the system unwinder (gcc and Path B
#                  backends; docs/notes/eh-shim.md). --no-eh-unwind undoes it. --no-eh-shim (NFCXX_EHSHIM=0) links without the EH shim.
#   --instantiate=used|auto (NFCXX_INSTANTIATE): templates are instantiated in each unit that uses them (default) or by EDG's
#                  prelinker at link time (docs/notes/cxx-driver.md).
#   --promote-slots=on|off, --unroll=on|off, --struct-slots=on|off (NFCXX_PROMOTE_SLOTS, NFCXX_UNROLL, NFCXX_STRUCT_SLOTS = 0|1):
#                  the optimizations of a .cu file's device code (docs/notes/gpu.md); on by default.
#   --pathb-c=gcc (NFCXX_PATHB_C=gcc): with Path B, the .c inputs go through gcc-cc instead of Path B's C front end.
#   --gnu-version: GCC version the g++ front end emulates, e.g. 130000 (EDG default when unset)
#   -fsanitize=undefined|CHECK[,CHECK...]: the undefined behavior sanitizer (docs/notes/ubsan.md). Implies Path B, whose IR has the
#                  checks; a failing check prints "file:line: runtime error: ..." and aborts. -fno-sanitize=all turns it off.
#   file.cpp2:     Cpp2 source, experimental: cppfront (build/cppfront, scripts/setup-cppfront.sh) translates it to C++ first.
#                  docs/notes/cpp2.md.
#   --trace=FILE: write a Chrome trace-event JSON file (open in ui.perfetto.dev); NFCXX_TRACE=FILE too.
#   --time-log=FILE (NFCXX_TIME_LOG=FILE): appends one line per stage, "SECONDS<Tab>CATEGORY<Tab>STAGE<Tab>SOURCE", to FILE; the compiles
#                  of a parallel build can share it (sort -rn FILE ranks them). A .cu file's stages are the rewriter's two
#                  passes, the device front end, the PTX emitter, ptxas, the embed step and the host compile (eccp).
#   --module-dir=DIR: where C++ module interface files (NAME.eifc) are written and read; the default is the directory of -o.
#                  A program with `export module` or `import` is built one source at a time (docs/notes/modules.md).
#   NFCXX_CUDA_HOST_SYMBOLS=FILE: internal (the second pass of a .cu compile, see "Kernel instances from the host
#                  compile" below): the demangled symbols of the first pass's output, for the device rewrite.
#   --keep-intermediates (NFCXX_KEEP_INTERMEDIATES=1): a compile and link keeps its intermediates (the .o files, <stem>.ii, <stem>.ti) in the
#                  temporary directory the driver names on stderr, instead of removing it on exit. A -c compile keeps
#                  <stem>.ii and <stem>.ti beside its object in any case: the link that follows reads them there.
#   -shared [-fPIC] [-rdynamic]: build a shared object (-shared implies -fPIC); -rdynamic exports an
#                  executable's symbols so a dlopen'd object can bind to them. See docs/notes/eval.md.
#   --bundle-libs [--bundle-exclude=NAME,...] [--bundle-only=NAME,...]: after the link, the shared libraries the output
#                  needs (libstdc++, libgcc_s, the program's own; never glibc) are copied into it, so it runs without them
#                  (tools/bundle, docs/notes/bundle.md). Executables and -shared objects.
#   --cuda-driver=auto|cudart|libcuda: a link that names libcuda (-lcuda, CMake's CUDA::cuda_driver path) reaches the
#                  CUDA driver API through libcudart instead (default auto; scripts/wrap.rb,
#                  docs/notes/cuda-driver.md); NFCXX_CUDA_DRIVER= for every command.
#   -c / *.o:      separate compilation: `nfcxx -c a.cpp -o a.o`, then `nfcxx a.o b.o -o x` links objects (docs/notes/multi-tu.md).
#   -fuse-ld=NAME (NFCXX_LD=NAME): link with that linker (mold, lld, gold, bfd; needs ld.NAME on PATH). Default: the system linker.
#   --cache=DIR (NFCXX_CACHE=DIR): keeps each -c compile in DIR and takes it back when nothing it depends on changed (docs/notes/cxx-driver.md).
#                  For a .cu file it keeps the device images (DIR/cu-device): an unchanged device unit skips the device
#                  front end, the PTX emitter and ptxas; the rewriter and the host compile still run.
#   --cache-log=FILE (NFCXX_CACHE_LOG=FILE): with --cache, appends each lookup's key inputs, its key, and hit or miss to FILE, to diff a miss against a hit.
#   NFCXX_CACHE_REMOTE=gha: with the cache, objects are also kept in the GitHub Actions cache (scripts/nfcxx-cache-gha.rb), like sccache's GHA backend.
#   -fsanitize=address: AddressSanitizer (heap/stack/global overflow, use-after-free, double free, leaks). Path B (the default
#                  backend) calls libasan's checks before each access through a computed address (docs/notes/asan-plan.md), and
#                  a program Path B does not build falls back to gcc, which instruments the code; --backend=gcc is used.
#                  docs/notes/asan.md. -fno-sanitize=address undoes it; other -fsanitize= values are
#                  refused (-fsanitize=undefined and its checks are the UBSan option above).
#   -fsafe-pointers: Fil-C-style memory safety checks (docs/notes/safe-pointers.md). Implies Path B: pointer arithmetic must
#                  stay in its object, loads and stores must be in a live object (heap, global, escaping local), and a
#                  freed or returned-from object cannot be used; a failure prints "file:line: safety error: ..." and
#                  aborts. -fno-safe-pointers turns it off.
#   --freestanding: headers come only from lib/ (no EDG std headers, no hosted libc++/libstdc++),
#                  and --gnu-version defaults to 130000. Opt-in; see docs/notes/freestanding.md.
#   --target=NAME: with --freestanding and --emit-c only. The front end lays out the program for an EDG target (sizes,
#                  predefined macros) instead of the build host: linux_aarch64, linux_armv7, linux_riscv64, linux_riscv32,
#                  linux_i686, linux_k1om (Intel Knights Corner: freestanding, the k1om GCC; docs/notes/k1om.md), win64 (MinGW's macros when MinGW is installed at setup; docs/notes/freestanding.md, "Windows"), win32. The generated C is for that target, so the
#                  host cc must not compile it: give it to a cross compiler. docs/notes/freestanding.md, "Targets".
#   --cosmo: build with cosmocc (Cosmopolitan libc, APE output) as the C compiler. Implies --backend=gcc. cosmocc is
#                  read from NFCXX_COSMOCC, else build/cosmocc/bin/cosmocc (scripts/setup-cosmo.sh). docs/notes/cosmo.md.
set -euo pipefail
root=$(cd "$(dirname "$0")" && pwd)
# temp_cleanup: removes the driver's temporary directories the EXIT traps name. Each trap calls it, so a later trap (which
# replaces an earlier one) does not leave the earlier stage's directory behind. The eccp directory is not here: eccp_cleanup
# removes it, and only when the intermediates are not kept.
temp_cleanup() {
  [ -z "${tmp:-}" ] || rm -rf "$tmp"
  [ -z "${ptmp:-}" ] || rm -rf "$ptmp"
  [ -z "${ctmp:-}" ] || rm -rf "$ctmp"
  [ -z "${cudatmp:-}" ] || rm -rf "$cudatmp"
  [ -z "${fso_dir:-}" ] || rm -rf "$fso_dir"
}
# -fsyntax-only is rewritten by the Ruby driver before this body runs (scripts/nfcxx-syntax-only.rb).
# --bundle-libs and --cuda-driver= are wrapped by the Ruby driver before this body runs (scripts/wrap.rb, from scripts/nfcxx.rb).
source "$root/scripts/trace.sh"
edg=${EDG_BUILD:-$root/build/edg}/bin
# The exception handling state is per thread when the EDG runtime was built so (lib_src's RUNTIME_EH_TLS, Linux targets;
# scripts/setup-edg.sh then writes the eh-tls marker): --nfcxx_eh_thread_local makes the generated code declare it
# __thread too. A program whose threads run code with destructors or try blocks (ggml's CPU worker pool) shared one
# stack of EH entries before.
eh_tls=(); [ ! -f "$edg/../eh-tls" ] || eh_tls=(--nfcxx_eh_thread_local)

# The host probes are scripts/host-sys.rb's (the Ruby port of the functions this driver sourced); abs_path is the bash
# one, which runs once per argument and stays here.
abs_path() {
  local d b
  d=$(dirname "$1"); b=$(basename "$1")
  if (cd "$d" 2>/dev/null); then (cd "$d" && printf '%s/%s\n' "$(pwd -P)" "$b")
  else printf '%s\n' "$1"; fi
}
sanitize=""
std=--c++23; out=a.out; emit_c=0; backend=${NFCXX_BACKEND:-}; files=()   # empty: chosen below (default_backend)
cfiles=(); cflags=(); cflags_pic=(); ncpp=0; nobj=0
shared=0; pic=0; rdynamic=0; compile_only=0
asan=0; backend_explicit=0; asanopts=(); safeptr=0; cosmo=0
dialect=${NFCXX_DIALECT:-$("${RUBY:-ruby}" "$root/scripts/host-sys.rb" host_dialect)}; dialect_asked=${NFCXX_DIALECT:+1}; freestanding=0; gnu=""; trace=${NFCXX_TRACE:-}; target=""
# Options with a flag and an environment variable: the variable is the default, the flag overrides it (see the usage above).
path_b=0; [ "${NFCXX_PATH:-}" != b ] || path_b=1                        # --backend=pathb: Path B asked for by name
ir_opt_set=0; ir_opt=""; if [ -n "${NFCXX_IR_OPT+x}" ]; then ir_opt_set=1; ir_opt=$NFCXX_IR_OPT; fi   # --ir-opt=LIST
eh_unwind_on=0; [ "${NFCXX_EH_UNWIND:-}" != 1 ] || eh_unwind_on=1       # --eh-unwind
eh_shim_on=1; [ "${NFCXX_EHSHIM:-1}" != 0 ] || eh_shim_on=0             # --no-eh-shim
cache_dir=${NFCXX_CACHE:-}; cache_log_file=${NFCXX_CACHE_LOG:-}         # --cache=DIR, --cache-log=FILE
# NFCXX_CACHE_REMOTE=gha: each stored object is also kept in the GitHub Actions cache, and a local miss is looked up there
# (scripts/nfcxx-cache-gha.rb; docs/notes/cxx-driver.md). Without NFCXX_CACHE the local side is a temporary directory.
cache_remote=${NFCXX_CACHE_REMOTE:-}
case $cache_remote in ""|gha) ;; *) echo "nfcxx: NFCXX_CACHE_REMOTE takes gha (got '$cache_remote')" >&2; exit 2 ;; esac
[ -n "$cache_dir" ] || [ -z "$cache_remote" ] || cache_dir=${TMPDIR:-/tmp}/nfcxx-cache-$(id -u)
keep_intermediates=0; [ "${NFCXX_KEEP_INTERMEDIATES:-}" != 1 ] || keep_intermediates=1   # --keep-intermediates
time_log=${NFCXX_TIME_LOG:-}                                            # --time-log=FILE
instantiate=${NFCXX_INSTANTIATE:-used}                                  # --instantiate=used|auto
promote_slots=${NFCXX_PROMOTE_SLOTS:-1}; unroll=${NFCXX_UNROLL:-1}; struct_slots=${NFCXX_STRUCT_SLOTS:-1}   # --promote-slots= ...
ld_name=${NFCXX_LD:-}                                  # -fuse-ld=NAME
pathb_c=${NFCXX_PATHB_C:-}                                              # --pathb-c=gcc
pb_flags=()   # the options scripts/pathb-cc.rb gets (--asan, --safe-pointers, --sanitize=, --ir-opt=): flags, not exported variables
onoff() {  # onoff FLAG VALUE: on|1 -> 1, off|0 -> 0; anything else is an error
  case $2 in on|1) echo 1 ;; off|0) echo 0 ;; *) echo "nfcxx: $1 takes on or off (got '$2')" >&2; exit 2 ;; esac
}
# CUDA kernel names are obfuscated (docs/notes/gpu.md, "Kernel name obfuscation"): --obfuscate-kernels, or NFCXX_OBFUSCATE_KERNELS=1
# in the environment (which reaches a CMake build through nfcxx-cuda without any change to its command line).
obfuscate=0; case ${NFCXX_OBFUSCATE_KERNELS:-0} in 0|"") ;; *) obfuscate=1 ;; esac
# Compiler-driver options a build system passes (CMake, ninja, make; mruby's rake build). See docs/notes/cxx-driver.md.
pthread=0; preprocess=0; outset=0; depmode=""; dfile=""; dtarget=""; depphony=""
moddir=""   # --module-dir=DIR: where C++ module interface files are written and read (docs/notes/modules.md)
sysdirs=(); srcs=(); ppflags=(); pie_opts=(); xlang=""; stdin_src=0; preinc=(); isa=(); cuda_opts=()
# A .cu input is rewritten to C++ before the front end (tools/cuda-rewrite: launches become calls of
# __nfcxx_cuda_launch), and the runtime helper lib/cuda/nfcxx_cuda.h is included first. The copy goes in a temp
# directory that the EXIT traps below remove. Its basename is the source's, so default output names are unchanged.
cudatmp=""
# Device code of a .cu file: its __global__ and __device__ functions go through the Path B front end
# (scripts/pathb-dump.rb), the IR-to-PTX emitter (tools/pathb-ptx-emit) and ptxas for NFCXX_SM (default 75). The kernels
# are split into modules within NFCXX_CUDA_MAX_CONST_BYTES (65536: ptxas's limit on constant data) and
# NFCXX_CUDA_MAX_PTX_LINES; each module is one cubin (a file that fits has one). The cubins are embedded at the end of
# the host copy with a registration tail (pathb-ptx-emit --embed), so the one object holds the host code and its device
# images. A file with no kernel gets no device image.
# The cache helpers (the compile cache below and the device image cache of cu_rewrite).
cache_sha() { if command -v sha256sum >/dev/null 2>&1; then sha256sum; else shasum -a 256; fi; }
cache_log() {  # cache_log TEXT: appends TEXT as one write to NFCXX_CACHE_LOG when --cache-log (NFCXX_CACHE_LOG) is set (a diagnostic; no effect on the key).
  # The append is scripts/nfcxx-cache-io.rb log (a lock shared with the parallel compiles, one write per call).
  [ -n "$cache_log_file" ] || return 0
  "${RUBY:-ruby}" "$root/scripts/nfcxx-cache-io.rb" log "$cache_log_file" "$*"
}
# The remote tier (NFCXX_CACHE_REMOTE=gha). An entry is the object and its records, as one tar keyed by the cache key. A
# remote failure is a miss or a store that did not happen, with a note on stderr: a build does not fail for its cache.
# scripts/nfcxx-cache-io.rb does the work (the temporary entry, the move into place, the GHA client's calls and the note).
cache_remote_get() {  # cache_remote_get KEY ENTRY: fills ENTRY (a directory) from the remote cache; fails on a miss or an error
  "${RUBY:-ruby}" "$root/scripts/nfcxx-cache-io.rb" remote-get "$1" "$2"
}
cache_remote_put() {  # cache_remote_put KEY ENTRY: stores the files of the local entry ENTRY remotely
  "${RUBY:-ruby}" "$root/scripts/nfcxx-cache-io.rb" remote-put "$1" "$2" || true
}
# The rewritten copy of each .cu input is made after the arguments are read (cu_prepare), so that -c and -o are known:
# with -c the copy goes to the per-user cache (see cu_prepare), not to the user's tree. Otherwise it goes in a temp directory.
cu_inputs=()
cu_keep=""   # with -c: the directory the device images are kept in (the link re-reads the copy, and the copy names them)
cu_prepare() {  # cu_prepare: rewrites every .cu input and puts its copy in srcs and files in place of the source
  [ ${#cu_inputs[@]} -gt 0 ] || return 0
  cudatmp=$(mktemp -d); trap 'temp_cleanup; trace_finish' EXIT
  local dir=$cudatmp
  if [ $compile_only = 1 ]; then
    # The copy must outlive the compile: the prelinker re-reads it when it needs a template instance at link time,
    # and a failed link deletes the objects. It goes to a per-user cache, keyed by the absolute object path, and the
    # object records that absolute path, so the link finds it from any directory.
    local obj=$out; [ $outset = 1 ] || obj=$(basename "${cu_inputs[0]}" .cu).o
    # The directory is scripts/nfcxx-cuda-device.rb's (--cu-dir: the key is the SHA-1 of realpath -m OBJ, as before).
    dir=$("${RUBY:-ruby}" "$root/scripts/nfcxx-cuda-device.rb" --cu-dir="$obj") || exit $?
    mkdir -p "$dir"
    cu_keep=$dir
  fi
  # The loop over the inputs is scripts/nfcxx-cuda-device.rb --cu-prepare: the copies, the -I of each source directory, the
  # rewrite of each input (in that process) and the state it changes, which come back as the groups sdirs, copies, cuda and
  # preinc. The state goes in as records (state_put). The bash keeps the array edits (srcs, files, cflags) and sets cuda_opts
  # and preinc from the reply. A failing rewrite ends the driver with its status (the reply's file is read after the call).
  local rec group done=0 idx src copy i bpid=$BASHPID inf=$cudatmp/cu-in.rec outf=$cudatmp/cu-out.rec
  local cu_sdirs=() cu_copies=() cu_cuda=() cu_pre=()
  {
    state_put root "$root"; state_put tmp "$cudatmp"; state_put keep "$cu_keep"; state_put bash_pid "$bpid"
    state_put trace_unit "${trace_unit:-${NFCXX_TRACE_UNIT:-}}"; state_put dir "$dir"
    state_put inputs ${cu_inputs[@]+"${cu_inputs[@]}"}; state_put cflags ${cflags[@]+"${cflags[@]}"}
    if [ "$obfuscate" = 1 ]; then state_put obfuscate 1; else state_put obfuscate 0; fi
    if [ "$ir_opt_set" = 1 ]; then state_put ir_opt "$ir_opt"; else state_put ir_opt; fi
    state_put promote_slots "$promote_slots"; state_put unroll "$unroll"; state_put struct_slots "$struct_slots"
    state_put cache_dir "$cache_dir"; state_put cache_log "${cache_log_file:-}"
    state_put preinc ${preinc[@]+"${preinc[@]}"}; state_put cuda ${cuda_opts[@]+"${cuda_opts[@]}"}
    state_put edg_launch "${NFCXX_CUDA_EDG_LAUNCH:-1}"
  } > "$inf"
  "${RUBY:-ruby}" "$root/scripts/nfcxx-cuda-device.rb" --cu-prepare < "$inf" > "$outf" || exit $?
  while IFS= read -r -d '' rec; do
    case $rec in
      k*) group=${rec:1} ;;
      v*)
        case $group in
          sdirs) cu_sdirs+=("${rec:1}") ;;
          copies) cu_copies+=("${rec:1}") ;;
          cuda) cu_cuda+=("${rec:1}") ;;
          preinc) cu_pre+=("${rec:1}") ;;
        esac ;;
      x*) printf '%s\n' "${rec:1}" >&2; exit 2 ;;
      z) done=1 ;;
    esac
  done < "$outf"
  [ $done = 1 ] || { echo "nfcxx: scripts/nfcxx-cuda-device.rb stopped before its end (the .cu inputs are incomplete)" >&2; exit 1; }
  for idx in "${!cu_inputs[@]}"; do
    src=${cu_inputs[$idx]}; copy=${cu_copies[$idx]}
    cflags+=("-I${cu_sdirs[$idx]}"); files+=("-I${cu_sdirs[$idx]}")
    # if, not `[ ] && x`: a loop whose last test fails returns non-zero, and set -e would end the driver.
    for i in "${!srcs[@]}"; do if [ "${srcs[$i]}" = "$src" ]; then srcs[$i]=$copy; fi; done
    for i in "${!files[@]}"; do if [ "${files[$i]}" = "$src" ]; then files[$i]=$copy; fi; done
  done
  cuda_opts=(${cu_cuda[@]+"${cu_cuda[@]}"}); preinc=(${cu_pre[@]+"${cu_pre[@]}"})
}
# A .cpp2 input (experimental, docs/notes/cpp2.md) is translated to C++1 by cppfront (scripts/setup-cppfront.sh) before the
# front end, the way .cu inputs are rewritten: the copy has the source's basename, so default output names are unchanged, and
# its #line directives name the .cpp2 file. cppfront writes cpp2_post_build.sh into its working directory, so it runs in a
# scratch directory. The metaclass build steps that file would hold are not run. cpp2util.h, which the copy includes, comes from the pinned source.
cpp2_inputs=()
cpp2_prepare() {  # cpp2_prepare: translates every .cpp2 input and puts its translation in srcs and files in place of the source
  [ ${#cpp2_inputs[@]} -gt 0 ] || return 0
  local cppfront_src=${CPPFRONT_SRC:-$root/build/cppfront-src}
  [ -x "$root/build/cppfront" ] || { echo "nfcxx: cppfront is not built; run scripts/setup-cppfront.sh (docs/notes/cpp2.md)" >&2; exit 2; }
  [ -f "$cppfront_src/include/cpp2util.h" ] || { echo "nfcxx: no cpp2util.h under $cppfront_src; run scripts/setup-cppfront.sh" >&2; exit 2; }
  if [ -z "${cudatmp:-}" ]; then cudatmp=$(mktemp -d); trap 'temp_cleanup' EXIT; fi
  local dir=$cudatmp
  if [ $compile_only = 1 ]; then
    # As for .cu inputs (cu_prepare): the translation outlives the compile, because the prelinker re-reads it at link time.
    local obj=$out; [ $outset = 1 ] || obj=$(basename "${cpp2_inputs[0]}" .cpp2).o
    local key; key=$(realpath -m "$obj" | sha1sum | cut -c1-16)
    dir=${NFCXX_CU_CACHE:-${XDG_CACHE_HOME:-${HOME:-/tmp}/.cache}/nfcxx}/cpp2/$key
    mkdir -p "$dir"
  fi
  local scratch; scratch=$(mktemp -d -p "$cudatmp")
  # The translations are scripts/nfcxx-cpp2.rb --prepare (the source directories, and cppfront in the scratch directory, from
  # the records of the driver's state); the bash keeps the array edits. A failing step ends the driver with its status (the
  # reply's file is read after the call).
  local rec group done=0 idx src copy i inf=$cudatmp/cpp2-in.rec outf=$cudatmp/cpp2-out.rec
  local cpp2_sdirs=() cpp2_copies=()
  {
    state_put root "$root"; state_put dir "$dir"; state_put scratch "$scratch"; state_put cppfront "$root/build/cppfront"
    state_put inputs ${cpp2_inputs[@]+"${cpp2_inputs[@]}"}
  } > "$inf"
  "${RUBY:-ruby}" "$root/scripts/nfcxx-cpp2.rb" --prepare < "$inf" > "$outf" || exit $?
  while IFS= read -r -d '' rec; do
    case $rec in
      k*) group=${rec:1} ;;
      v*)
        case $group in
          sdirs) cpp2_sdirs+=("${rec:1}") ;;
          copies) cpp2_copies+=("${rec:1}") ;;
        esac ;;
      x*) printf '%s\n' "${rec:1}" >&2; exit 2 ;;
      z) done=1 ;;
    esac
  done < "$outf"
  [ $done = 1 ] || { echo "nfcxx: scripts/nfcxx-cpp2.rb stopped before its end (the translations are incomplete)" >&2; exit 1; }
  for idx in "${!cpp2_inputs[@]}"; do
    src=${cpp2_inputs[$idx]}; copy=${cpp2_copies[$idx]}
    cflags+=("-I${cpp2_sdirs[$idx]}"); files+=("-I${cpp2_sdirs[$idx]}")
    for i in "${!srcs[@]}"; do if [ "${srcs[$i]}" = "$src" ]; then srcs[$i]=$copy; fi; done
    for i in "${!files[@]}"; do if [ "${files[$i]}" = "$src" ]; then files[$i]=$copy; fi; done
  done
  cflags+=("-I$cppfront_src/include"); files+=("-I$cppfront_src/include")
}
# A CUDA_HOME outside /usr is still a system directory for the rewriter (its headers are not inlined into the device unit),
# so a CUDA_HOME-shaped directory from PyPI wheels (scripts/fetch-cudart-wheel.sh) behaves like the toolkit's.
[ -n "${CUDA_HOME:-}" ] && export NFCXX_SYSTEM_PATHS="$CUDA_HOME${NFCXX_SYSTEM_PATHS:+:$NFCXX_SYSTEM_PATHS}"
# NFCXX_CUDA_TARGET=amdgpu: lib/hip (the CUDA runtime on HIP, lib/hip/cuda_runtime.h) is a system directory for the rewriter too.
# (and ROCm's include directory, where the HIP headers are: the host copy's -I is the caller's.)
[ "${NFCXX_CUDA_TARGET:-nvidia}" = amdgpu ] && export NFCXX_SYSTEM_PATHS="$root/lib/hip:${ROCM:-/opt/rocm}/include${NFCXX_SYSTEM_PATHS:+:$NFCXX_SYSTEM_PATHS}"
# ensure_tool DIR OUT: builds the repo tool in DIR (its build.ninja) into OUT on first use. The driver runs in parallel
# (one process per source file), so the build is serialized by a lock directory: the first run builds, the others wait
# and find OUT. ninja's output is not hidden: a failed build says why.
ensure_tool() {
  local dir=$1 out=$2 lock=$2.lock waited=0
  # Fresh when the binary is newer than the sources in DIR (a binary from an older checkout is rebuilt, not reused).
  tool_fresh() { [ -x "$out" ] && [ -z "$(find "$dir" -maxdepth 1 -type f \( -name '*.c' -o -name '*.cpp' -o -name '*.h' -o -name '*.hpp' -o -name '*.inc' -o -name '*.rb' \) -newer "$out" -print -quit 2>/dev/null)" ]; }
  tool_fresh && return 0
  mkdir -p "$(dirname "$out")"   # a fresh checkout has no build/: the lock mkdir would fail and every run would wait
  while ! mkdir "$lock" 2>/dev/null; do
    tool_fresh && return 0
    sleep 0.2; waited=$((waited + 1))
    [ "$waited" -lt 3000 ] || { echo "nfcxx: $lock is stuck (remove it if no build is running)" >&2; return 1; }
  done
  local rc=0
  tool_fresh || CXX=${NFCXX_CXX:-g++} ninja -C "$dir" >&2 || rc=$?
  rmdir "$lock"
  return $rc
}
# The rewriter: the C++ tool (build/cuda-rewrite, built from tools/cuda-rewrite on first use).
ensure_tool "$root/tools/cuda-rewrite" "$root/build/cuda-rewrite" || exit $?
# A compile and link (or a link of objects) runs eccp in a temporary directory, which the EXIT trap removes. eccp writes
# <stem>.o, <stem>.ii and <stem>.ti into its working directory, and the prelinker reads the .ii and .ti there, so the
# records of one build could be read by the next build in the same directory. The arguments of such a run are made
# absolute first (ecp_args), because its working directory changes. A -c compile is not moved: the link that follows reads
# its <stem>.ii and <stem>.ti beside the object (see "-c" before the eccp call).
moves=0; eccp_dir=""
ecp_args() {  # ecp_args ARG...: ARG as eccp receives it, for each ARG in order, into ecp_list (one ruby call for all of them)
  local rec done=0 group=
  ecp_list=()
  [ $# -gt 0 ] || return 0
  # the port (tests/nfcxx-ecp-arg/run.sh checks it against the bash original): NUL-separated records, a group "k ecp" with one
  # v ANSWER per argument, and the end marker z, which the port writes last: without it the helper stopped early and the driver stops
  while IFS= read -r -d '' rec; do
    case $rec in
      k*) group=${rec:1} ;;
      v*) if [ "$group" = ecp ]; then ecp_list+=("${rec:1}"); fi ;;
      z) done=1 ;;
    esac
  done < <("${RUBY:-ruby}" "$root/scripts/ecp-arg.rb" --batch "$moves" "$@")
  [ $done = 1 ] || { echo "nfcxx: scripts/ecp-arg.rb stopped before its end (the argument answers are incomplete)" >&2; exit 1; }
  return 0
}
state_put() {  # state_put NAME VALUE...: one group of the records scripts/driver-state.rb reads (k NAME, then v VALUE for each)
  local n=$1 v
  shift
  printf 'k%s\0' "$n"
  for v in ${1+"$@"}; do printf 'v%s\0' "$v"; done
}
eccp_plan_input() {  # the records of the eccp command line: the call's arrays and scalars, in the order of nfcxx-eccp-plan.rb
  state_put eccp "$eccp_bin"; state_put std "$std"; state_put dialect "$dialect"; state_put out "$eccp_out"
  state_put extra ${extra[@]+"${extra[@]}"}; state_put inst_opts ${inst_opts[@]+"${inst_opts[@]}"}
  state_put modopts ${modopts[@]+"${modopts[@]}"}; state_put diag_opts ${diag_opts[@]+"${diag_opts[@]}"}
  state_put root "$root"; state_put files ${files[@]+"${files[@]}"}; state_put compile_only "$compile_only"
  state_put sys_inc ${sys_inc[@]+"${sys_inc[@]}"}
  state_put hosted_libs ${hosted_libs[@]+"${hosted_libs[@]}"}; state_put keep_static ${keep_static[@]+"${keep_static[@]}"}
  state_put eh_unwind ${eh_unwind[@]+"${eh_unwind[@]}"}; state_put picopts ${picopts[@]+"${picopts[@]}"}
  state_put cobjs ${cobjs[@]+"${cobjs[@]}"}; state_put pre_opts ${pre_opts[@]+"${pre_opts[@]}"}
  state_put cuda_opts ${cuda_opts[@]+"${cuda_opts[@]}"}
  state_put shim ${shim[@]+"${shim[@]}"}; state_put vlart ${vlart[@]+"${vlart[@]}"}; state_put rtlib ${rtlib[@]+"${rtlib[@]}"}
  state_put moves "$moves"
}
eccp_plan() {  # eccp_plan: the eccp command line (eccp_argv), its exports (eccp_envs) and its directory (eccp_cd), from
  # scripts/nfcxx-eccp-plan.rb (tests/nfcxx-eccp-plan/run.sh checks it against the bash's own construction). The plan also
  # plans the link arguments (eflist and userinc, from the files), and refuses an option it cannot keep: the status is the
  # plan's, read from the reply file after the call (a refused option ends the driver with 2, as the bash did). The keep note
  # is printed by the port.
  local rec done=0 reply rc
  eccp_argv=(); eccp_envs=(); eccp_cd=""
  local rdir; rdir=$(mktemp -d) || exit $?
  reply=$rdir/reply.rec
  eccp_plan_input | "${RUBY:-ruby}" "$root/scripts/nfcxx-eccp-plan.rb" "$eccp_dir" "$keep_intermediates" "$shared" > "$reply" \
    || { rc=$?; rm -rf "$rdir"; exit $rc; }
  while IFS= read -r -d "" rec; do
    case $rec in
      a*) eccp_argv+=("${rec:1}") ;;
      e*) eccp_envs+=("${rec:1}") ;;
      d*) eccp_cd=${rec:1} ;;
      z) done=1 ;;
    esac
  done < "$reply"
  rm -rf "$rdir"
  [ $done = 1 ] || { echo "nfcxx: scripts/nfcxx-eccp-plan.rb stopped before its end (the eccp command line is incomplete)" >&2; exit 1; }
}
eccp_cleanup() {  # the EXIT trap of a build that runs eccp in a temporary directory (and of the C-input and .cu steps)
  local rc=$?
  "${RUBY:-ruby}" "$root/scripts/nfcxx-link.rb" cleanup "$keep_intermediates" "$eccp_dir" "${cudatmp:-}" "${ctmp:-}"   # the removals (tests/nfcxx-link/run.sh)
  temp_cleanup
  trace_finish
  return $rc
}
modules_plan_input() {  # the records of the modules block: the state scripts/nfcxx-modules-plan.rb reads (its header lists the groups)
  state_put root "$root"; state_put out "$out"; state_put moddir "${moddir:-}"; state_put std "$std"
  state_put emit_c "$emit_c"; state_put compile_only "$compile_only"
  state_put cfiles ${cfiles[@]+"${cfiles[@]}"}; state_put srcs ${srcs[@]+"${srcs[@]}"}; state_put argv ${nfcxx_argv[@]+"${nfcxx_argv[@]}"}
}
nfcxx_argv=("$@")   # the command as given: the compile cache keys on it (see cache_key)
args0=("$@")   # the arguments as given: the SYCL two-pass build below re-runs the driver with them
# BEGIN the argument loop: scripts/nfcxx-loop.rb --bash-state reads the arguments and prints the statements that set the state
# they leave (the loop's scalars and arrays, from the planner's records; the setup above has set the NFCXX_* defaults). A refusal
# is its message on standard error, with status 2 (the driver ends with it). A value option given last is a loop_no_value
# statement: set -u ends the driver there ("$2: unbound variable"). A planner that stops before its end ends the driver with 1.
loop_no_value() { : "$2"; }   # a value option given last: $2 is unset here (set -u ends the driver)
# The Ruby driver (scripts/nfcxx.rb) ran the loop before this body, on these arguments, and passes its result in the environment:
# NFCXX_LOOP_STATUS (0: NFCXX_LOOP_STATE is the statements; otherwise the refusal's status, and NFCXX_LOOP_STATE its message).
# Without it (the arguments the wrappers rewrite, or the body run alone) the loop runs here.
if [ "${NFCXX_LOOP_STATUS+x}" = x ]; then
  loop_status=$NFCXX_LOOP_STATUS; loop_state=${NFCXX_LOOP_STATE-}
  unset NFCXX_LOOP_STATUS NFCXX_LOOP_STATE
  if [ "$loop_status" != 0 ]; then printf '%s' "$loop_state" >&2; exit "$loop_status"; fi
else
  loop_state=$("${RUBY:-ruby}" "$root/scripts/nfcxx-loop.rb" --bash-state -- "$@") || exit $?
fi
eval "$loop_state"
shift $#
# END the argument loop
# The early exits: the refusals of the state above and the --emit-hip route are scripts/nfcxx-early-exit.rb's (pre: status 2 is a
# refusal, its message on stderr; status 3 is the route). early_records gives the state as records.
early_rec() { printf 's%s\0' "$1"; }
early_records() {
  local kv
  for kv in "ncpp=$ncpp" "nobj=$nobj" "cfiles_n=${#cfiles[@]}" "cu_n=${#cu_inputs[@]}" "stdin_src=$stdin_src" \
    "emit_hip=${emit_hip:-0}" "compile_only=$compile_only" "emit_c=$emit_c" "xlang=$xlang" "depmode=$depmode" \
    "dialect=$dialect" "edg=$edg"; do
    early_rec "$kv"
  done
}
early_status=0; "${RUBY:-ruby}" "$root/scripts/nfcxx-early-exit.rb" pre < <(early_records) || early_status=$?
case $early_status in
  0) ;;
  3)  # --emit-hip: the .cu input as HIP source on stdout, for hipcc (tools/cuda-rewrite --hip). Nothing is compiled, and the
      # -I, -D and -U options go to the rewriter as they go to the host copy.
    hip_opts=(); for f in ${cflags[@]+"${cflags[@]}"}; do case $f in -I*|-D*|-U*) hip_opts+=("$f");; esac; done
    exec "$root/build/cuda-rewrite" --hip ${hip_opts[@]+"${hip_opts[@]}"} "${cu_inputs[0]}" ;;
  *) exit $early_status ;;
esac
[ $compile_only = 1 ] || moves=1   # a -c compile stays in the user's directory (see ecp_args)
# The unit of the time log's lines (scripts/trace.sh): the first source, else the output. Tracing starts before the .cu
# and .cpp2 inputs are prepared, whose stages it records.
trace_unit=${srcs[0]-$out}; export NFCXX_TRACE_UNIT=$trace_unit   # the back-end scripts it runs log under it too
# The time log is read by every script that sources scripts/trace.sh (the gcc-cc that eccp runs, ...): the one setting that is
# handed to the processes below as an environment variable, as NFCXX_TRACE is (trace_begin).
[ -z "$time_log" ] || export NFCXX_TIME_LOG=$(abs_path "$time_log")
[ -z "$trace" ] || trace_begin "$trace"
cu_prepare
cpp2_prepare
# preprocess_records: the state of the -E command line, as NUL-terminated records for scripts/nfcxx-preprocess.rb (s NAME=VALUE for
# the scalars; e, c, d, i and r for the ppflags, cflags, sysdirs, forced includes and sources).
preprocess_records() {
  local a
  pp_rec() { printf '%s\0' "$1$2"; }
  pp_rec s "host=${NFCXX_CXX:-g++}"; pp_rec s "std=$std"; pp_rec s "xlang=$xlang"; pp_rec s "outset=$outset"
  pp_rec s "out=$out"; pp_rec s "stdin_src=$stdin_src"
  for a in ${ppflags[@]+"${ppflags[@]}"}; do pp_rec e "$a"; done
  for a in ${cflags[@]+"${cflags[@]}"}; do pp_rec c "$a"; done
  for a in ${sysdirs[@]+"${sysdirs[@]}"}; do pp_rec d "$a"; done
  for a in ${preinc[@]+"${preinc[@]}"}; do pp_rec i "$a"; done
  for a in ${srcs[@]+"${srcs[@]}"}; do pp_rec r "$a"; done
}
if [ $preprocess = 1 ]; then
  # -E: the host C++ compiler preprocesses, as nfcc does for C (build systems run the compiler this way). The command line is
  # scripts/nfcxx-preprocess.rb's, from the records of preprocess_records.
  preprocess_argv=(); while IFS= read -r -d "" pp_arg; do preprocess_argv+=("$pp_arg"); done < <(preprocess_records | "${RUBY:-ruby}" "$root/scripts/nfcxx-preprocess.rb")
  [ ${#preprocess_argv[@]} -gt 0 ] || { echo "nfcxx: scripts/nfcxx-preprocess.rb planned no command" >&2; exit 2; }
  exec "${preprocess_argv[@]}"
fi
# The refusals after the -E route (stdin without -E, -x, dependency files without -c, the EDG build, the dialect): the same planner.
early_status=0; "${RUBY:-ruby}" "$root/scripts/nfcxx-early-exit.rb" post < <(early_records) || early_status=$?
[ $early_status = 0 ] || exit $early_status
# C++ modules (docs/notes/modules.md): scripts/nfcxx-modules-plan.rb plans the block. It scans the sources, refuses a module program
# (the standard, --emit-c, C sources, a partition, a header unit, an import of std, -c with more than one source), builds a link
# with scripts/nfcxx-modules.rb build (the driver ends with the build's status, as the bash's mod_build_program did), and gives a
# compile its module options: --modules, the directory of the interface files (BMIs, --module-dir, else the directory of -o)
# and, for an interface unit, the BMI it writes. The EXIT trap is left as it is, so cu_prepare's cleanup and trace_finish still
# run when the build ends the driver. Its state and reply are records in a temporary directory, removed before the driver ends.
modules=0; modopts=()
modplan=$(mktemp -d) || exit $?
modules_plan_input > "$modplan/state"
modrc=0; "${RUBY:-ruby}" "$root/scripts/nfcxx-modules-plan.rb" "$modplan/state" "$modplan/reply" || modrc=$?
if [ $modrc != 0 ]; then rm -rf "$modplan"; exit $modrc; fi
modgroup=""; modbuilt=""; modz=0
while IFS= read -r -d "" modrec; do
  case $modrec in
    k*) modgroup=${modrec:1} ;;
    v*) case $modgroup in
          modules) modules=${modrec:1} ;;
          modopts) modopts+=("${modrec:1}") ;;
          built) modbuilt=${modrec:1} ;;
        esac ;;
    z) modz=1 ;;
  esac
done < "$modplan/reply"
rm -rf "$modplan"
[ $modz = 1 ] || { echo "nfcxx: scripts/nfcxx-modules-plan.rb stopped before its end (the module block is incomplete)" >&2; exit 1; }
[ -z "$modbuilt" ] || exit "$modbuilt"

# The default backend: Path B on x86-64 Linux (and on aarch64 Linux and arm64 macOS for freestanding programs), unless the request needs
# something only qbe or gcc does (cosmo, --emit-c, --target, -E, -M, -shared; a freestanding program takes Path B on
# x86-64 and aarch64 Linux, arm64 macOS). A program Path B does not build is built again with gcc, below
# (docs/notes/pathb-default.md). An explicit --backend=, or NFCXX_BACKEND, is used as given.
default_backend=0
# pb_fs_host: the hosts Path B compiles freestanding programs on, x86-64 and aarch64 Linux and arm64 macOS (the EDG front end is the
# x86-64 target on all; see docs/notes/freestanding.md, "Path B on aarch64" and "Path B on macOS"). Used for the default and for an explicit --backend=pathb.
pb_fs_host=0
case $(uname -s) in
  Linux) case $(uname -m) in x86_64|aarch64|arm64) pb_fs_host=1 ;; esac ;;
  Darwin) [ "$(uname -m)" = arm64 ] && pb_fs_host=1 ;;   # macOS arm64: the same front end; its link is the Darwin one (docs/notes/freestanding.md)
esac
if [ -z "$backend" ]; then
  backend=gcc
  # A .cu input takes Path B too: its rewritten host copy gets the forced nfcxx_cuda.h include and the launch syntax, and
  # its device image is a file-scope asm block that Path B passes through (docs/notes/pathb-default.md, "CUDA").
  # A freestanding program takes Path B on x86-64 and aarch64 Linux and arm64 macOS (the old harness with the lib/ headers, docs/notes/freestanding.md).
  fs_ok=1; [ $freestanding = 0 ] || [ $pb_fs_host = 1 ] || fs_ok=0
  if [ $backend_explicit = 0 ] && [ $fs_ok = 1 ] && [ $cosmo = 0 ] \
     && [ $emit_c = 0 ] && [ -z "$target" ] && [ $preprocess = 0 ] && [ -z "$depmode" ] && [ $shared = 0 ]; then
    backend=pathb; default_backend=1
  fi
fi

# -fsanitize=address: gcc's instrumentation on the gcc backend. Both link libasan. Path B calls
# libasan's checks before each access (scripts/pathb-cc.rb --asan, passed below once the backend is final); the default backend gets it too (docs/notes/asan-plan.md; a program Path B does not build falls back to gcc).
asan_c=()   # options for every C compile and link of the program
if [ $asan = 1 ]; then
  case $backend in
    gcc) ;;
    pathb) ;;
    *) echo "nfcxx: -fsanitize=address: unknown backend $backend" >&2; exit 2 ;;
  esac
  asan_c=(-fsanitize=address -fno-omit-frame-pointer ${asanopts[@]+${asanopts[@]+"${asanopts[@]}"}})
else
  asanopts=()
fi

# C inputs: a .c file does not go through EDG. It is compiled to an object file by the backend's C compiler
# (gcc: gcc -O2 -fwrapv
# -fno-strict-aliasing), and the objects are linked with the C++ side (EDG's runtime) when any .cpp is
# present. -I, -D, -U options reach the C compiler; -l/-L and other options go to the link only.
# A stand-alone C program therefore needs no EDG build.

# Freestanding: headers come only from lib/. --no_standard_includes drops EDG's default include dirs
# (EDG ships no <cstdio> etc. for the C++ side anyway). Without --gnu-version the g++ front end rejects
# __is_same, __builtin_bit_cast and friends, so freestanding defaults to GCC 13 emulation.
# Hosted mode (default) uses the host C++ library headers, so real code can include <cstdio>,
# <cctype>, <string> and friends. Their include directories and the GNU version come from the host
# g++ (override with NFCXX_CXX, or NFCXX_SYS_INCLUDES as a colon-separated list).
extra=()
sys_inc=()
hosted_libs=()
# Template instantiation. Default (--instantiate=used, or NFCXX_INSTANTIATE): each unit instantiates the templates it uses, as g++ does,
# so the link recompiles nothing (libggml-sycl: 8 minutes in all, a 3 s link). The C output has the instances as weak
# symbols in one .text, not as COMDAT groups, so the link would keep every unit's copy (libggml-sycl: 77 MB of code): each
# function and object gets its own section, and the link drops the sections nothing reaches (--gc-sections), among them
# the copies the link did not choose (24 MB). --instantiate=auto: EDG's automatic instantiation, where the prelinker
# assigns each instance a unit and recompiles that unit at link time, one unit per pass (libggml-sycl: 3087 instances in
# 98 passes, a 33-minute link; 59 MB of code).
inst_opts=()
case $instantiate in
  auto) ;;
  used)
    inst_opts=(--no_auto_instantiation -tused)
    # Mach-O: ld64 coalesces the weak definitions itself (and takes no --gc-sections)
    [ "$(uname -s)" = Darwin ] || inst_opts+=(--c_to_obj_option -ffunction-sections --c_to_obj_option -fdata-sections
                                              --c_to_obj_option -Wl,--gc-sections) ;;
  *) echo "nfcxx: --instantiate (NFCXX_INSTANTIATE) is auto or used (got $instantiate)" >&2; exit 2 ;;
esac
# --cosmo (docs/notes/cosmo.md): cosmocc is the C compiler (NFCXX_GCC: gcc-cc runs it, pathb-cc assembles with it), and
# its libc++ headers and predefined macros are the C++ target. The backend is gcc, or Path B with --backend=pathb (NFCXX_PATH=b).
if [ $cosmo = 1 ]; then
  [ $path_b = 0 ] || backend=pathb
  if [ $backend != pathb ]; then
    [ $backend_explicit = 0 ] || [ $backend = gcc ] || { echo "nfcxx: --cosmo needs --backend=gcc or --backend=pathb" >&2; exit 2; }
    backend=gcc
  fi
  cosmo_bin=${NFCXX_COSMOCC:-$root/build/cosmocc/bin/cosmocc}
  [ -x "$cosmo_bin" ] || { echo "nfcxx: $cosmo_bin is not installed; run scripts/setup-cosmo.sh (or set NFCXX_COSMOCC)" >&2; exit 2; }
  cosmo_root=$(cd "$(dirname "$cosmo_bin")/.." && pwd)
  export NFCXX_GCC=$cosmo_bin
  # cosmoc++ is a wrapper that prints no include list, so the directories are named here: libc++ first, then the C library.
  export NFCXX_SYS_INCLUDES=$cosmo_root/include/third_party/libcxx:$cosmo_root/include
  gver=$cosmo_root/bin/x86_64-linux-cosmo-g++; [ -x "$gver" ] || gver=$cosmo_bin
  [ -n "${gnu:-}" ] || gnu=$({ "$gver" -dumpfullversion 2>/dev/null || true; } | awk -F. '{ printf "%d%02d%02d\n", $1, $2, $3 }')
  # cosmo's own build force-includes libc/integral/normalize.inc (libcesque, bool32, __static_yoink, the c.inc macros); the
  # front end needs it too. __has_feature is clang's: libc++'s __config uses it, and cosmo's gcc does not define it.
  cflags+=(-D__COSMOPOLITAN__ -D__COSMOCC__ -D__FATCOSMOCC__)
  # Path B only: its front end reads libc++, whose __config uses __has_feature (clang's; cosmo's gcc does not define it)
  [ $backend = pathb ] && cflags+=('-D__has_feature(x)=0' -include "$cosmo_root/include/libc/integral/normalize.inc" -include "$root/lib/cosmo/libcxx_traits.h")
fi
if [ $freestanding = 1 ]; then
  extra=(--no_standard_includes "-I$root/lib")
  [ -n "$gnu" ] || gnu=130000
else
  t=$(trace_start)
  while IFS= read -r d; do [ -n "$d" ] && sys_inc+=("--sys_include=$d"); done < <("${RUBY:-ruby}" "$root/scripts/host-sys.rb" host_sys_includes)
  trace_end "$t" "host C++ headers" driver
  # g++ links libm implicitly through libstdc++; the hosted headers (<cmath>, used by doctest for
  # log10) need it too. The EDG link appends --c_to_obj_lib libraries after the objects.
  hosted_libs=(--c_to_obj_lib=m)
  # macOS has libc++, not libstdc++: the link needs it explicitly (eccp's Linux default is libstdc++).
  [ "$(uname -s)" = Darwin ] && hosted_libs+=(--c_to_obj_lib=c++)
  if [ -z "$gnu" ]; then
    gnu=$("${RUBY:-ruby}" "$root/scripts/host-sys.rb" host_gnu_version)
  fi
fi
# -isystem DIR from the command line: searched after the host's own directories, as the host compiler does.
ecp_args ${sysdirs[@]+"${sysdirs[@]}"}
for d in ${ecp_list[@]+"${ecp_list[@]}"}; do sys_inc+=("--sys_include=$d"); done
# -include FILE is found through the include directories as well as here, so it is made absolute only when it exists here.
pre_opts=(); for f in ${preinc[@]+${preinc[@]+"${preinc[@]}"}}; do
  if [ $moves = 1 ] && [ -e "$f" ]; then f=$(abs_path "$f"); fi
  pre_opts+=(--preinclude "$f")
done
# Path B hosted on macOS (the SDK's libc++): its __config evaluates __has_feature and friends in #if, which EDG's g++
# mode does not define (lib/pathb/clang_macros.h). Gated on Darwin, not on the dialect: a Linux clang host keeps libstdc++
# and its own feature checks.
[ $backend = pathb ] && [ $freestanding = 0 ] && [ "$(uname -s)" = Darwin ] && cflags+=(-include "$root/lib/pathb/clang_macros.h" -I "$root/lib/pathb/darwin-include")
# Path B's front end is an x86-64 EDG target (no __aarch64__, no __clang__), so libc++ takes the x86-64 std::string layout on
# an arm64 Mac, where the SDK's libc++ (clang's Apple arm64 config) uses the alternate layout: the size in byte 23, the
# short-string flag in its top bit. Path B would read a string made by the library wrongly. Defining the layout macro is
# the only ABI knob of that config that changes the object. Darwin arm64 only: x86-64 Macs keep the old layout.
[ $backend = pathb ] && [ $freestanding = 0 ] && [ "$(uname -s)" = Darwin ] && [ "$(uname -m)" = arm64 ] && cflags+=(-D_LIBCPP_ABI_ALTERNATE_STRING_LAYOUT)
# Hosted Path B on Linux aarch64: the host's <bits/math-vector.h> uses GCC's AdvSIMD/SVE vector types, which EDG (x86-64
# target) does not have; lib/pathb/linux-aarch64-include/bits/math-vector.h stands in for it (scripts/pathb-dump.rb does the same).
[ $backend = pathb ] && [ $freestanding = 0 ] && [ "$(uname -s)" = Linux ] && { [ "$(uname -m)" = aarch64 ] || [ "$(uname -m)" = arm64 ]; } && cflags+=(-I "$root/lib/pathb/linux-aarch64-include")
# Hosted Linux aarch64 (either backend): the front end's predefined macros have __aarch64__ but not __AARCH64EL__, which gcc
# defines there. glibc's and CPython's multiarch headers (python3.12's pyconfig.h) choose their directory by both, so without
# it Python.h stops with "unknown multiarch location for pyconfig.h". The value is the one gcc defines.
[ $freestanding = 0 ] && [ "$(uname -s)" = Linux ] && { [ "$(uname -m)" = aarch64 ] || [ "$(uname -m)" = arm64 ]; } && { cflags+=(-D__AARCH64EL__=1); files+=(-D__AARCH64EL__=1); }
gnu_opts=()
if [ "$dialect" = clang ]; then
  cv=$("${RUBY:-ruby}" "$root/scripts/host-sys.rb" host_clang_version); [ -n "$cv" ] && gnu_opts=(--clang_version="$cv")
elif [ -n "$gnu" ]; then
  gnu_opts=(--gnu_version="$gnu")
fi
# --target: the EDG configuration of the generated C (only with --freestanding --emit-c, see the usage above). The host
# library headers and the host C compiler would be the build host's, so a hosted or compiled build with a target is refused.
# --target=linux_k1om: Intel Knights Corner (k1om). The front end lays out the program for the build host (LP64, the
# same sizes as k1om); the C is compiled and linked by the k1om GCC 5.1.1 (scripts/k1om-cc.rb) with the k1om assembler and
# runtime (scripts/setup-k1om.sh). Freestanding and the gcc backend only: the k1om toolchain is GCC's.
if [ "$target" = linux_k1om ]; then
  [ $freestanding = 1 ] || { echo "nfcxx: --target=linux_k1om needs --freestanding (the host's C++ headers are GCC 13's, not k1om's)" >&2; exit 2; }
  [ "$backend_explicit" = 0 ] || [ "$backend" = gcc ] || { echo "nfcxx: --target=linux_k1om uses the gcc backend (the k1om GCC)" >&2; exit 2; }
  backend=gcc
  k1om_root=${NFCXX_K1OM_ROOT:-/opt/k1om}
  [ -x "$k1om_root/bin/k1om-mpss-linux-gcc" ] || { echo "nfcxx: no k1om toolchain at $k1om_root (NFCXX_K1OM_ROOT; docs/notes/k1om.md)" >&2; exit 2; }
  [ -f "$root/build/k1om/libC.a" ] || { echo "nfcxx: no k1om runtime at $root/build/k1om/libC.a (run scripts/setup-k1om.sh)" >&2; exit 2; }
  export NFCXX_GCC="$root/scripts/k1om-cc.rb" NFCXX_AS="$root/scripts/k1om-bin/as.rb" NFCXX_K1OM_ROOT="$k1om_root"
fi
if [ -n "$target" ] && [ "$target" != linux_k1om ]; then
  [ $freestanding = 1 ] || { echo "nfcxx: --target needs --freestanding (the host's library headers are the host target's)" >&2; exit 2; }
  [ $emit_c = 1 ] || { echo "nfcxx: --target needs --emit-c (the generated C is for the target; compile it with a cross compiler)" >&2; exit 2; }
  tbase=${EDG_BASE:-$root/build/edg-base}
  [ -d "$tbase/lib_$target" ] || { echo "nfcxx: no EDG target '$target' in $tbase (lib_* tables: $(cd "$tbase" && ls -d lib_* | sed 's/^lib_//' | tr '\n' ' '))" >&2; exit 2; }
  gnu_opts+=(--target "$target")
  # Plain char is unsigned on these ABIs (clang -dM: __CHAR_UNSIGNED__ for each triple). EDG's table says signed for
  # linux_aarch64 and linux_armv7 (src/defines.h, TARG_HAS_SIGNED_CHARS_*), so the driver sets it: the EDG base is not patched.
  case $target in linux_aarch64|linux_armv7|linux_riscv32|linux_riscv64) gnu_opts+=(--unsigned_chars) ;; esac
fi
[ ${#gnu_opts[@]} -gt 0 ] && export EDG_CPFE_DEFAULT_OPTIONS="${gnu_opts[*]} ${EDG_CPFE_DEFAULT_OPTIONS:-}"

if [ $emit_c = 1 ] && [ ${#cfiles[@]} -gt 0 ]; then
  echo "nfcxx: --emit-c does not apply to .c inputs (they skip the front end)" >&2; exit 2
fi
if [ $emit_c = 1 ]; then
  # Run the front end alone and print the generated C.
  base=${EDG_BASE:-$root/build/edg-base}
  tmp=$(mktemp -d); trap 'temp_cleanup; trace_finish' EXIT
  f=$(realpath "${srcs[0]}")   # the first source, not files[0] (which may be an -I option)
  # host dirs first, then EDG's own, as eccp orders user and default include dirs
  inc=(${sys_inc[@]+${sys_inc[@]+"${sys_inc[@]}"}} --sys_include="$base/include"); [ $freestanding = 1 ] && inc=("-I$root/lib")
  # The user's -I directories (kept in files, with the other options) go in front, as eccp puts them.
  # cpfe runs from the EDG base directory, so a relative -I is made absolute first.
  for x in ${files[@]+${files[@]+"${files[@]}"}}; do case $x in -I?*) inc=("-I$(abs_path "${x#-I}")" ${inc[@]+${inc[@]+"${inc[@]}"}}) ;; esac; done
  t=$(trace_start)
  posix_def=(-D_POSIX_SOURCE); [ "$(uname -s)" = Darwin ] && posix_def=(-D_DARWIN_C_SOURCE -U__BLOCKS__)   # as the macOS base
  (cd "$base" && "$edg/cpfe" ${posix_def[@]+"${posix_def[@]}"} -D__CHAR_BIT__=8 "$std" --"$dialect" ${eh_tls[@]+"${eh_tls[@]}"} ${gnu_opts[@]+"${gnu_opts[@]}"} ${diag_opts[@]+"${diag_opts[@]}"} \
      ${inc[@]+"${inc[@]}"} --gen_c_file_name="$tmp/out.c" "$f")
  trace_end "$t" "cpfe --emit-c (front end)" frontend
  cat "$tmp/out.c"
  exit 0
fi

if [ -n "$sanitize" ]; then
  # The checks live in the Path B IR (docs/notes/ubsan.md); the names are gcc's, and not every one is implemented.
  IFS=, read -ra sz <<< "$sanitize"
  for c in ${sz[@]+"${sz[@]}"}; do
    case $c in
      undefined|signed-integer-overflow|integer-divide-by-zero|shift|bounds|null|unreachable|return|float-cast-overflow) ;;
      *) echo "nfcxx: -fsanitize=$c is not supported (implemented: undefined, signed-integer-overflow, integer-divide-by-zero, shift, bounds, null, unreachable, return, float-cast-overflow)" >&2; exit 2 ;;
    esac
  done
  [ $freestanding = 0 ] || { echo "nfcxx: -fsanitize needs Path B, which compiles hosted programs only" >&2; exit 2; }
  pb_flags+=(--sanitize="$sanitize")   # scripts/pathb-cc.rb: the front end's checks (NFCXX_IR_SANITIZE)
  backend=pathb
fi
if [ $safeptr = 1 ]; then
  # The checks are emitted from the Path B IR (docs/notes/safe-pointers.md), and the runtime replaces malloc and free.
  [ $freestanding = 0 ] || { echo "nfcxx: -fsafe-pointers needs Path B, which compiles hosted programs only" >&2; exit 2; }
  [ $asan = 0 ] || { echo "nfcxx: -fsafe-pointers and -fsanitize=address both replace malloc; use one" >&2; exit 2; }
  pb_flags+=(--safe-pointers)
  backend=pathb
fi
# --backend=pathb, or NFCXX_PATH=b: the Path B compiler (docs/notes/pathb-hosted.md). Asked for by name, so a file Path B cannot
# build is an error, not a fallback to gcc (the fallback re-run would also take NFCXX_PATH=b back to Path B).
[ $path_b = 0 ] || { backend=pathb; default_backend=0; }
[ $ir_opt_set = 0 ] || pb_flags+=(--ir-opt="$ir_opt")
[ $asan = 0 ] || [ $backend != pathb ] || pb_flags+=(--asan)   # the SSA emitter's __asan_load/store checks (scripts/pathb-cc.rb)
[ $pic = 0 ] || pb_flags+=(--pic)   # -shared / -fPIC: scripts/pathb-cc.rb --pic reads a preemptible symbol's address through the GOT
# Freestanding: the front end reads only lib/ (the old harness, which has no host headers), emulates GNU $gnu, and the program links
# EDG's runtime, so its exception handling state is declared as that runtime has it (scripts/pathb-dump.rb --eh-runtime).
# Hosted Path B: scripts/pathb-dump.rb takes the host's GNU version unless the command line gave one.
pb_flags+=(${diag_opts[@]+"${diag_opts[@]}"})   # EDG diagnostic options (-Wno-narrowing), for scripts/pathb-dump.rb
# EDG's clang mode on Path B only when asked for (--dialect=clang, NFCXX_DIALECT), not for a clang host's default: Path B on macOS stays in g++ mode
# with lib/pathb/clang_macros.h, since libc++ needs __BYTE_ORDER__, which the clang mode does not define.
[ $backend != pathb ] || [ "$dialect" != clang ] || [ -z "${dialect_asked:-}" ] || pb_flags+=(--dialect=clang)   # scripts/pathb-dump.rb
[ $backend != pathb ] || [ $freestanding != 0 ] || [ -z "${gnu_user:-}" ] || pb_flags+=("--gnu-version=$gnu_user")
[ $backend != pathb ] || [ $freestanding = 0 ] || pb_flags+=(--freestanding --eh-runtime "--gnu-version=$gnu" "-I$root/lib")
case $backend in
  pathb) [ $freestanding = 0 ] || [ $pb_fs_host = 1 ] ||
           { echo "nfcxx: Path B (--backend=pathb) compiles freestanding programs on x86-64 and aarch64 Linux and arm64 macOS only" >&2; exit 2; }
       [ -x "$root/build/qbe/qbe" ] || { echo "nfcxx: QBE not built; run scripts/setup-qbe.sh" >&2; exit 2; }
       export NFCXX_CC=$root/scripts/gcc-cc.rb ;;
  gcc) export NFCXX_CC=$root/scripts/gcc-cc.rb ;;   # EDG's generated C through gcc, with the pragma filter (edg_eccp_config reads NFCXX_CC)
  *) echo "nfcxx: unknown backend '$backend'" >&2; exit 2 ;;
esac

# Hosted link (not -c, -shared or --freestanding): two additions to what eccp links.
#  - the EH shim (lib/ehshim, docs/notes/eh-shim.md): exceptions thrown by libstdc++.so and std::exception_ptr on EDG's
#    exception runtime; --no-eh-shim (NFCXX_EHSHIM=0) leaves it out;
#  - libC.a (EDG's runtime) ahead of libstdc++, as Path B links it: eccp puts -lC last, after -lstdc++, so `operator new`
#    came from libstdc++.so and threw a gcc-ABI std::bad_alloc that EDG's handlers cannot catch.
# With -fsanitize=address, the C++ VLA runtime (lib/asan/nfcxx_vla_asan.c, docs/notes/asan.md) goes ahead of libC.a: it
# defines the four VLA entry points, so EDG's allocator in libC.a is not linked.
shim=(); rtlib=(); vlart=()
if [ $freestanding = 0 ] && [ $compile_only = 0 ] && [ $shared = 0 ] && [ $((ncpp + nobj)) -gt 0 ]; then
  t=$(trace_start)
  s=""; [ $eh_shim_on = 0 ] || s=$("$root/scripts/ehshim.rb") || s=""
  trace_end "$t" "EH shim" driver
  # cosmo: the shim interoperates with libstdc++.so (its type_info vtables and __cxa layout); cosmo links libc++ only
  [ $cosmo = 1 ] || { [ -z "$s" ] || shim=("$s"); }
  rtlib=("${EDG_BUILD:-$root/build/edg}/lib/libC.a")   # the archive by path: -L -lC breaks libc on Linux aarch64
  if [ $asan = 1 ]; then
    t=$(trace_start)
    v=$("$root/scripts/asan-vla.rb") || { echo "nfcxx: cannot build the C++ VLA runtime for -fsanitize=address (scripts/asan-vla.rb)" >&2; exit 2; }
    trace_end "$t" "VLA runtime (asan)" driver
    vlart=("$v")
  fi
fi

# -fPIC / -rdynamic / -shared reach the C compiler and the link. EDG_OBJ_TO_EXEC_DEFAULT_OPTIONS replaces the
# options eccp gives its link command (default: the C compile options), so only -shared goes there.
picopts=(); ldopts=()
# -m options (ISA and target): the C compile gets them, and the front end gets the macros gcc predefines for them
# (gcc -mavx2 defines __AVX2__, which the intrinsic headers test). Each macro goes in files, as a -D option does, so
# eccp passes it to both the front end and the C compile. Macros with arguments are not passed.
if [ ${#isa[@]} -gt 0 ]; then
  for o in ${isa[@]+"${isa[@]}"}; do picopts+=(--c_to_obj_option "$o"); done
  while IFS= read -r d; do files+=("$d"); done < <(
    comm -13 <(gcc -dM -E -x c /dev/null | sort) <(gcc ${isa[@]+"${isa[@]}"} -dM -E -x c /dev/null | sort) \
      | sed -n 's/^#define \([^ (]*\) */-D\1=/p')
fi
[ $pic = 0 ] || { picopts=(--c_to_obj_option -fPIC); cflags_pic=(-fPIC); }
[ $rdynamic = 0 ] || picopts+=(--c_to_obj_option -rdynamic)
[ $pthread = 0 ] || picopts+=(--c_to_obj_option -pthread)
picopts+=(${pie_opts[@]+${pie_opts[@]+"${pie_opts[@]}"}})
for o in ${asan_c[@]+${asan_c[@]+"${asan_c[@]}"}}; do picopts+=(--c_to_obj_option "$o"); done
[ $shared = 0 ] || { export EDG_OBJ_TO_EXEC_DEFAULT_OPTIONS=-shared; ldopts=(-shared); }
[ $rdynamic = 0 ] || ldopts+=(-rdynamic)   # the executable link exports its global symbols (a dlopen'd module binds to them)
# -fuse-ld=NAME, or NFCXX_LD=NAME: the linker gcc runs (mold, lld, gold, bfd; ld.NAME must be on PATH). The C++ link gets
# it through eccp's link options, as the -Wl options do.
if [ -n "$ld_name" ]; then
  command -v "ld.$ld_name" >/dev/null || { echo "nfcxx: NFCXX_LD=$ld_name: ld.$ld_name is not on PATH" >&2; exit 2; }
  ldopts+=("-fuse-ld=$ld_name"); picopts+=(--c_to_obj_option "-fuse-ld=$ld_name")
fi

# C inputs: compile each .c to an object. Link options (-l, -L, ...) stay in files for the final link.
cobjs=()
if [ ${#cfiles[@]} -gt 0 ]; then
  ctmp=$(mktemp -d); trap 'temp_cleanup; trace_finish' EXIT
  n=0
  for c in ${cfiles[@]+"${cfiles[@]}"}; do
    o=$ctmp/$n.o; n=$((n + 1))
    t=$(trace_start)
    if [ $backend = pathb ]; then
      # A C source takes the Path B front end in C mode (EDG's C front end, the same IR and QBE route).
      prc=0
      "$root/scripts/pathb-cc.rb" ${pb_flags[@]+"${pb_flags[@]}"} -std=c11 ${cflags[@]+${cflags[@]+"${cflags[@]}"}} "$c" -o "$o" || prc=$?
      if [ $prc != 0 ]; then
        # as for a C++ file: the default backend failed on this one (status 3: a construct Path B refuses), so the whole
        # program is built again with gcc, which reports its own errors if it fails too. An explicit backend is an error.
        [ $default_backend = 1 ] || exit $prc
        echo "nfcxx: Path B did not build $c (status $prc); building the program with the gcc backend, which compiles with C semantics (-fwrapv -fno-strict-aliasing)" >&2
        rm -rf "$ctmp"
        temp_cleanup; exec env NFCXX_BACKEND=gcc "$root/nfcxx" "${nfcxx_argv[@]}"
      fi
    else
      "${NFCXX_GCC:-gcc}" -c -O2 -fwrapv -fno-strict-aliasing ${asan_c[@]+${asan_c[@]+"${asan_c[@]}"}} ${cflags_pic[@]+${cflags_pic[@]+"${cflags_pic[@]}"}} ${cflags[@]+${cflags[@]+"${cflags[@]}"}} "$c" -o "$o"
    fi
    trace_end "$t" "C input: $c" cinput
    cobjs+=("$o")
  done
  if [ $compile_only = 1 ] && [ $ncpp = 0 ]; then
    # -c with only C sources: the objects are the output (-o names the one object; otherwise each is <source>.o)
    [ $outset = 0 ] || [ ${#cobjs[@]} = 1 ] || { echo "nfcxx: -c with -o needs exactly one source" >&2; exit 2; }
    for i in "${!cobjs[@]}"; do
      dst=$out; [ $outset = 1 ] || dst=$(basename "${cfiles[$i]}" .c).o
      cp "${cobjs[$i]}" "$dst"
    done
    exit 0
  fi
  if [ $ncpp = 0 ] && { [ $nobj = 0 ] || [ ! -x "$edg/eccp" ]; }; then
    # Only C: link with the C compiler.
    t=$(trace_start)
    if [ $backend = pathb ]; then
      # Path B objects: EDG's runtime (libC.a: the VLA and EH entry points), the long double helpers and, with -fsanitize=address, libasan
      # (the C++ VLA runtime too: EDG lowers a C VLA to the same __vla_alloc calls, so each VLA is a malloc block libasan checks)
      cvla=(); [ $asan = 0 ] || cvla=("$("$root/scripts/asan-vla.rb")")
      # a link that names -lcudart also gets the CUB archive (scripts/cuda-cub.rb), before the -lcudart it needs; no archive, no argument
      linkf=()
      for f in ${files[@]+"${files[@]}"}; do
        if [ "$f" = -lcudart ]; then cub=$("$root/scripts/cuda-cub.rb") && [ -n "$cub" ] && linkf+=("$cub"); fi
        linkf+=("$f")
      done
      cc ${asan_c[@]+${asan_c[@]+"${asan_c[@]}"}} ${ldopts[@]+${ldopts[@]+"${ldopts[@]}"}} ${cobjs[@]+"${cobjs[@]}"} ${linkf[@]+${linkf[@]+"${linkf[@]}"}} ${cvla[@]+"${cvla[@]}"} -o "$out" "$("$root/scripts/pathb-ldrt.rb")" "${EDG_BUILD:-$root/build/edg}/lib/libC.a" $([ "$(uname -s)" = Darwin ] && echo -lc++ || echo -lstdc++) -lm $([ "$(uname -s)" = Darwin ] || echo -latomic)
    else "${NFCXX_GCC:-gcc}" ${asan_c[@]+${asan_c[@]+"${asan_c[@]}"}} ${ldopts[@]+${ldopts[@]+"${ldopts[@]}"}} ${cobjs[@]+"${cobjs[@]}"} ${files[@]+${files[@]+"${files[@]}"}} -o "$out"; fi
    trace_end "$t" "link (C only)" cinput
    exit 0
  fi
fi

# The compile cache's functions, defined before the routes that use them (the Path B -c route runs before the gcc route's
# code). The decisions are scripts/nfcxx-cache.rb's: the key of this compile, the --cache-log block, hit or miss, the copy of
# a hit back beside the output, and the store of the object just built. The bash runs Ruby only when the cache is on.
# cache_check is the lookup and the hit (exit 0 on a hit); cache_store stores the object just built when the cache is in use
# and has no entry for it yet. The remote tier (NFCXX_CACHE_REMOTE=gha) is scripts/nfcxx-cache-io.rb, called from here.
# cache_plan: prints the lookup's options, NUL-separated: the records of this compile (scripts/nfcxx-cache-plan.rb turns them into
# the options; the command arguments without the cache options, the host preprocessor's -std, cflags, forced includes and sysdirs)
cache_plan() {
  local a
  cache_rec() { printf '%s\0' "$1$2"; }   # cache_rec KIND PAYLOAD: one record
  cache_rec o "cache-dir=$cache_dir"; cache_rec o "cache-log=$cache_log_file"; cache_rec o "out=$out"; cache_rec o "src=${srcs[0]-}"; cache_rec o "cwd=$PWD"
  cache_rec v "backend=$backend"; cache_rec v "compile_only=$compile_only"; cache_rec v "ncpp=$ncpp"; cache_rec v "outset=$outset"; cache_rec v "nobj=$nobj"
  cache_rec v "modules=$modules"; cache_rec v "preprocess=$preprocess"; cache_rec v "stdin_src=$stdin_src"; cache_rec v "depmode=$depmode"
  cache_rec v "cfiles_n=${#cfiles[@]}"; cache_rec v "cu_n=${#cu_inputs[@]}"; cache_rec v "cpp2_n=${#cpp2_inputs[@]}"
  for a in ${nfcxx_argv[@]+"${nfcxx_argv[@]}"}; do cache_rec a "$a"; done
  cache_rec s "$std"
  for a in ${cflags[@]+"${cflags[@]}"}; do cache_rec f "$a"; done
  for a in ${preinc[@]+"${preinc[@]}"}; do cache_rec p "$a"; done
  for a in ${sysdirs[@]+"${sysdirs[@]}"}; do cache_rec d "$a"; done
}
cache_check() {  # cache_check: sets cache_entry (empty when the cache does not apply) and exits 0 on a hit
cache_entry=""
[ -n "$cache_dir" ] || return 0   # the cache is off: no Ruby is started
local f a look decision state key rec opts=()
while IFS= read -r -d "" rec; do opts+=("$rec"); done < <(cache_plan | "${RUBY:-ruby}" "$root/scripts/nfcxx-cache-plan.rb")
# lookup: the --cache-log block (when there is a log) and the last line, "hit KEY" or "miss KEY"; nothing when not cached
look=$("${RUBY:-ruby}" "$root/scripts/nfcxx-cache.rb" lookup "${opts[@]}") || return 0
[ -n "$look" ] || return 0
decision=${look##*$'\n'}
[ "$look" = "$decision" ] || cache_log "${look%$'\n'*}"
read -r state key <<<"$decision"
cache_entry=$cache_dir/objects/$key
# a local miss is looked up in the remote tier (nfcxx-cache-io.rb remote-get; a failure is a miss)
if [ "$state" = miss ]; then
  [ -z "$cache_remote" ] || cache_remote_get "$key" "$cache_entry" || true
  [ -f "$cache_entry/obj" ] || return 0
fi
# hit: the object and its records are copied back, and the program is done
"${RUBY:-ruby}" "$root/scripts/nfcxx-cache.rb" hit --out="$out" --entry="$cache_entry" && exit 0
return 0
}
cache_store() {  # cache_store OBJ: a whole entry appears at once (a partial copy is never a hit)
  [ -n "$cache_entry" ] || return 0
  # store: exit 0 when this call made the entry; a new entry goes to the remote tier (cache_remote_put, a note on failure)
  if "${RUBY:-ruby}" "$root/scripts/nfcxx-cache.rb" store --out="$1" --entry="$cache_entry" && [ -n "$cache_remote" ]; then
    cache_remote_put "${cache_entry##*/}" "$cache_entry"
  fi
}
# Path B: no C is generated. Each C++ file goes EDG -> typed IR -> QBE -> object (scripts/pathb-cc.rb), and the objects are
# linked with EDG's runtime (libC.a: exceptions, operator new) before libstdc++, as tests/pathb-qbe/run.sh links them.
# The forced includes (a .cu input's nfcxx_cuda.h, and -include) reach pathb-cc as -include, as they reach EDG's preinclude.
pb_pre=(); for f in ${preinc[@]+"${preinc[@]}"}; do pb_pre+=(-include "$f"); done
if [ $backend = pathb ] && [ $compile_only = 1 ] && [ $ncpp -gt 0 ]; then
  # A .cu unit with kernel instances only the host compile makes (its .dev.kernels.unresolved is not empty) needs the second pass
  # (below, on the EDG route); Path B does not build them, so this unit takes the gcc route, which runs it.
  if [ ${#cu_inputs[@]} -gt 0 ] && [ -n "${cudatmp:-}" ] && [ -s "$cudatmp/$(basename "${cu_inputs[0]}" .cu).dev.kernels.unresolved" ]; then
    echo "nfcxx: ${cu_inputs[0]} has kernel instances only the host compile makes; building it with the gcc backend, which runs the second pass" >&2
    temp_cleanup; exec env NFCXX_BACKEND=gcc "$root/nfcxx" "${nfcxx_argv[@]}"
  fi
  cache_check   # a hit: the object is copied back and the program is done
  # -c: one object per C++ file, named as the gcc and Path B backends name it (-o FILE for one file, else basename.o)
  for f in ${files[@]+"${files[@]}"}; do
    case $f in
      -I*|-D*|-U*|-*|*.o|*.a|*.so) ;;
      *) b=$(basename "$f"); dst=${b%.*}.o; [ $outset = 1 ] && dst=$out
         prc=0; "$root/scripts/pathb-cc.rb" ${pb_flags[@]+"${pb_flags[@]}"} "-std=c++${std#--c++}" ${cflags[@]+${cflags[@]+"${cflags[@]}"}} ${pb_pre[@]+"${pb_pre[@]}"} ${cuda_opts[@]+"${cuda_opts[@]}"} ${modopts[@]+"${modopts[@]}"} "$f" -o "$dst" || prc=$?
         if [ $prc != 0 ]; then
           # the default backend failed on this file: the object is built again with gcc, which reports its own errors
           [ $default_backend = 1 ] || exit $prc
           echo "nfcxx: Path B did not build $f (status $prc); building the program with the gcc backend, which compiles with C semantics (-fwrapv -fno-strict-aliasing)" >&2
           temp_cleanup; exec env NFCXX_BACKEND=gcc "$root/nfcxx" "${nfcxx_argv[@]}"
         fi ;;
    esac
  done
  if [ -n "$cache_entry" ] && [ ${#srcs[@]} = 1 ]; then cache_store "$out"; fi
  exit 0
fi
if [ $backend = pathb ]; then
  ptmp=$(mktemp -d); trap 'temp_cleanup; trace_finish' EXIT
  pobjs=(); plink=(); n=0
  for f in ${files[@]+"${files[@]}"}; do
    case $f in
      -I*|-D*|-U*) ;;                       # reach pathb-cc through cflags
      -lcudart)                             # the CUB archive (scripts/cuda-cub.rb) before the -lcudart it needs; none when it fails
        if [ $shared = 0 ]; then cub=$("$root/scripts/cuda-cub.rb") && [ -n "$cub" ] && plink+=("$cub"); fi
        plink+=("$f") ;;
      -*|*.o|*.a|*.so) plink+=("$f") ;;
      *) o=$ptmp/p$n.o; n=$((n + 1))
         t=$(trace_start)
         prc=0
         "$root/scripts/pathb-cc.rb" ${pb_flags[@]+"${pb_flags[@]}"} "-std=c++${std#--c++}" ${cflags[@]+${cflags[@]+"${cflags[@]}"}} ${pb_pre[@]+"${pb_pre[@]}"} ${cuda_opts[@]+"${cuda_opts[@]}"} "$f" -o "$o" || prc=$?
         trace_end "$t" "Path B: $f" pathb
         if [ $prc != 0 ] && [ $default_backend = 1 ]; then
           # the default backend failed on this file (status 3: a construct Path B refuses; otherwise a Path B fault):
           # the whole program is built again with gcc, which reports its own errors if it fails too
           echo "nfcxx: Path B did not build $f (status $prc); building the program with the gcc backend, which compiles with C semantics (-fwrapv -fno-strict-aliasing)" >&2
           rm -rf "$ptmp"
           temp_cleanup; exec env NFCXX_BACKEND=gcc "$root/nfcxx" "${nfcxx_argv[@]}"
         fi
         [ $prc = 0 ] || exit $prc
         pobjs+=("$o") ;;
    esac
  done
  t=$(trace_start)
  # libnfcxxld.a: the long double helpers and nothing else (scripts/pathb-ldrt.rb, docs/notes/pathb-longdouble.md)
  ldrt=$("$root/scripts/pathb-ldrt.rb")
  # The C++ and atomic libraries of the host: macOS has libc++ (in libSystem's SDK) and no libstdc++, libgcc_s or libatomic.
  if [ "$(uname -s)" = Darwin ]; then pb_cxx_libs="-lc++"; pb_atomic_lib=""; else pb_cxx_libs="-lstdc++ -lgcc_s"; pb_atomic_lib="-latomic"; fi
  [ $freestanding = 0 ] || { pb_cxx_libs=""; pb_atomic_lib=""; }   # no hosted C++ runtime: the program links EDG's runtime and libc
  sprt=(); [ $safeptr = 0 ] || [ $compile_only = 1 ] || sprt=("$("$root/scripts/safeptr-rt.rb")" -pthread)   # first: its malloc wins
  if [ $cosmo = 1 ]; then
    # cosmo: cosmocc links, its libc++ comes with the C++ driver, and the glibc-only libraries are not there
    # cosmocc's fat link (an aarch64 companion per input) is not used: the x86_64 driver links the objects with cosmo's
    # startup code (ape.o, crt.o), linker script and libraries, as cosmocc's x86_64 link does (bin/cosmocc).
    cosmo_lib=$cosmo_root/x86_64-linux-cosmo/lib
    cosmo_libc=$("$root/scripts/cosmo-libc.rb")   # EDG's runtime for cosmo (libC.a, built from the host member list)
    # The ELF is then fixed up (zip sections: tools/cosmo/fixupobj.c) and packaged as APE, as cosmocc's link does.
    cosmo_elf=$ptmp/cosmo.elf
    "$cosmo_root/bin/x86_64-linux-cosmo-g++" -nostartfiles -nodefaultlibs -static -Wl,-T,"$cosmo_lib/ape.lds" -L"$cosmo_lib" -o "$cosmo_elf" ${sprt[@]+"${sprt[@]}"} "$cosmo_lib/ape.o" "$cosmo_lib/crt.o" ${cobjs[@]+${cobjs[@]+"${cobjs[@]}"}} ${pobjs[@]+"${pobjs[@]}"} ${plink[@]+${plink[@]+"${plink[@]}"}} "$ldrt" ${shim[@]+${shim[@]+"${shim[@]}"}} -L"$cosmo_libc" -lC -lcxx -lc -lcosmo -lm
    "$cosmo_root/bin/fixupobj" "$cosmo_elf" && "$cosmo_root/bin/apelink" -V -1 -l "$cosmo_root/bin/ape-x86_64.elf" -o "$out" "$cosmo_elf"
  else
  cc ${asan_c[@]+${asan_c[@]+"${asan_c[@]}"}} ${ldopts[@]+${ldopts[@]+"${ldopts[@]}"}} -o "$out" ${sprt[@]+"${sprt[@]}"} ${cobjs[@]+${cobjs[@]+"${cobjs[@]}"}} ${pobjs[@]+"${pobjs[@]}"} ${plink[@]+${plink[@]+"${plink[@]}"}} "$ldrt" ${shim[@]+${shim[@]+"${shim[@]}"}} ${vlart[@]+${vlart[@]+"${vlart[@]}"}} "${EDG_BUILD:-$root/build/edg}/lib/libC.a" $pb_cxx_libs -lpthread -lm $pb_atomic_lib
  fi
  trace_end "$t" "link" pathb
  exit 0
fi

# With the gcc backend the generated C relies on C's UB rules (e.g. plain signed '+'), so make the C
# compiler give those operations defined behavior. -fkeep-static-functions keeps EDG's static __tls_init
# (thread_local dynamic initialization): it is referenced only through a top-level asm alias, which gcc
# -O2 does not count as a use, so it was dropped and the wrapper's call went unresolved.
# With --trace, eccp's own C compiler steps are child processes that record their spans too (gcc-cc).
# -fkeep-static-functions is a GCC option; clang (the C compiler on macOS) rejects it.
keep_static=(--c_to_obj_option -fkeep-static-functions)
"${NFCXX_GCC:-cc}" --version 2>/dev/null | head -1 | grep -qi clang && keep_static=()
# --eh-unwind (NFCXX_EH_UNWIND=1): a throw runs the cleanups of the frames it unwinds in the system unwinder (EDG's --nfcxx_eh_unwind;
# lib_src/throw.c). gcc: the frames need unwind tables (-fexceptions) and the declarations of
# lib/ehshim/nfcxx_eh_unwind.h, which the C compiler reads first.
eh_unwind=(${eh_tls[@]+"${eh_tls[@]}"})
if [ $eh_unwind_on = 1 ] && [ "$backend" = gcc ]; then
  eh_unwind+=(--nfcxx_eh_unwind --c_to_obj_option -fexceptions --c_to_obj_option -include --c_to_obj_option "$root/lib/ehshim/nfcxx_eh_unwind.h")
fi
# The link arguments (-I, -l, -lcudart, -Wl and the objects, in argument order) become the EDG options and the user include
# directories, and the one-step command line is planned here, before the compile cache: a refused option stops the driver
# (status 2) before a cache hit could skip it. scripts/nfcxx-eccp-plan.rb plans the arguments with the call (see the port;
# tests/nfcxx-linkargs/run.sh and tests/nfcxx-eccp-plan/run.sh check them).
# -c without -o: the object is <stem>.o, as for C and .cu inputs. eccp makes one object per call, so several sources need -o.
if [ $compile_only = 1 ] && [ $outset = 0 ] && [ $ncpp -gt 0 ]; then
  [ ${#srcs[@]} = 1 ] || { echo "nfcxx: -c with several sources needs -o (one object is made per call)" >&2; exit 2; }
  b=$(basename "${srcs[0]}"); out=${b%.*}.o
fi
# The one-step build: eccp runs in a temporary directory, so its paths are made absolute before the cd (in the plan).
eccp_bin="$edg/eccp"; eccp_out=$out
if [ $moves = 1 ]; then
  eccp_dir=$(mktemp -d); trap eccp_cleanup EXIT
fi
# The command line (its arguments, the variable a shared link exports, and the directory it runs in) is planned by
# scripts/nfcxx-eccp-plan.rb, which also prints the note for a kept temporary directory (--keep-intermediates).
# A shared link: EDG_OBJ_TO_EXEC_DEFAULT_OPTIONS replaces eccp's link options (see the port).
eccp_plan
# -c: eccp writes the records of each source (<stem>.ti, the requests) beside its object, and the link reads them there. eccp
# adds to a .ti that exists, so the records of the sources being compiled are removed first and the compile starts clean
# (eccp keeps the old content of a .ti and writes the new record ahead of it). The first source takes the name of -o, as eccp names it.
compile_clean() {  # compile_clean: removes the records of the sources of a -c compile (scripts/nfcxx-link.rb compile-clean)
  if [ $compile_only = 1 ] && [ $ncpp -gt 0 ]; then
    "${RUBY:-ruby}" "$root/scripts/nfcxx-link.rb" compile-clean "$out" ${srcs[@]+"${srcs[@]}"}
  fi
}
compile_clean
link_records_rm() {  # link_records_rm: removes <stem>.ii beside each object of this link (see "A link writes" below)
  "${RUBY:-ruby}" "$root/scripts/nfcxx-link.rb" records-rm -- ${files[@]+"${files[@]}"}   # the loop (tests/nfcxx-link/run.sh)
}
# A link writes <stem>.ii beside each object it uses: the instances the link assigned to that object (the <stem>.ti requests
# stay). An assignment left by an earlier link can name an instance that a later link assigns to another object ("assigned
# to more than one file"), so these records are removed before the link and again once it succeeds (set -e: a failed link
# exits before the second removal).
link_records_rm
# Compile cache (opt-in: --cache=DIR, or NFCXX_CACHE=DIR). A -c compile of one C++ source with -o is kept in DIR/objects under a key of
# everything that can change the object: the command as given, the absolute output path (the prelinker records it in the
# object's .ti), the working directory, the source and each header the host preprocessor lists (-M), the NFCXX_* environment,
# the driver and its scripts, the EDG and QBE binaries, and the host compilers. A hit copies the object back with its
# <stem>.ti and <stem>.ii, which the link reads beside it. Not cached: .cu (its device images are, in cu_rewrite), C and
# -E inputs, -MD (its dependency file), several sources in one command, and an -o without an extension. A file name with
# spaces in the header list is not handled.
cache_check
t=$(trace_start)
(
  [ -z "$eccp_cd" ] || cd "$eccp_cd"
  for e in ${eccp_envs[@]+"${eccp_envs[@]}"}; do export "$e"; done
  "${eccp_argv[@]}"
)
trace_end "$t" "eccp (front end, C compile, link)" eccp
link_records_rm
# Kernel instances from the host compile. The rewriter lists the kernel templates whose instances the text does not
# give (<kernels>.unresolved: a launch or address in a template the unit calls with deduced or dependent arguments,
# binbcast.cu's launch_bin_bcast_pack), and their device code is not made. The host compile made them, though: when its
# output has an instance of one of them (nm -C), the build runs again with those symbols (NFCXX_CUDA_HOST_SYMBOLS), and
# the device rewrite makes each instance's entry. A unit whose templates are instantiated by other units (fattn.cu)
# has none, and builds once. One .cu input only: the symbols of two units' static kernels could not be told apart.
if [ ${#cu_inputs[@]} = 1 ] && [ -z "${NFCXX_CUDA_HOST_SYMBOLS:-}" ] && [ $preprocess = 0 ] && [ -f "$out" ] \
   && [ -s "$cudatmp/$(basename "${cu_inputs[0]}" .cu).dev.kernels.unresolved" ]; then
  hsyms=$cudatmp/host.syms
  nm -C "$out" 2>/dev/null | sed 's/_INTERNAL_[A-Za-z0-9_]*:://g' > "$hsyms" || true
  found=0
  while IFS= read -r k; do
    [ -n "$k" ] && grep -qE "(^|[ :])$k<" "$hsyms" && found=1
  done < "$cudatmp/$(basename "${cu_inputs[0]}" .cu).dev.kernels.unresolved"
  if [ $found = 1 ]; then
    t=$(trace_start)
    # (the second pass is not cached: the --cache option is left out, and NFCXX_CACHE emptied)
    args2=(); for a in "${args0[@]}"; do case $a in --cache=*) ;; *) args2+=("$a") ;; esac; done
    NFCXX_CUDA_HOST_SYMBOLS=$hsyms NFCXX_CACHE= NFCXX_CACHE_REMOTE= "$root/nfcxx" ${args2[@]+"${args2[@]}"} || exit $?
    trace_end "$t" "second pass (kernel instances from the host compile)" eccp
  fi
fi
cache_store "$out"
if [ -n "$depmode" ]; then
  # -MD/-MMD (with -MF/-MT/-MQ/-MP): the host preprocessor writes the dependency file, as nfcc does for C.
  df=${dfile:-${out%.*}.d}; tgt=${dtarget:-$out}
  mflag=-M; [ "$depmode" = -MMD ] && mflag=-MM
  "${NFCXX_CXX:-g++}" $mflag $depphony -MT "$tgt" -MF "$df" "-std=${std#--}" ${cflags[@]+${cflags[@]+"${cflags[@]}"}} \
    ${sysdirs[@]+"${sysdirs[@]/#/-isystem}"} ${srcs[@]+${srcs[@]+"${srcs[@]}"}}
fi
