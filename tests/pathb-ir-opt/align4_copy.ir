(ir-module "align4_copy.cpp" (layout (short 2) (int 4) (long 8) (long_long 8) (pointer 8) (float 4) (double 8) (long_double 16)))
(abi-type "u3" 12 4 (leaf 0 w) (leaf 4 w))
(function "f" (ret void) (params (param %0 "p" (ptr (const (struct "u3")))) (param %1 "q" (ptr (struct "u3"))))
  (slot "t" (struct "u3") 12 4)
  (copy 12 $"t" %0 4)
  (let %2 (ptr int) (offset $"t" 8))
  (let %3 int (load int %2))
  (copy 12 %1 $"t" 4)
  (let %4 (ptr int) (offset %1 8))
  (store int %4 %3))
