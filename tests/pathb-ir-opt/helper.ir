(ir-module "helper.cpp" (layout (short 2) (int 4) (long 8) (long_long 8) (pointer 8) (float 4) (double 8) (long_double 16)))

(function "square"
  (ret int)
  (params (param %0 "x" int))
  (slot "x" int 4 4)
  (store int $"x" %0)
  (let %1 int (load int $"x"))
  (let %2 int (load int $"x"))
  (let %3 int (wmul int %1 %2))
  (return %3))

(function "square_plus_one"
  (ret int)
  (params (param %0 "x" int))
  (slot "x" int 4 4)
  (store int $"x" %0)
  (let %1 int (load int $"x"))
  (let %2 int (call int &"square" %1))
  (let %3 int (wadd int %2 (const int 1)))
  (return %3))

(function "scale"
  (ret float)
  (params (param %0 "v" float))
  (slot "v" float 4 4)
  (store float $"v" %0)
  (let %1 float (load float $"v"))
  (let %2 float (fmul float %1 (const float 0.5)))
  (let %3 float (fadd float %2 (const float 1.0)))
  (return %3))

(function "helper_kernel"
  (ret void)
  (params (param %0 "in" (ptr (const int))) (param %1 "out" (ptr int)) (param %2 "n" int))
  (slot "in" (ptr (const int)) 8 8)
  (slot "out" (ptr int) 8 8)
  (slot "n" int 4 4)
  (slot "i" int 4 4)
  (slot "tmp" int 4 4)
  (store (ptr (const int)) $"in" %0)
  (store (ptr int) $"out" %1)
  (store int $"n" %2)
  (let %3 unsigned_int (call unsigned_int &"__nfcxx_tid_x"))
  (let %4 int (iconv int %3))
  (let %5 unsigned_int (call unsigned_int &"__nfcxx_ctaid_x"))
  (let %6 int (iconv int %5))
  (let %7 unsigned_int (call unsigned_int &"__nfcxx_ntid_x"))
  (let %8 int (iconv int %7))
  (let %9 int (wmul int %6 %8))
  (let %10 int (wadd int %4 %9))
  (store int $"i" %10)
  (let %11 int (load int $"i"))
  (let %12 int (load int $"n"))
  (let %13 bool (lt.s int %11 %12))
  (if %13
    (then
      (block
        (let %14 (ptr (const int)) (load (ptr (const int)) $"in"))
        (let %15 int (load int $"i"))
        (let %16 (ptr int) (index %14 %15 4))
        (let %17 int (load int %16))
        (let %18 int (call int &"square_plus_one" %17))
        (store int $"tmp" %18)
        (let %19 int (load int $"tmp"))
        (let %20 (ptr int) (load (ptr int) $"out"))
        (let %21 int (load int $"i"))
        (let %22 (ptr int) (index %20 %21 4))
        (store int %22 %19))))
  (return))

(function "helper_scale"
  (ret void)
  (params (param %0 "in" (ptr (const float))) (param %1 "out" (ptr float)) (param %2 "n" int))
  (slot "in" (ptr (const float)) 8 8)
  (slot "out" (ptr float) 8 8)
  (slot "n" int 4 4)
  (slot "i" int 4 4)
  (slot "tmp" float 4 4)
  (store (ptr (const float)) $"in" %0)
  (store (ptr float) $"out" %1)
  (store int $"n" %2)
  (let %3 unsigned_int (call unsigned_int &"__nfcxx_tid_x"))
  (let %4 int (iconv int %3))
  (let %5 unsigned_int (call unsigned_int &"__nfcxx_ctaid_x"))
  (let %6 int (iconv int %5))
  (let %7 unsigned_int (call unsigned_int &"__nfcxx_ntid_x"))
  (let %8 int (iconv int %7))
  (let %9 int (wmul int %6 %8))
  (let %10 int (wadd int %4 %9))
  (store int $"i" %10)
  (let %11 int (load int $"i"))
  (let %12 int (load int $"n"))
  (let %13 bool (lt.s int %11 %12))
  (if %13
    (then
      (block
        (let %14 (ptr (const float)) (load (ptr (const float)) $"in"))
        (let %15 int (load int $"i"))
        (let %16 (ptr float) (index %14 %15 4))
        (let %17 float (load float %16))
        (let %18 float (call float &"scale" %17))
        (store float $"tmp" %18)
        (let %19 float (load float $"tmp"))
        (let %20 (ptr float) (load (ptr float) $"out"))
        (let %21 int (load int $"i"))
        (let %22 (ptr float) (index %20 %21 4))
        (store float %22 %19))))
  (return))
