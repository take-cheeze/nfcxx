(ir-module "forward.cpp" (layout (short 2) (int 4) (long 8) (long_long 8) (pointer 8) (float 4) (double 8) (long_double 16)))
(function "f"
  (ret int)
  (params (param %0 "a" int))
  (slot "x" int 4 4)
  (store int $"x" %0)
  (let %1 int (load int $"x"))
  (eval (call void &"g"))
  (let %2 int (load int $"x"))
  (return %2))
