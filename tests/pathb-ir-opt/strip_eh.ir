(ir-module "strip_eh.cpp" (layout (short 2) (int 4) (long 8) (long_long 8) (pointer 8) (float 4) (double 8) (long_double 16)))
(global "__curr_eh_stack_entry" (ptr (struct "__C8")) 8 8 (thread) (extern))
(global "__eh_curr_region" unsigned_short 2 2 (thread) (extern))
(function "fwd"
