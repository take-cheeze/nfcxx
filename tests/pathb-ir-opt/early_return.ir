(ir-module "early_return.cpp" (layout (short 2) (int 4) (long 8) (long_long 8) (pointer 8) (float 4) (double 8) (long_double 16)))
(function "clamp0"
  (ret int)
  (params (param %0 "v" int))
  (let %1 bool (lt.s int %0 (const int 0)))
  (if %1
    (then
      (block
        (return (const int 0)))))
  (let %2 int (wadd int %0 (const int 1)))
  (return %2))
(function "find"
  (ret int)
  (params (param %0 "n" int))
  (slot "i" int 4 4)
  (store int $"i" (const int 0))
  (loop
    (body
      (let %1 int (load int $"i"))
      (let %2 bool (lt.s int %1 %0))
      (if %2 (then) (else (break)))
      (return %1))
    (step))
  (return (const int -1)))
(function "caller"
  (ret int)
  (params (param %0 "a" int))
  (let %1 int (call int &"clamp0" %0))
  (let %2 int (call int &"find" %1))
  (return %2))
