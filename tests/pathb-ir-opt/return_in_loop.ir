(ir-module "return_in_loop.cpp" (layout (short 2) (int 4) (long 8) (long_long 8) (pointer 8) (float 4) (double 8) (long_double 16)))
(function "find"
  (ret int)
  (params (param %0 "n" int) (param %1 "want" int))
  (slot "i" int 4 4)
  (store int $"i" (const int 0))
  (loop
    (body
      (let %2 int (load int $"i"))
      (let %3 bool (lt.s int %2 %0))
      (if %3 (then) (else (break)))
      (let %4 int (wmul int %2 %2))
      (let %5 bool (eq int %4 %1))
      (if %5 (then (return %2))))
    (step
      (let %6 int (load int $"i"))
      (store int $"i" (wadd int %6 (const int 1)))))
  (return (const int -1)))
(function "pair"
  (ret int)
  (params (param %0 "n" int) (param %1 "want" int))
  (slot "i" int 4 4)
  (slot "j" int 4 4)
  (store int $"i" (const int 0))
  (loop
    (body
      (let %2 int (load int $"i"))
      (let %3 bool (lt.s int %2 %0))
      (if %3 (then) (else (break)))
      (store int $"j" (const int 0))
      (loop
        (body
          (let %4 int (load int $"j"))
          (let %5 bool (lt.s int %4 %0))
          (if %5 (then) (else (break)))
          (let %6 int (wmul int %2 %4))
          (let %7 bool (eq int %6 %1))
          (if %7 (then (block (let %8 int (wmul int %2 (const int 10))) (return (wadd int %8 %4)))))
          (let %9 bool (lt.s int %1 %6))
          (if %9 (then (break))))
        (step
          (let %10 int (load int $"j"))
          (store int $"j" (wadd int %10 (const int 1))))))
    (step
      (let %11 int (load int $"i"))
      (store int $"i" (wadd int %11 (const int 1)))))
  (return (const int -1)))
(function "sw"
  (ret int)
  (params (param %0 "n" int) (param %1 "t" int))
  (slot "i" int 4 4)
  (slot "s" int 4 4)
  (store int $"i" (const int 0))
  (store int $"s" (const int 0))
  (loop
    (body
      (let %2 int (load int $"i"))
      (let %3 bool (lt.s int %2 %0))
      (if %3 (then) (else (break)))
      (let %4 int (and int %2 (const int 3)))
      (switch %4
        (body
          (block
            (case (const int 0))
            (let %5 int (load int $"s"))
            (store int $"s" (wadd int %5 (const int 1)))
            (break)
            (case (const int 1))
            (let %6 int (load int $"s"))
            (let %7 bool (lt.s int %1 %6))
            (if %7 (then (return %6)))
            (continue)
            (case (const int 2))
            (let %8 int (load int $"s"))
            (store int $"s" (wadd int %8 (const int 10)))
            (break)
            (default)
            (let %9 int (load int $"s"))
            (store int $"s" (wadd int %9 (const int 100))))))
      (let %10 int (load int $"s"))
      (store int $"s" (wadd int %10 (const int 1000))))
    (step
      (let %11 int (load int $"i"))
      (store int $"i" (wadd int %11 (const int 1)))))
  (let %12 int (load int $"s"))
  (return (wsub int (const int 0) %12)))
(function "loop_in_switch"
  (ret void)
  (params (param %0 "k" int) (param %1 "out" (ptr int)))
  (slot "i" int 4 4)
  (store int %1 (const int 7))
  (switch %0
    (body
      (block
        (case (const int 0))
        (store int $"i" (const int 0))
        (loop
          (body
            (let %2 int (load int $"i"))
            (let %3 bool (lt.s int %2 (const int 5)))
            (if %3 (then) (else (break)))
            (let %4 bool (eq int %2 (const int 3)))
            (if %4 (then (block (store int %1 %2) (return))))
            (store int %1 (wadd int %2 (const int 100))))
          (step
            (let %5 int (load int $"i"))
            (store int $"i" (wadd int %5 (const int 1)))))
        (store int %1 (const int -5))
        (break)
        (case (const int 1))
        (return)
        (default)
        (store int %1 (const int 9)))))
  (let %6 int (load int %1))
  (store int %1 (wadd int %6 (const int 1000)))
  (return))
(function "main"
  (ret int)
  (params (param %0 "a" int))
  (slot "o" int 4 4)
  (slot "acc" int 4 4)
  (store int $"acc" (const int 0))
  (let %1 int (call int &"find" (const int 10) %0))
  (let %2 int (call int &"pair" (const int 10) %0))
  (let %3 int (call int &"sw" (const int 9) %0))
  (let %10 int (and int %0 (const int 3)))
  (eval (call void &"loop_in_switch" %10 $"o"))
  (let %4 int (load int $"o"))
  (let %5 int (wmul int %1 (const int 1000000)))
  (let %6 int (wmul int %2 (const int 10000)))
  (let %7 int (wadd int %5 %6))
  (let %8 int (wmul int %3 (const int 10)))
  (let %9 int (wadd int %7 %8))
  (return (wadd int %9 %4)))
