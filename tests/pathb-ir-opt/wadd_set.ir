(ir-module "bug.cpp" (layout (short 2) (int 4) (long 8) (long_long 8) (pointer 8) (float 4) (double 8) (long_double 16)))
(function "wrap" (ret int)
  (params (param %0 "x" int))
  (slot "a" int 4 4)
  (store int $"a" (const int 2147483647))
  (let %1 int (load int $"a"))
  (let %2 int (wadd int %1 (const int 1)))
  (return %2))
(function "unit_then_set" (ret int)
  (params (param %0 "b" (ptr int)) (param %1 "i" int))
  (bounds %1 1)
  (set %1 (const int 3))
  (let %2 (ptr int) (index %0 %1 4))
  (let %3 int (load int %2))
  (return %3))
