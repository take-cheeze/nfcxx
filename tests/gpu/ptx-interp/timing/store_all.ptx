// Every thread stores one int32 to its own element: one 4-byte global access per thread. With many threads per block the
// global bytes, not the critical path, decide the estimate (run_timing.sh checks the exact values).
.version 8.0
.target sm_75
.address_size 64

.visible .entry store_all(
  .param .u64 a_param
)
{
  .reg .b32 %r<2>;
  .reg .b64 %rd<4>;

  ld.param.u64 %rd0, [a_param];
  mov.u32 %r0, %tid.x;
  mul.wide.u32 %rd1, %r0, 4;
  add.s64 %rd2, %rd0, %rd1;
  st.global.u32 [%rd2], %r0;
  ret;
}
