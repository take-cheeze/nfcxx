// Every thread of every block loads a[tid.x]. With 32 threads that is 32 ints = 128 bytes, one cache line (the first
// buffer of the arena starts on a line boundary). Each thread then stores its value to b[tid.x]. run_timing.sh derives
// the estimates for this kernel by hand from the model.
.version 8.0
.target sm_75
.address_size 64

.visible .entry l1line(
  .param .u64 a_param,
  .param .u64 b_param
)
{
  .reg .b32 %r<2>;
  .reg .b64 %rd<6>;

  ld.param.u64 %rd0, [a_param];
  ld.param.u64 %rd1, [b_param];
  mov.u32 %r0, %tid.x;
  mul.wide.u32 %rd2, %r0, 4;
  add.s64 %rd3, %rd0, %rd2;
  ld.global.u32 %r1, [%rd3];
  add.s64 %rd4, %rd1, %rd2;
  st.global.u32 [%rd4], %r1;
  ret;
}
