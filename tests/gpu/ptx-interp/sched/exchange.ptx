// Two threads of a block: thread i stores a[i] = i + 1, then (after bar.sync 0, when present) reads a[1 - i] into b[i].
// With the barrier, b = (2, 1) in every schedule. Without it, the sequentially consistent schedules give b = (0, 1),
// (2, 0) and (2, 1), and never (0, 0).
.version 8.0
.target sm_75
.address_size 64

.visible .entry exchange(
  .param .u64 a_param,
  .param .u64 b_param
)
{
  .reg .b32 %r<4>;
  .reg .b64 %rd<8>;

  ld.param.u64 %rd0, [a_param];
  ld.param.u64 %rd1, [b_param];
  mov.u32 %r0, %tid.x;
  add.u32 %r1, %r0, 1;
  mul.wide.u32 %rd2, %r0, 4;
  add.s64 %rd3, %rd0, %rd2;
  st.global.u32 [%rd3], %r1;
  bar.sync 0;
  sub.u32 %r2, 1, %r0;
  mul.wide.u32 %rd4, %r2, 4;
  add.s64 %rd5, %rd0, %rd4;
  ld.global.u32 %r3, [%rd5];
  add.s64 %rd6, %rd1, %rd2;
  st.global.u32 [%rd6], %r3;
  ret;
}
