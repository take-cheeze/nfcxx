  (let %2 unsigned_int (call unsigned_int &"__nfcxx_tid_x"))
  (store unsigned_int $"t" %2)
  (let %3 unsigned_int (call unsigned_int &"__nfcxx_ctaid_x"))
  (let %4 unsigned_int (wmul unsigned_int %3 (const unsigned_int 128)))
  (let %5 unsigned_int (load unsigned_int $"t"))
  (let %6 unsigned_int (wadd unsigned_int %4 %5))
