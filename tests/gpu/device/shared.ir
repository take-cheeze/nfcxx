  (eval (call void &"__nfcxx_syncthreads"))
  (let %14 (ptr float) (bitcast (ptr float) @"tile"))
  (let %15 unsigned_int (load unsigned_int $"t"))
  (let %16 unsigned_int (wsub unsigned_int (const unsigned_int 127) %15))
  (bounds %16 128)
  (let %17 (ptr float) (index %14 %16 4))
  (let %18 float (load float %17))
  (let %19 (ptr float) (load (ptr float) $"out"))
  (let %20 unsigned_int (load unsigned_int $"g"))
  (let %21 (ptr float) (index %19 %20 4))
  (store float %21 %18)
