  (let %7 (ptr (const float)) (load (ptr (const float)) $"in"))
  (let %8 unsigned_int (load unsigned_int $"g"))
  (let %9 (ptr float) (index %7 %8 4))
  (let %10 float (load float %9))
  (let %11 (ptr float) (bitcast (ptr float) @"tile"))
  (let %12 unsigned_int (load unsigned_int $"t"))
  (bounds %12 128)
