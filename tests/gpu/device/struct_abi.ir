(ir-module "struct_abi.cpp" (layout (short 2) (int 4) (long 8) (long_long 8) (pointer 8) (float 4) (double 8) (long_double 16)))
(abi-type "P8" 8 4 (leaf 0 w) (leaf 4 w))
(abi-type "M12" 12 4 (leaf 0 w) (leaf 4 h) (leaf 6 b) (leaf 8 s))
(abi-type "V16" 16 16 (leaf 0 s) (leaf 4 s) (leaf 8 s) (leaf 12 s))
(abi-type "U" 4 4 (leaf 0 w))
(abi-type "Outer" 12 4 (leaf 0 w) (leaf 4 w) (leaf 8 s))
(abi-type "E" 1 1 (empty))

(function "sum_p8"
  (ret int)
  (params (param %0 "p" (byval (struct "P8"))))
  (let %1 int (load int %0))
  (let %2 (ptr int) (offset %0 4))
  (let %3 int (load int %2))
  (let %4 int (wadd int %1 %3))
  (return %4))

(function "mk_p8"
  (ret void)
  (params (sret %0 (struct "P8")) (param %1 "a" int) (param %2 "b" int))
  (slot "a" int 4 4)
  (slot "b" int 4 4)
  (slot "r" (struct "P8") 8 4)
  (slot "tmp" (struct "P8") 8 4)
  (store int $"a" %1)
  (store int $"b" %2)
  (let %3 int (load int $"a"))
  (store int $"r" %3)
  (let %4 int (load int $"b"))
  (let %5 (ptr int) (offset $"r" 4))
  (store int %5 %4)
  (block
    (copy 8 $"tmp" $"r")
    (copy 8 %0 $"tmp")
    (return)))

(function "sum_m12"
  (ret int)
  (params (param %0 "m" (byval (struct "M12"))))
  (let %1 int (load int %0))
  (let %2 (ptr short) (offset %0 4))
  (let %3 short (load short %2))
  (let %4 int (iconv int %3))
  (let %5 int (wadd int %1 %4))
  (let %6 (ptr char) (offset %0 6))
  (let %7 char (load char %6))
  (let %8 int (iconv int %7))
  (let %9 int (wadd int %5 %8))
  (let %10 (ptr float) (offset %0 8))
  (let %11 float (load float %10))
  (let %12 int (cf2i int %11))
  (let %13 int (wadd int %9 %12))
  (return %13))

(function "bump_m12"
  (ret void)
  (params (sret %0 (struct "M12")) (param %1 "m" (byval (struct "M12"))))
  (slot "tmp" (struct "M12") 12 4)
  (let %2 int (load int %1))
  (let %3 int (wadd int %2 (const int 1)))
  (store int %1 %3)
  (let %4 (ptr float) (offset %1 8))
  (let %5 float (load float %4))
  (let %6 float (fmul float %5 (const float 2.0)))
  (store float %4 %6)
  (block
    (copy 12 $"tmp" %1)
    (copy 12 %0 $"tmp")
    (return)))

(function "sum_v16"
  (ret float)
  (params (param %0 "v" (byval (struct "V16"))))
  (let %1 float (load float %0))
  (let %2 (ptr float) (offset %0 4))
  (let %3 float (load float %2))
  (let %4 float (fadd float %1 %3))
  (let %5 (ptr float) (offset %0 8))
  (let %6 float (load float %5))
  (let %7 float (fadd float %4 %6))
  (let %8 (ptr float) (offset %0 12))
  (let %9 float (load float %8))
  (let %10 float (fadd float %7 %9))
  (return %10))

(function "scale_v16"
  (ret void)
  (params (sret %0 (struct "V16")) (param %1 "v" (byval (struct "V16"))) (param %2 "s" float))
  (slot "s" float 4 4)
  (slot "r" (struct "V16") 16 16)
  (slot "tmp" (struct "V16") 16 16)
  (store float $"s" %2)
  (let %3 float (load float %1))
  (let %4 float (load float $"s"))
  (let %5 float (fmul float %3 %4))
  (store float $"r" %5)
  (let %6 (ptr float) (offset %1 4))
  (let %7 float (load float %6))
  (let %8 float (load float $"s"))
  (let %9 float (fmul float %7 %8))
  (let %10 (ptr float) (offset $"r" 4))
  (store float %10 %9)
  (let %11 (ptr float) (offset %1 8))
  (let %12 float (load float %11))
  (let %13 float (load float $"s"))
  (let %14 float (fmul float %12 %13))
  (let %15 (ptr float) (offset $"r" 8))
  (store float %15 %14)
  (let %16 (ptr float) (offset %1 12))
  (let %17 float (load float %16))
  (let %18 float (load float $"s"))
  (let %19 float (fmul float %17 %18))
  (let %20 (ptr float) (offset $"r" 12))
  (store float %20 %19)
  (block
    (copy 16 $"tmp" $"r")
    (copy 16 %0 $"tmp")
    (return)))

(function "u_read"
  (ret int)
  (params (param %0 "u" (byval (union "U"))))
  (let %1 int (load int %0))
  (return %1))

(function "nest_outer"
  (ret int)
  (params (param %0 "o" (byval (struct "Outer"))))
  (let %1 int (load int %0))
  (let %2 (ptr int) (offset %0 4))
  (let %3 int (load int %2))
  (let %4 int (wadd int %1 %3))
  (let %5 (ptr float) (offset %0 8))
  (let %6 float (load float %5))
  (let %7 int (cf2i int %6))
  (let %8 int (wadd int %4 %7))
  (return %8))

(function "empty_arg"
  (ret int)
  (params (param %0 "e" (byval (struct "E"))) (param %1 "k" int))
  (slot "k" int 4 4)
  (store int $"k" %1)
  (let %2 int (load int $"k"))
  (return %2))

(function "struct_kernel"
  (ret void)
  (params (param %0 "out" (ptr int)) (param %1 "n" int) (param %2 "p" (byval (struct "P8"))) (param %3 "u" (byval (union "U"))) (param %4 "v" (byval (struct "V16"))) (param %5 "m" (byval (struct "M12"))))
  (slot "out" (ptr int) 8 8)
  (slot "n" int 4 4)
  (slot "i" int 4 4)
  (slot "tmp" int 4 4)
  (slot "tmp.1" int 4 4)
  (slot "tmp.2" (struct "P8") 8 4)
  (slot "q" (struct "P8") 8 4)
  (slot "mi" (struct "M12") 12 4)
  (slot "tmp.3" (struct "M12") 12 4)
  (slot "tmp.4" (struct "M12") 12 4)
  (slot "bm" (struct "M12") 12 4)
  (slot "tmp.5" (struct "V16") 16 16)
  (slot "tmp.6" float 4 4)
  (slot "tmp.7" (struct "V16") 16 16)
  (slot "tmp.8" (struct "V16") 16 16)
  (slot "w" (struct "V16") 16 16)
  (slot "o" (struct "Outer") 12 4)
  (slot "tmp.9" (struct "E") 1 1)
  (slot "tmp.10" (struct "P8") 8 4)
  (slot "tmp.11" (union "U") 4 4)
  (slot "tmp.12" (struct "V16") 16 16)
  (slot "tmp.13" (struct "M12") 12 4)
  (slot "tmp.14" (struct "Outer") 12 4)
  (slot "tmp.15" int 4 4)
  (slot "tmp.16" (struct "E") 1 1)
  (slot "tmp.17" int 4 4)
  (store (ptr int) $"out" %0)
  (store int $"n" %1)
  (let %6 unsigned_int (call unsigned_int &"__nfcxx_tid_x"))
  (let %7 int (iconv int %6))
  (let %8 unsigned_int (call unsigned_int &"__nfcxx_ctaid_x"))
  (let %9 int (iconv int %8))
  (let %10 unsigned_int (call unsigned_int &"__nfcxx_ntid_x"))
  (let %11 int (iconv int %10))
  (let %12 int (wmul int %9 %11))
  (let %13 int (wadd int %7 %12))
  (store int $"i" %13)
  (let %14 int (load int $"i"))
  (let %15 int (load int $"n"))
  (let %16 bool (lt.s int %14 %15))
  (if %16
    (then
      (block
        (let %17 int (load int %2))
        (let %18 int (load int $"i"))
        (let %19 int (wadd int %17 %18))
        (store int $"tmp" %19)
        (let %20 (ptr int) (offset %2 4))
        (let %21 int (load int %20))
        (store int $"tmp.1" %21)
        (let %22 int (load int $"tmp"))
        (let %23 int (load int $"tmp.1"))
        (eval (call void &"mk_p8" (sret (struct "P8") $"tmp.2") %22 %23))
        (copy 8 $"q" $"tmp.2")
        (copy 12 $"mi" %5)
        (let %24 int (load int $"i"))
        (let %25 int (load int $"mi"))
        (let %26 int (wadd int %25 %24))
        (store int $"mi" %26)
        (copy 12 $"tmp.4" $"mi")
        (eval (call void &"bump_m12" (sret (struct "M12") $"tmp.3") (byval (struct "M12") $"tmp.4")))
        (copy 12 $"bm" $"tmp.3")
        (copy 16 $"tmp.5" %4)
        (let %27 int (load int $"n"))
        (let %28 float (i2f float %27))
        (store float $"tmp.6" %28)
        (copy 16 $"tmp.8" $"tmp.5")
        (let %29 float (load float $"tmp.6"))
        (eval (call void &"scale_v16" (sret (struct "V16") $"tmp.7") (byval (struct "V16") $"tmp.8") %29))
        (copy 16 $"w" $"tmp.7")
        (copy 8 $"o" $"q")
        (let %30 int (load int $"n"))
        (let %31 float (i2f float %30))
        (let %32 (ptr float) (offset $"o" 8))
        (store float %32 %31)
        (block
          (copy 8 $"tmp.10" $"q")
          (let %33 int (call int &"sum_p8" (byval (struct "P8") $"tmp.10")))
          (copy 4 $"tmp.11" %3)
          (let %34 int (call int &"u_read" (byval (union "U") $"tmp.11")))
          (let %35 int (wadd int %33 %34))
          (copy 16 $"tmp.12" $"w")
          (let %36 float (call float &"sum_v16" (byval (struct "V16") $"tmp.12")))
          (let %37 int (cf2i int %36))
          (let %38 int (wadd int %35 %37))
          (copy 12 $"tmp.13" $"bm")
          (let %39 int (call int &"sum_m12" (byval (struct "M12") $"tmp.13")))
          (let %40 int (wadd int %38 %39))
          (copy 12 $"tmp.14" $"o")
          (let %41 int (call int &"nest_outer" (byval (struct "Outer") $"tmp.14")))
          (let %42 int (wadd int %40 %41))
          (let %43 int (load int $"i"))
          (store int $"tmp.15" %43)
          (copy 1 $"tmp.16" $"tmp.9")
          (let %44 int (load int $"tmp.15"))
          (let %45 int (call int &"empty_arg" (byval (struct "E") $"tmp.16") %44))
          (let %46 int (wadd int %42 %45))
          (store int $"tmp.17" %46)
          (let %47 int (load int $"tmp.17"))
          (let %48 (ptr int) (load (ptr int) $"out"))
          (let %49 int (load int $"i"))
          (let %50 (ptr int) (index %48 %49 4))
          (store int %50 %47)))))
  (return))
