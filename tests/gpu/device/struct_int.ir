(ir-module "struct_int.cpp" (layout (short 2) (int 4) (long 8) (long_long 8) (pointer 8) (float 4) (double 8) (long_double 16)))
(abi-type "P8" 8 4 (leaf 0 w) (leaf 4 w))
(abi-type "M12" 12 4 (leaf 0 w) (leaf 4 h) (leaf 6 b) (leaf 8 w))
(abi-type "U" 4 4 (leaf 0 w))

(function "sum_p8"
  (ret int)
  (params (param %0 "p" (byval (struct "P8"))))
  (let %1 int (load int %0))
  (let %2 (ptr int) (offset %0 4))
  (let %3 int (load int %2))
  (let %4 int (wadd int %1 %3))
  (return %4))

(function "mk_p8"
  (ret void)
  (params (sret %0 (struct "P8")) (param %1 "a" int) (param %2 "b" int))
  (slot "a" int 4 4)
  (slot "b" int 4 4)
  (slot "r" (struct "P8") 8 4)
  (slot "tmp" (struct "P8") 8 4)
  (store int $"a" %1)
  (store int $"b" %2)
  (let %3 int (load int $"a"))
  (store int $"r" %3)
  (let %4 int (load int $"b"))
  (let %5 (ptr int) (offset $"r" 4))
  (store int %5 %4)
  (block
    (copy 8 $"tmp" $"r")
    (copy 8 %0 $"tmp")
    (return)))

(function "sum_m12"
  (ret int)
  (params (param %0 "m" (byval (struct "M12"))))
  (let %1 int (load int %0))
  (let %2 (ptr short) (offset %0 4))
  (let %3 short (load short %2))
  (let %4 int (iconv int %3))
  (let %5 int (wadd int %1 %4))
  (let %6 (ptr char) (offset %0 6))
  (let %7 char (load char %6))
  (let %8 int (iconv int %7))
  (let %9 int (wadd int %5 %8))
  (let %10 (ptr int) (offset %0 8))
  (let %11 int (load int %10))
  (let %12 int (wadd int %9 %11))
  (return %12))

(function "bump_m12"
  (ret void)
  (params (sret %0 (struct "M12")) (param %1 "m" (byval (struct "M12"))))
  (slot "tmp" (struct "M12") 12 4)
  (let %2 int (load int %1))
  (let %3 int (wadd int %2 (const int 1)))
  (store int %1 %3)
  (let %4 (ptr int) (offset %1 8))
  (let %5 int (load int %4))
  (let %6 int (wmul int %5 (const int 2)))
  (store int %4 %6)
  (block
    (copy 12 $"tmp" %1)
    (copy 12 %0 $"tmp")
    (return)))

(function "u_read"
  (ret int)
  (params (param %0 "u" (byval (union "U"))))
  (let %1 int (load int %0))
  (return %1))

(function "struct_kernel"
  (ret void)
  (params (param %0 "out" (ptr int)) (param %1 "n" int) (param %2 "p" (byval (struct "P8"))) (param %3 "u" (byval (union "U"))) (param %4 "m" (byval (struct "M12"))))
  (slot "out" (ptr int) 8 8)
  (slot "n" int 4 4)
  (slot "i" int 4 4)
  (slot "tmp" int 4 4)
  (slot "tmp.1" int 4 4)
  (slot "tmp.2" (struct "P8") 8 4)
  (slot "q" (struct "P8") 8 4)
  (slot "mi" (struct "M12") 12 4)
  (slot "tmp.3" (struct "M12") 12 4)
  (slot "tmp.4" (struct "M12") 12 4)
  (slot "bm" (struct "M12") 12 4)
  (slot "tmp.5" (struct "P8") 8 4)
  (slot "tmp.6" (union "U") 4 4)
  (slot "tmp.7" (struct "M12") 12 4)
  (slot "tmp.8" int 4 4)
  (store (ptr int) $"out" %0)
  (store int $"n" %1)
  (let %5 unsigned_int (call unsigned_int &"__nfcxx_tid_x"))
  (let %6 int (iconv int %5))
  (let %7 unsigned_int (call unsigned_int &"__nfcxx_ctaid_x"))
  (let %8 int (iconv int %7))
  (let %9 unsigned_int (call unsigned_int &"__nfcxx_ntid_x"))
  (let %10 int (iconv int %9))
  (let %11 int (wmul int %8 %10))
  (let %12 int (wadd int %6 %11))
  (store int $"i" %12)
  (let %13 int (load int $"i"))
  (let %14 int (load int $"n"))
  (let %15 bool (lt.s int %13 %14))
  (if %15
    (then
      (block
        (let %16 int (load int %2))
        (let %17 int (load int $"i"))
        (let %18 int (wadd int %16 %17))
        (store int $"tmp" %18)
        (let %19 (ptr int) (offset %2 4))
        (let %20 int (load int %19))
        (store int $"tmp.1" %20)
        (let %21 int (load int $"tmp"))
        (let %22 int (load int $"tmp.1"))
        (eval (call void &"mk_p8" (sret (struct "P8") $"tmp.2") %21 %22))
        (copy 8 $"q" $"tmp.2")
        (copy 12 $"mi" %4)
        (let %23 int (load int $"i"))
        (let %24 int (load int $"mi"))
        (let %25 int (wadd int %24 %23))
        (store int $"mi" %25)
        (copy 12 $"tmp.4" $"mi")
        (eval (call void &"bump_m12" (sret (struct "M12") $"tmp.3") (byval (struct "M12") $"tmp.4")))
        (copy 12 $"bm" $"tmp.3")
        (copy 8 $"tmp.5" $"q")
        (let %26 int (call int &"sum_p8" (byval (struct "P8") $"tmp.5")))
        (copy 4 $"tmp.6" %3)
        (let %27 int (call int &"u_read" (byval (union "U") $"tmp.6")))
        (let %28 int (wadd int %26 %27))
        (copy 12 $"tmp.7" $"bm")
        (let %29 int (call int &"sum_m12" (byval (struct "M12") $"tmp.7")))
        (let %30 int (wadd int %28 %29))
        (store int $"tmp.8" %30)
        (let %31 int (load int $"tmp.8"))
        (let %32 (ptr int) (load (ptr int) $"out"))
        (let %33 int (load int $"i"))
        (let %34 (ptr int) (index %32 %33 4))
        (store int %34 %31))))
  (return))
