(ir-module "p.cpp" (layout (short 2) (int 4) (long 8) (long_long 8) (pointer 8) (float 4) (double 8) (long_double 16)))
(function "sub1"
  (ret long)
  (params (param %0 "x" long))
  (return (wadd long %0 (const long 1))))
(function "case_main"
  (ret long)
  (params (param %0 "n" long))
  (slot "a" (array 8 int) 32 4)
  (slot "fp" (ptr void) 8 8)
  (let %ip (ptr int) (index (addr $"a") %0 4))
  (let %d1 long (pdiff %ip (addr $"a") 4))
  (let %d2 long (pdiff (addr $"a") %ip 4))
  (store (ptr void) $"fp" &"sub1")
  (let %f (ptr void) (load (ptr void) $"fp"))
  (let %r long (call long %f %0))
  (let %s1 long (wadd long %d1 %r))
  (let %s2 long (wmul long %d2 (const long 1000)))
  (let %s long (wadd long %s1 %s2))
  (return %s))
