(ir-module "share.cpp" (layout (short 2) (int 4) (long 8) (long_long 8) (pointer 8) (float 4) (double 8) (long_double 16)))
(function "case_main"
  (ret int)
  (params (param %0 "n" int))
  (slot "g" (array 256 int) 1024 16)
  (slot "a" (array 256 int) 1024 16)
  (slot "b" (array 256 int) 1024 16)
  (slot "c" (array 256 int) 1024 16)
  (slot "d" (array 256 int) 1024 16)
  (slot "f" (array 256 int) 1024 16)
  (slot "e" (array 256 int) 1024 16)
  (slot "i" int 4 4)
  (slot "s" int 4 4)
  (store int $"s" (const int 0))
  (life-start $"g")
  (let %pg (ptr int) (bitcast (ptr int) $"g"))
  (let %g1 int (wadd int %0 (const int 7)))
  (eval (call void &"fill" %pg (const int 256) %g1))
  (life-end $"g")
  (life-start $"a")
  (let %pa (ptr int) (bitcast (ptr int) $"a"))
  (eval (call void &"fill" %pa (const int 256) %0))
  (let %a1 int (call int &"sumi" %pa (const int 256)))
  (let %a2 int (load int $"s"))
  (let %a3 int (wadd int %a1 %a2))
  (store int $"s" %a3)
  (life-end $"a")
  (life-start $"b")
  (let %pb (ptr int) (bitcast (ptr int) $"b"))
  (let %b0 int (wadd int %0 (const int 1)))
  (eval (call void &"fill" %pb (const int 256) %b0))
  (let %b1 int (call int &"sumi" %pb (const int 256)))
  (let %b2 int (load int $"s"))
  (let %b3 int (wadd int %b1 %b2))
  (store int $"s" %b3)
  (life-end $"b")
  (life-start $"c")
  (life-start $"d")
  (let %pc (ptr int) (bitcast (ptr int) $"c"))
  (let %pd (ptr int) (bitcast (ptr int) $"d"))
  (let %c0 int (wadd int %0 (const int 2)))
  (let %d0 int (wadd int %0 (const int 3)))
  (eval (call void &"fill" %pc (const int 256) %c0))
  (eval (call void &"fill" %pd (const int 256) %d0))
  (let %c1 int (call int &"sumi" %pc (const int 256)))
  (let %d1 int (call int &"sumi" %pd (const int 256)))
  (let %cd int (wadd int %c1 %d1))
  (let %c2 int (load int $"s"))
  (let %c3 int (wadd int %cd %c2))
  (store int $"s" %c3)
  (life-end $"d")
  (life-end $"c")
  (let %pf (ptr int) (bitcast (ptr int) $"f"))
  (let %f0 int (wadd int %0 (const int 4)))
  (eval (call void &"fill" %pf (const int 256) %f0))
  (let %f1 int (call int &"sumi" %pf (const int 256)))
  (let %f2 int (load int $"s"))
  (let %f3 int (wadd int %f1 %f2))
  (store int $"s" %f3)
  (store int $"i" (const int 0))
  (loop
    (body
      (let %l1 int (load int $"i"))
      (let %l2 bool (lt.s int %l1 (const int 3)))
      (if %l2 (then) (else (break)))
      (life-start $"e")
      (let %pe (ptr int) (bitcast (ptr int) $"e"))
      (let %l3 int (load int $"i"))
      (let %l4 int (wadd int %0 %l3))
      (eval (call void &"fill" %pe (const int 256) %l4))
      (let %l5 int (call int &"sumi" %pe (const int 256)))
      (life-end $"e")
      (let %l6 int (load int $"s"))
      (let %l7 int (wadd int %l6 %l5))
      (store int $"s" %l7)
      (let %l8 int (load int $"i"))
      (let %l9 int (wadd int %l8 (const int 1)))
      (store int $"i" %l9))
    (step))
  (let %pg2 (ptr int) (bitcast (ptr int) $"g"))
  (let %g2 int (call int &"sumi" %pg2 (const int 256)))
  (let %g3 int (load int $"s"))
  (let %g4 int (wadd int %g2 %g3))
  (return %g4))
