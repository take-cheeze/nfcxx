(ir-module "byval.cpp" (layout (short 2) (int 4) (long 8) (long_long 8) (pointer 8) (float 4) (double 8) (long_double 16)))
(abi-type "II" 8 4 (leaf 0 w) (leaf 4 w))
(abi-type "LL" 16 8 (leaf 0 l) (leaf 8 l))
(abi-type "DD" 16 8 (leaf 0 d) (leaf 8 d))
(abi-type "LD" 16 8 (leaf 0 l) (leaf 8 d))
(abi-type "L3" 24 8 (memory))
(function "mk_ii"
  (ret void)
  (params (sret %0 (struct "II")) (param %1 "a" int) (param %2 "b" int))
  (slot "r" (struct "II") 8 4)
  (store int $"r" %1)
  (store int (offset $"r" 4) %2)
  (copy 8 %0 $"r" 4)
  (return))
(function "mk_ll"
  (ret void)
  (params (sret %0 (struct "LL")) (param %1 "a" long) (param %2 "b" long))
  (slot "r" (struct "LL") 16 8)
  (store long $"r" %1)
  (store long (offset $"r" 8) %2)
  (copy 16 %0 $"r" 8)
  (return))
(function "mk_dd"
  (ret void)
  (params (sret %0 (struct "DD")) (param %1 "a" double) (param %2 "b" double))
  (slot "r" (struct "DD") 16 8)
  (store double $"r" %1)
  (store double (offset $"r" 8) %2)
  (copy 16 %0 $"r" 8)
  (return))
(function "mk_ld"
  (ret void)
  (params (sret %0 (struct "LD")) (param %1 "a" long) (param %2 "b" double))
  (slot "r" (struct "LD") 16 8)
  (store long $"r" %1)
  (store double (offset $"r" 8) %2)
  (copy 16 %0 $"r" 8)
  (return))
(function "mk_l3"
  (ret void)
  (params (sret %0 (struct "L3")) (param %1 "a" long))
  (slot "r" (struct "L3") 24 8)
  (store long $"r" %1)
  (store long (offset $"r" 8) (wadd long %1 (const long 1)))
  (store long (offset $"r" 16) (wadd long %1 (const long 2)))
  (copy 24 %0 $"r" 8)
  (return))
(function "sum_ii"
  (ret int)
  (params (param %0 "v" (byval (struct "II"))))
  (return (wadd int (load int %0) (load int (offset %0 4)))))
(function "sum_ll"
  (ret long)
  (params (param %0 "v" (byval (struct "LL"))) (param %1 "k" long))
  (return (wadd long (wadd long (load long %0) (load long (offset %0 8))) %1)))
(function "sum_dd"
  (ret double)
  (params (param %0 "v" (byval (struct "DD"))) (param %1 "k" double))
  (return (fadd double (fadd double (load double %0) (load double (offset %0 8))) %1)))
(function "sum_l3"
  (ret long)
  (params (param %0 "v" (byval (struct "L3"))))
  (return (wadd long (load long (offset %0 16)) (load long %0))))
(function "pass_ii"
  (ret int)
  (params (param %0 "x" int) (param %1 "y" int))
  (slot "t" (struct "II") 8 4)
  (eval (call void &"mk_ii" (sret (struct "II") $"t") %0 %1))
  (return (call int &"sum_ii" (byval (struct "II") $"t"))))
