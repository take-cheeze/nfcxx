    (let %8 int (cdiv int %0 (const int 4)))
    (let %9 int (cdiv int %0 (const int -7)))
    (let %10 int (crem int %0 (const int 10)))
    (let %11 int (wmul int %2 (const int 3)))
    (let %12 int (wadd int %1 %11))
    (let %13 int (wadd int %12 %3))
    (let %14 int (wadd int %13 %4))
    (let %15 int (wadd int %14 %5))
