(ir-module "bf.cpp" (layout (short 2) (int 4) (long 8) (long_long 8) (pointer 8) (float 4) (double 8) (long_double 16)))
(function "main"
  (ret int)
  (params (param %0 "x" int))
  (slot "s" (struct "II") 8 4)
  (store unsigned_int $"s" (const unsigned_int 0))
  (bfstore unsigned_int 4 (addr $"s") 0 3 %0)
  (bfstore unsigned_int 4 (addr $"s") 3 5 %0)
  (bfstore unsigned_int 4 (addr $"s") 28 4 %0)
  (let %1 unsigned_int (bfload unsigned_int 4 (addr $"s") 0 3))
  (let %2 int (bfload int 4 (addr $"s") 3 5))
  (let %3 unsigned_int (bfload unsigned_int 4 (addr $"s") 28 4))
  (let %4 int (wadd int %1 %2))
  (let %5 int (wadd int %4 %3))
  (return %5))
