# Builds build/nfcbundle (docs/notes/bundle.md). Run: ninja -C tools/bundle
# CXX and CXXFLAGS come from the environment, with the defaults of the Makefile this replaces.
ninja_required_version = 1.7
root = ../..

rule cxx
  command = $${CXX:-g++} $${CXXFLAGS:--std=c++17 -O2 -Wall -Wextra} -o $out.tmp $in && mv -f $out.tmp $out
  description = CXX $out

build $root/build/nfcbundle: cxx nfcbundle.cpp
